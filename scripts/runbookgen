#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
command="${1:-}"

case "$command" in
  e2e)
    shift
    exec "$root/scripts/run_factory_e2e.sh" "$@"
    ;;
  status)
    shift
    exec python3 "$root/scripts/runbookgen_status.py" "$@"
    ;;
  validate)
    shift
    exec python3 "$root/scripts/runbookgen_validate.py" "$@"
    ;;
  help|--help|-h|"")
    cat <<'EOF'
Usage: runbookgen <command>

Commands:
  e2e    Interactively choose an example project (or set E2E_SCENARIO), run
         its real factory, validate generated R-series runbooks, then verify
         resume behaviour.
  status [project-name]
         Show the durable E2E/factory state, accepted and active tasks, and
         generated B/R runbook counts. `--project <name>` also works.
  validate [project-name] [--require-r-series]
         Deterministically validate narrative, visual, and audio coverage.
         Use --require-r-series only once all generated R contracts should
         exist; ordinary dispatcher/B waves validate the IMP routes first.

The e2e command uses the configured real Supervisor agents and leaves its
generated project workspace under projects/ for inspection.
EOF
    ;;
  *)
    echo "Unknown runbookgen command: $command" >&2
    echo "Run 'runbookgen help' for usage." >&2
    exit 2
    ;;
esac
