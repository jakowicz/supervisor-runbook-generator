# Versioned non-secret Supervisor configuration.
# Re-run the command whenever the agent, QA, dashboard, or telemetry policy changes.

BROWSER_QA_COMMAND=./supervisor/.venv/bin/python supervisor/scripts/browser_worker.py {task_file}
CODEX_COMMAND=./supervisor/.venv/bin/python supervisor/scripts/codex_worker.py {task_file}
CODEX_MODEL=gpt-5.6-terra
LANGFUSE_BASE_URL=http://127.0.0.1:3001
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=ollama/qwen3-coder-next:latest
OLLAMA_BASE_URL=http://127.0.0.1:11434
OPENHANDS_COMMAND=./supervisor/.venv/bin/python supervisor/scripts/openhands_worker.py {task_file}
QWEN_CODER_COMMAND=./supervisor/.venv/bin/python supervisor/scripts/qwen_worker.py {task_file}
QWEN_MODEL=qwen3-coder-next:latest
SUPERVISOR_AGENT_ORDER=codex
SUPERVISOR_ALLOW_AUTONOMOUS_WRITES=true
SUPERVISOR_AUTO_COMMIT=false
SUPERVISOR_AUTO_PUSH=false
SUPERVISOR_CODEX_ATTEMPTS=3
SUPERVISOR_CODEX_FINAL_ATTEMPTS=3
SUPERVISOR_CODING_AGENTS=codex
SUPERVISOR_TEST_COMMANDS=["git diff --check","python3 scripts/runbookgen_validate.py"]
SUPERVISOR_DASHBOARD_PORT=8765
SUPERVISOR_DATABASE_PATH=.state/supervisor.sqlite3
SUPERVISOR_ENV_SCHEMA_VERSION=4
SUPERVISOR_OBSERVABILITY_ENABLED=true
SUPERVISOR_OBSERVABILITY_ENVIRONMENT=local
SUPERVISOR_OPENHANDS_ATTEMPTS=1
SUPERVISOR_PROGRESS_HEARTBEAT_SECONDS=30
SUPERVISOR_QWEN_ATTEMPTS=1
SUPERVISOR_QWEN_IDLE_TIMEOUT_SECONDS=600
SUPERVISOR_REPO_ROOT=../..
SUPERVISOR_WORKER_TIMEOUT_SECONDS=1800

# Art direction selected by `supervisor initial`.
ART_DIRECTION_BRIEF=Original modern football broadcast graphics, bold category colours, readable typography, and celebratory but accessible feedback
ART_DIRECTION_MODE=user_provided
ART_DIRECTION_MODEL=gemma4:12b
ART_PRODUCT_SLUG=football-trivia-e2e
ART_STYLE_NAME=user-directed original product art
ART_STYLE_PROMPT=Original modern football broadcast graphics, bold category colours, readable typography, and celebratory but accessible feedback, original product asset, clear readable silhouette, no text, no logo

# Art direction selected by `supervisor initial`.
AUDIO_DIRECTION_BRIEF=
AUDIO_DIRECTION_MODE=gemma4_auto
AUDIO_DIRECTION_MODEL=gemma4:12b
AUDIO_GENERATOR_COMMAND=./supervisor/.venv/bin/python supervisor/scripts/ace_audio_generator.py {task_file}
AUDIO_QA_COMMAND=./supervisor/.venv/bin/python supervisor/scripts/audio_qa_worker.py {task_file}

# Applied by `supervisor update`; values already set above were preserved.
SUPERVISOR_FAILURE_SUMMARY_ENABLED=true
SUPERVISOR_FAILURE_SUMMARY_MODEL=gemma4:12b
SUPERVISOR_FAILURE_SUMMARY_TIMEOUT_SECONDS=180
SUPERVISOR_FAILURE_SUMMARY_KEEP_ALIVE=0
ACE_STEP_API_URL=http://127.0.0.1:8001
ACE_STEP_MODEL=acestep-v15-xl-turbo
ACE_STEP_GENERATION_TIMEOUT_SECONDS=1800
ACE_STEP_INFERENCE_STEPS=8
AUDIO_STYLE_NAME=original product audio
AUDIO_STYLE_PROMPT=original instrumental product music, clear looping structure, no vocals, no recognisable melody
SUPERVISOR_ENV_SCHEMA_VERSION=7
