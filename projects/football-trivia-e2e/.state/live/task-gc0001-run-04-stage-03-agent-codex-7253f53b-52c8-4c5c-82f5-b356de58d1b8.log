[stderr] def front_matter(path: Path) -> dict[str, str]:
[stderr]     document = path.read_text(encoding="utf-8")
[stderr]     match = re.match(r"^---\n(.*?)\n---\n", document, re.DOTALL)
[stderr]     if not match:
[stderr]         return {}
[stderr]     result: dict[str, str] = {}
[stderr]     for line in match.group(1).splitlines():
[stderr]         key, separator, value = line.partition(":")
[stderr]         if separator:
[stderr]             result[key.strip()] = value.strip()
[stderr]     return result
[stderr] 
[stderr] 
[stderr] def identifiers(path: Path, kind: str) -> set[str]:
[stderr]     return set(ID_PATTERNS[kind].findall(path.read_text(encoding="utf-8"))) if path.is_file() else set()
