[stderr] +## Objective
[stderr] +
[stderr] +Read `../PROJECT_BRIEF.md`, `../INITIAL.md`, `../specification/00-domain-discovery.md`,
[stderr] +`../specification/01-game-identity.md`, `../specification/02-game-design-bible.{md,json}`,
