ntext, repo_root)\nsupervisor/supervisor/cli.py-205-        return\n--\nsupervisor/supervisor/cli.py-582-    return [f\"{start_prefix.upper()}{number:0{width}d}\" for number in range(int(start_number), int(end_number) + 1)]\nsupervisor/supervisor/cli.py-583-\nsupervisor/supervisor/cli.py-584-\nsupervisor/supervisor/cli.py:585:def _collection_runbooks(directory: Path) -> list[Path]:\nsupervisor/supervisor/cli.py:586:    \"\"\"Return a collection's task contracts in their declared sequence order.\"\"\"\nsupervisor/supervisor/cli.py-587-\nsupervisor/supervisor/cli.py-588-    candidates = [path for path in directory.glob(\"*.md\") if re.fullmatch(r\"[A-Za-z]+\\d+\", path.stem)]\nsupervisor/supervisor/cli.py-589-    return sorted(candidates, key=lambda path: (load_task(path).sequence, path.name))\nsupervisor/supervisor/cli.py-590-\nsupervisor/supervisor/cli.py-591-\nsupervisor/supervisor/cli.py-592-def _initial_document(directory: Path, explicit_path: Path | None = None) -> str:\nsupervisor/supervisor/cli.py:593:    \"\"\"Load the collection context that must precede an all-task run.\"\"\"\nsupervisor/supervisor/cli.py-594-\nsupervisor/supervisor/cli.py-595-    if explicit_path is not None:\nsupervisor/supervisor/cli.py-596-        path = explicit_path.expanduser().resolve()\n--\nsupervisor/supervisor/cli.py-601-            raise ValueError(f\"--initial requires a completed {path}.\")\nsupervisor/supervisor/cli.py-602-        return content\nsupervisor/supervisor/cli.py-603-\nsupervisor/supervisor/cli.py:604:    # Generated collections live one level below a project workspace and inherit\nsupervisor/supervisor/cli.py-605-    # its normalised brief. The source factory receives its brief explicitly by\nsupervisor/supervisor/cli.py-606-    # --initial, preventing a global CLI from accidentally reading another\nsupervisor/supervisor/cli.py-607-    # project's INITIAL.md.\n--\nsupervisor/supervisor/cli.py-636-\nsupervisor/supervisor/cli.py-637-\nsupervisor/supervisor/cli.py-6