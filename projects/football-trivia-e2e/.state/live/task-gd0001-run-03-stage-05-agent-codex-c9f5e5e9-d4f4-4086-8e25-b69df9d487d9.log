[stderr]     errors: list[str] = []
[stderr]     audit = manifest.get("final_audit")
[stderr]     if manifest.get("status") != "accepted":
[stderr]         errors.append("game-design manifest status must be accepted")
[stderr]     if not isinstance(audit, dict) or not isinstance(audit.get("task_id"), str) or not audit["task_id"].startswith("G") or audit.get("status") != "accepted":
[stderr]         errors.append("game-design manifest needs an accepted G-series final_audit")
[stderr]     modules = {item.get("module"): item for item in object_items(manifest.get("modules")) if isinstance(item.get("module"), str)}
[stderr]     for module in sorted(selected_modules):
[stderr]         entry = modules.get(module)
[stderr]         if not isinstance(entry, dict) or entry.get("status") != "accepted":
[stderr]             errors.append(f"game-design manifest has no accepted entry for selected module {module!r}")
[stderr]             continue
[stderr]         if not values(entry.get("design_output_paths")):
[stderr]             errors.append(f"game-design manifest module {module!r} has no design output")
[stderr]         covered = set(values(entry.get("game_design_ids")))
[stderr]         required = {str(unit["id"]) for unit in design_units if unit.get("module") == module and isinstance(unit.get("id"), str)}
[stderr]         if required and not required.issubset(covered):
[stderr]             errors.append(f"game-design manifest module {module!r} does not cover its GAME-* units")
[stderr]     if values(manifest.get("pending_modules")) or values(manifest.get("blocked_modules")):
[stderr]         errors.append("game-design manifest still has pending or blocked modules")
[stderr]     return errors
