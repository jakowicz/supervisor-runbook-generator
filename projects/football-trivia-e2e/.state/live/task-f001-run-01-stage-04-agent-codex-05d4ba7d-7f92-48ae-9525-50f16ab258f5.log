"requirement_ids\":[\"REQ-0007\",\"REQ-0010\",\"NFR-0004\",\"NFR-0008\"],\"bounded_outcome\":\"Original semantic tokens cover typography, spacing, focus, motion, touch targets, status, contrast, and non-colour cues, enabling later responsive web UI and inherited PWA UI.\",\"prerequisites\":[\"IMP-0001\",\"IMP-0002\"],\"ownership\":{\"files\":[\"src/app/design/tokens/\",\"docs/design-tokens.md\",\"tests/app/design-tokens.*\"],\"data\":[\"semantic token inventory\"],\"api\":[\"token consumption contract\"]},\"forbidden_scope\":[\"screens\",\"maps\",\"final artwork/fonts\",\"final breakpoints\",\"copied reference styling\"],\"verification\":\"Token validation proves semantic labels/non-colour cues and reduced-motion values in representative fixtures.\",\"human_external_gate\":\"GATE-0002 and GATE-0004 before numeric contrast/font/breakpoint claims.\",\"complexity\":\"medium\",\"status\":\"gated\"},\n    {\"id\":\"IMP-0011\",\"title\":\"Create original-content provenance control\",\"domain\":\"content\",\"targets\":[\"shared\"],\"requirement_ids\":[\"REQ-0001\",\"REQ-0008\",\"NFR-0008\"],\"bounded_outcome\":\"A provenance record format, review checklist, and source-asset manifest make authorship and permitted functional reference scope auditable before authored content enters a build.\",\"prerequisites\":[\"IMP-0005\"],\"ownership\":{\"files\":[\"assets/source-manifest.*\",\"docs/original-content-review.md\",\"tests/content/provenance.*\"],\"data\":[\"provenance manifest and review disposition\"],\"api\":[\"provenance validator input contract\"]},\"forbidden_scope\":[\"creating art/audio/story\",\"licensing approval\",\"automatic legal clearance\"],\"verification\":\"Validator rejects missing provenance fields; human creative review is recorded for each authored package.\",\"human_external_gate\":\"Human creative/provenance review; legal or licensing review if applicable under GATE-0007.\",\"complexity\":\"low\",\"status\":\"current\"},\n    {\"id\":\"IMP-0012\",\"title\":\"Document foundation architecture and recovery boundaries\",\"domain\":\"documentation\",\"targets\":[\"shared\",\"web\",\"pwa\"],\"requirement_ids\":[\"NFR-0012\",\"NFR-0010\",\"NFR-0002\",\"NFR-0003\"],\"bounded_outcome\":\"Developer documentation records ownership, command flow, save-versus-cache separation, deferred connected scope, and the decisions/gates that later domain authors must preserve.\",\"prerequisites\":[\"IMP-0002\",\"IMP-0004\",\"IMP-0006\",\"IMP-0008\"],\"ownership\":{\"files\":[\"docs/{architecture,development,save-and-recovery,security-boundary}.md\"],\"data\":[\"foundation decision and ownership index\"],\"api\":[\"documented public-boundary inventory\"]},\"forbidden_scope\":[\"player release guide\",\"operational rollout\",\"claiming approved vendor or policy choices\"],\"verification\":\"Documentation review cross-checks every foundation contract's ownership, dependency, and gate against this catalogue.\",\"human_external_gate\":\"None; approval gates are documented, not resolved.\",\"complexity\":\"low\",\"status\":\"current\"},\n    {\"id\":\"IMP-0013\",\"title\":\"Define exploration scene and exit transition contract\",\"domain\":\"campaign\",\"targets\":[\"shared\"],\"requirement_ids\":[\"REQ-0002\",\"REQ-0008\",\"NFR-0007\"],\"bounded_outcome\":\"Content-neutral scene, exit, collision, and interaction transitions preserve a completable route without UI ownership.\",\"prerequisites\":[\"IMP-0004\",\"IMP-0005\"],\"ownership\":{\"files\":[\"src/core/campaign/scene*\",\"tests/core/campaign/scene*\"],\"data\":[\"scene and exit envelope\"],\"api\":[\"scene transition commands\"]},\"forbidden_scope\":[\"UI\",\"extra regions\",\"procedural worlds\",\"authored maps\"],\"verification\":\"Invalid exits and references leave state unchanged; a route graph is validated.\",\"human_external_gate\":\"GATE-0004 before concrete content shapes.\",\"complexity\":\"medium\",\"status\":\"ready_for_authoring\"},\n    {\"id\":\"IMP-0014\",\"title\":\"Define