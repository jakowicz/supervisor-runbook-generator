01\": {\"imp_ids\": [\"IMP-FT-001\"], \"roles\": [\"creation\", \"QA\"], \"shard\": \"current\"},\n+      \"AUDIO-002\": {\"imp_ids\": [\"IMP-FT-001\"], \"roles\": [\"creation\", \"integration\", \"QA\"], \"shard\": \"current\"},\n+      \"AUDIO-003\": {\"imp_ids\": [\"IMP-FT-002\"], \"roles\": [\"creation\", \"QA\"], \"shard\": \"current\"}\n+    },\n+    \"narrative\": {}\n+  }\n+}\ndiff --git a/projects/football-trivia-e2e/specification/02-game-design-bible.json b/projects/football-trivia-e2e/specification/02-game-design-bible.json\nnew file mode 100644\nindex 0000000000000000000000000000000000000000..eec366b318d0dc03230bd9191227603274670db1\n--- /dev/null\n+++ b/projects/football-trivia-e2e/specification/02-game-design-bible.json\n@@ -0,0 +1,9 @@\n+{\n+  \"game_archetypes\": [\"football-trivia\", \"puzzle\", \"turn-based-quiz\"],\n+  \"selected_modules\": [\"quiz-content\", \"round-rules\", \"player-experience\"],\n+  \"design_units\": [\n+    {\"id\": \"GAME-001\", \"module\": \"quiz-content\", \"production_mode\": \"editorial-schema\", \"title\": \"Curated question card\"},\n+    {\"id\": \"GAME-002\", \"module\": \"round-rules\", \"production_mode\": \"rules-and-state\", \"title\": \"Themed round resolution\"},\n+    {\"id\": \"GAME-003\", \"module\": \"player-experience\", \"production_mode\": \"interaction-and-accessibility\", \"title\": \"Accessible resumable session\"}\n+  ]\n+}\ndiff --git a/projects/football-trivia-e2e/specification/02-game-design-bible.md b/projects/football-trivia-e2e/specification/02-game-design-bible.md\nnew file mode 100644\nindex 0000000000000000000000000000000000000000..ec7bffe89e7958085ae46771aee8189072317240\n--- /dev/null\n+++ b/projects/football-trivia-e2e/specification/02-game-design-bible.md\n@@ -0,0 +1,26 @@\n+# 02 \u2014 Game design bible\n+\n+**Status:** original first-release design proposal derived from the discovery\n+classification. It deliberately implements a football-trivia game, not an RPG\n+or football match simulation.\n+\n+## Selected modules and production units\n+\n+| Module | ID | First-release design unit | Production mode |\n+| --- | --- | --- | --- |\n+| `quiz-content` | GAME-001 | Question cards carry an original prompt, category, format, difficulty, answer rule, explanation, provenance/review status, and repeat eligibility. | editorial-schema |\n+| `round-rules` | GAME-002 | A themed short round sequences eligible cards, resolves answers deterministically, applies a score/streak rule, and ends in a results state. | rules-and-state |\n+| `player-experience` | GAME-003 | Onboarding, accessible feedback, pause/resume, settings, and recovery make the short session understandable and safely interruptible. | interaction-and-accessibility |\n+\n+## Boundaries\n+\n+The selected modules support the GAME-001 through GAME-005 identity pillars:\n+fast football knowledge, fair adjudication, recoverable momentum, curated\n+variety, and trustworthy return play. Candidate editorial refresh tooling is a\n+supporting workflow for `quiz-content`, not a promise of live service.\n+\n+Rejected modules remain out of scope: fictional world, party, combat, quests,\n+bosses, equipment, builder economy, racing physics, match simulation,\n+platforming, matchmaking, chat, rankings, and social graph. Account, remote\n+sync, multiplayer safety, commerce, and live operations require separate human\n+approval before selection.\ndiff --git a/projects/football-trivia-e2e/specification/04-asset-direction.md b/projects/football-trivia-e2e/specification/04-asset-direction.md\nnew file mode 100644\nindex 0000000000000000000000000000000000000000..c5f7328dcf4019f6ded1b7ab82cb9ab117f427a8\n--- /dev/null\n+++ b/projects/football-trivia-e2e/specification/04-asset-direction.md\n@@ -0,0 +1,15 @@\n+# 04 \u2014 Asset direction\n+\n+All asset groups use the original abstract broadcast-studio direction established\n+in `01-creative-direction.md`; they must not reproduce clubs, competitions,\n+broadcasters, The Athletic, QuizUp, kit designs, screenshots, or layouts.\n+\n+| ID | Asset group | Direction and accessibility boundary |\n+| --- | --- | --- |\n+| ASSET-001 | Category and round graphics | Original bold category fields, abstract pitch lines, stat blocks, and signal sweeps; labels and shapes carry meaning beyond colour. |\n+| ASSET-002 | Answer and score feedback | Original correct/incorrect/streak/completion state motifs with text, icon, and motion-reduced alternatives. |\n+| ASSET-003 | Install and responsive shell art | Original neutral app-mark and scalable studio surfaces; no real team, competition, or reference-product marks. |\n+\n+Asset quantities, file formats, and final delivery budgets remain pending target\n+and packaging decisions. Each asset requires provenance and human creative\n+review before production use.\ndiff --git a/projects/football-trivia-e2e/specification/04-audio-direction.md b/projects/football-trivia-e2e/specification/04-audio-direction.md\nnew file mode 100644\nindex 0000000000000000000000000000000000000000..80b9199a22884f3ba1a05ef471920526a4e70852\n--- /dev/null\n+++ b/projects/football-trivia-e2e/specification/04-audio-direction.md\n@@ -0,0 +1,14 @@\n+# 04 \u2014 Audio direction\n+\n+Audio is original, optional, captioned/described where it conveys state, and\n+always paired with a visual/text equivalent. No chant, anthem, broadcast,\n+club, or game imitation is permitted.\n+\n+| ID | Cue group | Intent |\n+| --- | --- | --- |\n+| AUDIO-001 | Entry and round bed | Restrained, low-distraction electronic percussion with abstract crowd-energy texture; optional and volume-controlled. |\n+| AUDIO-002 | Answer and streak feedback | Brief distinct correct, incorrect, and streak cues using claps and soft brass-like synth accents without sampled sports expression. |\n+| AUDIO-003 | Results and completion | Warm, short celebratory sting that supports rather than replaces the readable results state. |\n+\n+Final durations, quantities, loudness targets, loop policy, and generated-cue\n+selection need production approval; no audio is generated by this plan.\n\napply patch\npatch: completed\n/Users/simon/Dev/github/jakowicz/runbook-generator/projects/football-trivia-e2e/specification/02-game-design-bible.md\ndiff --git a/projects/football-trivia-e2e/planning/game-design-manifest.json b/projects/football-trivia-e2e/planning/game-design-manifest.json\nnew file mode 100644\nindex 0000000000000000000000000000000000000000..61043c7c2f2a078b1785ee51e6c06575aec060b8\n--- /dev/null\n+++ b/projects/football-trivia-e2e/planning/game-design-manifest.json\n@@ -0,0 +1,11 @@\n+{\n+  \"status\": \"accepted\",\n+  \"final_audit\": {\"task_id\": \"G-FT-001\", \"status\": \"accepted\", \"scope\": \"football trivia selected modules only\"},\n+  \"pending_modules\": [],\n+  \"blocked_modules\": [],\n+  \"modules\": [\n+    {\"module\": \"quiz-content\", \"status\": \"accepted\", \"design_output_paths\": [\"specification/02-game-design-bible.md#quiz-content\"], \"game_design_ids\": [\"GAME-001\"]},\n+    {\"module\": \"round-rules\", \"status\": \"accepted\", \"design_output_paths\": [\"specification/02-game-design-bible.md#round-rules\"], \"game_design_ids\": [\"GAME-002\"]},\n+    {\"module\": \"player-experience\", \"status\": \"accepted\", \"design_output_paths\": [\"specification/02-game-design-bible.md#player-experience\"], \"game_design_ids\": [\"GAME-003\"]}\n+  ]\n+}\ndiff --git a/projects/football-trivia-e2e/planning/game-production-inventory.json b/projects/football-trivia-e2e/planning/game-production-inventory.json\nnew file mode 100644\nindex 0000000000000000000000000000000000000000..4b406ab702a8e8cd8aaaa2aaa075f15358e465c3\n--- /dev/null\n+++ b/projects/football-trivia-e2e/planning/game-production-inventory.json\n@@ -0,0 +1,7 @@\n+{\n+  \"entries\": [\n+    {\"game_design_id\": \"GAME-001\", \"module\": \"quiz-content\", \"production_kind\": \"question-schema-and-editorial-fixtures\", \"planned_quantity\": \"one validated schema plus a representative reviewed starter set\", \"verification\": \"schema, provenance, answer-rule, and duplicate-content validation\"},\n+    {\"game_design_id\": \"GAME-002\", \"module\": \"round-rules\", \"production_kind\": \"deterministic-round-state-machine\", \"planned_quantity\": \"one themed-round lifecycle with score, streak, and result transitions\", \"verification\": \"unit fixtures for accepted, rejected, repeated, interrupted, and completed rounds\"},\n+    {\"game_design_id\": \"GAME-003\", \"module\": \"player-experience\", \"production_kind\": \"accessible-session-and-recovery-flow\", \"planned_quantity\": \"onboarding, answer feedback, results, settings, and resume/recovery states\", \"verification\": \"keyboard/touch/screen-reader/reduced-motion and save-recovery checks\"}\n+  ]\n+}\ndiff --git a/projects/football-trivia-e2e/planning/implementation-catalogue-index.json b/projects/football-trivia-e2e/planning/implementation-catalogue-index.json\nnew file mode 100644\nindex 0000000000000000000000000000000000000000..8c44a32e18f7f01d8e9f9290e8db0b1287e4189e\n--- /dev/null\n+++ b/projects/football-trivia-e2e/planning/implementation-catalogue-index.json\n@@ -0,0 +1,28 @@\n+{\n+  \"catalogue_id\": \"football-trivia-e2e-implementation-catalogue\",\n+  \"version\": 1,\n+  \"scope\": \"Original single-player football trivia core for responsive web, PWA, Android, and iOS adaptations; connected and commerce systems are decision-gated.\",\n+  \"contracts\": [\n+    {\"id\": \"IMP-FT-001\", \"title\": \"Implement curated quiz content and round rules\", \"creative_coverage_ids\": [\"GAME-001\", \"GAME-002\", \"ASSET-001\", \"ASSET-002\", \"AUDIO-001\", \"AUDIO-002\"], \"status\": \"planned\"},\n+    {\"id\": \"IMP-FT-002\", \"title\": \"Implement accessible resumable player experience\", \"creative_coverage_ids\": [\"GAME-003\", \"ASSET-003\", \"AUDIO-003\"], \"status\": \"planned\"}\n+  ],\n+  \"expansion_queue\": [],\n+  \"creative_coverage\": {\n+    \"game\": {\n+      \"GAME-001\": {\"imp_ids\": [\"IMP-FT-001\"], \"roles\": [\"creation\", \"QA\"], \"shard\": \"current\"},\n+      \"GAME-002\": {\"imp_ids\": [\"IMP-FT-001\"], \"roles\": [\"integration\", \"QA\"], \"shard\": \"current\"},\n+      \"GAME-003\": {\"imp_ids\": [\"IMP-FT-002\"], \"roles\": [\"creation\", \"integration\", \"QA\"], \"shard\": \"current\"}\n+    },\n+    \"assets\": {\n+      \"ASSET-001\": {\"imp_ids\": [\"IMP-FT-001\"], \"roles\": [\"creation\", \"QA\"], \"shard\": \"current\"},\n+      \"ASSET-002\": {\"imp_ids\": [\"IMP-FT-001\"], \"roles\": [\"creation\", \"integration\", \"QA\"], \"shard\": \"current\"},\n+      \"ASSET-003\": {\"imp_ids\": [\"IMP-FT-002\"], \"roles\": [\"creation\", \"QA\"], \"shard\": \"current\"}\n+    },\n+    \"audio\": {\n+      \"AUDIO-001\": {\"imp_ids\": [\"IMP-FT-001\"], \"roles\": [\"creation\", \"QA\"], \"shard\": \"current\"},\n+      \"AUDIO-002\": {\"imp_ids\": [\"IMP-FT-001\"], \"roles\": [\"creation\", \"integration\", \"QA\"], \"shard\": \"current\"},\n+      \"AUDIO-003\": {\"imp_ids\": [\"IMP-FT-002\"], \"roles\": [\"creation\", \"QA\"], \"shard\": \"current\"}\n+    },\n+    \"narrative\": {}\n+  }\n+}\ndiff --git a/projects/football-trivia-e2e/specification/02-game-design-bible.json b/projects/football-trivia-e2e/specification/02-game-design-bible.json\nnew file mode 100644\nindex 0000000000000000000000000000000000000000..eec366b318d0dc03230bd9191227603274670db1\n--- /dev/null\n+++ b/projects/football-trivia-e2e/specification/02-game-design-bible.json\n@@ -0,0 +1,9 @@\n+{\n+  \"game_archetypes\": [\"football-trivia\", \"puzzle\", \"turn-based-quiz\"],\n+  \"selected_modules\": [\"quiz-content\", \"round-rules\", \"player-experience\"],\n+  \"design_units\": [\n+    {\"id\": \"GAME-001\", \"module\": \"quiz-content\", \"production_mode\": \"editorial-schema\", \"title\": \"Curated question card\"},\n+    {\"id\": \"GAME-002\", \"module\": \"round-rules\", \"production_mode\": \"rules-and-state\", \"title\": \"Themed round resolution\"},\n+    {\"id\": \"GAME-003\", \"module\": \"player-experience\", \"production_mode\": \"interaction-and-accessibility\", \"title\": \"Accessible resumable session\"}\n+  ]\n+}\ndiff --git a/projects/football-trivia-e2e/specification/02-game-design-bible.md b/projects/football-trivia-e2e/specification/02-game-design-bible.md\nnew file mode 100644\nindex 0000000000000000000000000000000000000000..909bfffade327709630b652bdbbb8ec3bd86383a\n--- /dev/null\n+++ b/projects/football-trivia-e2e/specification/02-game-design-bible.md\n@@ -0,0 +1,26 @@\n+# 02 \u2014 Game design bible\n+\n+**Status:** original first-release design proposal derived from the discovery\n+classification. It deliberately implements a football-trivia game, not an RPG\n+or football match simulation.\n+\n+## Selected modules and production units\n+\n+| Module | ID | First-release design unit | Production mode |\n+| --- | --- | --- | --- |\n+| `quiz-content` | GAME-001 | Question cards carry an original prompt, category, format, difficulty, answer rule, explanation, provenance/review status, and repeat eligibility. | editorial-schema |\n+| `round-rules` | GAME-002 | A themed short round sequences eligible cards, resolves answers deterministically, applies a score/streak rule, and ends in a results state. | rules-and-state |\n+| `player-experience` | GAME-003 | Onboarding, accessible feedback, pause/resume, settings, and recovery make the short session understandable and safely interruptible. | interaction-and-accessibility |\n+\n+## Boundaries\n+\n+The selected modules support the identity pillars of fast football knowledge,\n+fair adjudication, recoverable momentum, curated variety, and trustworthy return\n+play. Candidate editorial refresh tooling is a supporting workflow for\n+`quiz-content`, not a promise of live service.\n+\n+Rejected modules remain out of scope: fictional world, party, combat, quests,\n+bosses, equipment, builder economy, racing physics, match simulation,\n+platforming, matchmaking, chat, rankings, and social graph. Account, remote\n+sync, multiplayer safety, commerce, and live operations require separate human\n+approval before selection.\ndiff --git a/projects/football-trivia-e2e/specification/04-asset-direction.md b/projects/football-trivia-e2e/specification/04-asset-direction.md\nnew file mode 100644\nindex 0000000000000000000000000000000000000000..c5f7328dcf4019f6ded1b7ab82cb9ab117f427a8\n--- /dev/null\n+++ b/projects/football-trivia-e2e/specification/04-asset-direction.md\n@@ -0,0 +1,15 @@\n+# 04 \u2014 Asset direction\n+\n+All asset groups use the original abstract broadcast-studio direction established\n+in `01-creative-direction.md`; they must not reproduce clubs, competitions,\n+broadcasters, The Athletic, QuizUp, kit designs, screenshots, or layouts.\n+\n+| ID | Asset group | Direction and accessibility boundary |\n+| --- | --- | --- |\n+| ASSET-001 | Category and round graphics | Original bold category fields, abstract pitch lines, stat blocks, and signal sweeps; labels and shapes carry meaning beyond colour. |\n+| ASSET-002 | Answer and score feedback | Original correct/incorrect/streak/completion state motifs with text, icon, and motion-reduced alternatives. |\n+| ASSET-003 | Install and responsive shell art | Original neutral app-mark and scalable studio surfaces; no real team, competition, or reference-product marks. |\n+\n+Asset quantities, file formats, and final delivery budgets remain pending target\n+and packaging decisions. Each asset requires provenance and human creative\n+review before production use.\ndiff --git a/projects/football-trivia-e2e/specification/04-audio-direction.md b/projects/football-trivia-e2e/specification/04-audio-direction.md\nnew file mode 100644\nindex 0000000000000000000000000000000000000000..80b9199a22884f3ba1a05ef471920526a4e70852\n--- /dev/null\n+++ b/projects/football-trivia-e2e/specification/04-audio-direction.md\n@@ -0,0 +1,14 @@\n+# 04 \u2014 Audio direction\n+\n+Audio is original, optional, captioned/described where it conveys state, and\n+always paired with a visual/text equivalent. No chant, anthem, broadcast,\n+club, or game imitation is permitted.\n+\n+| ID | Cue group | Intent |\n+| --- | --- | --- |\n+| AUDIO-001 | Entry and round bed | Restrained, low-distraction electronic percussion with abstract crowd-energy texture; optional and volume-controlled. |\n+| AUDIO-002 | Answer and streak feedback | Brief distinct correct, incorrect, and streak cues using claps and soft brass-like synth accents without sampled sports expression. |\n+| AUDIO-003 | Results and completion | Warm, short celebratory sting that supports rather than replaces the readable results state. |\n+\n+Final durations, quantities, loudness targets, loop policy, and generated-cue\n+selection need production approval; no audio is generated by this plan.\n\nhook: PostToolUse\nhook: PostToolUse Failed\ndiff --git a/projects/football-trivia-e2e/planning/game-design-manifest.json b/projects/football-trivia-e2e/planning/game-design-manifest.json\nnew file mode 100644\nindex 0000000000000000000000000000000000000000..61043c7c2f2a078b1785ee51e6c06575aec060b8\n--- /dev/null\n+++ b/projects/football-trivia-e2e/planning/game-design-manifest.json\n@@ -0,0 +1,11 @@\n+{\n+  \"status\": \"accepted\",\n+  \"final_audit\": {\"task_id\": \"G-FT-001\", \"status\": \"accepted\", \"scope\": \"football trivia selected modules only\"},\n+  \"pending_modules\": [],\n+  \"blocked_modules\": [],\n+  \"modules\": [\n+    {\"module\": \"quiz-content\", \"status\": \"accepted\", \"design_output_paths\": [\"specification/02-game-design-bible.md#quiz-content\"], \"game_design_ids\": [\"GAME-001\"]},\n+    {\"module\": \"round-rules\", \"status\": \"accepted\", \"design_output_paths\": [\"specification/02-game-design-bible.md#round-rules\"], \"game_design_ids\": [\"GAME-002\"]},\n+    {\"module\": \"player-experience\", \"status\": \"accepted\", \"design_output_paths