[stderr]                     errors.append(f"{kind} {item_id} allocated {contract.get('id')} but its R file is missing")
[stderr]                     continue
[stderr]                 meta = front_matter(r_path)
[stderr]                 field = (
[stderr]                     "game_design_ids" if kind == "game" else
[stderr]                     "asset_ids" if kind == "assets" else
[stderr]                     "audio_ids" if kind == "audio" else "narrative_ids"
[stderr]                 )
[stderr]                 impact = "asset_impact" if kind == "assets" else "audio_impact" if kind == "audio" else None
[stderr]                 if impact and meta.get(impact) != "required":
[stderr]                     errors.append(f"{contract.get('id')} must mark {impact}: required for {item_id}")
[stderr]                 if item_id not in values(meta.get(field)):
[stderr]                     errors.append(f"{contract.get('id')} does not reserve {item_id} in {field}")
[stderr]     print(f"Creative coverage gate — {workspace.name}")
[stderr]     for kind, entries in expected.items():
[stderr]         print(f"{kind}: {len(entries)} declared")
[stderr]     if errors:
[stderr]         for error in errors:
[stderr]             print("ERROR:", error)
[stderr]         return 1
[stderr]     print("PASS: every declared creative item has an owned implementation route.")
[stderr]     return 0
