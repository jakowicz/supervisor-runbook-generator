[stderr] def _run_task_range(
[stderr]     runbooks: list[Path], dry_run: bool, continue_on_nonpass: bool, database_path: Path, initial_context: str = "", repo_root: Path | None = None
[stderr] ) -> bool:
[stderr]     """Run independent CLI invocations sequentially in one shared worktree."""
[stderr] 
[stderr]     print(
[stderr]         "BATCH START " + ", ".join(path.stem for path in runbooks) + " · sequential shared-worktree mode",
[stderr]         file=sys.stderr,
[stderr]         flush=True,
[stderr]     )
[stderr]     for index, runbook in enumerate(runbooks, start=1):
[stderr]         task_id = runbook.stem
[stderr]         print(f"BATCH {index:02d}/{len(runbooks):02d} START {task_id} · {runbook}", file=sys.stderr, flush=True)
[stderr]         command = [sys.executable, "-m", "supervisor.cli", "--runbook", str(runbook)]
[stderr]         if dry_run:
[stderr]             command.append("--dry-run")
[stderr]         environment = os.environ.copy()
[stderr]         # Batch tasks are launched with ``python -m supervisor.cli``.  Unlike
[stderr]         # the installed console script, that module invocation does not know
[stderr]         # where Supervisor is installed when the working directory is an
[stderr]         # application/factory repository.  Preserve the package root so a
[stderr]         # application/factory repository.  Preserve the package root so a
[stderr]         # plain `supervisor-run --project name` needs no caller-managed
[stderr]         # PYTHONPATH export.
[stderr]         package_root = str(Path(__file__).resolve().parents[1])
[stderr]         inherited_path = environment.get("PYTHONPATH", "")
[stderr]         environment["PYTHONPATH"] = package_root if not inherited_path else package_root + os.pathsep + inherited_path
[stderr]         environment["SUPERVISOR_REPO_ROOT"] = str((repo_root or Path.cwd()).resolve())
[stderr]         environment["SUPERVISOR_DATABASE_PATH"] = str(database_path)
[stderr]         if initial_context:
[stderr]             environment["SUPERVISOR_INITIAL_CONTEXT"] = initial_context
[stderr]         completed = subprocess.run(command, check=False, env=environment)
[stderr]         if completed.returncode:
[stderr]             raise SystemExit(f"BATCH HALTED {task_id} · supervisor process exited {completed.returncode}")
[stderr]         store = RunStore(database_path)
[stderr]         try:
[stderr]             state = store.state_for(task_id)
[stderr]         finally:
[stderr]             store.close()
[stderr]         status = state.get("status") if state else "missing_state"
[stderr]         if status == "accepted":
[stderr]             print(f"BATCH {index:02d}/{len(runbooks):02d} DONE {task_id} · accepted", file=sys.stderr, flush=True)
[stderr]             continue
[stderr]         message = f"BATCH {index:02d}/{len(runbooks):02d} STOP {task_id} · state={status}"
[stderr]         if not continue_on_nonpass:
[stderr]             print(message + " · later tasks were not started", file=sys.stderr, flush=True)
[stderr]             return False
[stderr]         print(message + " · continuing by explicit override", file=sys.stderr, flush=True)
[stderr]     print("BATCH FINAL · all requested tasks were started", file=sys.stderr, flush=True)
[stderr]     return True
