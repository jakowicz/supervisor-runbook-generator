[stderr] -| S02 | 2 / `A,B,C,D` | `{A,C}`, `{D}` | `A,B` | true |
[stderr] -| S03 | 3 / `A,B,C,D,E` | `{A}`, `{B}` | `C,D,E` | false |
[stderr] -| S04 | 3 / `A,B,C,D` | `{A}`, `{B}` | `A,B,C` | true |
[stderr] -| S05 | 2 / `A,B,C` | `{A}`, `{A}` | `B,C` | false |
[stderr] -| S06 | 2 / `A,B` | `{A,B}`, `{}` | `A,B` | true |
[stderr] -| S07 | 2 / `A,B,C` | abandoned `{A}`; completed `{B}`, `{}` | `A,C` | false |
[stderr] -| S08 | 2 / `A,B,C,D` (tokens: `A=01,B=01,C=02,D=03`) | `{C}`, `{D}` | `A,B` | false; ID tie-break orders `A` before `B` |
[stderr] +Candidate lists are frozen, filtered, and published; R1/R2 are newest completed
[stderr] +rounds. Implementation fixtures calculate the specified SHA-256 ordering and
[stderr] +assert selected IDs, shortage fields, and disclosure key.
