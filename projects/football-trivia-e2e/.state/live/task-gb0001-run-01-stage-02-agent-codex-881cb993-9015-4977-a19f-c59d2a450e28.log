[stderr] projects/football-trivia-e2e/planning/game-production-inventory.md-24-The machine-readable [inventory](game-production-inventory.json) is
[stderr] #!/usr/bin/env python3
[stderr] """Deterministically validate creative coverage in a generated project.
[stderr] 
[stderr] This is a planning-quality gate, not product/release evidence.  It prevents a
[stderr] factory from calling a game complete while the creative direction exists only
[stderr] as prose or is represented by a generic schema task.
[stderr] """
[stderr] 
[stderr] from __future__ import annotations
[stderr] 
[stderr] import argparse
[stderr] import json
[stderr] import re
[stderr] import sys
[stderr] from pathlib import Path
[stderr] 
[stderr] 
[stderr] ID_PATTERNS = {
[stderr]     "game": re.compile(r"\bGAME-[A-Z0-9-]+\b"),
[stderr]     "assets": re.compile(r"\bASSET-[A-Z0-9-]+\b"),
[stderr]     "audio": re.compile(r"\bAUDIO-[A-Z0-9-]+\b"),
[stderr]     "narrative": re.compile(r"\bNAR-[A-Z0-9-]+\b"),
[stderr] }
[stderr] 
[stderr] 
[stderr] def front_matter(path: Path) -> dict[str, str]:
[stderr]     document = path.read_text(encoding="utf-8")
[stderr]     match = re.match(r"^---\n(.*?)\n---\n", document, re.DOTALL)
[stderr]     if not match:
[stderr]         return {}
[stderr]     result: dict[str, str] = {}
[stderr]     for line in match.group(1).splitlines():
[stderr]         key, separator, value = line.partition(":")
[stderr]         if separator:
[stderr]             result[key.strip()] = value.strip()
[stderr]     return result
[stderr] 
[stderr] 
[stderr] def identifiers(path: Path, kind: str) -> set[str]:
[stderr]     return set(ID_PATTERNS[kind].findall(path.read_text(encoding="utf-8"))) if path.is_file() else set()
[stderr] 
[stderr] 
[stderr] def values(value: object) -> list[str]:
[stderr]     if isinstance(value, list):
[stderr]         return [item for item in value if isinstance(item, str)]
[stderr]     if isinstance(value, str):
[stderr]         return [item.strip() for item in value.split(",") if item.strip()]
[stderr]     return []
[stderr] 
[stderr] 
[stderr] def object_items(value: object) -> list[dict[str, object]]:
[stderr]     """Return only JSON-object entries from a list-like field."""
[stderr]     return [item for item in value if isinstance(item, dict)] if isinstance(value, list) else []
[stderr] 
[stderr] 
[stderr] def is_game_workspace(workspace: Path) -> bool:
[stderr]     initial = workspace / "INITIAL.md"
[stderr]     return initial.is_file() and "Game" in initial.read_text(encoding="utf-8")
[stderr] 
[stderr] 
[stderr] def game_design_manifest_errors(workspace: Path, selected_modules: set[str], design_units: list[dict[str, object]]) -> list[str]:
[stderr]     """Validate the deterministic handoff from generated G design work."""
[stderr]     path = workspace / "planning" / "game-design-manifest.json"
[stderr]     if not path.is_file():
[stderr]         return ["game is missing planning/game-design-manifest.json"]
[stderr]     try:
