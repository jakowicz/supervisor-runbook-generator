projects/football-trivia-e2e/specification/02-game-design-bible.json:15:    {"id":"GAME-002","module":"quiz-content-and-editorial-integrity","title":"Kickoff Mix catalogue batch","player_outcome":"Play varied football knowledge questions.","source_evidence":["INITIAL: themed rounds","PROJECT_BRIEF: curated reviewed versioned bank"],"first_release_boundary":"48 cards in four 12-card reviewed batches with stated category/difficulty quotas.","dependencies":["GAME-001"],"production_mode":"finite_named_content"},
projects/football-trivia-e2e/specification/02-game-design-bible.json:16:    {"id":"GAME-003","module":"quiz-content-and-editorial-integrity","title":"Answer adjudication and provenance","player_outcome":"Understand a fair accepted or rejected answer.","source_evidence":["INITIAL: answer validation","F001: provenance and fact review"],"first_release_boundary":"Deterministic ID/normalised-alias comparison only; no fuzzy matching or unreviewed source.","dependencies":["GAME-001"],"production_mode":"systemic_rules"},
projects/football-trivia-e2e/specification/02-game-design-bible.json:17:    {"id":"GAME-004","module":"quiz-content-and-editorial-integrity","title":"Freshness and editorial workflow","player_outcome":"Avoid unnecessary repeat questions.","source_evidence":["INITIAL: curated bank and local progress","F001: anti-repetition"],"first_release_boundary":"Exclude last two completed-round cards where alternatives exist; versioned propose-to-publish workflow.","dependencies":["GAME-001","GAME-002"],"production_mode":"scalable_catalogue"},
