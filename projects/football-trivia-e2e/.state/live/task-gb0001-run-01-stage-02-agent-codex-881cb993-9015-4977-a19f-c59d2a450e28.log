projects/football-trivia-e2e/specification/02-game-design-bible.json:19:    {"id":"GAME-006","module":"round-score-and-progress-rules","title":"Mixed Fixture standard round","player_outcome":"Complete a mobile-friendly themed round.","source_evidence":["INITIAL: quick sessions and themed rounds"],"first_release_boundary":"One 10-card template with deterministic eligible selection and optional-off timer.","dependencies":["GAME-002","GAME-003","GAME-004"],"production_mode":"systemic_rules"},
projects/football-trivia-e2e/specification/02-game-design-bible.json:20:    {"id":"GAME-007","module":"round-score-and-progress-rules","title":"Score and streak rules","player_outcome":"See understandable momentum and results.","source_evidence":["INITIAL: scoring streaks and feedback"],"first_release_boundary":"100 base points; capped 3+ streak bonus; wrong/blank/timeout/abandon resets streak.","dependencies":["GAME-003","GAME-006"],"production_mode":"systemic_rules"},
projects/football-trivia-e2e/specification/02-game-design-bible.json-21-    {"id":"GAME-008","module":"round-score-and-progress-rules","title":"Result and local milestone","player_outcome":"Know what was achieved and what to do next.","source_evidence":["INITIAL: local progress and save/load"],"first_release_boundary":"Results and first_whistle_complete only; no RPG levels, ranks, or social leaderboard.","dependencies":["GAME-006","GAME-007","GAME-010"],"production_mode":"systemic_rules"},
