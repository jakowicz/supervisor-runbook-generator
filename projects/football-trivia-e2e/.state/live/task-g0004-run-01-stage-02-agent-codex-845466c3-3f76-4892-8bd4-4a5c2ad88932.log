odule\":\"characters-factions-quests-dialogue\",\"reason\":\"No fictional cast, quest, or dialogue activity is in scope.\"},\n    {\"module\":\"combat-classes-abilities-bosses\",\"reason\":\"The product has no battle, party, action, or power-progression loop.\"},\n    {\"module\":\"units-buildings-resources-economy\",\"reason\":\"There is no builder, collection, or economy loop.\"},\n    {\"module\":\"levels-maps-match-simulation-racing\",\"reason\":\"Football is trivia subject matter, not simulated sport or traversal.\"},\n    {\"module\":\"multiplayer-social-safety\",\"reason\":\"Single-player is selected; connected mode and safety policy require approval.\"},\n    {\"module\":\"live-content-and-commerce\",\"reason\":\"Events and monetisation are deferred; operations, entitlements, and policy are unresolved.\"}\n  ],\n  \"design_units\": [\n    {\"id\":\"GAME-001\",\"module\":\"quiz-content-and-editorial-integrity\",\"title\":\"Question-card grammar\",\"player_outcome\":\"Receive an unambiguous, accessible question.\",\"source_evidence\":[\"INITIAL: multiple question formats and answer validation\",\"F001: curated editorial question bank\"],\"first_release_boundary\":\"Published original cards require prompt, answer rule, explanation, provenance, and two-editor approval.\",\"dependencies\":[],\"production_mode\":\"bounded_content_set\"},\n    {\"id\":\"GAME-002\",\"module\":\"quiz-content-and-editorial-integrity\",\"title\":\"Kickoff Mix catalogue batch\",\"player_outcome\":\"Play varied football knowledge questions.\",\"source_evidence\":[\"INITIAL: themed rounds\",\"PROJECT_BRIEF: curated reviewed versioned bank\"],\"first_release_boundary\":\"48 cards in four 12-card reviewed batches with stated category/difficulty quotas.\",\"dependencies\":[\"GAME-001\"],\"production_mode\":\"finite_named_content\"},\n    {\"id\":\"GAME-003\",\"module\":\"quiz-content-and-editorial-integrity\",\"title\":\"Answer adjudication and provenance\",\"player_outcome\":\"Understand a fair accepted or rejected answer.\",\"source_evidence\":[\"INITIAL: answer validation\",\"F001: provenance and fact review\"],\"first_release_boundary\":\"Deterministic ID/normalised-alias comparison only; no fuzzy matching or unreviewed source.\",\"dependencies\":[\"GAME-001\"],\"production_mode\":\"systemic_rules\"},\n    {\"id\":\"GAME-004\",\"module\":\"quiz-content-and-editorial-integrity\",\"title\":\"Freshness and editorial workflow\",\"player_outcome\":\"Avoid unnecessary repeat questions.\",\"source_evidence\":[\"INITIAL: curated bank and local progress\",\"F001: anti-repetition\"],\"first_release_boundary\":\"Exclude last two completed-round cards where alternatives exist; versioned propose-to-publish workflow.\",\"dependencies\":[\"GAME-001\",\"GAME-002\"],\"production_mode\":\"scalable_catalogue\"},\n    {\"id\":\"GAME-005\",\"module\":\"round-score-and-progress-rules\",\"title\":\"First Whistle tutorial round\",\"player_outcome\":\"Finish a first round and understand saving.\",\"source_evidence\":[\"INITIAL: onboarding/tutorial and save/resume\",\"PROJECT_BRIEF: first useful session\"],\"first_release_boundary\":\"Five fixed named tutorial cards, non-timed, completable offline without sign-in.\",\"dependencies\":[\"GAME-001\",\"GAME-009\",\"GAME-010\"],\"production_mode\":\"finite_named_content\"},\n    {\"id\":\"GAME-006\",\"module\":\"round-score-and-progress-rules\",\"title\":\"Mixed Fixture standard round\",\"player_outcome\":\"Complete a mobile-friendly themed round.\",\"source_evidence\":[\"INITIAL: quick sessions and themed rounds\"],\"first_release_boundary\":\"One 10-card template with deterministic eligible selection and optional-off timer.\",\"dependencies\":[\"GAME-002\",\"GAME-003\",\"GAME-004\"],\"production_mode\":\"systemic_rules\"},\n    {\"id\":\"GAME-007\",\"module\":\"round-score-and-progress-rules\",\"title\":\"Score and streak rules\",\"player_outcome\":\"See understandable momentum and results.\",\"source_evidence\":[\"INITIAL: scoring streaks and feedback\"],\"first_release_boundary\":\"100 base points; capped 3+ streak bonus; wrong/blank/timeout/abandon resets streak.\",\"dependencies\":[\"GAME-003\",\"GAME-006\"],\"production_mode\":\"systemic_rules\"},\n    {\"id\":\"GAME-008\",\"module\":\"round-score-and-progress-rules\",\"title\":\"Result and local milestone\",\"player_outcome\":\"Know what was achieved and what to do next.\",\"source_evidence\":[\"INITIAL: local progress and save/load\"],\"first_release_boundary\":\"Results and first_whistle_complete only; no RPG levels, ranks, or social leaderboard.\",\"dependencies\":[\"GAME-006\",\"GAME-007\",\"GAME-010\"],\"production_mode\":\"systemic_rules\"},\n    {\"id\":\"GAME-009\",\"module\":\"accessible-recoverable-multitarget-experience\",\"title\":\"Guided accessible start\",\"player_outcome\":\"Start and control the game with a chosen input method.\",\"source_evidence\":[\"INITIAL: accessible controls/text/captions/visual settings\",\"INITIAL: web keyboard/mouse/touch/gamepad\"],\"first_release_boundary\":\"Local profile, tutorial entry, settings, and equivalent touch/pointer/keyboard/gamepad actions; no mandatory account.\",\"dependencies\":[],\"production_mode\":\"systemic_rules\"},\n    {\"id\":\"GAME-010\",\"module\":\"accessible-recoverable-multitarget-experience\",\"title\":\"Confirmed snapshot recovery\",\"player_outcome\":\"Return without silent loss after interruption or failure.\",\"source_evidence\":[\"INITIAL: save resume data-loss recovery\",\"INITIAL: crash/error recovery\"],\"first_release_boundary\":\"Confirmed local snapshots, write-failure UI, corrupt-draft choice, and confirmed local deletion; no remote sync.\",\"dependencies\":[\"GAME-008\"],\"production_mode\":\"systemic_rules\"},\n    {\"id\":\"GAME-011\",\"module\":\"accessible-recoverable-multitarget-experience\",\"title\":\"Offline update and error path\",\"player_outcome\":\"Play cached content and recover safely from update/error states.\",\"source_evidence\":[\"INITIAL: PWA offline/cache refresh\",\"INITIAL: crash reporting and recovery\"],\"first_release_boundary\":\"Cached batch is playable offline; updates apply between rounds; minimised optional diagnostics only.\",\"dependencies\":[\"GAME-002\",\"GAME-010\"],\"production_mode\":\"systemic_rules\"},\n    {\"id\":\"GAME-012\",\"module\":\"accessible-recoverable-multitarget-experience\",\"title\":\"Shared-core platform adaptation\",\"player_outcome\":\"Receive the same fair quiz on each selected target.\",\"source_evidence\":[\"INITIAL: responsive web, PWA, Android, iOS\",\"INITIAL: shared core with adaptations\"],\"first_release_boundary\":\"Rule/content/save parity; web inputs/responsive layout, PWA install/cache UX, phone touch adaptation only.\",\"dependencies\":[\"GAME-009\",\"GAME-010\",\"GAME-011\"],\"production_mode\":\"systemic_rules\"}\n  ],\n  \"implementation_map\": [\n    {\"id\":\"GAME-001\",\"first_release_journeys\":[\"J1\",\"J2\",\"J4\"],\"implementation_domains\":[\"B-content-adjudication\" ]},\n    {\"id\":\"GAME-002\",\"first_release_journeys\":[\"J1\",\"J2\",\"J4\",\"J5\"],\"implementation_domains\":[\"B-content-adjudication\",\"F-delivery-operations\"]},\n    {\"id\":\"GAME-003\",\"first_release_journeys\":[\"J1\",\"J2\"],\"implementation_domains\":[\"B-content-adjudication\",\"C-round-score-feedback\"]},\n    {\"id\":\"GAME-004\",\"first_release_journeys\":[\"J2\",\"J4\"],\"implementation_domains\":[\"A-shell-progress\",\"B-content-adjudication\"]},\n    {\"id\":\"GAME-005\",\"first_release_journeys\":[\"J1\",\"J3\"],\"implementation_domains\":[\"A-shell-progress\",\"C-round-score-feedback\",\"D-persistence-recovery\"]},\n    {\"id\":\"GAME-006\",\"first_release_journeys\":[\"J2\",\"J3\"],\"implementation_domains\":[\"A-shell-progress\",\"C-round-score-feedback\"]},\n    {\"id\":\"GAME-007\",\"first_release_journeys\":[\"J1\",\"J2\"],\"implementation_domains\":[\"C-round-score-feedback\"]},\n    {\"id\":\"GAME-008\",\"first_release_journeys\":[