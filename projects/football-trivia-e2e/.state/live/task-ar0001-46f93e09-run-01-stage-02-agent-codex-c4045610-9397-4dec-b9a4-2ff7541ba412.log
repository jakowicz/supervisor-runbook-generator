[stderr] def _unmet_dependencies(runbooks: list[Path], states: dict[str, dict | None]) -> dict[str, list[str]]:
[stderr]     """Return R tasks whose declared implementation dependencies are unaccepted."""
[stderr] 
[stderr]     available = {path.stem for path in runbooks}
[stderr]     unmet: dict[str, list[str]] = {}
[stderr]     for runbook in runbooks:
[stderr]         task = load_task(runbook)
[stderr]         missing = [dependency for dependency in task.dependencies if dependency not in available or (states.get(dependency) or {}).get("status") != "accepted"]
[stderr]         if missing:
[stderr]             unmet[runbook.stem] = missing
[stderr]     return unmet
