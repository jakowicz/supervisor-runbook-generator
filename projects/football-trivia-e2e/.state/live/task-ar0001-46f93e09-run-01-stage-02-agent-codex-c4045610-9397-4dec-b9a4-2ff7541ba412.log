[stderr] def _run_collection_until_complete(
[stderr]     directory: Path, dry_run: bool, continue_on_nonpass: bool, database_path: Path, initial_context: str, repo_root: Path | None = None
[stderr] ) -> bool:
[stderr]     """Run a collection until no unaccepted task remains.
[stderr] 
[stderr]     A task may create more runbooks. Re-enumerating only after an accepted pass
[stderr]     lets a single invocation consume a bounded, dynamically growing collection
[stderr]     without precomputing an unbounded task list.
[stderr]     """
[stderr] 
[stderr]     wave = 0
[stderr]     while True:
[stderr]         runbooks = _collection_runbooks(directory)
[stderr]         if not runbooks:
[stderr]             raise ValueError(f"No runnable Markdown runbooks found in {directory}.")
[stderr]         store = RunStore(database_path)
[stderr]         try:
[stderr]             states = {path.stem: store.state_for(path.stem) for path in runbooks}
[stderr]         finally:
[stderr]             store.close()
[stderr]         reopened = _reopen_invalid_authoring_tasks(runbooks, states, database_path)
[stderr]         if reopened:
[stderr]             print(
[stderr]                 "COLLECTION REOPENED · " + ", ".join(reopened) +
[stderr]                 " has invalid generated R-series contracts and will be repaired before continuing.",
[stderr]                 file=sys.stderr,
[stderr]                 flush=True,
[stderr]             )
[stderr]             continue
[stderr]         blocked = [path for path in runbooks if (states[path.stem] or {}).get("status") == "needs_user_review"]
[stderr]         if blocked:
[stderr]             print(
[stderr]                 "COLLECTION BLOCKED · " + ", ".join(path.stem for path in blocked) +
[stderr]                 " requires user review; use an explicit --retry after repairing the environment.",
[stderr]                 file=sys.stderr,
[stderr]                 flush=True,
[stderr]             )
[stderr]             return False
[stderr]         pending = [path for path in runbooks if (states[path.stem] or {}).get("status") != "accepted"]
[stderr]         if pending and not _run_ready_prerequisite_collections(
[stderr]             runbooks, states, database_path, dry_run, continue_on_nonpass, repo_root
[stderr]         ):
[stderr]             return False
[stderr]         unmet = _unmet_dependencies(runbooks, states)
[stderr]         runnable = [path for path in pending if path.stem not in unmet]
[stderr]         if pending and not runnable:
[stderr]             details = ", ".join(f"{task_id} waits for {','.join(dependencies)}" for task_id, dependencies in unmet.items())
[stderr]             print(f"COLLECTION WAITING · {details}", file=sys.stderr, flush=True)
[stderr]             return False
[stderr]         if not pending:
[stderr]             print(f"COLLECTION FINAL · {directory} has no pending tasks", file=sys.stderr, flush=True)
[stderr]             return True
[stderr]         wave += 1
[stderr]         print(f"COLLECTION WAVE {wave:02d} · {len(pending)} pending tasks in {directory}", file=sys.stderr, flush=True)
[stderr]         if not _run_task_range(runnable, dry_run, continue_on_nonpass, database_path, initial_context, repo_root):
[stderr]             return False
[stderr] 
[stderr] 
[stderr] def _run_registered_collections(
[stderr]     directory: Path, dry_run: bool, continue_on_nonpass: bool, project_workspace: Path | None = None, repo_root: Path | None = None
[stderr] ) -> None:
[stderr]     """Follow explicit child-collection registrations after a parent completes."""
[stderr] 
[stderr]     registrations = directory / ".supervisor-children"
[stderr]     if not registrations.is_dir():
[stderr]         return
[stderr]     for registration in sorted(registrations.glob("*.json")):
[stderr]         try:
[stderr]             payload = json.loads(registration.read_text(encoding="utf-8"))
[stderr]             child_value = payload["runbooks_dir"]
[stderr]         except (json.JSONDecodeError, KeyError, TypeError) as error:
[stderr]             raise ValueError(f"Invalid child collection registration {registration}: {error}") from error
[stderr]         if not isinstance(child_value, str) or not child_value.strip():
[stderr]             raise ValueError(f"Invalid child collection registration {registration}: runbooks_dir must be a path string.")
[stderr]         child_directory = (directory / child_value).resolve()
[stderr]         if not child_directory.is_dir():
[stderr]             raise ValueError(f"Registered child collection does not exist: {child_directory} ({registration})")
[stderr]         if project_workspace and not child_directory.is_relative_to(project_workspace):
[stderr]             continue
[stderr]         if project_workspace:
[stderr]             child_database = project_workspace / ".state" / f"{child_directory.name}.sqlite3"
[stderr]         else:
[stderr]             child_database = child_directory.parent / ".state" / "supervisor.sqlite3"
[stderr]         child_context = _initial_document(child_directory)
[stderr]         if _run_collection_until_complete(child_directory, dry_run, continue_on_nonpass, child_database, child_context, repo_root):
[stderr]             _run_registered_collections(child_directory, dry_run, continue_on_nonpass, project_workspace, repo_root)
