[stderr]     match = re.search(rf"^## {re.escape(heading)}\s*$\n(.*?)(?=^## |\Z)", document, re.MULTILINE | re.DOTALL)
[stderr]     if not match:
[stderr]         raise ValueError(f"Runbook is missing a ## {heading} section.")
[stderr]     return match.group(1).strip()
