entory commands\"]},\"forbidden_scope\":[\"crafting\",\"trading\",\"purchases\",\"destructive discard\"],\"verification\":\"Ineligible use and duplicate rewards are no-ops.\",\"human_external_gate\":\"GATE-0004 before authored item/progression shapes.\",\"complexity\":\"medium\",\"status\":\"ready_for_authoring\"},\nprojects/mock-fantasy-quest-4/planning/implementation-catalogue-index.json:24:    {\"id\":\"IMP-0017\",\"title\":\"Specify campaign progression and safe ending integration\",\"domain\":\"campaign\",\"targets\":[\"shared\"],\"requirement_ids\":[\"REQ-0001\",\"REQ-0002\",\"REQ-0003\",\"REQ-0004\",\"REQ-0005\"],\"bounded_outcome\":\"One town-to-dungeon-to-ending progression integration specifies safe checkpoints and a completable original campaign route.\",\"prerequisites\":[\"IMP-0013\",\"IMP-0014\",\"IMP-0015\",\"IMP-0016\"],\"ownership\":{\"files\":[\"src/core/campaign/progression*\",\"tests/core/campaign/progression*\"],\"data\":[\"campaign route graph\"],\"api\":[\"campaign completion command\"]},\"forbidden_scope\":[\"UI\",\"additional regions\",\"remote content\"],\"verification\":\"Reachability proves one route and ending is idempotent.\",\"human_external_gate\":\"GATE-0004 before authored campaign implementation.\",\"complexity\":\"high\",\"status\":\"ready_for_authoring\"},\nprojects/mock-fantasy-quest-4/planning/implementation-catalogue-index.json:25:    {\"id\":\"IMP-0018\",\"title\":\"Define original campaign content-package and provenance assembly\",\"domain\":\"content\",\"targets\":[\"shared\"],\"requirement_ids\":[\"REQ-0001\",\"REQ-0002\",\"REQ-0008\",\"NFR-0007\",\"NFR-0008\"],\"bounded_outcome\":\"A versioned package assembles the one-town/one-dungeon campaign using original assets and auditable provenance, without creating those assets in authoring.\",\"prerequisites\":[\"IMP-0005\",\"IMP-0011\",\"IMP-0013\",\"IMP-0014\",\"IMP-0015\",\"IMP-0016\"],\"ownership\":{\"files\":[\"content/campaign/\",\"assets/source-manifest.*\",\"tests/conte