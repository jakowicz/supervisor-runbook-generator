rivacy-and-security\"],\"catalogue_records\":[\"IMP-0012\"]},\"checkpoint\":\"cross-check all foundation ownership, dependencies, and gates before accepting the wave\",\"recovery\":\"retain R0012 and correct only its documentation contract\",\"acceptance_checks\":[\"documentation concludes the foundation slice without claiming implementation or approval\",\"gated save work remains visible\"]}\n33:    {\"id\":\"R0002\",\"catalogue_id\":\"IMP-0002\",\"title\":\"Enforce shared-core and adapter dependency seams\",\"dependencies\":[\"R0001\"],\"output_path\":\"projects/mock-fantasy-quest-4/runbooks/R0002.md\",\"source_specifications\":[\"specification/03-technical-contract.md#architecture-and-requirement-traceability\",\"specification/03-technical-contract.md#dependency-direction-and-state-rules\"],\"source_catalogue_ids\":[\"IMP-0002\"],\"authoring_batch\":\"B0002\",\"factory_stages\":[\"F011\",\"F012\",\"F013\"],\"asset_impact\":\"not_applicable\",\"asset_ids\":[],\"asset_brief\":\"No assets; this is an interface and dependency-policy contract.\",\"acceptance_checks\":[\"forbidden core imports rejected\",\"adapter command-only fixture\"],\"checkpoint_cadence\":\"after metadata, after draft, before manifest acceptance\",\"recovery\":\"retain ID and repair only this contract\"},\n34:    {\"id\":\"R0003\",\"catalogue_id\":\"IMP-0003\",\"title\":\"Create deterministic test and fixture harness\",\"dependencies\":[\"R0001\",\"R0002\"],\"output_path\":\"projects/mock-fantasy-quest-4/runbooks/R0003.md\",\"source_specifications\":[\"specification/03-technical-contract.md#observability-quality-evidence-and-release-verification\"],\"source_catalogue_ids\":[\"IMP-0003\"],\"authoring_batch\":\"B0002\",\"factory_stages\":[\"F011\",\"F012\",\"F013\"],\"asset_impact\":\"not_applicable\",\"asset_ids\":[],\"asset_brief\":\"No assets; fixtures use non-product deterministic data.\",\"acceptance_checks\":[\"repeatable fixture result\",\"isolated fixture storage\"],\"checkpoint_cadence\":\"