[stderr] +---
[stderr] +task_id: R0004
[stderr] +sequence: 4
[stderr] +title: Define deterministic campaign state and command contract
[stderr] +dependencies:
[stderr] +  - R0002
[stderr] +  - R0003
[stderr] +requirement_ids:
[stderr] +  - REQ-0001
[stderr] +  - REQ-0003
[stderr] +  - REQ-0004
[stderr] +  - REQ-0006
[stderr] +  - NFR-0002
[stderr] +  - NFR-0010
