ract.md#persistence-migration-and-failure-semantics\",\"specification/02-feature-model.md#save-recovery-and-offline-persistence\",\"specification/04-experience-contract.md#empty-error-recovery-destructive-and-privacy-sensitive-states\"],\"catalogue_records\":[\"IMP-0005\",\"IMP-0006\"]},\"checkpoint\":\"validate content/save boundaries and retained storage gate\",\"recovery\":\"retain R0005,R0006 and rerun the blocked item after its decision\",\"acceptance_checks\":[\"content and save/cache ownership is separated\",\"save recovery remains a bounded foundation slice\"]},\nprojects/mock-fantasy-quest-4/planning/runbook-authoring-manifest.json-28-    {\"id\":\"B0005\",\"order\":5,\"title\":\"Migration, diagnostics, and provenance controls\",\"state\":\"planned\",\"depends_on_batches\":[\"B0004\"],\"parallel_with\":[\"B0006 after B0004 acceptance, except R0007 still waits for R0006\"],\"preceding_decision\":\"R0007 needs GATE-0003; R0009 needs GATE-0005\",\"r_contract_ids\":[\"R0007\",\"R0009\",\"R0011\"],\"context_packet\":{\"specification\":[\"specification/03-technical-contract.md#persistence-migration-and-failure-semantics\",\"specification/03-technical-contract.md#trust-privacy-and-security\",\"specification/01-product-brief.md#originality-boundary\",\"specification/04-experience-contract.md#experience-premise-and-originality-boundary\"],\"catalogue_records\":[\"IMP-0007\",\"IMP-0009\",\"IMP-0011\"]},\"checkpoint\":\"validate migration, diagnostics, and provenance fields; record unresolved gates\",\"recovery\":\"rerun only incomplete assigned IDs; preserve any accepted R contract\",\"acceptance_checks\":[\"no transport or remote diagnostics is introduced\",\"provenance review is explicit\",\"contracts remain at most three\"]},\nprojects/mock-fantasy-quest-4/planning/runbook-authoring-manifest.json-29-    {\"id\":\"B0006\",\"order\":6,\"title\":\"Foundation documentation closure\",\"state\":\"planned\",\"depends_on_batches\":[\"B0004\",\"B0003\"],\"parallel_with\":[\"B0005 after B0004 acceptance\"],\"preceding_decision\":\"R0006 must be accepted or documented as blocked; no gate is implicitly resolved\",\"r_contract_ids\":[\"R0012\"],\"context_packet\":{\"specification\":[\"specification/03-technical-contract.md#architecture-and-requirement-traceability\",\"specification/03-technical-contract.md#persistence-migration-and-failure-semantics\",\"specification/03-technical-contract.md#trust-privacy-and-security\"],\"catalogue_records\":[\"IMP-0012\"]},\"checkpoint\":\"cross-check all foundation ownership, dependencies, and gates before accepting the wave\",\"recovery\":\"retain R0012 and correct only its documentation contract\",\"acceptance_checks\":[\"documentation concludes the foundation slice without claiming implementation or approval\",\"gated save work remains visible\"]}\nprojects/mock-fantasy-quest-4/planning/runbook-authoring-manifest.json-30-  ],\nprojects/mock-fantasy-quest-4/planning/runbook-authoring-manifest.json-31-  \"r_contracts\": [\nprojects/mock-fantasy-quest-4/planning/runbook-authoring-manifest.json-32-    {\"id\":\"R0001\",\"catalogue_id\":\"IMP-0001\",\"title\":\"Bootstrap reproducible shared project baseline\",\"dependencies\":[],\"output_path\":\"projects/mock-fantasy-quest-4/runbooks/R0001.md\",\"source_specifications\":[\"specification/01-product-brief.md#release-definition\",\"specification/03-technical-contract.md#architecture-and-requirement-traceability\"],\"source_catalogue_ids\":[\"IMP-0001\"],\"authoring_batch\":\"B0001\",\"factory_stages\":[\"F011\",\"F012\",\"F013\"],\"asset_impact\":\"not_applicable\",\"asset_ids\":[],\"asset_brief\":\"No product asset work; establish only project/tooling boundaries and prohibit incidental assets.\",\"acceptance_checks\":[\"documented deterministic baseline command\",\"isolated ownership directories\",\"GATE-0001 retained\"],\"checkpoint_cadence\":\"after metadata, after draft, before manifest acceptance\",\"recovery\":\"retain ID and path; repair only this contract\"},\nprojects/mock-fantasy-quest-4/planning/runbook-authoring-manifest.json-33-    {\"id\":\"R0002\",\"catalogue_id\":\"IMP-0002\",\"title\":\"Enforce shared-core and adapter dependency seams\",\"dependencies\":[\"R0001\"],\"output_path\":\"projects/mock-fantasy-quest-4/runbooks/R0002.md\",\"source_specifications\":[\"specification/03-technical-contract.md#architecture-and-requirement-traceability\",\"specification/03-technical-contract.md#dependency-direction-and-state-rules\"],\"source_catalogue_ids\":[\"IMP-0002\"],\"authoring_batch\":\"B0002\",\"factory_stages\":[\"F011\",\"F012\",\"F013\"],\"asset_impact\":\"not_applicable\",\"asset_ids\":[],\"asset_brief\":\"No assets; this is an interface and dependency-policy contract.\",\"acceptance_checks\":[\"forbidden core imports rejected\",\"adapter command-only fixture\"],\"checkpoint_cadence\":\"after metadata, after draft, before manifest acceptance\",\"recovery\":\"retain ID and repair only this contract\"},\nprojects/mock-fantasy-quest-4/planning/runbook-authoring-manifest.json-34-    {\"id\":\"R0003\",\"catalogue_id\":\"IMP-0003\",\"title\":\"Create deterministic test and fixture harness\",\"dependencies\":[\"R0001\",\"R0002\"],\"output_path\":\"projects/mock-fantasy-quest-4/runbooks/R0003.md\",\"source_specifications\":[\"specification/03-technical-contract.md#observability-quality-evidence-and-release-verification\"],\"source_catalogue_ids\":[\"IMP-0003\"],\"authoring_batch\":\"B0002\",\"factory_stages\":[\"F011\",\"F012\",\"F013\"],\"asset_impact\":\"not_applicable\",\"asset_ids\":[],\"asset_brief\":\"No assets; fixtures use non-product deterministic data.\",\"acceptance_checks\":[\"repeatable fixture result\",\"isolated fixture storage\"],\"checkpoint_cadence\":\"after metadata, after draft, before manifest acceptance\",\"recovery\":\"retain ID and repair only this contract\"},\nprojects/mock-fantasy-quest-4/planning/runbook-authoring-manifest.json:35:    {\"id\":\"R0004\",\"catalogue_id\":\"IMP-0004\",\"title\":\"Define deterministic campaign state and command contract\",\"dependencies\":[\"R0002\",\"R0003\"],\"output_path\":\"projects/mock-fantasy-quest-4/runbooks/R0004.md\",\"source_specifications\":[\"specification/03-technical-contract.md#data-contract\",\"specification/03-technical-contract.md#commands-validation-idempotency-and-concurrency\"],\"source_catalogue_ids\":[\"IMP-0004\"],\"authoring_batch\":\"B0003\",\"factory_stages\":[\"F011\",\"F012\",\"F013\"],\"asset_impact\":\"not_applicable\",\"asset_ids\":[],\"asset_brief\":\"No assets; state envelopes deliberately exclude authored content.\",\"acceptance_checks\":[\"stale and invalid commands do not mutate state\",\"duplicate interaction is idempotent\"],\"checkpoint_cadence\":\"after metadata, after draft, before manifest acceptance\",\"recovery\":\"retain ID and repair only this contract\"},\nprojects/mock-fantasy-quest-4/planning/runbook-authoring-manifest.json-36-    {\"id\":\"R0005\",\"catalogue_id\":\"IMP-0005\",\"title\":\"Define versioned content schema and validation boundary\",\"dependencies\":[\"R0001\",\"R0003\",\"R0004\"],\"output_path\":\"projects/mock-fantasy-quest-4/runbooks/R0005.md\",\"source_specifications\":[\"specification/03-technical-contract.md#versioned-content-and-save-schemas\",\"specification/02-feature-model.md#domain-vocabulary-and-state-ownership\"],\"source_catalogue_ids\":[\"IMP-0005\"],\"authoring_batch\":\"B0004\",\"factory_stages\":[\"F011\",\"F012\",\"F013\"],\"asset_impact\":\"not_applicable\",\"asset_ids\":[],\"asset_brief\":\"No art/audio assets; reserve only schema/provenance fields for later original assets.\",\"acceptance_checks\":[\"valid minimal package passes\",\"invalid references fail\",\"reachability fixture\"],\"checkpoint_cadence\":\"after metadata, after draft, before manifest acceptance\",\"recovery\":\"retain ID and repair only this contract\"},\nprojects/mock-fantasy-quest-4/planning/runbook-authoring-manifest.json-37-    {\"id\":\"R0006\",\"catal