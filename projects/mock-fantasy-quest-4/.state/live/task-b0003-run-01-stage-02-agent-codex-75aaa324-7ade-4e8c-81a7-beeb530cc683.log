import json
from pathlib import Path

root = Path('projects/mock-fantasy-quest-4')
manifest = json.loads((root / 'planning/runbook-authoring-manifest.json').read_text())
contracts = {c['id']: c for c in manifest['r_contracts']}
required_headings = {
    'R0004': {'Objective', 'Dependencies', 'Ownership', 'Required behaviour', 'Web and PWA differences', 'Non-goals', 'Asset assessment', 'Verification', 'Evidence', 'Acceptance criteria'},
    'R0008': {'Objective', 'Dependencies', 'Ownership', 'Required behaviour', 'Web and PWA differences', 'Non-goals', 'Asset assessment', 'Verification', 'Evidence', 'Acceptance criteria'},
}
def metadata(path):
    lines = path.read_text().splitlines()
    assert lines[0] == '---'
    end = lines.index('---', 1)
    values, active = {}, None
    for line in lines[1:end]:
        if line.startswith('  - ') and active:
            values.setdefault(active, []).append(line[4:])
        elif ': ' in line or line.endswith(':'):
            active, value = line.split(':', 1)
            values[active] = value.strip() or []
    return values
for rid, expected in contracts.items():
    if rid not in required_headings:
        continue
    path = Path(expected['output_path'])
    assert path.is_file(), f'{rid} missing'
    text = path.read_text()
    meta = metadata(path)
    assert meta['task_id'] == rid
    assert meta['dependencies'] == expected['dependencies']
    assert meta['requirement_ids'] == next(r['requirement_ids'] for r in json.loads((root / 'planning/implementation-catalogue-index.json').read_text())['contracts'] if r['id'] == expected['catalogue_id'])
    for key in ('source_specifications', 'source_catalogue_ids', 'authoring_batch', 'factory_stages', 'asset_impact', 'asset_ids'):
        assert meta[key] == expected[key], f'{rid} {key}'
    assert meta['audio_impact'] == 'not_applicable'
    assert meta['audio_ids'] == [] and meta['audio_brief'] == [] and meta['audio_duration_seconds'] == '0' and meta['audio_loop'] == 'not_applicable' and meta['audio_style_version'] == []
    headings = {line[3:] for line in text.splitlines() if line.startswith('## ')}
    assert required_headings[rid] <= headings, f'{rid}: {required_headings[rid] - headings}'
assert next(b for b in manifest['batches'] if b['id'] == 'B0003')['state'] == 'accepted'
print('B0003 targeted metadata, section, dependency, provenance, asset/audio, and checkpoint validation: PASS')
print(f'Whole-wave validator exit status: {validator_status} (expected prior-wave incompleteness is reported separately)')
