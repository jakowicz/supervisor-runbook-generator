[stderr] +  - specification/03-technical-contract.md#commands-validation-idempotency-and-concurrency
[stderr] +source_catalogue_ids:
[stderr] +  - IMP-0004
[stderr] +authoring_batch: B0003
[stderr] +factory_stages:
[stderr] +  - F011
[stderr] +  - F012
[stderr] +  - F013
[stderr] +asset_impact: not_applicable
