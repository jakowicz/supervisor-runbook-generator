identity, authorization, and connected-service exclusions\",\"dependencies\":[\"R0002\",\"R0004\"],\"output_path\":\"projects/mock-fantasy-quest-4/runbooks/R0008.md\",\"source_specifications\":[\"specification/03-technical-contract.md#trust-privacy-and-security\"],\"source_catalogue_ids\":[\"IMP-0008\"],\"authoring_batch\":\"B0003\",\"factory_stages\":[\"F011\",\"F012\",\"F013\"],\"asset_impact\":\"not_applicable\",\"asset_ids\":[],\"asset_brief\":\"No assets; a negative scope boundary.\",\"acceptance_checks\":[\"no identity/token/network fields\",\"future connected work remains gated\"],\"checkpoint_cadence\":\"after metadata, after draft, before manifest acceptance\",\"recovery\":\"retain ID and repair only this contract\"},\nprojects/mock-fantasy-quest-4/planning/runbook-authoring-manifest.json-40-    {\"id\":\"R0009\",\"catalogue_id\":\"IMP-0009\",\"title\":\"Define privacy-safe local diagnostics boundary\",\"dependencies\":[\"R0002\",\"R0003\",\"R0006\"],\"output_path\":\"projects/mock-fantasy-quest-4/runbooks/R0009.md\",\"source_specifications\":[\"specification/03-technical-contract.md#trust-privacy-and-security\",\"specification/04-experience-contract.md#empty-error-recovery-destructive-and-privacy-sensitive-states\"],\"source_catalogue_ids\":[\"IMP-0009\"],\"authoring_batch\":\"B0005\",\"factory_stages\":[\"F011\",\"F012\",\"F013\"],\"asset_impact\":\"not_applicable\",\"asset_ids\":[],\"asset_brief\":\"No assets; local redacted records only.\",\"acceptance_checks\":[\"consent and deletion controls\",\"payload redaction\",\"no network transport\",\"GATE-0005 retained\"],\"checkpoint_cadence\":\"after metadata, after draft, before manifest acceptance\",\"recovery\":\"retain ID and wait for privacy gate where required\"},\nprojects/mock-fantasy-quest-4/planning/runbook-authoring-manifest.json-41-    {\"id\":\"R0010\",\"catalogue_id\":\"IMP-0010\",\"title\":\"Establish semantic accessibility design tokens\",\"dependencies\":[\"R0001\",\"R0002\"],\"output_path\":\"projects/mock-fantasy-quest-4/runbooks/R0010.md\",\"source_specifications\":[\"specification/04-experience-contract.md#layout-visual-tokens-and-responsive-behaviour\",\"specification/04-experience-contract.md#accessibility-policy\"],\"source_catalogue_ids\":[\"IMP-0010\"],\"authoring_batch\":\"B0002\",\"factory_stages\":[\"F011\",\"F012\",\"F013\"],\"asset_impact\":\"not_applicable\",\"asset_ids\":[],\"asset_brief\":\"No final artwork, fonts, or icons; semantic tokens only and prohibit incidental assets.\",\"acceptance_checks\":[\"non-colour cues\",\"reduced motion values\",\"GATE-0002,GATE-0004 retained\"],\"checkpoint_cadence\":\"after metadata, after draft, before manifest acceptance\",\"recovery\":\"retain ID and await numeric design decisions\"},\nprojects/mock-fantasy-quest-4/planning/runbook-authoring-manifest.json-42-    {\"id\":\"R0011\",\"catalogue_id\":\"IMP-0011\",\"title\":\"Create original-content provenance control\",\"dependencies\":[\"R0005\"],\"output_path\":\"projects/mock-fantasy-quest-4/runbooks/R0011.md\",\"source_specifications\":[\"specification/01-product-brief.md#originality-boundary\",\"specification/04-experience-contract.md#experience-premise-and-originality-boundary\"],\"source_catalogue_ids\":[\"IMP-0011\"],\"authoring_batch\":\"B0005\",\"factory_stages\":[\"F011\",\"F012\",\"F013\"],\"asset_impact\":\"not_applicable\",\"asset_ids\":[],\"asset_brief\":\"No assets are created; this contract defines provenance controls for later asset-required work.\",\"acceptance_checks\":[\"missing provenance rejected\",\"human creative review recorded\"],\"checkpoint_cadence\":\"after metadata, after draft, before manifest acceptance\",\"recovery\":\"retain ID and repair only this contract\"},\nprojects/mock-fantasy-quest-4/planning/runbook-authoring-manifest.json-43-    {\"id\":\"R0012\",\"catalogue_id\":\"IMP-0012\",\"title\":\"Document foundation architecture and recovery boundaries\",\"dependencies\":[\"R0002\",\"R0004\",\"R0006\",\"R0008\"],\"output_path\":\"projects/mock-fantasy-quest-4/runbooks/R0012.md\",\"source_specifications\":[\"specification/03-technical-contract.md#architecture-and-requirement-traceability\",\"specification/03-technical-contract.md#persistence-migration-and-failure-semantics\",\"specification/03-technical-contract.md#trust-privacy-and-security\"],\"source_catalogue_ids\":[\"IMP-0012\"],\"authoring_batch\":\"B0006\",\"factory_stages\":[\"F011\",\"F012\",\"F013\"],\"asset_impact\":\"not_applicable\",\"asset_ids\":[],\"asset_brief\":\"No assets; developer-documentation closure only.\",\"acceptance_checks\":[\"all foundation ownership/dependencies/gates cross-checked\",\"does not claim release readiness\"],\"checkpoint_cadence\":\"after metadata, after draft, before manifest acceptance\",\"recovery\":\"retain ID and repair only this documentation contract\"}\nprojects/mock-fantasy-quest-4/planning/runbook-authoring-manifest.json-44-  ]\nprojects/mock-fantasy-quest-4/planning/runbook-authoring-manifest.json-45-}\nprojects/mock-fantasy-quest-4/authoring-runbooks/B0001.md\nprojects/mock-fantasy-quest-4/authoring-runbooks/B0002.md\nprojects/mock-fantasy-quest-4/authoring-runbooks/B0003.md\nprojects/mock-fantasy-quest-4/authoring-runbooks/B0004.md\nprojects/mock-fantasy-quest-4/authoring-runbooks/B0005.md\nprojects/mock-fantasy-quest-4/authoring-runbooks/B0006.md\nprojects/mock-fantasy-quest-4/authoring-runbooks/C0001.md\nprojects/mock-fantasy-quest-4/authoring-runbooks/D0001.md\nprojects/mock-fantasy-quest-4/authoring-runbooks/INITIAL.md\nprojects/mock-fantasy-quest-4/runbooks/R0002.md\nprojects/mock-fantasy-quest-4/runbooks/R0003.md\nprojects/mock-fantasy-quest-4/runbooks/R0010.md\n---\ntask_id: B0003\nsequence: 4\ntitle: Author deterministic state and connected-scope exclusion contracts\nbrowser_impact: not_applicable\nplaywright_spec:\n---\n\n## Objective\n\nAfter B0002, create only `../runbooks/R0004.md` and `../runbooks/R0008.md`\nfor IMP-0004 and IMP-0008.\n\n## Context packet\n\nRead `../PROJECT_BRIEF.md`, the B0003/R0004/R0008 manifest records, the two\ncatalogue records, and `02-feature-model.md#domain-vocabulary-and-state-ownership`,\n`03-technical-contract.md#data-contract`,\n`03-technical-contract.md#commands-validation-idempotency-and-concurrency`, and\n`03-technical-contract.md#trust-privacy-and-security`.\n\n## Output list\n\n- `../runbooks/R0004.md` \u2014 IMP-0004; dependencies R0002,R0003.\n- `../runbooks/R0008.md` \u2014 IMP-0008; dependencies R0002,R0004.\n\n## Required authoring content\n\nUse exact manifest provenance with `authoring_batch: B0003`, standard\nSupervisor metadata, and `asset_impact: not_applicable` with blank\n`asset_ids`. Each R file must include precise objective, dependencies,\nrequirements, files/data/interfaces, required behaviour, non-goals, platform\ndifferences, verification/evidence, observable acceptance criteria, and an\n`## Asset assessment` that explains no visual/source asset is needed and\nprohibits incidental creation.\n\n## Validation procedure\n\nStop on an existing conflicting R ID/path. Load both files; compare metadata,\nprovenance, dependencies, and ownership with the manifest; and verify every\nrequired section before updating state.\n\n## Checkpoint and update procedure\n\nCheckpoint B0003 only when both R files validate. Retain IDs and repair only\nthe failed output on resume.\n\n## Stop condition\n\nStop after R0004 and R0008; do not create services, identity, accounts, or more R files.\n\n## Acceptance criteria\n\n- Exactly R0004 and R0008 are authored for their allocated IMP records.\n- Both outputs are small, dependency-correct, fully traceable contracts with explicit no-asset assessments.\n- Conflicting existing work stops authoring without overwrite or ID reuse.\n- The manifest is checkpointed only after both outputs load and match it.\n---\ntask_id: T001\nsequence: 1\ntitle: Describe one small, reviewable change\nbrowser_impact: none\nplaywright_spec:\n---\n\n## Objective\n\nDescribe the smallest complete outcome. State what is in scope and, equally\nimportant, what must not be changed.\n\n## Acceptance criteria\n\n- The intended behaviour is implemented and documented where it affects users or developers.\n- Focused automated tests cover the change and pass.\n- No unrelated refactors, network calls, or credentials are introduced.\n---\ntask_id: F014\nsequence: 14\ntitle: Generate the bounded implementation-runbook authoring collection\nbrowser_impact: not_applicable\nplaywright_spec:\n---\n\n## Objective\n\nGenerate only the bootstrap wave of ordinary Supervisor runbooks in\n`projects/<project-slug>/authoring-runbooks/`: a bounded catalogue-expansion\ntask followed by a dispatcher task. The dispatcher allocates at most ten\nauthoring B-series tasks per wave, creates one successor dispatcher, and stops.\nEach authoring task instructs Codex to create only its assigned R-series\nimplementation runbooks under\n`projects/<project-slug>/runbooks/`, then validate their metadata and update the\nmanifest. The successor dispatcher repeats this process until no queued\ncatalogue chapter or unassigned implementation contract remains. Generate an\n`INITIAL.md` context document in `authoring-runbooks/`\nthat points to the canonical `PROJECT_BRIEF.md` and specification.\n\nRegister the generated authoring collection with the source collection by\nwriting `runbooks/.supervisor-children/<project-slug>.json` containing\n`{\"runbooks_dir\": \"../projects/<project-slug>/authoring-runbooks\"}`. Also\nwrite `authoring-runbooks/.supervisor-children/implementation.json` containing\n`{\"runbooks_dir\": \"../runbooks\"}`. These are explicit child-collection\nregistrations; `supervisor-run --run-all` follows them automatically after the\nparent collection is accepted.\n\nEvery dispatcher first expands at most one queued specification/catalogue domain\nchapter (maximum 250 `IMP-*` contracts), validates its coverage, then allocates\nready contracts. If any queued chapter or ready contract remains, it creates no\nmore than ten authoring tasks and exactly one successor dispatcher. If none\nremains, it creates the final audit task instead. This is a durable loop, not a\nrecursive prompt or an unbounded single run.\n\nEvery generated R-series runbook must use the standard Supervisor front matter\nand contain: precise objective; dependencies; relevant requirement IDs; owned\nfiles/data/interfaces; required behaviour; non-goals; platform differences;\nverification commands/evidence; and observable acceptance criteria. It must be\nsmall enough for one implementation task, not a vague epic.\n\nEvery generated R-series runbook must retain machine-readable provenance to the\ncanonical decisions that justify it. Its front matter must declare all of these\nnon-empty fields, using comma-separated values where more than one applies:\n\n```yaml\nsource_specifications: specification/03-technical-contract.md#save-state\nsource_catalogue_ids: IMP-SAVE-001\nauthoring_batch: B0007\nfactory_stages: F003,F005,F012,F013\n```\n\n`source_specifications` points to the smallest relevant canonical\nspecification section; `source_catalogue_ids` identifies the allocated\nimplementation-catalogue records; `authoring_batch` identifies the B-series\nwriter that created the R file; and `factory_stages` identifies the F-series\nstages that established the requirement. This is a traceability trail, not an\ninstruction to inject every F or B runbook into the implementation agent's\nprompt. The R task uses these links to read only the canonical context it needs.\n\nEvery generated R-series runbook must also include a detailed asset assessment.\nIts front matter must always declare both fields below, even when no assets are\nneeded:\n\n```yaml\nasset_impact: required # or not_applicable\nasset_ids: village_gate_main,village_gate_construction # blank only when not_applicable\n```\n\nFor `asset_impact: required`, the B-series writer must reserve stable,\nproduct-specific asset IDs (never generic names such as `image1`), provide an\n`asset_brief` and `visual_style_version`, and include an `## Asset assessment`\nsection explaining the assets' purpose, where they appear, the required visual\nstates/variants, source-of-truth ownership, and original-art acceptance checks.\nFor `not_applicable`, that section must explain why the scope needs no generated\nor source visual asset and explicitly prohibit incidental asset creation. This\nkeeps UI, illustration, icon, texture, sprite, audio-visual, and other product\nasset work visible in the implementation plan instead of discovering it midway\nthrough coding.\n\nEvery generated R-series runbook must also declare an audio assessment, even\nwhen audio is not needed:\n\n```yaml\naudio_impact: required # or not_applicable\naudio_ids: ember_menu_loop # blank only when not_applicable\naudio_brief: 30-second seamless instrumental menu cue # blank only when not_applicable\naudio_duration_seconds: 30 # 0 only when not_applicable\naudio_loop: required # required, not_required, or not_applicable\naudio_style_version: project-audio-v1\n```\n\nFor `audio_impact: required`, the writer must reserve stable cue IDs, cite the\nrelevant `04-audio-direction.md` section, describe the in-product trigger and\nmix/accessibility expectations, and assign a sensible duration and loop policy.\nThe Supervisor's separate local audio lane then creates a manifest, invokes\nACE-Step, and performs technical/provenance QA before coding begins. For\n`not_applicable`, every audio field has the stated empty/default form so an\notherwise unrelated task cannot silently generate music or sound effects.\n\nEach B-series authoring task may create at most seven R-series implementation\nrunbooks. It must stop after its assigned seven (or fewer), update the manifest,\nand leave remaining work for the next bounded batch.\n\nAn unresolved framework, legal, service, design, or other human gate is never\npermission for a B-series writer to omit its assigned R files or wait for an\nearlier B batch to be accepted. The writer produces the bounded contract now,\nrecords the gate and any R-to-R implementation dependency explicitly, and lets\nthe later R-series product-work run pause at that genuine decision. In short:\n**gates block implementation, not runbook authoring**.\n\n## Acceptance criteria\n\n- The initial collection contains only a bounded bootstrap wave; each\n  dispatcher expands at most one 250-contract domain shard, creates at most ten\n  new B-series authoring tasks plus one successor, then exits. It never attempts\n  to materialise the whole game plan.\n- There is exactly one valid B-series authoring runbook per allocated manifest\n  batch, and it creates no more than seven assigned R-series runbooks.\n- B-series runbooks never overwrite an existing R-series contract with a\n  conflicting ID; they stop and report mismatches.\n- Every generated B-series runbook includes its context packet, output list,\n  validation procedure, checkpoint/update procedure, and a clear stop condition.\n- Every generated B-series runbook states that it must author its allocated R\n  files despite unresolved implementation gates or unimplemented R\n  dependencies, retaining those gates in the R contract rather than stopping.\n- Both child-collection registration files exist, contain valid JSON with a\n  relative `runbooks_dir`, and point to the generated authoring and\n  implementation collections respectively.\n- R-series contracts use stable IDs and parse with the Supervisor runbook\n  loader; their declared dependencies match the manifest, every contract has\n  explicit `asset_impact` and `asset_ids` metadata, and asset-required\n  contracts have non-empty stable IDs. Every R contract also has non-empty,\n  valid `source_specifications`, `source_catalogue_ids`, `authoring_batch`,\n  and `factory_stages` provenance metadata.\n- Every R-series contract has explicit valid audio metadata. Audio-required\n  contracts have stable IDs, a non-empty cue brief, duration, loop policy,\n  audio-style version, and a source link to the canonical audio direction.\n- The collection contains a final audit B-series task after all authoring\n  batches and catalogue expansions are complete, rather than pretending that\n  thousands of contracts can be reviewed in one generation step.\n\nexec\n/bin/zsh -lc \"sed -n '1,260p' projects/mock-fantasy-quest-4/runbooks/R0002.md && sed -n '1,260p' projects/mock-fantasy-quest-4/runbooks/R0003.md && sed -n '1,260p' projects/mock-fantasy-quest-4/runbooks/R0010.md && rg -n -C 4 '\"'^(## (Domain vocabulary and state ownership|Data contract|Commands, validation, idempotency, and concurrency|Trust, privacy, and security)|### (Domain vocabulary and state ownership|Data contract|Commands, validation, idempotency, and concurrency|Trust, privacy, and security))'\"' projects/mock-fantasy-quest-4/specification/{02-feature-model,03-technical-contract}.md\" in /Users/simon/Dev/github/jakowicz/runbook-generator\n succeeded in 0ms:\n---\ntask_id: R0002\nsequence: 2\ntitle: Enforce shared-core and adapter dependency seams\ndependencies:\n  - R0001\nrequirement_ids:\n  - NFR-0010\n  - REQ-0013\n  - NFR-0012\nsource_specifications:\n  - specification/03-technical-contract.md#architecture-and-requirement-traceability\n  - specification/03-technical-contract.md#dependency-direction-and-state-rules\nsource_catalogue_ids:\n  - IMP-0002\nauthoring_batch: B0002\nfactory_stages:\n  - F011\n  - F012\n  - F013\nasset_impact: not_applicable\nasset_ids:\nasset_brief: No assets; this is an interface and dependency-policy contract.\naudio_impact: not_applicable\naudio_ids:\naudio_brief:\naudio_duration_seconds: 0\naudio_loop: not_applicable\naudio_style_version:\nbrowser_impact: not_applicable\nplaywright_spec:\n---\n\n## Objective\n\nCreate the dependency policy and public contracts that keep the deterministic\nshared core independent of browser, renderer, clock, network, and platform\nmodules. Adapters may submit commands and render returned state/events only.\n\n## Dependencies\n\nR0001 is an implementation dependency. Author and validate this contract now;\ndo not treat GATE-0001 as permission to implement or as a blocker to authoring.\n\n## Ownership\n\n- `src/core/public interfaces` and the `Command`, state, event, and adapter interfaces.\n- `src/platform/{web,pwa}/adapter interfaces` and the dependency-policy manifest.\n- `architecture dependency rules` and `docs/architecture.md`.\n\n## Behaviour\n\nDefine an enforceable import direction in which the core accepts shared\ncommands, validates and returns state/events, while web and PWA adapters\ntranslate platform input and render those returned values. The adapter must not\nmutate campaign state directly. Keep the policy framework-neutral so a later\ntool decision can choose its enforcement mechanism without changing the seam.\n\n## Web and PWA differences\n\nBoth targets consume the same core contract. The web adapter owns browser\ninput, rendering, and viewport integration; the PWA adapter additionally owns\ninstallation and cache-lifecycle adaptation. Neither target imports platform\nconcerns into the core or becomes a campaign authority.\n\n## Non-goals\n\nDo not implement combat, exploration, screens, campaign rules, accounts,\nnetwork clients, renderer behaviour, or target-specific rules. Do not create\nassets, artwork, fonts, icons, audio, maps, or copied reference styling.\n\n## Asset assessment\n\n`asset_impact` is `not_applicable`. This interface and dependency-policy work\nmust not create incidental product assets; `asset_ids` remains blank.\n\n## Verification\n\n- Add a dependency-rule test that rejects forbidden core imports.\n- Add a fixture adapter proving command-only interaction and returned\n  state/event rendering.\n- Record the selected enforcement mechanism only after the retained GATE-0001\n  tool decision; do not claim that gate is resolved here.\n\n## Evidence\n\nPreserve the dependency-rule test result, the fixture-adapter result, and an\narchitecture document showing the one-way core/adapter boundary.\n\n## Acceptance criteria\n\n- Forbidden imports into the core are rejected.\n- A fixture adapter can submit commands and consume returned state/events\n  without directly mutating campaign state.\n- The shared contract remains usable by web and PWA adapters without choosing\n  implementation tooling or creating product assets.\n---\ntask_id: R0003\nsequence: 3\ntitle: Create deterministic test and fixture harness\ndependencies:\n  - R0001\n  - R0002\nrequirement_ids:\n  - NFR-0010\n  - NFR-0012\nsource_specifications:\n  - specification/03-technical-contract.md#observability-quality-evidence-and-release-verification\nsource_catalogue_ids:\n  - IMP-0003\nauthoring_batch: B0002\nfactory_stages:\n  - F011\n  - F012\n  - F013\nasset_impact: not_applicable\nasset_ids:\nasset_brief: No assets; fixtures use non-product deterministic data.\naudio_impact: not_applicable\naudio_ids:\naudio_brief:\naudio_duration_seconds: 0\naudio_loop: not_applicable\naudio_style_version:\nbrowser_impact: not_applicable\nplaywright_spec:\n---\n\n## Objective\n\nEstablish layered unit, content, integration, and reserved browser-test\nconventions with isolated RNG, clock, and persistence fixtures. The harness\nmust be repeatable and must never access real services or player data.\n\n## Dependencies\n\nR0001 and R0002 are implementation dependencies. This contract may be authored\nand structurally validated before they run; its later implementation uses the\nshared seam from R0002.\n\n## Ownership\n\n- Test-runner configuration and `tests/{core,content,platform,app}/fixtures`.\n- Deterministic fixture factories plus fake clock and RNG interfaces.\n- `docs/testing.md` and the reserved browser-test convention.\n\n## Behaviour\n\nProvide factories that receive controlled clock, RNG, and storage fakes, reset\ntheir state between cases, and expose explicit deterministic inputs. Define\nseparate layers for core, content, platform, and application checks so future\nfeatures add evidence at the appropriate layer instead of coupling tests to\nreal browser state or services.\n\n## Web and PWA differences\n\nShared fixtures cover core behaviour. Web and PWA adapter tests use isolated\nplatform fakes; reserved browser tests are conventions only, not claims of a\nreal browser/device matrix. PWA cache and web origin storage remain distinct\nfrom fixture storage.\n\n## Non-goals\n\nDo not add final feature assertions, real browser or device compatibility\nclaims, production telemetry, network calls, player data, campaign content, or\nproduct assets. Do not create incidental art, fonts, icons, audio, maps, or\nreference-derived fixture content.\n\n## Asset assessment\n\n`asset_impact` is `not_applicable`. Fixtures contain only deterministic,\nnon-product data and must not create incidental product assets or reserve them.\n\n## Verification\n\n- Run a representative core fixture repeatedly and prove identical results.\n- Deliberately fail a fixture assertion and prove the runner reports it.\n- Verify fixture storage is isolated from browser-origin and production data.\n- Retain GATE-0002: this harness does not establish compatibility or\n  performance claims.\n\n## Evidence\n\nRecord repeated-run output, the deliberate-failure detection result, and an\nisolation check showing no real service, player, or browser-origin storage use.\n\n## Acceptance criteria\n\n- Repeated execution of a controlled fixture returns identical results.\n- Fixture state, clock, RNG, and storage are isolated and resettable.\n- The harness defines layered conventions without asserting final features,\n  browser/device support, or production telemetry.\n---\ntask_id: R0010\nsequence: 10\ntitle: Establish semantic accessibility design tokens\ndependencies:\n  - R0001\n  - R0002\nrequirement_ids:\n  - REQ-0007\n  - REQ-0010\n  - NFR-0004\n  - NFR-0008\nsource_specifications:\n  - specification/04-experience-contract.md#layout-visual-tokens-and-responsive-behaviour\n  - specification/04-experience-contract.md#accessibility-policy\nsource_catalogue_ids:\n  - IMP-0010\nauthoring_batch: B0002\nfactory_stages:\n  - F011\n  - F012\n  - F013\nasset_impact: not_applicable\nasset_ids:\nasset_brief: No final artwork, fonts, or icons; semantic tokens only and prohibit incidental assets.\naudio_impact: not_applicable\naudio_ids:\naudio_brief:\naudio_duration_seconds: 0\naudio_loop: not_applicable\naudio_style_version:\nbrowser_impact: not_applicable\nplaywright_spec:\n---\n\n## Objective\n\nDefine original semantic tokens for typography, spacing, focus, motion, touch\ntargets, status, contrast, and non-colour cues. The contract enables later\nresponsive web UI and inherited PWA UI without selecting final visual assets or\nnumeric design decisions that remain gated.\n\n## Dependencies\n\nR0001 and R0002 are implementation dependencies. Retain GATE-0002 and\nGATE-0004 for numeric contrast, font, and breakpoint claims; neither gate\nblocks authoring this bounded token contract.\n\n## Ownership\n\n- `src/app/design/tokens/` and the semantic token inventory.\n- `docs/design-tokens.md` and `tests/app/design-tokens.*`.\n- The token consumption contract used by shared UI, web, and PWA adapters.\n\n## Behaviour\n\nUse semantic names such as surface, text, action, status, focus, spacing,\ntypography, motion, and target-size rather than screen- or asset-specific\nvalues. Require visible focus, text-plus-shape/icon status cues, and\nreduced-motion values that remove nonessential motion. Support scalable text,\nsemantic labels, and non-colour state indication without binding tokens to a\nspecific component or final visual composition.\n\n## Web and PWA differences\n\nWeb UI consumes the shared semantic contract across responsive layouts. The\ninstalled PWA inherits those tokens and accessibility behaviour; installation,\ncache, and display-mode adaptation do not introduce a separate token system.\nNo final breakpoint or browser/device compatibility claim is made.\n\n## Non-goals\n\nDo not build screens, maps, layouts, final breakpoints, final artwork, fonts,\nicons, audio, animations, or copied reference styling. Do not approve numeric\ncontrast, font, or breakpoint values while GATE-0002 and GATE-0004 remain\nunresolved.\n\n## Asset assessment\n\n`asset_impact` is `not_applicable`. This semantic contract explicitly\nprohibits incidental asset creation: no final art, fonts, icons, audio, maps,\nor other product assets may be created or reserved.\n\n## Verification\n\n- Validate representative token fixtures contain semantic labels and\n  text/non-colour cues for status.\n- Validate reduced-motion values remove nonessential transitions without\n  suppressing essential information.\n- Confirm focus, target-size, typography, spacing, and status tokens are\n  semantic and do not encode a screen or final asset.\n- Record GATE-0002 and GATE-0004 as retained before any numeric design,\n  contrast, font, or breakpoint claim.\n\n## Evidence\n\nPreserve token-validation results, representative non-colour and\nreduced-motion fixtures, and the explicit retained-gate record.\n\n## Acceptance criteria\n\n- Semantic tokens provide non-colour cues and reduced-motion values.\n- The token contract can be consumed by web and PWA UI without platform forks.\n- No final visual assets or approval-gated numeric claims are introduced.\nprojects/mock-fantasy-quest-4/specification/03-technical-contract.md-38-ephemeral UI state (open panels, selection, animation), while the repository\nprojects/mock-fantasy-quest-4/specification/03-technical-contract.md-39-owns only serialized snapshots and recovery metadata. Rendering, input,\nprojects/mock-fantasy-quest-4/specification/03-technical-contract.md-40-caching, and diagnostics must not be required to make a legal game decision.\nprojects/mock-fantasy-quest-4/specification/03-technical-contract.md-41-\nprojects/mock-fantasy-quest-4/specification/03-technical-contract.md:42:## Data contract\nprojects/mock-fantasy-quest-4/specification/03-technical-contract.md-43-\nprojects/mock-fantasy-quest-4/specification/03-technical-contract.md-44-### Ownership, lifecycle, and retention\nprojects/mock-fantasy-quest-4/specification/03-technical-contract.md-45-\nprojects/mock-fantasy-quest-4/specification/03-technical-contract.md-46-| Data class | Owner and lifecycle | Persistence / retention | Access and recovery |\n--\nprojects/mock-fantasy-quest-4/specification/03-technical-contract.md-95-  ranges. Incompatible saves are quarantined with their original bytes and a\nprojects/mock-fantasy-quest-4/specification/03-technical-contract.md-96-  clear fallback/new-game action; a migration must create a new candidate and\nprojects/mock-fantasy-quest-4/specification/03-technical-contract.md-97-  validate it before promotion.\nprojects/mock-fantasy-quest-4/specification/03-technical-contract.md-98-\nprojects/mock-fantasy-quest-4/specification/03-technical-contract.md:99:## Commands, validation, idempotency, and concurrency\nprojects/mock-fantasy-quest-4/specification/03-technical-contract.md-100-\nprojects/mock-fantasy-quest-4/specification/03-technical-contract.md-101-The core exposes typed intent commands such as `StartCampaign`,\nprojects/mock-fantasy-quest-4/specification/03-technical-contract.md-102-`ChooseAction`, `UseItem`, `Talk`, `AcceptQuest`, `ClaimReward`,\nprojects/mock-fantasy-quest-4/specification/03-technical-contract.md-103-`EnterExit`, `CommitCheckpoint`, `LoadSlot`, and `ApplySettings`. A command\n--\nprojects/mock-fantasy-quest-4/specification/03-technical-contract.md-145-be idempotent or record the source version so a retry cannot apply a migration\nprojects/mock-fantasy-quest-4/specification/03-technical-contract.md-146-twice. A release may remove old migrations only after a separately approved\nprojects/mock-fantasy-quest-4/specification/03-technical-contract.md-147-support/retention decision.\nprojects/mock-fantasy-quest-4/specification/03-technical-contract.md-148-\nprojects/mock-fantasy-quest-4/specification/03-technical-contract.md:149:## Trust, privacy, and security\nprojects/mock-fantasy-quest-4/specification/03-technical-contract.md-150-\nprojects/mock-fantasy-quest-4/specification/03-technical-contract.md-151-- Treat content, imported saves, URL parameters, browser events, service-worker\nprojects/mock-fantasy-quest-4/specification/03-technical-contract.md-152-  messages, and persisted bytes as untrusted. Validate and bound sizes before\nprojects/mock-fantasy-quest-4/specification/03-technical-contract.md-153-  parsing; never execute content as code or render dialogue via unsafe HTML.\n--\nprojects/mock-fantasy-quest-4/specification/02-feature-model.md-32-| J5 | Save, load, and recover: player can leave and return safely. | Manual save or checkpoint completes atomically \u2192 resume chooses latest valid save \u2192 state restores at a safe scene boundary. | No save slot shows explanation; corrupt/incompatible candidate is quarantined, never overwritten, and falls back to the last valid checkpoint or new game; storage denial/quota exposes retry and export/support guidance where feasible; interrupted write keeps prior confirmed save. Local cache and any future remote copy conflict resolve only with explicit player choice; remote sync is not first release. Deleting a save requires confirmation and removes only that selected local save. |\nprojects/mock-fantasy-quest-4/specification/02-feature-model.md-33-| J6 | Adjust accessibility and feedback: player can make the game usable. | Open settings \u2192 preview/change text, captions, visual and input options \u2192 apply \u2192 preferences persist. | Unsupported option/device is labelled unavailable; reset asks confirmation; settings storage failure leaves current-session setting active and explains it may not persist. No permission denial is required for these settings. |\nprojects/mock-fantasy-quest-4/specification/02-feature-model.md-34-| J7 | Install, update, and recover from a fault: player retains a coherent playable version. | Install when browser allows \u2192 cache approved release \u2192 play offline \u2192 accept update at launch/menu after save boundary. | Installation prompt may be unavailable/declined without blocking web play; offline uncached assets state the requirement; cache refresh failure retains known-good cache; crash/error boundary offers retry, return to title, and safe recovery. Diagnostics are minimal and consent-gated where required; a player can decline or delete local diagnostic data without losing play. |\nprojects/mock-fantasy-quest-4/specification/02-feature-model.md-35-\nprojects/mock-fantasy-quest-4/specification/02-feature-model.md:36:## Domain vocabulary and state ownership\nprojects/mock-fantasy-quest-4/specification/02-feature-model.md-37-\nprojects/mock-fantasy-quest-4/specification/02-feature-model.md-38-| Term | Meaning / owner |\nprojects/mock-fantasy-quest-4/specification/02-feature-model.md-39-| --- | --- |\nprojects/mock-fantasy-quest-4/specification/02-feature-model.md-40-| Campaign | The fixed first-release sequence from new game through ending; owns completion state. |\n\nexec\n/bin/zsh -lc \"sed -n '36,92p' projects/mock-fantasy-quest-4/specification/02-feature-model.md && sed -n '42,145p' projects/mock-fantasy-quest-4/specification/03-technical-contract.md && sed -n '149,192p' projects/mock-fantasy-quest-4/specification/03-technical-contract.md && sed -n '1,180p' projects/mock-fantasy-quest-4/planning/validate_runbook_generation.py\" in /Users/simon/Dev/github/jakowicz/runbook-generator\n succeeded in 0ms:\n## Domain vocabulary and state ownership\n\n| Term | Meaning / owner |\n| --- | --- |\n| Campaign | The fixed first-release sequence from new game through ending; owns completion state. |\n| Scene | One authored playable location: town or dungeon; owns exits, encounter zones, and presentation references. |\n| Quest | Authored objective and state machine that gates campaign progress and rewards. |\n| Party | Player-controlled combat group; owns members' current combat-ready values and progression. Exact party size is an authoring decision. |\n| Encounter | A combat instance created from an authored encounter definition; never persists mid-turn. |\n| Item | Authored definition; an inventory stack/reference is the player-owned instance/count. |\n| Save snapshot | Versioned, validated, atomic representation of durable player state at a safe boundary. |\n| Checkpoint | Authored or system-selected safe snapshot point; it is not a promise to restore arbitrary moment-to-moment state. |\n| Content package | Versioned original scenes, dialogue, quests, encounters, items, translations, and audiovisual assets delivered together. |\n\n## System relationship map\n\n```text\nContent package \u2500\u2500validates/defines\u2500\u2500> Scene \u2500\u2500starts\u2500\u2500> Encounter\n      \u2502                                  \u2502                  \u2502\n      \u251c\u2500\u2500defines\u2500\u2500> Dialogue \u2500\u2500updates\u2500\u2500> Quest <\u2500\u2500rewards\u2500\u2500\u2500\u2518\n      \u2502                                  \u2502       \u2502\n      \u2514\u2500\u2500defines\u2500\u2500> Items \u2500\u2500held by\u2500\u2500> Inventory \u2502\n                                                 \u2502\nInput + accessibility \u2500\u2500drives\u2500\u2500> Game shell \u2500\u2500> exploration / UI\n                                                 \u2502\nQuest + inventory + party + scene \u2500\u2500snapshot\u2500\u2500> Save / checkpoint\nSave version <\u2500\u2500compatible-with\u2500\u2500 Content package / PWA release\nPWA cache + release workflow \u2500\u2500protect\u2500\u2500> runnable assets and save boundary\nError recovery + minimal diagnostics \u2500\u2500observe\u2500\u2500> shell, persistence, cache\n```\n\n**Cross-domain invariants and lifecycle boundaries**\n\n- A quest transition, reward grant, and save snapshot are ordered: validate\n  transition, apply reward once, then checkpoint; retrying cannot duplicate a\n  reward.\n- An encounter may read party, item, and quest state but changes durable state\n  only after a resolved turn/encounter safe boundary. A crash cannot restore a\n  half-consumed item or half-applied reward.\n- A scene exit is available only when its authored quest predicate is true.\n  Content validation ensures every required predicate, target, reward, and\n  localisation key exists.\n- Settings affect presentation/input immediately but never campaign rules.\n  The same semantic action must be available through supported keyboard,\n  mouse, touch, and gamepad adaptations.\n- Save snapshots record content/schema version and are written atomically.\n  Cache replacement and application migration happen only outside combat and\n  only while a valid fallback save remains intact.\n- The local offline campaign neither needs identity nor sends player state.\n  Any later account is an optional replication boundary, not campaign truth.\n\n## Accepted domain chapters\n\n### 1. Game shell, session, input, and responsive presentation\n\n**Entities/lifecycle:** `Session` moves `launching \u2192 title \u2192 new-or-resume \u2192\nplaying \u2194 paused \u2192 ending \u2192 title`; `InputAction` is mapped per supported input\n## Data contract\n\n### Ownership, lifecycle, and retention\n\n| Data class | Owner and lifecycle | Persistence / retention | Access and recovery |\n| --- | --- | --- | --- |\n| Content package | Build/content owner: authored \u2192 schema-validated \u2192 bundled \u2192 immutable release artifact \u2192 superseded | Public static assets; current and previous known-good cache retained per cache policy | Read by client only; invalid references reject package before gameplay. |\n| Campaign snapshot | Player; new game \u2192 checkpoint/manual save \u2192 valid, migrated, quarantined, or explicitly deleted | Browser-origin local storage appropriate for structured durable data (implementation selects IndexedDB or equivalent); retain current valid slot plus last-known-good checkpoint | Same browser origin only in P0; player may load, delete after confirmation, and receive export/support guidance where feasible. |\n| Settings | Player; default \u2192 previewed \u2192 applied \u2192 persisted/reset | Separate local preference record; current session remains active if persistence fails | Read/write only by local game; reset requires confirmation. |\n| Recovery metadata | Client; write attempt/failure \u2192 recovery offer \u2192 resolved | Local, bounded and tied to save slot; remove with slot/delete-local-data action | Never overwrites valid snapshot; aids quarantine and fallback. |\n| Diagnostic record | Player-controlled, consent-gated; fault \u2192 local record \u2192 optional future export/delete | Bounded local record, no identifiers, no campaign dialogue, and no network sending in P0 | Player can decline, clear, or export only after a future approved workflow. |\n\nThe local campaign is the P0 source of truth. There is no account, remote\nprofile, analytics stream, purchase ledger, match state, or cloud backup.\nRemote account-linked replication is a later optional mirror\u2014not campaign truth\nuntil approval defines identity, vendor, consent, cost, retention, deletion,\nsupport, conflict UX, and outage behaviour.\n\n### Versioned content and save schemas\n\nAll high-volume authored data uses a versioned, machine-validated package:\n\n```text\nContentPackage { packageId, semanticVersion, schemaVersion, localeDefault,\n  scenes[], exits[], dialogues[], quests[], encounters[], enemyDefinitions[],\n  itemDefinitions[], rewards[], localisation[], assetManifest[] }\nSaveSnapshot { schemaVersion, contentPackageId, contentVersion, slotId,\n  revision, checkpointId, campaign, quests, party, inventory, rewardLedger,\n  settingsReference?, checksum, committedAt }\n```\n\n- **Ownership and authoring:** designated game/content owners maintain source\n  data in repository-controlled files and original asset references. The exact\n  editor/format is an implementation choice; generated bundles are derived,\n  never hand-edited.\n- **Validation:** CI validates JSON/schema shape, unique stable IDs, required\n  fields, asset and localisation-key existence, valid quest predicates,\n  scene/spawn/exit targets, legal reward/item/enemy references, no duplicate\n  reward IDs, and reachability from opening scene to ending. It also rejects\n  missing required translations in any release locale and unsafe quest-item\n  removal paths.\n- **Relationship rules:** every required quest path has a reachable transition;\n  each locked exit predicate refers to an existing quest state; each encounter\n  has legal targets/actions and a completion path; all rewards resolve to\n  extant definitions. Tests include valid minimal package, each broken\n  reference class, and a graph traversal proving the authored campaign is\n  completable.\n- **Import/export:** P0 imports content only at build time through the\n  validator and packages it into the release. Player save export/import is not\n  promised; if added, it must use a versioned envelope, parse/validate before\n  write, never replace a valid save until confirmation, and reject untrusted\n  payloads safely.\n- **Compatibility:** each release declares supported content and save schema\n  ranges. Incompatible saves are quarantined with their original bytes and a\n  clear fallback/new-game action; a migration must create a new candidate and\n  validate it before promotion.\n\n## Commands, validation, idempotency, and concurrency\n\nThe core exposes typed intent commands such as `StartCampaign`,\n`ChooseAction`, `UseItem`, `Talk`, `AcceptQuest`, `ClaimReward`,\n`EnterExit`, `CommitCheckpoint`, `LoadSlot`, and `ApplySettings`. A command\ncontains an expected campaign revision and an interaction/action ID. The core\nreturns either a typed rejection without mutation or an ordered state/event\nresult with a new revision.\n\n- Validate session state, command shape, actor/target existence, availability,\n  eligibility, quest predicate, and expected revision before mutation. UI\n  selections are untrusted/stale inputs even though all execution is local.\n- Use stable `rewardId`/`grantId` ledger entries and interaction IDs. Retrying\n  an acknowledged reward, quest completion, or checkpoint returns the prior\n  result rather than granting twice.\n- One command is processed at a time per active campaign. Disable/debounce\n  duplicate controls while pending; compare expected revision on completion.\n  Visibility changes, gamepad repeats, and multiple tabs cannot interleave\n  transitions. A second tab must be warned/read-only or acquire an explicit\n  local slot lease; stale writers fail without replacing the latest revision.\n- Combat resolution uses an explicit deterministic seed/state recorded at\n  safe boundaries. It never persists an unresolved turn; a crash restores the\n  prior checkpoint, avoiding half-consumed items, half-applied damage, or\n  duplicate rewards.\n\n## Persistence, migration, and failure semantics\n\nSave commit is a write-ahead replacement protocol: serialize a complete\nsnapshot \u2192 validate checksum/schema/invariants \u2192 write candidate under a new\nrevision \u2192 verify read-back \u2192 mark current \u2192 retain prior known-good snapshot.\nImplementations must use browser storage semantics that make the final pointer\nswitch atomic, or emulate it with immutable revision records and a validated\ncurrent pointer. Never clear the prior save before the new pointer is valid.\n\n| Condition | Required behaviour |\n| --- | --- |\n| Storage quota, permission, or unavailable local storage | Keep session playable; show non-blocking save failure and retry guidance; do not claim persistence succeeded. |\n| Interrupted/crashed write | Ignore incomplete candidate, retain/reload prior confirmed snapshot, and show recovery state at next launch. |\n| Malformed/checksum-invalid save | Quarantine bytes and metadata; do not overwrite; offer last valid checkpoint/new game and support/export guidance where feasible. |\n| Migration failure or unsupported version | Preserve original, fail closed into quarantine, and offer clear version/fallback choices. |\n| Bad content package/reference | Fail build/CI; if discovered at runtime, stop the affected route, retain save, and offer title/retry rather than corrupting campaign state. |\n| Cache/network refresh failure | Continue with known-good cached release; explain first-install offline limitation without pretending an uncached release is playable. |\n| Application fault/crash loop | Error boundary offers retry, title, and safe recovery; diagnostics remain local unless explicitly consented and a future transport is approved. |\n\nMigration functions are ordered, pure transformations from one explicit schema\nversion to the next, with fixtures for every supported predecessor. They must\nbe idempotent or record the source version so a retry cannot apply a migration\n## Trust, privacy, and security\n\n- Treat content, imported saves, URL parameters, browser events, service-worker\n  messages, and persisted bytes as untrusted. Validate and bound sizes before\n  parsing; never execute content as code or render dialogue via unsafe HTML.\n- Serve production assets over HTTPS with a restrictive content security policy,\n  no third-party scripts by default, dependency lock/review, and build-time\n  asset integrity/hash manifest. Do not embed credentials in the client.\n- Use same-origin storage isolation; minimise persisted data to game state and\n  chosen preferences. Do not collect names, contact data, precise location,\n  advertising IDs, account identifiers, payment data, or gameplay analytics in\n  P0.\n- Diagnostics default off where consent is required and must state fields,\n  purpose, retention, deletion, and transport before collection. A local\n  diagnostic record excludes free-text dialogue and complete save contents.\n- There is no authorization role in P0 because there is no server resource or\n  identity boundary. Locally, a player controls their browser profile; this is\n  not a security guarantee against a device owner. Any server feature requires\n  explicit least-privilege roles, authenticated authorization on every request,\n  rate limits, audit events, deletion/retention policy, incident ownership, and\n  documented offline/outage behaviour before implementation.\n- No copied branding, assets, text, layouts, or distinctive interaction\n  sequences enter the content pipeline. Provenance/review is required for\n  shipped art, audio, writing, and dependencies.\n\n## Target-platform matrix\n\n| Contract area | Responsive public web application | Installable PWA |\n| --- | --- | --- |\n| Shared code/data boundary | Same rules core, content package, save schema, semantic actions, accessibility settings, and release compatibility rules. Browser adapter owns viewport/input differences. | Same shared core/data. Service worker, installation, cache lifecycle, and platform install affordance are PWA adapters. |\n| Input and device capability | Keyboard, mouse, touch, and gamepad where exposed; feature-detect and show available mappings. Handle resize, rotation, focus/visibility, reduced-motion/contrast settings where available. | Same inputs and feature detection; no assumed hardware merely because installed. Installation, notifications, or storage-persistence prompts are optional and must not block play. |\n| Offline and recovery | May play offline only after relevant assets are cached. First uncached visit tells player an initial download/network is required. Local save protocol applies. | Primary offline route after successful install/cache. Precaches approved shell/content, retains known-good cache on refresh failure, and keeps saves independent of cache eviction. |\n| Build and test | Produce hashed static assets, manifest, and browser-compatible bundle. Test core/unit/content validation, responsive layouts, input adaptations, save corruption/migration, error states, and supported browser/device/network matrix. | Build includes service worker and install manifest. Test installability, offline reload, cache rollback/update-at-safe-boundary, storage pressure, and all shared checks. |\n| Accessibility and performance | Keyboard-operable menus, semantic labels, visible focus, readable scalable text, captions, non-colour cues, settings persistence, responsive phone/tablet/desktop checks. Establish approval-gated performance budgets for initial load, interaction frame time, memory, bundle/cache size, and slow-network behaviour before release. | Same accessibility/performance requirements, plus offline messaging, update state, install prompt alternatives, and no inaccessible full-screen/install-only path. Measure cold/warm/offline startup and cache size. |\n| Release channel and policy | Immutable versioned static release to approved web hosting; staged/canary and rollback process must be selected before launch. Publish supported-browser matrix, privacy notice if diagnostics changes, and recovery notes. | Browser-mediated install/update channel; manifest/icon/display policy and service-worker behaviour must meet supported browser/platform rules. Prompt only at safe boundaries; release notes and rollback retain prior runnable cache. |\n\nSupport targets are expressed as capability tests rather than invented minimum\nOS versions: current and previous major releases of agreed evergreen browsers\non representative phone, tablet, and desktop classes; exact versions/devices,\nbrowser engine exclusions, storage quota, and slow-network thresholds remain a\nrelease approval gate.\n\n## Observability, quality evidence, and release verification\n\n#!/usr/bin/env python3\n\"\"\"Structural quality gate for generated B-series and R-series runbooks.\n\nThis validates planning artefacts only; it is never product or release evidence.\n\"\"\"\nfrom __future__ import annotations\nimport argparse\nimport json\nimport re\nimport sys\nfrom collections import Counter, defaultdict\nfrom pathlib import Path\n\nROOT = Path(__file__).resolve().parents[1]\nREPOSITORY = ROOT.parents[1]\nMANIFEST_PATH = ROOT / \"planning/runbook-authoring-manifest.json\"\nCATALOGUE_PATH = ROOT / \"planning/implementation-catalogue-index.json\"\nR_ID, F_ID = re.compile(r\"^R\\d{4}$\"), re.compile(r\"^F\\d{3}$\")\n\ndef values(value):\n    return value if isinstance(value, list) else ([value] if value else [])\n\ndef parse_value(value):\n    value = value.strip().strip(\"\\\"'\")\n    if value == \"[]\": return []\n    if value.startswith(\"[\") and value.endswith(\"]\"):\n        return [item.strip().strip(\"\\\"'\") for item in value[1:-1].split(\",\") if item.strip()]\n    return value\n\ndef front_matter(path):\n    text = path.read_text(encoding=\"utf-8\")\n    if not text.startswith(\"---\\n\"): return {}\n    end = text.find(\"\\n---\", 4)\n    if end < 0: return {}\n    result, key = {}, None\n    for line in text[4:end].splitlines():\n        if line.lstrip().startswith(\"-\") and key:\n            result.setdefault(key, []).append(parse_value(line.split(\"-\", 1)[1]))\n        elif \":\" in line:\n            key, value = line.split(\":\", 1); key = key.strip(); result[key] = parse_value(value)\n    return result\n\ndef headings(path):\n    return {re.sub(r\"[^a-z0-9]+\", \"-\", match.group(1).lower()).strip(\"-\")\n            for match in re.finditer(r\"^#{1,6}\\s+(.+?)\\s*$\", path.read_text(encoding=\"utf-8\"), re.M)}\n\ndef main():\n    parser = argparse.ArgumentParser(description=__doc__)\n    parser.add_argument(\"--wave\", help=\"validate allocations through this B batch\")\n    args = parser.parse_args()\n    manifest = json.loads(MANIFEST_PATH.read_text())\n    catalogue = json.loads(CATALOGUE_PATH.read_text())\n    batches = {b[\"id\"]: b for b in manifest[\"batches\"]}\n    contracts = manifest[\"r_contracts\"]\n    if args.wave:\n        if args.wave not in batches: parser.error(\"unknown B batch: \" + args.wave)\n        contracts = [c for c in contracts if batches.get(c.get(\"authoring_batch\"), {}).get(\"order\", 999) <= batches[args.wave][\"order\"]]\n    records = {r[\"id\"]: r for r in catalogue[\"contracts\"]}\n    errors, missing, blocked, unverified = [], [], [], []\n    def fail(text): errors.append(text)\n    ids = [c.get(\"id\", \"\") for c in contracts]\n    if ids != sorted(ids): fail(\"manifest R IDs are not sequence ordered\")\n    for item, count in Counter(ids).items():\n        if count > 1: fail(\"duplicate manifest R ID \" + item)\n    paths = [c.get(\"output_path\", \"\") for c in contracts]\n    for item, count in Counter(paths).items():\n        if count > 1: fail(\"duplicate output path \" + item)\n    assets, browser_paths = {}, defaultdict(list)\n    # The authoring collection is part of the gate: each allocated batch must\n    # exist, identify itself, and be the sole owner of its manifest R IDs.\n    for batch_id, batch_record in batches.items():\n        batch_path = ROOT / \"authoring-runbooks\" / f\"{batch_id}.md\"\n        meta = front_matter(batch_path) if batch_path.is_file() else {}\n        if not meta: fail(f\"{batch_id}: missing or invalid B-series front matter\")\n        elif meta.get(\"task_id\") != batch_id: fail(f\"{batch_id}: task ID mismatch in authoring runbook\")\n        if len(batch_record.get(\"r_contract_ids\", [])) > 7: fail(f\"{batch_id}: exceeds seven-contract batch limit\")\n    for contract in contracts:\n        rid, batch = contract.get(\"id\", \"\"), contract.get(\"authoring_batch\", \"\")\n        if not R_ID.fullmatch(rid): fail(f\"invalid R ID {rid!r}\")\n        if batch not in batches or rid not in batches.get(batch, {}).get(\"r_contract_ids\", []): fail(f\"{rid}: authoring batch ownership mismatch\")\n        catalogue_ids = values(contract.get(\"source_catalogue_ids\"))\n        if not catalogue_ids or contract.get(\"catalogue_id\") not in catalogue_ids: fail(f\"{rid}: missing or inconsistent catalogue provenance\")\n        for cid in catalogue_ids:\n            if cid not in records: fail(f\"{rid}: unknown catalogue ID {cid}\")\n        if contract.get(\"catalogue_id\") in records and not records[contract[\"catalogue_id\"]].get(\"requirement_ids\"): fail(f\"{rid}: catalogue record lacks requirement links\")\n        specs = values(contract.get(\"source_specifications\"))\n        if not specs: fail(f\"{rid}: missing source_specifications\")\n        for link in specs:\n            file_name, _, anchor = link.partition(\"#\"); source = ROOT / file_name\n            if not link.startswith(\"specification/\") or not source.is_file() or (anchor and anchor not in headings(source)):\n                fail(f\"{rid}: unresolved canonical specification link {link}\")\n        stages = values(contract.get(\"factory_stages\"))\n        if not stages or any(not F_ID.fullmatch(s) for s in stages): fail(f\"{rid}: invalid factory_stages\")\n        for dependency in values(contract.get(\"dependencies\")):\n            if dependency not in ids: fail(f\"{rid}: dependency {dependency} is outside allocation\")\n            elif dependency >= rid: fail(f\"{rid}: dependency {dependency} does not precede contract\")\n        impact, asset_ids = contract.get(\"asset_impact\"), values(contract.get(\"asset_ids\"))\n        if impact not in {\"required\", \"not_applicable\"}: fail(f\"{rid}: invalid asset_impact\")\n        if \"asset_ids\" not in contract: fail(f\"{rid}: asset_ids absent\")\n        if impact == \"required\":\n            if not asset_ids or not contract.get(\"asset_brief\") or not contract.get(\"visual_style_version\"): fail(f\"{rid}: required assets lack IDs, brief, or style version\")\n            for asset in asset_ids:\n                if not re.fullmatch(r\"ASSET-[A-Z0-9-]+\", asset): fail(f\"{rid}: unstable asset ID {asset}\")\n                if asset in assets: fail(f\"asset {asset} ambiguously owned by {assets[asset]} and {rid}\")\n                assets[asset] = rid\n        elif asset_ids: fail(f\"{rid}: non-asset contract reserves asset IDs\")\n        if batches.get(batch, {}).get(\"state\") in {\"blocked_on_gate\", \"blocked\", \"repairable\"}: blocked.append(rid)\n        r_path = REPOSITORY / contract.get(\"output_path\", \"\")\n        if not r_path.is_file(): missing.append(rid); continue\n        meta = front_matter(r_path)\n        for field in (\"task_id\", \"sequence\", \"source_specifications\", \"source_catalogue_ids\", \"authoring_batch\", \"factory_stages\", \"asset_impact\", \"asset_ids\"):\n            if field not in meta: fail(f\"{rid}: {r_path.name} lacks {field}\")\n        if \"requirement_ids\" not in meta: fail(f\"{rid}: {r_path.name} lacks requirement_ids\")\n        if meta.get(\"task_id\") != rid: fail(f\"{rid}: task ID mismatch\")\n        if values(meta.get(\"requirement_ids\")) != records.get(contract.get(\"catalogue_id\"), {}).get(\"requirement_ids\", []): fail(f\"{rid}: requirement_ids differ from catalogue\")\n        for field in (\"source_specifications\", \"source_catalogue_ids\", \"authoring_batch\", \"factory_stages\", \"asset_impact\", \"asset_ids\"):\n            if values(meta.get(field)) != values(contract.get(field)): fail(f\"{rid}: {field} differs from manifest\")\n        browser, specs = meta.get(\"browser_impact\", \"not_applicable\"), values(meta.get(\"playwright_spec\", meta.get(\"playwright_specs\")))\n        if browser == \"not_applicable\" and specs: fail(f\"{rid}: browser path on non-browser contract\")\n        if browser != \"not_applicable\" and (not specs or not set(records.get(contract.get(\"catalogue_id\"), {}).get(\"targets\", [])) & {\"web\", \"pwa\"}): fail(f\"{rid}: browser metadata outside browser behaviour scope\")\n        for spec in specs: browser_paths[spec].append(rid)\n        body = r_path.read_text(encoding=\"utf-8\")\n        if \"## Verification\" not in body: unverified.append(rid)\n        if not re.search(r\"^## Asset assessment\\s*$\", body, re.M | re.I): fail(f\"{rid}: missing explicit Asset assessment section\")\n    for path, owners in browser_paths.items():\n        if len(owners) > 1: fail(f\"duplicate browser test path {path}: {', '.join(owners)}\")\n    graph = {c[\"id\"]: values(c.get(\"dependencies\")) for c in contracts}; active, done = set(), set()\n    def visit(node):\n        if node in active: fail(\"unsupported circular dependency through \" + node); return\n        if node not in done:\n            active.add(node)\n            for dep in graph[node]:\n                if dep in graph: visit(dep)\n            active.remove(node); done.add(node)\n    for node in graph: visit(node)\n    # Discovered families need a canonical source and a category-appropriate\n    # catalogue/verification route. Explicitly held connected scope is a valid\n    # reviewed outcome, not a missing P0 implementation contract.\n    review = ROOT / \"specification/domain-completeness-review.md\"\n    for line in review.read_text(encoding=\"utf-8\").splitlines():\n        if not line.startswith(\"|\") or line.startswith(\"| System\") or line.startswith(\"| ---\"): continue\n        cells = [cell.strip() for cell in line.split(\"|\")[1:-1]]\n        if len(cells) != 5: continue\n        family, source, _deps, authoring, decision = cells\n        if \"SPEC-\" not in source: fail(f\"domain family {family}: no specification chapter\")\n        if \"hold\" in decision.lower(): continue\n        keywords = [word.lower() for word in re.findall(r\"[A-Za-z]{5,}\", family)]\n        searchable = json.dumps(catalogue).lower()\n        if not any(word in searchable for word in keywords): fail(f\"domain family {family}: no catalogue traceability\")\n        if authoring.lower() not in {\"none\", \"n/a\"} and not authoring: fail(f\"domain family {family}: no content/authoring approach\")\n    allocated = {c.get(\"catalogue_id\") for c in contracts}\n    unallocated = [cid for cid in records if cid not in allocated]\n    print(\"Runbook-generation structural quality gate (not product/release evidence)\")\n    chapter_count = len(list((ROOT / \"specification\").glob(\"*.md\")))\n    source_link_count = sum(len(values(c.get(\"source_specifications\"))) for c in contracts)\n    print(f\"canonical specification chapters: {chapter_count}\")\n    print(f\"specification provenance links: {source_link_count}\")\n    for label, result in ((\"catalogue contracts\", list(records)), (\"manifest contracts\", ids), (\"R files missing\", missing), (\"blocked contracts\", blocked), (\"unverified contracts\", unverified), (\"unallocated catalogue contracts\", unallocated), (\"reserved asset IDs\", list(assets)), (\"browser test paths\", list(browser_paths))):\n        print(f\"{label}: {len(result)}\" + (\" (\" + \", \".join(sorted(result)) + \")\" if result else \"\"))\n    for error in errors: print(\"ERROR:\", error)\n    return 1 if errors or missing or unverified else 0\nif __name__ == \"__main__\": sys.exit(main())\n\ncodex\n{\"status\":\"pass\",\"summary\":\"The allocated paths are absent and non-conflicting. I found the prior B0002 contracts and the canonical state/security rules; I\u2019m drafting the two bounded R contracts and will checkpoint B0003 only after structural validation.\",\"changed_files\":[],\"test_result\":\"\",\"evidence\":{\"agent_log\":\"Verified R0004.md and R0008.md do not exist; B0003 owns exactly these IDs in the authoritative manifest.\",\"adapter_log\":\"\",\"test_log\":\"\",\"browser_log\":\"\",\"screenshots\":[]},\"acceptance_results\":[],\"documentation\":{\"reviewed_files\":[\"projects/mock-fantasy-quest-4/PROJECT_BRIEF.md\",\"projects/mock-fantasy-quest-4/specification/README.md\",\"projects/mock-fantas