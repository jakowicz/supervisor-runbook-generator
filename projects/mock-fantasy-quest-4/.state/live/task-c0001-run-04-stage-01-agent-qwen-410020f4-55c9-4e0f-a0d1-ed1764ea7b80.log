[stdout] {"type":"user","uuid":"45f1b28c-1785-4385-970a-4bbd53dc9e48","session_id":"99a15d88-e19e-4b39-ac15-1dd02ec31ec1","parent_tool_use_id":null,"message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call_86te1y6o","is_error":false,"content":"{\n  \"catalogue_id\": \"mock-fantasy-quest-4-implementation-catalogue\",\n  \"version\": 1,\n  \"source\": [\"../specification/README.md\", \"../specification/requirements.json\", \"05-delivery-map.md\", \"06-foundation-domain-contracts.md\", \"07-feature-experience-contracts.md\", \"08-quality-operations-contracts.md\"],\n  \"scope\": \"P0 is an original, offline-capable 2D single-player fantasy RPG delivered through a shared web core and a PWA delivery adaptation. Connected services are not P0 implementation scope.\",\n  \"first_bounded_domain\": {\"id\": \"SHARD-01\", \"title\": \"Foundation and core contracts\", \"contract_limit\": 250, \"contract_count\": 12, \"state\": \"ready_for_authoring\", \"boundary\": \"Framework-neutral seams, deterministic state/data contracts, local persistence protocol, quality foundations, and original-design controls; excludes campaign rules, UI flows, PWA lifecycle, and release execution.\"},\n  \"contracts\": [\n    {\"id\":\"IMP-0001\",\"title\":\"Bootstrap reproducible shared project baseline\",\"domain\":\"foundation\",\"targets\":[\"shared\",\"web\",\"pwa\"],\"requirement_ids\":[\"NFR-0010\",\"NFR-0012\"],\"bounded_outcome\":\"A framework-neutral project skeleton documents one bootstrap, lint, format, and deterministic test command with isolated shared, web-adapter, PWA-adapter, content, and test directories.\",\"prerequisites\":[],\"ownership\":{\"files\":[\"root build/tooling configuration\",\"src/{core,content,app,platform/web,platform/pwa}/\",\"tests/\",\"docs/development.md\"],\"data\":[\"pinned toolchain declaration\"],\"api\":[\"build/test command interface\"]},\"forbidden_scope\":[\"selecting framework/package manager/CI without DEC-0001\",\"gameplay\",\"service worker\",\"hosting\"],\"verification\":\"Clean approved-runtime checkout runs the documented deterministic sample test, lint, and format checks.\",\"human_external_gate\":\"GATE-0001 / DEC-0001 framework, package-manager, and CI selection before implementation.\",\"complexity\":\"medium\",\"status\":\"gated\"},\n    {\"id\":\"IMP-0002\",\"title\":\"Enforce shared-core and adapter dependency seams\",\"domain\":\"foundation\",\"targets\":[\"shared\",\"web\",\"pwa\"],\"requirement_ids\":[\"NFR-0010\",\"REQ-0013\",\"NFR-0012\"],\"bounded_outcome\":\"A dependency policy and public interfaces prevent core code from importing browser, renderer, clock, network, or platform modules; adapters submit commands and render returned state/events.\",\"prerequisites\":[\"IMP-0001\"],\"ownership\":{\"files\":[\"src/core/public interfaces\",\"src/platform/{web,pwa}/adapter interfaces\",\"architecture dependency rules\",\"docs/architecture.md\"],\"data\":[\"dependency-policy manifest\"],\"api\":[\"Command, state, event, and adapter interfaces\"]},\"forbidden_scope\":[\"concrete combat/exploration/UI\",\"account or network client\",\"target-specific campaign rules\"],\"verification\":\"A dependency-rule test rejects forbidden core imports and a fixture adapter proves command-only interaction.\",\"human_external_gate\":\"None; retain GATE-0001 for tool-specific enforcement.\",\"complexity\":\"medium\",\"status\":\"current\"},\n    {\"id\":\"IMP-0003\",\"title\":\"Create deterministic test and fixture harness\",\"domain\":\"tests\",\"targets\":[\"shared\",\"web\",\"pwa\"],\"requirement_ids\":[\"NFR-0010\",\"NFR-0012\"],\"bounded_outcome\":\"Layered unit, content, integration, and reserved browser-test conventions provide isolated RNG/clock and persistence fixtures with no real service or player data access.\",\"prerequisites\":[\"IMP-0001\",\"IMP-0002\"],\"ownership\":{\"files\":[\"test-runner configuration\",\"tests/{core,content,platform,app}/fixtures\",\"docs/testing.md\"],\"data\":[\"deterministic fixture factories\"],\"api\":[\"test fixture and fake clock/RNG interfaces\"]},\"forbidden_scope\":[\"final feature assertions\",\"real browser/device matrix claims\",\"production telemetry\"],\"verification\":\"Repeated core fixture execution has identical results; a deliberately failing fixture is detected; fixture storage is isolated.\",\"human_external_gate\":\"GATE-0002 before compatibility or performance claims.\",\"complexity\":\"medium\",\"status\":\"current\"},\n    {\"id\":\"IMP-0004\",\"title\":\"Define deterministic campaign state and command contract\",\"domain\":\"data\",\"targets\":[\"shared\"],\"requirement_ids\":[\"REQ-0001\",\"REQ-0003\",\"REQ-0004\",\"REQ-0006\",\"NFR-0002\",\"NFR-0010\"],\"bounded_outcome\":\"Immutable versioned state, command/result/event envelopes, revision and interaction identifiers, deterministic RNG state, and invariant helpers define legal transition mechanics without feature state machines.\",\"prerequisites\":[\"IMP-0002\",\"IMP-0003\"],\"ownership\":{\"files\":[\"src/core/{state,commands,events,invariants,rng}/\",\"tests/core/contract.*\"],\"data\":[\"campaign snapshot envelope\",\"deterministic RNG state\"],\"api\":[\"Core command/state/event API\"]},\"forbidden_scope\":[\"authored values\",\"combat/inventory/quest algorithms\",\"save driver\",\"UI selection state\",\"account/network state\"],\"verification\":\"Invalid and stale commands do not mutate state; duplicate interaction IDs cause no extra durable transition.\",\"human_external_gate\":\"GATE-0004 before concrete party/content shapes.\",\"complexity\":\"high\",\"status\":\"current\"},\n    {\"id\":\"IMP-0005\",\"title\":\"Define versioned content schema and validation boundary\",\"domain\":\"content\",\"targets\":[\"shared\"],\"requirement_ids\":[\"REQ-0002\",\"REQ-0008\",\"NFR-0007\",\"NFR-0008\"],\"bounded_outcome\":\"Typed content-package schema and validator cover IDs, references, locale keys, assets, predicates, rewards, and reachability but contain no authored campaign expression.\",\"prerequisites\":[\"IMP-0001\",\"IMP-0004\",\"IMP-0003\"],\"ownership\":{\"files\":[\"src/content/{schema,validator,registry}/\",\"tests/content/validation.*\",\"docs/content-authoring.md\"],\"data\":[\"versioned content package format\",\"asset/provenance manifest schema\"],\"api\":[\"content registry and validator API\"]},\"forbidden_scope\":[\"town/dungeon dialogue/maps/assets\",\"copied reference expression\",\"release packaging\"],\"verification\":\"Valid minimum package passes; each invalid reference class fails; a graph fixture checks opening-to-ending reachability.\",\"human_external_gate\":\"GATE-0004 for quantities, locale, and content detail; human provenance review remains required.\",\"complexity\":\"high\",\"status\":\"current\"},\n    {\"id\":\"IMP-0006\",\"title\":\"Specify local save and recovery protocol\",\"domain\":\"persistence\",\"targets\":[\"shared\",\"web\",\"pwa\"],\"requirement_ids\":[\"REQ-0006\",\"REQ-0012\",\"NFR-0002\",\"NFR-0003\",\"NFR-0005\"],\"bounded_outcome\":\"A schema protocol specifies immutable revisions, checksums, current-pointer validation, known-good retention, quarantine, separate preferences, deletion confirmation, and safe-boundary persistence rules.\",\"prerequisites\":[\"IMP-0002\",\"IMP-0004\",\"IMP-0003\"],\"ownership\":{\"files\":[\"src/core/save/{schema,compatibility,migrations}/\",\"src/platform/web/persistence/\",\"tests/{core,platform}/save*\",\"docs/save-and-recovery.md\"],\"data\":[\"save snapshot and preference schemas\",\"quarantine record\"],\"api\":[\"snapshot repository and recovery protocol\"]},\"forbidden_scope\":[\"cloud sync\",\"identity\",\"PWA cache records\",\"eviction guarantee\"],\"verification\":\"Fault fixtures cover interrupted write, checksum failure, malformed data, quota/permission failure, quarantine, retry, and selected-slot deletion.\",\"human_external_gate\":\"GATE-0003 / DEC-0003 storage API, quota, support window, and recovery policy.\",\"complexity\":\"high\",\"status\":\"gated\"},\n    {\"id\":\"IMP-0007\",\"title\":\"Define pure save migration runner\",\"domain\":\"persistence\",\"targets\":[\"shared\",\"web\",\"pwa\"],\"requirement_ids\":[\"REQ-0006\",\"NFR-0002\",\"NFR-0003\"],\"bounded_outcome\":\"Ordered, pure migrations declare supported versions and promote only validated candidates while preserving original invalid bytes for quarantine.\",\"prerequisites\":[\"IMP-0005\",\"IMP-0006\"],\"ownership\":{\"files\":[\"src/core/save/{migrations,compatibility}/\",\"tests/core/save/fixtures\"],\"data\":[\"migration registry and predecessor fixtures\"],\"api\":[\"migration runner API\"]},\"forbidden_scope\":[\"storage driver changes\",\"future data export\",\"automatic destructive repair\"],\"verification\":\"Every declared predecessor migrates once; unsupported or failed migration leaves the original candidate intact and quarantined.\",\"human_external_gate\":\"GATE-0003 / DEC-0003 support-window approval.\",\"complexity\":\"medium\",\"status\":\"gated\"},\n    {\"id\":\"IMP-0008\",\"title\":\"Bound P0 identity, authorization, and connected-service exclusions\",\"domain\":\"security\",\"targets\":[\"shared\",\"web\",\"pwa\"],\"requirement_ids\":[\"REQ-0013\",\"REQ-0014\",\"REQ-0015\",\"NFR-0012\"],\"bounded_outcome\":\"Architecture and negative contract tests demonstrate that local campaign start/save/resume require no account identifier, token, remote profile, role, entitlement, multiplayer, or safety service.\",\"prerequisites\":[\"IMP-0002\",\"IMP-0004\"],\"ownership\":{\"files\":[\"docs/security-boundary.md\",\"tests/core/connected-scope-exclusion.*\"],\"data\":[\"future connected-service approval checklist\"],\"api\":[\"local-slot identity contract\"]},\"forbidden_scope\":[\"sign-in\",\"OAuth\",\"sync\",\"roles\",\"moderation\",\"purchases\",\"server APIs\"],\"verification\":\"Static scan and negative fixtures find no identity/token/privilege fields or network client in P0 foundation modules.\",\"human_external_gate\":\"GATE-0006 / DEC-0006 before any connected implementation.\",\"complexity\":\"low\",\"status\":\"current\"},\n    {\"id\":\"IMP-0009\",\"title\":\"Define privacy-safe local diagnostics boundary\",\"domain\":\"privacy\",\"targets\":[\"web\",\"pwa\"],\"requirement_ids\":[\"REQ-0012\",\"NFR-0006\"],\"bounded_outcome\":\"A bounded local diagnostic schema, consent and clear controls, redaction rules, and no-network guardrails support future player recovery without collecting save or dialogue payloads.\",\"prerequisites\":[\"IMP-0002\",\"IMP-0003\",\"IMP-0006\"],\"ownership\":{\"files\":[\"src/platform/web/diagnostics/\",\"src/app/recovery/diagnostic-contract.*\",\"tests/platform/diagnostics.*\",\"docs/privacy-and-recovery.md\"],\"data\":[\"redacted local diagnostic record\",\"consent state\"],\"api\":[\"diagnostic recorder interface\"]},\"forbidden_scope\":[\"diagnostic provider/transport\",\"remote analytics\",\"retention promise\",\"secrets\"],\"verification\":\"Tests prove diagnostics are absent without consent, redact payloads, and can be deleted locally.\",\"human_external_gate\":\"GATE-0005 / DEC-0005 before transport, retention, hosting, or support claims.\",\"complexity\":\"medium\",\"status\":\"gated\"},\n    {\"id\":\"IMP-0010\",\"title\":\"Establish semantic accessibility design tokens\",\"domain\":\"accessibility\",\"targets\":[\"shared\",\"web\",\"pwa\"],\"requirement_ids\":[\"REQ-0007\",\"REQ-0010\",\"NFR-0004\",\"NFR-0008\"],\"bounded_outcome\":\"Original semantic tokens cover typography, spacing, focus, motion, touch targets, status, contrast, and non-colour cues, enabling later responsive web UI and inherited PWA UI.\",\"prerequisites\":[\"IMP-0001\",\"IMP-0002\"],\"ownership\":{\"files\":[\"src/app/design/tokens/\",\"docs/design-tokens.md\",\"tests/app/design-tokens.*\"],\"data\":[\"semantic token inventory\"],\"api\":[\"token consumption contract\"]},\"forbidden_scope\":[\"screens\",\"maps\",\"final artwork/fonts\",\"final breakpoints\",\"copied reference styling\"],\"verification\":\"Token validation proves semantic labels/non-colour cues and reduced-motion values in representative fixtures.\",\"human_external_gate\":\"GATE-0002 and GATE-0004 before numeric contrast/font/breakpoint claims.\",\"complexity\":\"medium\",\"status\":\"gated\"},\n    {\"id\":\"IMP-0011\",\"title\":\"Create original-content provenance control\",\"domain\":\"content\",\"targets\":[\"shared\"],\"requirement_ids\":[\"REQ-0001\",\"REQ-0008\",\"NFR-0008\"],\"bounded_outcome\":\"A provenance record format, review checklist, and source-asset manifest make authorship and permitted functional reference scope auditable before authored content enters a build.\",\"prerequisites\":[\"IMP-0005\"],\"ownership\":{\"files\":[\"assets/source-manifest.*\",\"docs/original-content-review.md\",\"tests/content/provenance.*\"],\"data\":[\"provenance manifest and review disposition\"],\"api\":[\"provenance validator input contract\"]},\"forbidden_scope\":[\"creating art/audio/story\",\"licensing approval\",\"automatic legal clearance\"],\"verification\":\"Validator rejects missing provenance fields; human creative review is recorded for each authored package.\",\"human_external_gate\":\"Human creative/provenance review; legal or licensing review if applicable under GATE-0007.\",\"complexity\":\"low\",\"status\":\"current\"},\n    {\"id\":\"IMP-0012\",\"title\":\"Document foundation architecture and recovery boundaries\",\"domain\":\"documentation\",\"targets\":[\"shared\",\"web\",\"pwa\"],\"requirement_ids\":[\"NFR-0012\",\"NFR-0010\",\"NFR-0002\",\"NFR-0003\"],\"bounded_outcome\":\"Developer documentation records ownership, command flow, save-versus-cache separation, deferred connected scope, and the decisions/gates that later domain authors must preserve.\",\"prerequisites\":[\"IMP-0002\",\"IMP-0004\",\"IMP-0006\",\"IMP-0008\"],\"ownership\":{\"files\":[\"docs/{architecture,development,save-and-recovery,security-boundary}.md\"],\"data\":[\"foundation decision and ownership index\"],\"api\":[\"documented public-boundary inventory\"]},\"forbidden_scope\":[\"player release guide\",\"operational rollout\",\"claiming approved vendor or policy choices\"],\"verification\":\"Documentation review cross-checks every foundation contract's ownership, dependency, and gate against this catalogue.\",\"human_external_gate\":\"None; approval gates are documented, not resolved.\",\"complexity\":\"low\",\"status\":\"current\"}\n  ],\n  \"expansion_queue\": [\n    {\"id\":\"SHARD-02\",\"title\":\"Campaign content and domain logic\",\"max_contracts\":250,\"depends_on\":[\"SHARD-01\"],\"covers\":[\"exploration\",\"dialogue\",\"quests\",\"tutorial\",\"combat\",\"inventory\",\"party progression\",\"town/dungeon/ending content\",\"content validation\"],\"requirement_ids\":[\"REQ-0001\",\"REQ-0002\",\"REQ-0003\",\"REQ-0004\",\"REQ-0005\",\"REQ-0008\",\"NFR-0007\",\"NFR-0008\"],\"gate\":\"GATE-0004\",\"target_allocation\":\"shared core and content only; no UI ownership\",\"state\":\"queued\"},\n    {\"id\":\"SHARD-03\",\"title\":\"Session, UI, input, and accessibility\",\"max_contracts\":250,\"depends_on\":[\"SHARD-01\",\"SHARD-02\"],\"covers\":[\"session/checkpoints\",\"semantic responsive shell\",\"game panels\",\"keyboard/mouse/touch/gamepad adapters\",\"settings\",\"localisation\",\"captions\",\"feedback\",\"error recovery UI\",\"accessibility tests\"],\"requirement_ids\":[\"REQ-0005\",\"REQ-0006\",\"REQ-0007\",\"REQ-0009\",\"REQ-0010\",\"REQ-0012\",\"NFR-0002\",\"NFR-0003\",\"NFR-0004\",\"NFR-0005\"],\"gate\":\"GATE-0002,GATE-0003,GATE-0004\",\"target_allocation\":\"shared UI model; web input/layout adapter; PWA inherits UI with no separate UI fork\",\"state\":\"queued\"},\n    {\"id\":\"SHARD-04\",\"title\":\"PWA delivery, performance, operations, and release evidence\",\"max_contracts\":250,\"depends_on\":[\"SHARD-01\",\"SHARD-02\",\"SHARD-03\"],\"covers\":[\"PWA manifest/install\",\"service-worker cache lifecycle\",\"offline/update recovery\",\"performance measurement\",\"security headers\",\"release checks\",\"observability\",\"quality automation\",\"player/operator documentation\",\"platform certification assessment\"],\"requirement_ids\":[\"REQ-0011\",\"REQ-0012\",\"NFR-0001\",\"NFR-0003\",\"NFR-0006\",\"NFR-0009\",\"NFR-0011\",\"NFR-0012\"],\"gate\":\"GATE-0002,GATE-0005,GATE-0007\",\"target_allocation\":\"web release build and PWA service-worker/install adapter are distinct; shared core owns neither cache nor hosting\",\"state\":\"queued\"},\n    {\"id\":\"SHARD-05\",\"title\":\"Connected-scope decision package\",\"max_contracts\":250,\"depends_on\":[\"SHARD-01\"],\"covers\":[\"identity/sync conflict policy\",\"multiplayer/player safety\",\"live operations\",\"commerce/entitlements\"],\"requirement_ids\":[\"REQ-0014\",\"REQ-0015\"],\"gate\":\"GATE-0006\",\"target_allocation\":\"no P0 target implementation; research/decision outputs only if explicitly authorised\",\"state\":\"hold\"}\n  ],\n  \"requirement_coverage\": {\n    \"REQ-0001\":\"queued: SHARD-02; provenance foundation IMP-0011\",\"REQ-0002\":\"queued: SHARD-02\",\"REQ-0003\":\"queued: SHARD-02\",\"REQ-0004\":\"queued: SHARD-02\",\"REQ-0005\":\"queued: SHARD-02 and SHARD-03\",\"REQ-0006\":\"current/gated: IMP-0006, IMP-0007; queued: SHARD-03\",\"REQ-0007\":\"current/gated: IMP-0010; queued: SHARD-03\",\"REQ-0008\":\"current: IMP-0005, IMP-0011; queued: SHARD-02\",\"REQ-0009\":\"queued: SHARD-03\",\"REQ-0010\":\"current/gated: IMP-0010; queued: SHARD-03\",\"REQ-0011\":\"queued: SHARD-04\",\"REQ-0012\":\"current/gated: IMP-0006, IMP-0009; queued: SHARD-03 and SHARD-04\",\"REQ-0013\":\"current: IMP-0002, IMP-0008\",\"REQ-0014\":\"gated: SHARD-05 / GATE-0006; no P0 implementation\",\"REQ-0015\":\"hold: SHARD-05 / GATE-0006; no P0 implementation\",\"NFR-0001\":\"queued: SHARD-04\",\"NFR-0002\":\"current/gated: IMP-0004, IMP-0006, IMP-0007\",\"NFR-0003\":\"current/gated: IMP-0006, IMP-0007; queued: SHARD-04\",\"NFR-0004\":\"current/gated: IMP-0010; queued: SHARD-03\",\"NFR-0005\":\"current/gated: IMP-0006; queued: SHARD-03\",\"NFR-0006\":\"current/gated: IMP-0009; queued: SHARD-04\",\"NFR-0007\":\"current: IMP-0005; queued: SHARD-02\",\"NFR-0008\":\"current: IMP-0005, IMP-0010, IMP-0011; queued: SHARD-02\",\"NFR-0009\":\"gated: SHARD-04 / GATE-0002\",\"NFR-0010\":\"current: IMP-0001, IMP-0002, IMP-0003, IMP-0004; queued target adapters in SHARD-03 and SHARD-04\",\"NFR-0011\":\"gated: SHARD-04 / GATE-0005\",\"NFR-0012\":\"current/gated: IMP-0001, IMP-0002, IMP-0003, IMP-0008, IMP-0012; queued: SHARD-04\"\n  },\n  \"dependency_graph\": {\"nodes\":[\"IMP-0001\",\"IMP-0002\",\"IMP-0003\",\"IMP-0004\",\"IMP-0005\",\"IMP-0006\",\"IMP-0007\",\"IMP-0008\",\"IMP-0009\",\"IMP-0010\",\"IMP-0011\",\"IMP-0012\"],\"acyclic\":true,\"validation\":\"Each prerequisite points only to an earlier numbered contract; SHARD dependencies only point from later shards to earlier shards.\"}\n}\n"}]}}
[stdout] {"type":"user","uuid":"c8ff1fb1-6d90-44f9-9bf2-a141d4ba61b1","session_id":"99a15d88-e19e-4b39-ac15-1dd02ec31ec1","parent_tool_use_id":null,"message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call_co7puxjm","is_error":false,"content":"{\n  \"manifest_id\": \"mock-fantasy-quest-4-runbook-authoring-ledger\",\n  \"version\": 1,\n  \"purpose\": \"Persistent, append-only allocation ledger for bounded B-series authoring batches and immutable R-series implementation contracts. It allocates the current catalogue only; queued shards remain expansion work.\",\n  \"project_slug\": \"mock-fantasy-quest-4\",\n  \"source_catalogue\": \"planning/implementation-catalogue-index.json\",\n  \"expected_runbook_count\": 12,\n  \"id_counters\": {\"next_authoring_batch_id\": \"B0007\", \"next_implementation_runbook_id\": \"R0013\", \"rule\": \"Never reuse, renumber, or replace an accepted B or R ID. Append new allocations using these counters only.\"},\n  \"wave\": {\"number\": 1, \"state\": \"planned\", \"checkpoint_after_each_batch\": true, \"resume_from\": \"first batch whose state is not accepted; validate accepted IDs, paths, and provenance before dispatch\", \"recovery\": \"If a batch fails, retain its IDs, mark it blocked or repairable, repair only its listed output paths, validate its contracts, then resume that same batch. Do not reallocate its R IDs.\"},\n  \"catalogue_disposition\": {\"allocated\": [\"IMP-0001\",\"IMP-0002\",\"IMP-0003\",\"IMP-0004\",\"IMP-0005\",\"IMP-0006\",\"IMP-0007\",\"IMP-0008\",\"IMP-0009\",\"IMP-0010\",\"IMP-0011\",\"IMP-0012\"], \"deferred\": [], \"human_gates_retained\": {\"IMP-0001\":\"GATE-0001\", \"IMP-0006\":\"GATE-0003\", \"IMP-0007\":\"GATE-0003\", \"IMP-0009\":\"GATE-0005\", \"IMP-0010\":\"GATE-0002,GATE-0004\"}},\n  \"queued_expansion\": [\n    {\"chapter\":\"SHARD-02\",\"title\":\"Campaign content and domain logic\",\"depends_on\":[\"SHARD-01\"],\"state\":\"queued\",\"future_wave\":\"wave 2 after GATE-0004\",\"allocation_rule\":\"expand into bounded IMP records before assigning any R IDs\"},\n    {\"chapter\":\"SHARD-03\",\"title\":\"Session, UI, input, and accessibility\",\"depends_on\":[\"SHARD-01\",\"SHARD-02\"],\"state\":\"queued\",\"future_wave\":\"wave 3 after GATE-0002,GATE-0003,GATE-0004\",\"allocation_rule\":\"expand after its predecessor shards; preserve shared UI and web-adapter ownership\"},\n    {\"chapter\":\"SHARD-04\",\"title\":\"PWA delivery, performance, operations, and release evidence\",\"depends_on\":[\"SHARD-01\",\"SHARD-02\",\"SHARD-03\"],\"state\":\"queued\",\"future_wave\":\"wave 4 after GATE-0002,GATE-0005,GATE-0007\",\"allocation_rule\":\"expand only after the session/UI and campaign contracts exist\"},\n    {\"chapter\":\"SHARD-05\",\"title\":\"Connected-scope decision package\",\"depends_on\":[\"SHARD-01\"],\"state\":\"hold\",\"future_wave\":\"only if explicitly authorised after GATE-0006\",\"allocation_rule\":\"no P0 implementation R contracts\"}\n  ],\n  \"context_packet_baseline\": {\n    \"terminology\": [\"B-series = authoring runbook\", \"R-series = generated implementation runbook\", \"IMP-series = catalogue contract\", \"shared core\", \"web adapter\", \"PWA delivery adapter\", \"local save\", \"cache\", \"human gate\"],\n    \"target_constraints\": [\"original offline-capable 2D single-player RPG\", \"responsive web and installable PWA\", \"keyboard/mouse/touch/gamepad\", \"no accounts, sync, multiplayer, purchases, or network services in P0\", \"shared core must not import platform/render/network modules\", \"PWA cache and save data remain separate\"],\n    \"required_templates\": [\"runbooks/TEMPLATE.md\", \"runbooks/F014.md provenance and asset-assessment requirements\"],\n    \"authoring_rules\": [\"write only assigned paths\", \"preserve gates and unanswered questions\", \"do not create incidental assets when asset_impact is not_applicable\", \"perform structural, not product-release, validation\"]\n  },\n  \"batches\": [\n    {\"id\":\"B0001\",\"order\":1,\"title\":\"Bootstrap decision-gated foundation\",\"state\":\"blocked_on_gate\",\"parallel_with\":[],\"preceding_decision\":\"GATE-0001 / DEC-0001 framework, package manager, and CI selection\",\"r_contract_ids\":[\"R0001\"],\"context_packet\":{\"specification\":[\"specification/01-product-brief.md#release-definition\",\"specification/03-technical-contract.md#architecture-and-requirement-traceability\",\"specification/platform-appendix.md\"],\"catalogue_records\":[\"IMP-0001\"]},\"checkpoint\":\"validate R0001 metadata and output ownership, record gate disposition, then checkpoint wave\",\"recovery\":\"keep R0001 reserved; after the gate, rerun B0001 only\",\"acceptance_checks\":[\"one bounded R runbook\",\"gate is explicit\",\"baseline command and ownership evidence are specified\"]},\n    {\"id\":\"B0002\",\"order\":2,\"title\":\"Shared seams, deterministic harness, and token contract\",\"state\":\"planned\",\"depends_on_batches\":[\"B0001\"],\"parallel_with\":[],\"preceding_decision\":\"B0001 accepted; R0012's visual-token portion remains blocked by GATE-0002,GATE-0004\",\"r_contract_ids\":[\"R0002\",\"R0003\",\"R0010\"],\"context_packet\":{\"specification\":[\"specification/03-technical-contract.md#architecture-and-requirement-traceability\",\"specification/03-technical-contract.md#commands-validation-idempotency-and-concurrency\",\"specification/04-experience-contract.md#layout-visual-tokens-and-responsive-behaviour\",\"specification/04-experience-contract.md#accessibility-policy\"],\"catalogue_records\":[\"IMP-0002\",\"IMP-0003\",\"IMP-0010\"]},\"checkpoint\":\"validate the three contracts and record any gate-blocked subwork\",\"recovery\":\"repair only R0002,R0003,R0010; never split or renumber accepted contracts\",\"acceptance_checks\":[\"core/adapter seam precedes feature work\",\"fixture and token outputs have distinct ownership\",\"all gates retained\"]},\n    {\"id\":\"B0003\",\"order\":3,\"title\":\"Deterministic state slice and