 fixture\"],\"checkpoint_cadence\":\"after metadata, after draft, before manifest acceptance\",\"recovery\":\"retain ID and repair only this contract\"},\n    {\"id\":\"R0006\",\"catalogue_id\":\"IMP-0006\",\"title\":\"Specify local save and recovery protocol\",\"dependencies\":[\"R0002\",\"R0003\",\"R0004\"],\"output_path\":\"projects/mock-fantasy-quest-4/runbooks/R0006.md\",\"source_specifications\":[\"specification/03-technical-contract.md#persistence-migration-and-failure-semantics\",\"specification/04-experience-contract.md#empty-error-recovery-destructive-and-privacy-sensitive-states\"],\"source_catalogue_ids\":[\"IMP-0006\"],\"authoring_batch\":\"B0004\",\"factory_stages\":[\"F011\",\"F012\",\"F013\"],\"asset_impact\":\"not_applicable\",\"asset_ids\":[],\"asset_brief\":\"No assets; protocol is data/recovery only.\",\"acceptance_checks\":[\"fault fixtures cover write and validation failures\",\"save/cache separation\",\"GATE-0003 retained\"],\"checkpoint_cadence\":\"after metadata, after draft, before manifest acceptance\",\"recovery\":\"retain ID; wait for storage decision before accepting gated work\"},\n    {\"id\":\"R0007\",\"catalogue_id\":\"IMP-0007\",\"title\":\"Define pure save migration runner\",\"dependencies\":[\"R0005\",\"R0006\"],\"output_path\":\"projects/mock-fantasy-quest-4/runbooks/R0007.md\",\"source_specifications\":[\"specification/03-technical-contract.md#persistence-migration-and-failure-semantics\"],\"source_catalogue_ids\":[\"IMP-0007\"],\"authoring_batch\":\"B0005\",\"factory_stages\":[\"F011\",\"F012\",\"F013\"],\"asset_impact\":\"not_applicable\",\"asset_ids\":[],\"asset_brief\":\"No assets; migration fixtures retain original bytes only.\",\"acceptance_checks\":[\"predecessors migrate once\",\"failed candidate remains intact\",\"GATE-0003 retained\"],\"checkpoint_cadence\":\"after metadata, after draft, before manifest acceptance\",\"recovery\":\"retain ID and resume after R0006/gate closure\"},\n    {\"id\":\"R0008\",\"catalogue_id\