\"Foundation and core contracts\", \"contract_limit\": 250, \"contract_count\": 12, \"state\": \"ready_for_authoring\", \"boundary\": \"Framework-neutral seams, deterministic state/data contracts, local persistence protocol, quality foundations, and original-design controls; excludes campaign rules, UI flows, PWA lifecycle, and release execution.\"},\n  \"contracts\": [\n    {\"id\":\"IMP-0001\",\"title\":\"Bootstrap reproducible shared project baseline\",\"domain\":\"foundation\",\"targets\":[\"shared\",\"web\",\"pwa\"],\"requirement_ids\":[\"NFR-0010\",\"NFR-0012\"],\"bounded_outcome\":\"A framework-neutral project skeleton documents one bootstrap, lint, format, and deterministic test command with isolated shared, web-adapter, PWA-adapter, content, and test directories.\",\"prerequisites\":[],\"ownership\":{\"files\":[\"root build/tooling configuration\",\"src/{core,content,app,platform/web,platform/pwa}/\",\"tests/\",\"docs/development.md\"],\"data\":[\"pinned toolchain declaration\"],\"api\":[\"build/test command interface\"]},\"forbidden_scope\":[\"selecting framework/package manager/CI without DEC-0001\",\"gameplay\",\"service worker\",\"hosting\"],\"verification\":\"Clean approved-runtime checkout runs the documented deterministic sample test, lint, and format checks.\",\"human_external_gate\":\"GATE-0001 / DEC-0001 framework, package-manager, and CI selection before implementation.\",\"complexity\":\"medium\",\"status\":\"gated\"},\n    {\"id\":\"IMP-0002\",\"title\":\"Enforce shared-core and adapter dependency seams\",\"domain\":\"foundation\",\"targets\":[\"shared\",\"web\",\"pwa\"],\"requirement_ids\":[\"NFR-0010\",\"REQ-0013\",\"NFR-0012\"],\"bounded_outcome\":\"A dependency policy and public interfaces prevent core code from importing browser, renderer, clock, network, or platform modules; adapters submit commands and render returned state/events.\",\"prerequisites\":[\"IMP-0001\"],\"ownership\":{\"files\":[\"src/core/public interfaces\",\"src/platform/{web,pwa}/adapter interfaces\",\"architecture dependency rules\",\"docs/architecture.md\"],\"data\":[\"dependency-policy manifest\"],\"api\":[\"Command, state, event, and adapter interfaces\"]},\"forbidden_scope\":[\"concrete combat/exploration/UI\",\"account or network client\",\"target-specific campaign rules\"],\"verification\":\"A dependency-rule test rejects forbidden core imports and a fixture adapter proves command-only interaction.\",\"human_external_gate\":\"None; retain GATE-0001 for tool-specific enforcement.\",\"complexity\":\"medium\",\"status\":\"current\"},\n    {\"id\":\"IMP-0003\",\"title\":\"Create deterministic test and fixture harness\",\"domain\":\"tests\",\"targets\":[\"shared\",\"web\",\"pwa\"],\"requirement_ids\":[\"NFR-0010\",\"NFR-0012\"],\"bounded_outcome\":\"Layered unit, content, integration, and reserved browser-test conventions provide isolated RNG/clock and persistence fixtures with no real service or player data access.\",\"prerequisites\":[\"IMP-0001\",\"IMP-0002\"],\"ownership\":{\"files\":[\"test-runner configuration\",\"tests/{core,content,platform,app}/fixtures\",\"docs/testing.md\"],\"data\":[\"deterministic fixture factories\"],\"api\":[\"test fixture and fake clock/RNG interfaces\"]},\"forbidden_scope\":[\"final feature assertions\",\"real browser/device matrix claims\",\"production telemetry\"],\"verification\":\"Repeated core fixture execution has identical results; a deliberately failing fixture is detected; fixture storage is isolated.\",\"human_external_gate\":\"GATE-0002 before compatibility or performance claims.\",\"complexity\":\"medium\",\"status\":\"current\"},\n    {\"id\":\"IMP-0004\",\"title\":\"Define deterministic campaign state and command contract\",\"domain\":\"data\",\"targets\":[\"shared\"],\"requirement_ids\":[\"REQ-0001\",\"REQ-0003\",\"REQ-0004\",\"REQ-0006\",\"NFR-0002\",\"NFR-0010\"],\"bounded_outcome\":\"Immutable versioned state, command/result/event envelopes, revision and interaction identifiers,