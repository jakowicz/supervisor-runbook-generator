content-package and provenance assembly\",\"domain\":\"content\",\"targets\":[\"shared\"],\"requirement_ids\":[\"REQ-0001\",\"REQ-0002\",\"REQ-0008\",\"NFR-0007\",\"NFR-0008\"],\"bounded_outcome\":\"A versioned package assembles the one-town/one-dungeon campaign using original assets and auditable provenance, without creating those assets in authoring.\",\"prerequisites\":[\"IMP-0005\",\"IMP-0011\",\"IMP-0013\",\"IMP-0014\",\"IMP-0015\",\"IMP-0016\"],\"ownership\":{\"files\":[\"content/campaign/\",\"assets/source-manifest.*\",\"tests/content/campaign*\"],\"data\":[\"campaign package and provenance manifest\"],\"api\":[\"content package loader\"]},\"forbidden_scope\":[\"copied expression\",\"licensing approval\",\"new regions\"],\"verification\":\"Validator resolves references and rejects absent provenance.\",\"human_external_gate\":\"GATE-0004 and human creative/provenance review before implementation.\",\"complexity\":\"high\",\"status\":\"ready_for_authoring\"},\n    {\"id\":\"IMP-0019\",\"title\":\"Add campaign domain invariant and negative-fixture coverage\",\"domain\":\"tests\",\"targets\":[\"shared\"],\"requirement_ids\":[\"REQ-0002\",\"REQ-0003\",\"REQ-0004\",\"NFR-0007\"],\"bounded_outcome\":\"Deterministic fixtures cover invalid campaign references, blocked routes, stale commands, and duplicate grants across SHARD-02.\",\"prerequisites\":[\"IMP-0013\",\"IMP-0014\",\"IMP-0015\",\"IMP-0016\"],\"ownership\":{\"files\":[\"tests/core/campaign/fixtures/\",\"tests/core/campaign/invariants*\"],\"data\":[\"negative campaign fixtures\"],\"api\":[\"fixture builders\"]},\"forbidden_scope\":[\"real player data\",\"browser matrix\",\"product assets\"],\"verification\":\"Every fixture is deterministic and each invalid case is detected.\",\"human_external_gate\":\"GATE-0004 retained for concrete content assumptions.\",\"complexity\":\"medium\",\"status\":\"ready_for_authoring\"},\n    {\"id\":\"IMP-0020\",\"title\":\"Document SHARD-02 ownership, gates, and handoff boundari