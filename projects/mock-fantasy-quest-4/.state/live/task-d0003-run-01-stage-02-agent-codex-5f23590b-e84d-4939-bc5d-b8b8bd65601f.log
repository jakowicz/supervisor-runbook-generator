cache refresh\",\"new save schema\",\"network services\"],\"verification\":\"Deterministic tests prove focus loss pauses safely and unconfirmed saves never present as confirmed.\",\"human_external_gate\":\"GATE-0003 and GATE-0004 remain implementation gates for storage and concrete campaign assumptions.\",\"complexity\":\"medium\",\"status\":\"ready_for_authoring\"},\n+    {\"id\":\"IMP-0022\",\"title\":\"Define semantic responsive game-shell and navigation contract\",\"domain\":\"ui\",\"targets\":[\"web\",\"pwa\"],\"requirement_ids\":[\"REQ-0007\",\"REQ-0009\",\"REQ-0010\",\"NFR-0004\"],\"bounded_outcome\":\"A semantic shell specifies title, main controls, status, panels, dialogs, visible focus, reflow, and non-colour cues around the shared game state without a PWA-specific UI fork.\",\"prerequisites\":[\"IMP-0010\",\"IMP-0021\"],\"ownership\":{\"files\":[\"src/app/shell/\",\"src/platform/web/layout/\",\"tests/app/shell/\"],\"data\":[\"semantic navigation and viewport profiles\"],\"api\":[\"panel and focus routing API\"]},\"forbidden_scope\":[\"final art/fonts\",\"fixed supported-device claims\",\"service worker\",\"duplicated PWA UI\"],\"verification\":\"Representative fixtures retain labelled controls and legal focus order through resize and panel changes.\",\"human_external_gate\":\"GATE-0002 and GATE-0004 remain explicit for numeric thresholds and final content/layout choices.\",\"complexity\":\"high\",\"status\":\"ready_for_authoring\"},\n+    {\"id\":\"IMP-0023\",\"title\":\"Map semantic actions across keyboard, pointer, touch, and gamepad\",\"domain\":\"input\",\"targets\":[\"web\",\"pwa\"],\"requirement_ids\":[\"REQ-0005\",\"REQ-0009\",\"NFR-0004\"],\"bounded_outcome\":\"One action vocabulary maps movement, inspect, confirm, cancel, pause, panels, and legal combat choices across supported inputs with safe repeat and disconnect handling.\",\"prerequisites\":[\"IMP-0002\",\"IMP-0021\",\"IMP-0022\"],\"ownership\":{\"files\":[\"src/platform/web/input/\",\"src/a