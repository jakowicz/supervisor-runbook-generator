al project skeleton documents one bootstrap, lint, format, and deterministic test command with isolated shared, web-adapter, PWA-adapter, content, and test directories.\",\n    \"prerequisites\": [],\n    \"ownership\": {\n      \"files\": [\n        \"root build/tooling configuration\",\n        \"src/{core,content,app,platform/web,platform/pwa}/\",\n        \"tests/\",\n        \"docs/development.md\"\n      ],\n      \"data\": [\n        \"pinned toolchain declaration\"\n      ],\n      \"api\": [\n        \"build/test command interface\"\n      ]\n    },\n    \"forbidden_scope\": [\n      \"selecting framework/package manager/CI without DEC-0001\",\n      \"gameplay\",\n      \"service worker\",\n      \"hosting\"\n    ],\n    \"verification\": \"Clean approved-runtime checkout runs the documented deterministic sample test, lint, and format checks.\",\n    \"human_external_gate\": \"GATE-0001 / DEC-0001 framework, package-manager, and CI selection before implementation.\",\n    \"complexity\": \"medium\",\n    \"status\": \"gated\"\n  },\n  {\n    \"id\": \"IMP-0002\",\n    \"title\": \"Enforce shared-core and adapter dependency seams\",\n    \"domain\": \"foundation\",\n    \"targets\": [\n      \"shared\",\n      \"web\",\n      \"pwa\"\n    ],\n    \"requirement_ids\": [\n      \"NFR-0010\",\n      \"REQ-0013\",\n      \"NFR-0012\"\n    ],\n    \"bounded_outcome\": \"A dependency policy and public interfaces prevent core code from importing browser, renderer, clock, network, or platform modules; adapters submit commands and render returned state/events.\",\n    \"prerequisites\": [\n      \"IMP-0001\"\n    ],\n    \"ownership\": {\n      \"files\": [\n        \"src/core/public interfaces\",\n        \"src/platform/{web,pwa}/adapter interfaces\",\n        \"architecture dependency rules\",\n        \"docs/architecture.md\"\n      ],\n      \"data\": [\n        \"dependency-policy manifest\"\n      ],\n      \"api\": [\n        \"Command, state, event, and adap