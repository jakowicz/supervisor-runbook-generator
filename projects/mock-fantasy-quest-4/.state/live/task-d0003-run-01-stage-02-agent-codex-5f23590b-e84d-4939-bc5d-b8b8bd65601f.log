[stderr] """Load one scoped Markdown runbook into the supervisor task contract."""
[stderr] 
[stderr] from __future__ import annotations
[stderr] 
[stderr] import re
[stderr] from pathlib import Path
[stderr] 
[stderr] from .models import Task
[stderr] 
[stderr] 
[stderr] def _section(document: str, heading: str) -> str:
[stderr]     match = re.search(rf"^## {re.escape(heading)}\s*$\n(.*?)(?=^## |\Z)", document, re.MULTILINE | re.DOTALL)
[stderr]     if not match:
[stderr]         raise ValueError(f"Runbook is missing a ## {heading} section.")
[stderr]     return match.group(1).strip()
[stderr] 
[stderr] 
[stderr] def load_task(path: Path) -> Task:
[stderr]     """Parse the deliberately small runbook format and its execution gates."""
[stderr] 
[stderr]     document = path.read_text(encoding="utf-8")
[stderr]     metadata_match = re.match(r"^---\n(.*?)\n---\n", document, re.DOTALL)
[stderr]     if not metadata_match:
[stderr]         raise ValueError(f"{path} must start with YAML-style metadata.")
[stderr]     metadata: dict[str, str] = {}
[stderr]     for line in metadata_match.group(1).splitlines():
[stderr]         key, separator, value = line.partition(":")
[stderr]         if not separator:
[stderr]             raise ValueError(f"Invalid runbook metadata line: {line}")
[stderr]         metadata[key.strip()] = value.strip()
[stderr]     required = {"task_id", "sequence", "title", "browser_impact", "playwright_spec"}
[stderr]     missing = required - metadata.keys()
[stderr]     if missing:
[stderr]         raise ValueError(f"{path} is missing metadata: {', '.join(sorted(missing))}")
[stderr]     is_r_series = re.fullmatch(r"R\d+", metadata["task_id"]) is not None
[stderr]     if is_r_series:
[stderr]         dependencies = [value.strip() for value in metadata.get("dependencies", "").split(",") if value.strip()]
[stderr]         if len(dependencies) != len(set(dependencies)) or any(not re.fullmatch(r"R\d+", dependency) for dependency in dependencies):
[stderr]             raise ValueError(f"{path} has invalid dependencies; use comma-separated R-series IDs.")
[stderr]         if metadata["task_id"] in dependencies:
[stderr]             raise ValueError(f"{path} cannot depend on itself.")
[stderr]         provenance_metadata = {"source_specifications", "source_catalogue_ids", "authoring_batch", "factory_stages"}
[stderr]         missing_provenance_metadata = provenance_metadata - metadata.keys()
[stderr]         if missing_provenance_metadata:
[stderr]             raise ValueError(
[stderr]                 f"{path} is an R-series runbook and must declare provenance metadata: "
[stderr]                 f"{', '.join(sorted(missing_provenance_metadata))}"
[stderr]             )
[stderr]         source_specifications = [value.strip() for value in metadata["source_specifications"].split(",") if value.strip()]
[stderr]         source_catalogue_ids = [value.strip() for value in metadata["source_catalogue_ids"].split(",") if value.strip()]
[stderr]         factory_stages = [value.strip() for value in metadata["factory_stages"].split(",") if value.strip()]
[stderr]         if not source_specifications or not source_catalogue_ids or not factory_stages:
[stderr]             raise ValueError(f"{path} has incomplete R-series provenance metadata.")
[stderr]         if not re.fullmatch(r"B\d+", metadata["authoring_batch"]):
[stderr]             raise ValueError(f"{path} has invalid authoring_batch; use an ID such as B0001.")
[stderr]         if any(not re.fullmatch(r"F\d+", stage) for stage in factory_stages):
[stderr]             raise ValueError(f"{path} has invalid factory_stages; use comma-separated F-series IDs.")
[stderr]         asset_metadata = {"asset_impact", "asset_ids"}
[stderr]         missing_asset_metadata = asset_metadata - metadata.keys()
[stderr]         if missing_asset_metadata:
[stderr]             raise ValueError(
[stderr]                 f"{path} is an R-series runbook and must declare asset metadata: "
[stderr]                 f"{', '.join(sorted(missing_asset_metadata))}"
[stderr]             )
[stderr]         if metadata["asset_impact"] not in {"required", "not_applicable"}:
[stderr]             raise ValueError(f"{path} has invalid asset_impact; use required or not_applicable.")
[stderr]         declared_assets = [asset_id.strip() for asset_id in metadata["asset_ids"].split(",") if asset_id.strip()]
[stderr]         if metadata["asset_impact"] == "required" and not declared_assets:
[stderr]             raise ValueError(f"{path} requires assets but has no asset_ids.")
[stderr]         if metadata["asset_impact"] == "not_applicable" and declared_assets:
[stderr]             raise ValueError(f"{path} declares asset_ids but asset_impact is not_applicable.")
[stderr]         audio_metadata = {"audio_impact", "audio_ids", "audio_brief", "audio_duration_seconds", "audio_loop", "audio_style_version"}
[stderr]         missing_audio_metadata = audio_metadata - metadata.keys()
[stderr]         if missing_audio_metadata:
[stderr]             raise ValueError(
[stderr]                 f"{path} is an R-series runbook and must declare audio metadata: "
[stderr]                 f"{', '.join(sorted(missing_audio_metadata))}"
[stderr]             )
[stderr]         if metadata["audio_impact"] not in {"required", "not_applicable"}:
[stderr]             raise ValueError(f"{path} has invalid audio_impact; use required or not_applicable.")
[stderr]         declared_audio = [audio_id.strip() for audio_id in metadata["audio_ids"].split(",") if audio_id.strip()]
[stderr]         if metadata["audio_impact"] == "required":
[stderr]             if not declared_audio or not metadata["audio_brief"].strip():
[stderr]                 raise ValueError(f"{path} requires audio but has no audio_ids or audio_brief.")
[stderr]             try:
[stderr]                 duration = int(metadata["audio_duration_seconds"])
[stderr]             except ValueError as error:
[stderr]                 raise ValueError(f"{path} has invalid audio_duration_seconds.") from error
[stderr]             if duration < 1:
[stderr]                 raise ValueError(f"{path} requires audio_duration_seconds greater than zero.")
[stderr]             if metadata["audio_loop"] not in {"required", "not_required"}:
[stderr]                 raise ValueError(f"{path} has invalid audio_loop; use required or not_required.")
[stderr]         elif declared_audio or metadata["audio_brief"].strip() or metadata["audio_duration_seconds"].strip() not in {"", "0"} or metadata["audio_loop"] not in {"", "not_applicable"}:
[stderr]             raise ValueError(f"{path} declares audio fields but audio_impact is not_applicable.")
[stderr]     criteria: list[str] = []
[stderr]     current: list[str] = []
[stderr]     for line in _section(document, "Acceptance criteria").splitlines():
[stderr]         if line.startswith("- "):
[stderr]             if current:
[stderr]                 criteria.append(" ".join(current))
[stderr]             current = [line[2:].strip()]
[stderr]         elif current and line.strip():
[stderr]             # Markdown permits a hanging indent for a long bullet. Preserve
[stderr]             # the entire criterion so it remains a precise worker contract.
[stderr]             current.append(line.strip())
[stderr]     if current:
[stderr]         criteria.append(" ".join(current))
[stderr]     if not criteria:
[stderr]         raise ValueError(f"{path} has no acceptance criteria.")
[stderr]     return Task(
[stderr]         task_id=metadata["task_id"],
[stderr]         title=metadata["title"],
[stderr]         sequence=int(metadata["sequence"]),
[stderr]         dependencies=[value.strip() for value in metadata.get("dependencies", "").split(",") if value.strip()],
[stderr]         browser_impact=metadata["browser_impact"],
[stderr]         playwright_specs=[metadata["playwright_spec"]] if metadata["playwright_spec"] else [],
