l save and recovery protocol\",\"domain\":\"persistence\",\"targets\":[\"shared\",\"web\",\"pwa\"],\"requirement_ids\":[\"REQ-0006\",\"REQ-0012\",\"NFR-0002\",\"NFR-0003\",\"NFR-0005\"],\"bounded_outcome\":\"A schema protocol specifies immutable revisions, checksums, current-pointer validation, known-good retention, quarantine, separate preferences, deletion confirmation, and safe-boundary persistence rules.\",\"prerequisites\":[\"IMP-0002\",\"IMP-0004\",\"IMP-0003\"],\"ownership\":{\"files\":[\"src/core/save/{schema,compatibility,migrations}/\",\"src/platform/web/persistence/\",\"tests/{core,platform}/save*\",\"docs/save-and-recovery.md\"],\"data\":[\"save snapshot and preference schemas\",\"quarantine record\"],\"api\":[\"snapshot repository and recovery protocol\"]},\"forbidden_scope\":[\"cloud sync\",\"identity\",\"PWA cache records\",\"eviction guarantee\"],\"verification\":\"Fault fixtures cover interrupted write, checksum failure, malformed data, quota/permission failure, quarantine, retry, and selected-slot deletion.\",\"human_external_gate\":\"GATE-0003 / DEC-0003 storage API, quota, support window, and recovery policy.\",\"complexity\":\"high\",\"status\":\"gated\"},\n    {\"id\":\"IMP-0007\",\"title\":\"Define pure save migration runner\",\"domain\":\"persistence\",\"targets\":[\"shared\",\"web\",\"pwa\"],\"requirement_ids\":[\"REQ-0006\",\"NFR-0002\",\"NFR-0003\"],\"bounded_outcome\":\"Ordered, pure migrations declare supported versions and promote only validated candidates while preserving original invalid bytes for quarantine.\",\"prerequisites\":[\"IMP-0005\",\"IMP-0006\"],\"ownership\":{\"files\":[\"src/core/save/{migrations,compatibility}/\",\"tests/core/save/fixtures\"],\"data\":[\"migration registry and predecessor fixtures\"],\"api\":[\"migration runner API\"]},\"forbidden_scope\":[\"storage driver changes\",\"future data export\",\"automatic destructive repair\"],\"verification\":\"Every declared predecessor migrates once; unsupported or failed migration leaves the original candidate intact and quarantined.\",\"human_external_gate\":\"GATE-0003 / DEC-0003 support-window approval.\",\"complexity\":\"medium\",\"status\":\"gated\"},\n    {\"id\":\"IMP-0008\",\"title\":\"Bound P0 identity, authorization, and connected-service exclusions\",\"domain\":\"security\",\"targets\":[\"shared\",\"web\",\"pwa\"],\"requirement_ids\":[\"REQ-0013\",\"REQ-0014\",\"REQ-0015\",\"NFR-0012\"],\"bounded_outcome\":\"Architecture and negative contract tests demonstrate that local campaign start/save/resume require no account identifier, token, remote profile, role, entitlement, multiplayer, or safety service.\",\"prerequisites\":[\"IMP-0002\",\"IMP-0004\"],\"ownership\":{\"files\":[\"docs/security-boundary.md\",\"tests/core/connected-scope-exclusion.*\"],\"data\":[\"future connected-service approval checklist\"],\"api\":[\"local-slot identity contract\"]},\"forbidden_scope\":[\"sign-in\",\"OAuth\",\"sync\",\"roles\",\"moderation\",\"purchases\",\"server APIs\"],\"verification\":\"Static scan and negative fixtures find no identity/token/privilege fields or network client in P0 foundation modules.\",\"human_external_gate\":\"GATE-0006 / DEC-0006 before any connected implementation.\",\"complexity\":\"low\",\"status\":\"current\"},\n    {\"id\":\"IMP-0009\",\"title\":\"Define privacy-safe local diagnostics boundary\",\"domain\":\"privacy\",\"targets\":[\"web\",\"pwa\"],\"requirement_ids\":[\"REQ-0012\",\"NFR-0006\"],\"bounded_outcome\":\"A bounded local diagnostic schema, consent and clear controls, redaction rules, and no-network guardrails support future player recovery without collecting save or dialogue payloads.\",\"prerequisites\":[\"IMP-0002\",\"IMP-0003\",\"IMP-0006\"],\"ownership\":{\"files\":[\"src/platform/web/diagnostics/\",\"src/app/recovery/diagnostic-contract.*\",\"tests/platform/diagnostics.*\",\"docs/privacy-and-recovery.md\"],\"data\":[\"redacted local diagnostic record\",\"consent state\"],\"api\":[\"diagnostic recorder interface\"]},\"forbidden_scope\":[\"diagnostic provider/transport\",\"remote analytics\",\"retention promise\",\"secrets\"],\"verification\":\"Tests prove diagnostics are absent without consent, redact payloads, and can be deleted locally.\",\"human_external_gate\":\"GATE-0005 / DEC-0005 before transport, retention, hosting, or support claims.\",\"complexity\":\"medium\",\"status\":\"gated\"},\n    {\"id\":\"IMP-0010\",\"title\":\"Establish semantic accessibility design tokens\",\"domain\":\"accessibility\",\"targets\":[\"shared\",\"web\",\"pwa\"],\"requirement_ids\":[\"REQ-0007\",\"REQ-0010\",\"NFR-0004\",\"NFR-0008\"],\"bounded_outcome\":\"Original semantic tokens cover typography, spacing, focus, motion, touch targets, status, contrast, and non-colour cues, enabling later responsive web UI and inherited PWA UI.\",\"prerequisites\":[\"IMP-0001\",\"IMP-0002\"],\"ownership\":{\"files\":[\"src/app/design/tokens/\",\"docs/design-tokens.md\",\"tests/app/design-tokens.*\"],\"data\":[\"semantic token inventory\"],\"api\":[\"token consumption contract\"]},\"forbidden_scope\":[\"screens\",\"maps\",\"final artwork/fonts\",\"final breakpoints\",\"copied reference styling\"],\"verification\":\"Token validation proves semantic labels/non-colour cues and reduced-motion values in representative fixtures.\",\"human_external_gate\":\"GATE-0002 and GATE-0004 before numeric contrast/font/breakpoint claims.\",\"complexity\":\"medium\",\"status\":\"gated\"},\n    {\"id\":\"IMP-0011\",\"title\":\"Create original-content provenance control\",\"domain\":\"content\",\"targets\":[\"shared\"],\"requirement_ids\":[\"REQ-0001\",\"REQ-0008\",\"NFR-0008\"],\"bounded_outcome\":\"A provenance record format, review checklist, and source-asset manifest make authorship and permitted functional reference scope auditable before authored content enters a build.\",\"prerequisites\":[\"IMP-0005\"],\"ownership\":{\"files\":[\"assets/source-manifest.*\",\"docs/original-content-review.md\",\"tests/content/provenance.*\"],\"data\":[\"provenance manifest and review disposition\"],\"api\":[\"provenance validator input contract\"]},\"forbidden_scope\":[\"creating art/audio/story\",\"licensing approval\",\"automatic legal clearance\"],\"verification\":\"Validator rejects missing provenance fields; human creative review is recorded for each authored package.\",\"human_external_gate\":\"Human creative/provenance review; legal or licensing review if applicable under GATE-0007.\",\"complexity\":\"low\",\"status\":\"current\"},\n    {\"id\":\"IMP-0012\",\"title\":\"Document foundation architecture and recovery boundaries\",\"domain\":\"documentation\",\"targets\":[\"shared\",\"web\",\"pwa\"],\"requirement_ids\":[\"NFR-0012\",\"NFR-0010\",\"NFR-0002\",\"NFR-0003\"],\"bounded_outcome\":\"Developer documentation records ownership, command flow, save-versus-cache separation, deferred connected scope, and the decisions/gates that later domain authors must preserve.\",\"prerequisites\":[\"IMP-0002\",\"IMP-0004\",\"IMP-0006\",\"IMP-0008\"],\"ownership\":{\"files\":[\"docs/{architecture,development,save-and-recovery,security-boundary}.md\"],\"data\":[\"foundation decision and ownership index\"],\"api\":[\"documented public-boundary inventory\"]},\"forbidden_scope\":[\"player release guide\",\"operational rollout\",\"claiming approved vendor or policy choices\"],\"verification\":\"Documentation review cross-checks every foundation contract's ownership, dependency, and gate against this catalogue.\",\"human_external_gate\":\"None; approval gates are documented, not resolved.\",\"complexity\":\"low\",\"status\":\"current\"},\n    {\"id\":\"IMP-0013\",\"title\":\"Define exploration scene and exit transition contract\",\"domain\":\"campaign\",\"targets\":[\"shared\"],\"requirement_ids\":[\"REQ-0002\",\"REQ-0008\",\"NFR-0007\"],\"bounded_outcome\":\"Content-neutral scene, exit, collision, and interaction transitions preserve a completable route without UI ownership.\",\"prerequisites\":[\"IMP-0004\",\"IMP-0005\"],\"ownership\":{\"files\":[\"src/core/campaign/scene*\",\"tests/core/campaign/scene*\"],\"data\":[\"scene and exit envelope\"],\"api\":[\"scene transition commands\"]},\"forbidden_scope\":[\"UI\",\"extra regions\",\"procedural worlds\",\"authored maps\"],\"verification\":\"Invalid exits and references leave state unchanged; a route graph is validated.\",\"human_external_gate\":\"GATE-0004 before concrete content shapes.\",\"complexity\":\"medium\",\"status\":\"ready_for_authoring\"},\n    {\"id\":\"IMP-0014\",\"title\":\"Define narrative quest and tutorial state transitions\",\"domain\":\"campaign\",\"targets\":[\"shared\"],\"requirement_ids\":[\"REQ-0001\",\"REQ-0002\",\"REQ-0005\",\"REQ-0008\"],\"bounded_outcome\":\"Original-content-neutral dialogue, quest, tutorial, and campaign state rules make required progression explicit and idempotent.\",\"prerequisites\":[\"IMP-0004\",\"IMP-0013\"],\"ownership\":{\"files\":[\"src/core/campaign/{quest,dialogue,tutorial}*\",\"tests/core/campaign/quest*\"],\"data\":[\"quest and tutorial envelopes\"],\"api\":[\"progression commands\"]},\"forbidden_scope\":[\"authored story\",\"branching campaign\",\"user content\",\"UI\"],\"verification\":\"Repeated completion and invalid predicates are rejected safely.\",\"human_external_gate\":\"GATE-0004 before authored text, locale, and content detail.\",\"complexity\":\"high\",\"status\":\"ready_for_authoring\"},\n    {\"id\":\"IMP-0015\",\"title\":\"Define deterministic encounter and reward resolution contract\",\"domain\":\"campaign\",\"targets\":[\"shared\"],\"requirement_ids\":[\"REQ-0003\",\"REQ-0005\",\"NFR-0002\"],\"bounded_outcome\":\"A deterministic encounter, legal-action, defeat, and one-time reward contract supports the first battle without values or presentation.\",\"prerequisites\":[\"IMP-0003\",\"IMP-0004\"],\"ownership\":{\"files\":[\"src/core/campaign/{encounter,reward}*\",\"tests/core/campaign/encounter*\"],\"data\":[\"encounter and reward envelope\"],\"api\":[\"encounter commands\"]},\"forbidden_scope\":[\"multiplayer\",\"live balance\",\"art/audio\",\"mid-combat save guarantee\"],\"verification\":\"Invalid actions do not mutate and reward IDs grant once.\",\"human_external_gate\":\"GATE-0004 before concrete party, enemy, and balance shapes.\",\"complexity\":\"high\",\"status\":\"ready_for_authoring\"},\n    {\"id\":\"IMP-0016\",\"title\":\"Define safe inventory and party progression contract\",\"domain\":\"campaign\",\"targets\":[\"shared\"],\"requirement_ids\":[\"REQ-0004\",\"REQ-0008\",\"NFR-0002\"],\"bounded_outcome\":\"Eligibility-checked inventory, party progression, and stable reward application protect required items and avoid dead ends.\",\"prerequisites\":[\"IMP-0004\",\"IMP-0015\"],\"ownership\":{\"files\":[\"src/core/campaign/{inventory,party}*\",\"tests/core/campaign/inventory*\"],\"data\":[\"item and progression envelopes\"],\"api\":[\"inventory commands\"]},\"forbidden_scope\":[\"crafting\",\"trading\",\"purchases\",\"destructive discard\"],\"verification\":\"Ineligible use and duplicate rewards are no-ops.\",\"human_external_gate\":\"GATE-0004 before authored item/progression shapes.\",\"complexity\":\"medium\",\"status\":\"ready_for_authoring\"},\n    {\"id\":\"IMP-0017\",\"title\":\"Specify campaign progression and safe ending integration\",\"domain\":\"campaign\",\"targets\":[\"shared\"],\"requirement_ids\":[\"REQ-0001\",\"REQ-0002\",\"REQ-0003\",\"REQ-0004\",\"REQ-0005\"],\"bounded_outcome\":\"One town-to-dungeon-to-ending progression integration specifies safe checkpoints and a completable original campaign route.\",\"prerequisites\":[\"IMP-0013\",\"IMP-0014\",\"IMP-0015\",\"IMP-0016\"],\"ownership\":{\"files\":[\"src/core/campaign/progression*\",\"tests/core/campaign/progression*\"],\"data\":[\"campaign route graph\"],\"api\":[\"campaign completion command\"]},\"forbidden_scope\":[\"UI\",\"additional regions\",\"remote content\"],\"verification\":\"Reachability proves one route and ending is idempotent.\",\"human_external_gate\":\"GATE-0004 before authored campaign implementation.\",\"complexity\":\"high\",\"status\":\"ready_for_authoring\"},\n    {\"id\":\"IMP-0018\",\"title\":\"Define original campaign content-package and provenance assembly\",\"domain\":\"content\",\"targets\":[\"shared\"],\"requirement_ids\":[\"REQ-0001\",\"REQ-0002\",\"REQ-0008\",\"NFR-0007\",\"NFR-0008\"],\"bounded_outcome\":\"A versioned package assembles the one-town/one-dungeon campaign using original assets and auditable provenance, without creating those assets in authoring.\",\"prerequisites\":[\"IMP-0005\",\"IMP-0011\",\"IMP-0013\",\"IMP-0014\",\"IMP-0015\",\"IMP-0016\"],\"ownership\":{\"files\":[\"content/campaign/\",\"assets/source-manifest.*\",\"tests/content/campaign*\"],\"data\":[\"campaign package and provenance manifest\"],\"api\":[\"content package loader\"]},\"forbidden_scope\":[\"copied expression\",\"licensing approval\",\"new regions\"],\"verification\":\"Validator resolves references and rejects absent provenance.\",\"human_external_gate\":\"GATE-0004 and human creative/provenance review before implementation.\",\"complexity\":\"high\",\"status\":\"ready_for_authoring\"},\n    {\"id\":\"IMP-0019\",\"title\":\"Add campaign domain invariant and negative-fixture coverage\",\"domain\":\"tests\",\"targets\":[\"shared\"],\"requirement_ids\":[\"REQ-0002\",\"REQ-0003\",\"REQ-0004\",\"NFR-0007\"],\"bounded_outcome\":\"Deterministic fixtures cover invalid campaign references, blocked routes, stale commands, and duplicate grants across SHARD-02.\",\"prerequisites\":[\"IMP-0013\",\"IMP-0014\",\"IMP-0015\",\"IMP-0016\"],\"ownership\":{\"files\":[\"tests/core/campaign/fixtures/\",\"tests/core/campaign/invariants*\"],\"data\":[\"negative campaign fixtures\"],\"api\":[\"fixture builders\"]},\"forbidden_scope\":[\"real player data\",\"browser matrix\",\"product assets\"],\"verification\":\"Every fixture is deterministic and each invalid case is detected.\",\"human_external_gate\":\"GATE-0004 retained for concrete content assumptions.\",\"complexity\":\"medium\",\"status\":\"ready_for_authoring\"},\n    {\"id\":\"IMP-0020\",\"title\":\"Document SHARD-02 ownership, gates, and handoff boundaries\",\"domain\":\"documentation\",\"targets\":[\"shared\"],\"requirement_ids\":[\"REQ-0001\",\"REQ-0002\",\"REQ-0008\",\"NFR-0012\"],\"bounded_outcome\":\"Developer documentation records campaign-domain ownership, explicit gates, asset/provenance handoff, and the UI/PWA boundary for SHARD-03.\",\"prerequisites\":[\"IMP-0017\",\"IMP-0018\",\"IMP-0019\"],\"ownership\":{\"files\":[\"docs/campaign-domain-boundary.md\"],\"data\":[\"SHARD-02 ownership index\"],\"api\":[\"documented handoff\"]},\"forbidden_scope\":[\"UI implementation\",\"PWA delivery\",\"release claims\"],\"verification\":\"Review cross-checks all SHARD-02 contracts and retained gates.\",\"human_external_gate\":\"None; documents GATE-0004 and provenance review without resolving either.\",\"complexity\":\"low\",\"status\":\"ready_for_authoring\"}\n  ],\n  \"expansion_queue\": [\n    {\"id\":\"SHARD-02\",\"title\":\"Campaign content and domain logic\",\"max_contracts\":250,\"depends_on\":[\"SHARD-01\"],\"covers\":[\"exploration\",\"dialogue\",\"quests\",\"tutorial\",\"combat\",\"inventory\",\"party progression\",\"town/dungeon/ending content\",\"content validation\"],\"requirement_ids\":[\"REQ-0001\",\"REQ-0002\",\"REQ-0003\",\"REQ-0004\",\"REQ-0005\",\"REQ-0008\",\"NFR-0007\",\"NFR-0008\"],\"gate\":\"GATE-0004\",\"target_allocation\":\"shared core and content only; no UI ownership\",\"state\":\"expanded\"},\n    {\"id\":\"SHARD-03\",\"title\":\"Session, UI, input, and accessibility\",\"max_contracts\":250,\"depends_on\":[\"SHARD-01\",\"SHARD-02\"],\"covers\":[\"session/checkpoints\",\"semantic responsive shell\",\"game panels\",\"keyboard/mouse/touch/gamepad adapters\",\"settings\",\"localisation\",\"captions\",\"feedback\",\"error recovery UI\",\"accessibility tests\"],\"requirement_ids\":[\"REQ-0005\",\"REQ-0006\",\"REQ-0007\",\"REQ-0009\",\"REQ-0010\",\"REQ-0012\",\"NFR-0002\",\"NFR-0003\",\"NFR-0004\",\"NFR-0005\"],\"gate\":\"GATE-0002,GATE-0003,GATE-0004\",\"target_allocation\":\"shared UI model; web input/layout adapter; PWA inherits UI with no separate UI fork\",\"state\":\"queued\"},\n    {\"id\":\"SHARD-04\",\"title\":\"PWA delivery, performance, operations, and release evidence\",\"max_contracts\":250,\"depends_on\":[\"SHARD-01\",\"SHARD-02\",\"SHARD-03\"],\"covers\":[\"PWA manifest/install\",\"service-worker cache lifecycle\",\"offline/update recovery\",\"performance measurement\",\"security headers\",\"release checks\",\"observability\",\"quality automation\",\"player/operator documentation\",\"platform certification assessment\"],\"requirement_ids\":[\"REQ-0011\",\"REQ-0012\",\"NFR-0001\",\"NFR-0003\",\"NFR-0006\",\"NFR-0009\",\"NFR-0011\",\"NFR-0012\"],\"gate\":\"GATE-0002,GATE-0005,GATE-0007\",\"target_allocation\":\"web release build and PWA service-worker/install adapter are distinct; shared core owns neither cache nor hosting\",\"state\":\"queued\"},\n    {\"id\":\"SHARD-05\",\"title\":\"Connected-scope decision package\",\"max_contracts\":250,\"depends_on\":[\"SHARD-01\"],\"covers\":[\"identity/sync conflict policy\",\"multiplayer/player safety\",\"live operations\",\"commerce/entitlements\"],\"requirement_ids\":[\"REQ-0014\",\"REQ-0015\"],\"gate\":\"GATE-0006\",\"target_allocation\":\"no P0 target implementation; research/decision outputs only if explicitly authorised\",\"state\":\"hold\"}\n  ],\n  \"requirement_coverage\": {\n    \"REQ-0001\":\"queued: SHARD-02; provenance foundation IMP-0011\",\"REQ-0002\":\"queued: SHARD-02\",\"REQ-0003\":\"queued: SHARD-02\",\"REQ-0004\":\"queued: SHARD-02\",\"REQ-0005\":\"queued: SHARD-02 and SHARD-03\",\"REQ-0006\":\"current/gated: IMP-0006, IMP-0007; queued: SHARD-03\",\"REQ-0007\":\"current/gated: IMP-0010; queued: SHARD-03\",\"REQ-0008\":\"current: IMP-0005, IMP-0011; queued: SHARD-02\",\"REQ-0009\":\"queued: SHARD-03\",\"REQ-0010\":\"current/gated: IMP-0010; queued: SHARD-03\",\"REQ-0011\":\"queued: SHARD-04\",\"REQ-0012\":\"current/gated: IMP-0006, IMP-0009; queued: SHARD-03 and SHARD-04\",\"REQ-0013\":\"current: IMP-0002, IMP-0008\",\"REQ-0014\":\"gated: SHARD-05 / GATE-0006; no P0 implementation\",\"REQ-0015\":\"hold: SHARD-05 / GATE-0006; no P0 implementation\",\"NFR-0001\":\"queued: SHARD-04\",\"NFR-0002\":\"current/gated: IMP-0004, IMP-0006, IMP-0007\",\"NFR-0003\":\"current/gated: IMP-0006, IMP-0007; queued: SHARD-04\",\"NFR-0004\":\"current/gated: IMP-0010; queued: SHARD-03\",\"NFR-0005\":\"current/gated: IMP-0006; queued: SHARD-03\",\"NFR-0006\":\"current/gated: IMP-0009; queued: SHARD-04\",\"NFR-0007\":\"current: IMP-0005; queued: SHARD-02\",\"NFR-0008\":\"current: IMP-0005, IMP-0010, IMP-0011; queued: SHARD-02\",\"NFR-0009\":\"gated: SHARD-04 / GATE-0002\",\"NFR-0010\":\"current: IMP-0001, IMP-0002, IMP-0003, IMP-0004; queued target adapters in SHARD-03 and SHARD-04\",\"NFR-0011\":\"gated: SHARD-04 / GATE-0005\",\"NFR-0012\":\"current/gated: IMP-0001, IMP-0002, IMP-0003, IMP-0008, IMP-0012; queued: SHARD-04\"\n  },\n  \"dependency_graph\": {\"nodes\":[\"IMP-0001\",\"IMP-0002\",\"IMP-0003\",\"IMP-0004\",\"IMP-0005\",\"IMP-0006\",\"IMP-0007\",\"IMP-0008\",\"IMP-0009\",\"IMP-0010\",\"IMP-0011\",\"IMP-0012\",\"IMP-0013\",\"IMP-0014\",\"IMP-0015\",\"IMP-0016\",\"IMP-0017\",\"IMP-0018\",\"IMP-0019\",\"IMP-0020\"],\"acyclic\":true,\"validation\":\"Each prerequisite points only to an earlier numbered contract; SHARD dependencies only point from later shards to earlier shards.\"}\n}\n- The local offline campaign neither needs identity nor sends player state.\n  Any later account is an optional replication boundary, not campaign truth.\n\n## Accepted domain chapters\n\n### 1. Game shell, session, input, and responsive presentation\n\n**Entities/lifecycle:** `Session` moves `launching \u2192 title \u2192 new-or-resume \u2192\nplaying \u2194 paused \u2192 ending \u2192 title`; `InputAction` is mapped per supported input\nmethod; `ViewportProfile` selects responsive layout. Authoring inputs are title\ncopy, control hints, menu routes, and UI layouts. Rules: pause blocks world and\ncombat advancement; focus loss pauses or reaches a safe state; UI action labels\nremain readable and semantic across screen sizes. Dependencies are accessibility,\nrendering, persistence, and content. Outcome is an understandable, controllable\nstart and return path. Edge cases are no existing save, focus loss, rotation,\nunavailable gamepad, unsupported browser feature, and input remap conflict.\n**First-release boundary:** web/PWA keyboard, mouse, touch, and gamepad\nadaptation; one shared game core. No native-client shell or arbitrary controller\nconfiguration guarantee.\n\n### 2. Exploration, town, dungeon, and campaign content\n\n**Entities/lifecycle:** `Scene` is `unloaded \u2192 entered \u2192 active \u2192 exited`;\n`Exit` is `locked | available | used`; `Interactable` is `available \u2192 used` or\nreusable as authored. Inputs are original tile/layout data, collision shapes,\nspawn points, NPCs, exits, encounter zones, dialogue, and asset references.\nRules: exactly one town and one dungeon form the first campaign; collision and\ngates must leave a completable route. Dependencies are narrative, quests,\ncombat, rendering, and saves. Outcome is readable navigation to the ending.\nEdge cases: blocked exit, empty interaction, absent optional item, and invalid\ncontent reference. **Boundary:** no extra regions, procedural worlds, or shared\nlevels.\n\n### 3. Narrative, quests, onboarding, and ending\n\n**Entities/lifecycle:** `Dialogue` is `available \u2192 shown \u2192 acknowledged`;\n`Quest` is `unavailable \u2192 available \u2192 accepted \u2192 objective-complete \u2192\nclaimed \u2192 completed` (or `failed` only where authored); `TutorialStep` is\n`pending \u2192 presented \u2192 understood`; `Campaign` is `not-started \u2192 active \u2192\ncompleted`. Inputs are original characters, text, localisation keys, objective\npredicates, rewards, and ending sequence. Rules: tutorial teaches a battle and\nsaving before unrestricted progression; required quests cannot be abandoned;\ncompletion is idempotent. Dependencies are scenes, combat, inventory, UI, and\nsaves. Outcomes are clear objectives and a short finish. Edge cases: repeated\nNPC talk, dialogue after completion, missing translation, and an invalid quest\npredicate. **Boundary:** one authored story path; no branching campaign,\nseasonal narrative, or user-authored stories.\n## Layout, visual tokens, and responsive behaviour\n\nThe game scene retains its 2D world view while the interface reflows around it. Essential information is never permanently covered by a decorative frame, cut off by device notches, or dependent on hover.\n\n| Token / rule | Contract |\n| --- | --- |\n| `--surface-base`, `--surface-raised` | Warm parchment/dark-plum interface planes. Body text and essential icons meet at least **4.5:1** contrast; large text (at least 24 CSS px regular or 18.66 CSS px bold) meets **3:1**. |\n| `--text-primary`, `--text-muted` | Primary is used for all essential content. Muted text is never the only carrier of an instruction, state, or warning and meets 4.5:1 when conveying necessary text. |\n| `--accent-action`, `--state-success/warning/danger` | Accent is paired with text and a distinct icon/shape. Focus does not rely on the action colour. Error and destructive states use wording plus iconography. |\n| `--focus-ring` | A high-visibility 3 CSS-px minimum outline with at least 3:1 contrast against adjacent colours; never removed. It has clear offset from the focused control. |\n| Typography | Sans-serif UI type with clear letterforms; text scaling is supported to 200% without clipping, overlap, horizontal page scrolling, or lost actions. Body/default dialogue begins at a readable base size; users may choose larger text and line spacing. |\n| Spacing and targets | Minimum 44 by 44 CSS px target for touch-operable controls, with 8 CSS px separation where adjacent targets could be confused. Targets are not made smaller on compact screens. |\n| Motion | Motion is brief, non-essential, and can be reduced. Respect `prefers-reduced-motion`; provide an in-game reduction setting that removes camera shake, parallax, flashes, auto-panning, and nonessential transitions. No essential timing depends on animation. |\n\n| Viewport | Layout behaviour |\n| --- | --- |\n| Phone / narrow portrait | Full-width world view with safe-area insets. Objective is a compact expandable summary; action controls form a bottom reachable sheet. Inventory, quest, settings, and dialogue become full-screen panels with a sticky close/back control. Combat actions stack or use a single-column selection list; no critical control is below the browser chrome. |\n| Tablet / medium | World stays primary with a side or bottom contextual panel. Combat has a clear action area and target area side-by-side when space allows; otherwise it uses the phone sequence. Panels never overlap the action prompt. |\n| Desktop / wide | Centred game stage with persistent but collapsible objective/status rail. Inventory and quest can use a two-column inspection layout; combat keeps actions and party/enemy status simultaneously visible. Mouse hover may preview a definition but never supplies essential information. |\n\nRotation, resize, zoom, virtual keyboards, and PWA display-mode changes preserve the current game state and selection where practical. If reflow temporarily obscures the selected control, focus moves to the panel heading and a short status message announces the layout change. Full screen is optional and provides an obvious exit path.\n\n## Input and interaction adaptation\n\nAll supported physical inputs invoke one semantic action vocabulary: move, inspect/interact, confirm, cancel/pause, open quest, open bag, open settings, navigate previous/next, and choose a legal combat action/target. A player can complete every core journey without pointer precision, dragging, multi-touch, rapid repetition, or a time limit.\n\n| Surface / input | Required adaptation |\n| --- | --- |\n| Keyboard | Arrow keys and WASD move/navigate where appropriate; Tab and Shift+Tab move through UI controls in visual reading order; Enter/Space confirm; Escape cancels/closes/pause. Avoid keyboard traps; provide an early `Skip to game controls` link from the shell. Key repeat must not confirm a destructive choice or consume multiple turn actions. Control mappings are visible and remappable subject to the later-approved configuration depth; conflicts are explained before saving. |\n| Mouse / trackpad | Click targets match the semantic controls; hover is optional enrichment only. Right-click is not required. The pointer never needs to trace tiny map details to perform a required interaction. |\n| Touch | On-screen controls are reachable, labelled, and may be toggled in settings. Use tap-to-confirm and explicit target selection; do not require pinch, swipe-only navigation, double tap, drag, or long press. A touch action has the same feedback as its keyboard equivalent. |\n| Gamepad | Feature-detect rather than promise a model. Show button glyphs only after detection and accompany them with action text. D-pad/left stick navigates; primary face button confirms; secondary face button cancels; menu button pauses; shoulder buttons may switch top-level panels when discoverable. A disconnected controller preserves state and presents keyboard/mouse/touch alternatives without blocking. |\n| Remote / focus-only devices | These are not a selected delivery target. If a browser presents only directional/confirm/back focus input, the menus use the gamepad-style focus order and all core controls remain reachable; continuous exploration is not promised until a target/device decision is approved. |\n| Voice and other assistive input | Voice command recognition is not collected, enabled, or required in P0. Controls expose standard semantic HTML roles, names, states, and operable buttons so browser voice control, switch control, eye tracking, and other assistive input can target visible actions by label. Canvas/world interactions have equivalent labelled UI prompts and action-list routes. |\n\n## Accessibility policy\n\nThe release target is WCAG 2.2 AA for the public UI and the operable game controls, evaluated with automated checks and manual keyboard, screen-reader, zoom/reflow, touch, and reduced-motion review on the approved browser/device matrix. This is a product quality target; exact assistive-technology combinations remain a release approval gate rather than an invented compatibility claim.\n\n- Use semantic landmarks for banner/title navigation, main game controls, complementary objective/status, and dialogs. Mark decorative art as hidden from assistive technology. Give the world canvas a concise labelled description and provide its essential current state through adjacent semantic status and action elements.\n- Every interactive element has a unique accessible name that matches its visible label where one exists. Examples: `Open quest: Relight the Beacon`, `Use Moss Tonic on Rowan`, `Close inventory`, `Save slot 1`, and `Delete slot 1`.\n- Dialogues announce speaker and text through a controlled, non-interrupting status mechanism; combat announces turn start, selected action/target, damage/healing, and victory/defeat without flooding announcements for decorative animation frames. Notifications are concise, deduplicated, and reviewable in the status/quest panel.\n- Focus is visible at all times, enters a dialog at its heading or first safe action, remains contained only while that blocking dialog is open, and returns to its invoking control when closed. A newly opened non-modal panel receives focus on its heading. Error focus moves to an actionable summary, not an arbitrary visual element.\n- Do not use flicker above three flashes per second. Provide captions/subtitles for all non-text audio that conveys story, instruction, combat state, or warning; identify speaker and relevant sound in concise text. Master audio, music, effects, caption visibility, text size, contrast, and motion settings are reachable before starting a new game and while paused.\n- Required state has a text equivalent: party health uses values and state wording as well as bars; enemy intent uses a label/icon; map interaction, quest progression, and save status use text. Visual settings include a higher-contrast mode and non-colour state markers.\n- Users can pause, slow, or disable nonessential movement and screen effects. No essential dialogue, battle selection, confirmation, error message, or recovery choice disappears by timeout.\n- Settings save independently of campaign saves where storage permits. If persistence fails, keep the in-session choice, state that it will not persist, and preserve a usable default. Reset settings is confirmed and describes the affected preference categories.\n\n## Empty, error, recovery, destructive, and privacy-sensitive states\n\n| Situation | Experience requirement |\n| --- | --- |\n| Empty inventory / no quest / no save | State what is empty, why it may be empty, and the next useful action: e.g., `No items yet\u2014explore the town and finish the first encounter.` No decorative blank panels. |\n| Invalid action, locked exit, unavailable target | Keep the player\u2019s state and turn intact; name the unmet requirement and return focus to the legal choices. Do not use a generic `Error` as the only explanation. |\n| Storage failure, corrupt save, or interrupted save | Never claim a save completed until confirmed. Retain the last valid checkpoint; show retry, return-to-title, and fallback/new-game paths. Quarantined saves are explained as preserved but unusable; recovery text avoids blame. |\n| Offline, install, cache, or update state | Explain whether the current cached version can play, whether an initial download is required, and that an update will wait for a save-safe title/menu boundary. Declining install or update does not block play on a valid cached/current release. |\n| Fault / crash recovery | Present plain-language retry, return to title, and safe-recovery actions. Preserve confirmed progress. A diagnostic option is optional and clearly separate from recovery. |\n| Delete a save | Require a confirmation dialog that names the slot, its progress/time where available, and that deletion is irreversible. Initial focus is `Cancel`; `Delete` is visually and semantically distinct and cannot be activated through a stale/repeated input. Only the selected local slot and associated recovery metadata are removed. |\n| New game over an active slot / reset settings | Explain precisely what will change. New game must use a separate slot or obtain explicit confirmation before replacing a selected slot. Settings reset affects preferences only, not campaign state. |\n| Diagnostics and local data | P0 sends no telemetry. Before any consent-gated local diagnostic record is created or exported, state purpose, included minimal fields, retention, deletion control, and that it does not affect play. `Clear diagnostic data` confirms the local-only effect. Never show save contents or dialogue in diagnostics UI. |\n\n## PWA-specific experience\n\nThe web and installed PWA share the campaign, controls, accessibility settings, semantic UI, and local-save behaviour. Installation is an optional convenience: the title/PWA status area explains availability and has a non-modal fallback when the browser offers no install prompt. Offline status is visible but not alarming. An uncached first visit tells the player that the game cannot begin offline until its assets finish downloading; a known-good installed/cache version continues if an update check fails.\n\nAn update notice appears only at a safe boundary (title or paused menu after a confirmed save) and says whether reloading is needed. It offers `Update now` and `Later`; it never reloads during combat, a save write, a modal choice, or essential dialogue. Cache refresh messaging does not imply that save data was refreshed, deleted, or synchronised.\n\n## Content and interaction review checklist\n\nBefore a content or UI change ships, review it against this contract: original provenance; clear next action and empty/error copy; keyboard, touch, mouse, gamepad, and semantic assistive-input operation; visible focus and accurate accessible names; contrast and non-colour cues; 44 CSS-px touch targets; 200% text/reflow; captions and reduced motion; safe save/update/recovery behaviour; destructive confirmation; and consent/minimisation for any privacy-sensitive interface.\n\n## Open decisions retained for approval\n\n- Exact content quantities, party size, localisation languages, full control-remapping depth, audio scope, and supported browser/device/assistive-technology matrix.\n- The legal, age/parental, regional, and certification policies that may change content warnings or accessibility obligations.\n\ncodex\n{\"status\":\"pass\",\"summary\":\"The current dispatch state leaves SHARD-03 eligible: SHARD-02 is expanded, its implementation gate is retained as authoring-only constraint, and SHARD-04 remains queued. I\u2019m expanding only SHARD-03 into a six-contract, two-batch wave and will leave exactly one D0004 successor for SHARD-04.\",\"changed_files\":[],\"test_result\":\"\",\"evidence\":{\"agent_log\":\"\",\"adapter_log\":\"\",\"test_log\":\"\",\"browser_log\":\"\",\"screenshots\":[]},\"acceptance_results\":[],\"documentation\":{\"reviewed_files\":[],\"updated_files\":[],\"summary\":\"\"},\"known_limitations\":[],\"browser_coverage\":\"\",\"recommended_next_step\":\"complete\"}\napply patch\npatch: completed\n/Users/simon/Dev/github/jakowicz/runbook-generator/projects/mock-fantasy-quest-4/planning/implementation-catalogue-index.json\ndiff --git a/projects/mock-fantasy-quest-4/planning/implementation-catalogue-index.json b/projects/mock-fantasy-quest-4/planning/implementation-catalogue-index.json\nindex 92a9491ce4d93779e85ecb200dc3ba4b420b8ff4..926e2b3fa009136848f375561ac3ff753514c400\n--- a/projects/mock-fantasy-quest-4/planning/implementation-catalogue-index.json\n+++ b/projects/mock-fantasy-quest-4/planning/implementation-catalogue-index.json\n@@ -24,16 +24,22 @@\n     {\"id\":\"IMP-0017\",\"title\":\"Specify campaign progression and safe ending integration\",\"domain\":\"campaign\",\"targets\":[\"shared\"],\"requirement_ids\":[\"REQ-0001\",\"REQ-0002\",\"REQ-0003\",\"REQ-0004\",\"REQ-0005\"],\"bounded_outcome\":\"One town-to-dungeon-to-ending progression integration specifies safe checkpoints and a completable original campaign route.\",\"prerequisites\":[\"IMP-0013\",\"IMP-0014\",\"IMP-0015\",\"IMP-0016\"],\"ownership\":{\"files\":[\"src/core/campaign/progression*\",\"tests/core/campaign/progression*\"],\"data\":[\"campaign route graph\"],\"api\":[\"campaign completion command\"]},\"forbidden_scope\":[\"UI\",\"additional regions\",\"remote content\"],\"verification\":\"Reachability proves one route and ending is idempotent.\",\"human_external_gate\":\"GATE-0004 before authored campaign implementation.\",\"complexity\":\"high\",\"status\":\"ready_for_authoring\"},\n     {\"id\":\"IMP-0018\",\"title\":\"Define original campaign content-package and provenance assembly\",\"domain\":\"content\",\"targets\":[\"shared\"],\"requirement_ids\":[\"REQ-0001\",\"REQ-0002\",\"REQ-0008\",\"NFR-0007\",\"NFR-0008\"],\"bounded_outcome\":\"A versioned package assembles the one-town/one-dungeon campaign using original assets and auditable provenance, without creating those assets in authoring.\",\"prerequisites\":[\"IMP-0005\",\"IMP-0011\",\"IMP-0013\",\"IMP-0014\",\"IMP-0015\",\"IMP-0016\"],\"ownership\":{\"files\":[\"content/campaign/\",\"assets/source-manifest.*\",\"tests/content/campaign*\"],\"data\":[\"campaign package and provenance manifest\"],\"api\":[\"content package loader\"]},\"forbidden_scope\":[\"copied expression\",\"licensing approval\",\"new regions\"],\"verification\":\"Validator resolves references and rejects absent provenance.\",\"human_external_gate\":\"GATE-0004 and human creative/provenance review before implementation.\",\"complexity\":\"high\",\"status\":\"ready_for_authoring\"},\n     {\"id\":\"IMP-0019\",\"title\":\"Add campaign domain invariant and negative-fixture coverage\",\"domain\":\"tests\",\"targets\":[\"shared\"],\"requirement_ids\":[\"REQ-0002\",\"REQ-0003\",\"REQ-0004\",\"NFR-0007\"],\"bounded_outcome\":\"Deterministic fixtures cover invalid campaign references, blocked routes, stale commands, and duplicate grants across SHARD-02.\",\"prerequisites\":[\"IMP-0013\",\"IMP-0014\",\"IMP-0015\",\"IMP-0016\"],\"ownership\":{\"files\":[\"tests/core/campaign/fixtures/\",\"tests/core/campaign/invariants*\"],\"data\":[\"negative campaign fixtures\"],\"api\":[\"fixture builders\"]},\"forbidden_scope\":[\"real player data\",\"browser matrix\",\"product assets\"],\"verification\":\"Every fixture is deterministic and each invalid case is detected.\",\"human_external_gate\":\"GATE-0004 retained for concrete content assumptions.\",\"complexity\":\"medium\",\"status\":\"ready_for_authoring\"},\n-    {\"id\":\"IMP-0020\",\"title\":\"Document SHARD-02 ownership, gates, and handoff boundaries\",\"domain\":\"documentation\",\"targets\":[\"shared\"],\"requirement_ids\":[\"REQ-0001\",\"REQ-0002\",\"REQ-0008\",\"NFR-0012\"],\"bounded_outcome\":\"Developer documentation records campaign-domain ownership, explicit gates, asset/provenance handoff, and the UI/PWA boundary for SHARD-03.\",\"prerequisites\":[\"IMP-0017\",\"IMP-0018\",\"IMP-0019\"],\"ownership\":{\"files\":[\"docs/campaign-domain-boundary.md\"],\"data\":[\"SHARD-02 ownership index\"],\"api\":[\"documented handoff\"]},\"forbidden_scope\":[\"UI implementation\",\"PWA delivery\",\"release claims\"],\"verification\":\"Review cross-checks all SHARD-02 contracts and retained gates.\",\"human_external_gate\":\"None; documents GATE-0004 and provenance review without resolving either.\",\"complexity\":\"low\",\"status\":\"ready_for_authoring\"}\n+    {\"id\":\"IMP-0020\",\"title\":\"Document SHARD-02 ownership, gates, and handoff boundaries\",\"domain\":\"documentation\",\"targets\":[\"shared\"],\"requirement_ids\":[\"REQ-0001\",\"REQ-0002\",\"REQ-0008\",\"NFR-0012\"],\"bounded_outcome\":\"Developer documentation records campaign-domain ownership, explicit gates, asset/provenance handoff, and the UI/PWA boundary for SHARD-03.\",\"prerequisites\":[\"IMP-0017\",\"IMP-0018\",\"IMP-0019\"],\"ownership\":{\"files\":[\"docs/campaign-domain-boundary.md\"],\"data\":[\"SHARD-02 ownership index\"],\"api\":[\"documented handoff\"]},\"forbidden_scope\":[\"UI implementation\",\"PWA delivery\",\"release claims\"],\"verification\":\"Review cross-checks all SHARD-02 contracts and retained gates.\",\"human_external_gate\":\"None; documents GATE-0004 and provenance review without resolving either.\",\"complexity\":\"low\",\"status\":\"ready_for_authoring\"},\n+    {\"id\":\"IMP-0021\",\"title\":\"Define shared session and safe checkpoint presentation model\",\"domain\":\"session\",\"targets\":[\"shared\",\"web\",\"pwa\"],\"requirement_ids\":[\"REQ-0005\",\"REQ-0006\",\"NFR-0002\",\"NFR-0003\"],\"bounded_outcome\":\"A framework-neutral session model covers launch, title, new-or-resume, play, pause, ending, focus loss, and confirmed checkpoint state without owning persistence drivers or platform layout.\",\"prerequisites\":[\"IMP-0004\",\"IMP-0006\",\"IMP-0017\"],\"ownership\":{\"files\":[\"src/app/session/\",\"tests/app/session/\"],\"data\":[\"session and checkpoint view state\"],\"api\":[\"session intent and safe-boundary API\"]},\"forbidden_scope\":[\"browser lifecycle implementation\",\"cache refresh\",\"new save schema\",\"network services\"],\"verification\":\"Deterministic tests prove focus loss pauses safely and unconfirmed saves never present as confirmed.\",\"human_external_gate\":\"GATE-0003 and GATE-0004 remain implementation gates for storage and concrete campaign assumptions.\",\"complexity\":\"medium\",\"status\":\"ready_for_authoring\"},\n+    {\"id\":\"IMP-0022\",\"title\":\"Define semantic responsive game-shell and navigation contract\",\"domain\":\"ui\",\"targets\":[\"web\",\"pwa\"],\"requirement_ids\":[\"REQ-0007\",\"REQ-0009\",\"REQ-0010\",\"NFR-0004\"],\"bounded_outcome\":\"A semantic shell specifies title, main controls, status, panels, dialogs, visible focus, reflow, and non-colour cues around the shared game state without a PWA-specific UI fork.\",\"prerequisites\":[\"IMP-0010\",\"IMP-0021\"],\"ownership\":{\"files\":[\"src/app/shell/\",\"src/platform/web/layout/\",\"tests/app/shell/\"],\"data\":[\"semantic navigation and viewport profiles\"],\"api\":[\"panel and focus routing API\"]},\"forbidden_scope\":[\"final art/fonts\",\"fixed supported-device claims\",\"service worker\",\"duplicated PWA UI\"],\"verification\":\"Representative fixtures retain labelled controls and legal focus order through resize and panel changes.\",\"human_external_gate\":\"GATE-0002 and GATE-0004 remain explicit for numeric thresholds and final content/layout choices.\",\"complexity\":\"high\",\"status\":\"ready_for_authoring\"},\n+    {\"id\":\"IMP-0023\",\"title\":\"Map semantic actions across keyboard, pointer, touch, and gamepad\",\"domain\":\"input\",\"targets\":[\"web\",\"pwa\"],\"requirement_ids\":[\"REQ-0005\",\"REQ-0009\",\"NFR-0004\"],\"bounded_outcome\":\"One action vocabulary maps movement, inspect, confirm, cancel, pause, panels, and legal combat choices across supported inputs with safe repeat and disconnect handling.\",\"prerequisites\":[\"IMP-0002\",\"IMP-0021\",\"IMP-0022\"],\"ownership\":{\"files\":[\"src/platform/web/input/\",\"src/app/input/\",\"tests/platform/input/\"],\"data\":[\"input binding and availability state\"],\"api\":[\"semantic input action API\"]},\"forbidden_scope\":[\"native clients\",\"voice recognition\",\"arbitrary remapping guarantee\",\"input-specific rules\"],\"verification\":\"Fixtures prove equivalent semantic actions, no duplicate destructive confirmation, and usable fallback after gamepad disconnect.\",\"human_external_gate\":\"GATE-0002 remains for approved browser/device compatibility claims.\",\"complexity\":\"high\",\"status\":\"ready_for_authoring\"},\n+    {\"id\":\"IMP-0024\",\"title\":\"Specify accessible settings, captions, and feedback preferences\",\"domain\":\"accessibility\",\"targets\":[\"web\",\"pwa\"],\"requirement_ids\":[\"REQ-0007\",\"REQ-0010\",\"NFR-0004\",\"NFR-0005\"],\"bounded_outcome\":\"Settings and feedback contracts cover text, contrast, motion, caption visibility, audio controls, preference failure, and reset confirmation while retaining unapproved audio and localisation scope.\",\"prerequisites\":[\"IMP-0010\",\"IMP-0006\",\"IMP-0022\"],\"ownership\":{\"files\":[\"src/app/settings/\",\"src/app/accessibility/\",\"tests/app/accessibility/\"],\"data\":[\"local preference model and caption state\"],\"api\":[\"settings and accessible-status API\"]},\"forbidden_scope\":[\"audio asset creation\",\"locale selection\",\"cloud preferences\",\"WCAG conformance claim\"],\"verification\":\"Tests cover reduced motion, non-colour state text, preference-write failure, and reset isolation from campaign saves.\",\"human_external_gate\":\"GATE-0002, GATE-0003, and GATE-0004 remain explicit implementation and release gates.\",\"complexity\":\"medium\",\"status\":\"ready_for_authoring\"},\n+    {\"id\":\"IMP-0025\",\"title\":\"Define recoverable empty, error, and destructive UI states\",\"domain\":\"ui\",\"targets\":[\"web\",\"pwa\"],\"requirement_ids\":[\"REQ-0006\",\"REQ-0012\",\"NFR-0002\",\"NFR-0003\"],\"bounded_outcome\":\"Bounded UI state contracts explain empty content, invalid actions, save failure, recovery, diagnostics, and selected-slot deletion with focus-safe