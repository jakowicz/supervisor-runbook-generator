-index.json-1-{\nprojects/mock-fantasy-quest-4/planning/implementation-catalogue-index.json-2-  \"catalogue_id\": \"mock-fantasy-quest-4-implementation-catalogue\",\nprojects/mock-fantasy-quest-4/planning/implementation-catalogue-index.json-3-  \"version\": 1,\nprojects/mock-fantasy-quest-4/planning/implementation-catalogue-index.json-4-  \"source\": [\"../specification/README.md\", \"../specification/requirements.json\", \"05-delivery-map.md\", \"06-foundation-domain-contracts.md\", \"07-feature-experience-contracts.md\", \"08-quality-operations-contracts.md\"],\nprojects/mock-fantasy-quest-4/planning/implementation-catalogue-index.json-5-  \"scope\": \"P0 is an original, offline-capable 2D single-player fantasy RPG delivered through a shared web core and a PWA delivery adaptation. Connected services are not P0 implementation scope.\",\nprojects/mock-fantasy-quest-4/planning/implementation-catalogue-index.json-6-  \"first_bounded_domain\": {\"id\": \"SHARD-01\", \"title\": \"Foundation and core contracts\", \"contract_limit\": 250, \"contract_count\": 12, \"state\": \"ready_for_authoring\", \"boundary\": \"Framework-neutral seams, deterministic state/data contracts, local persistence protocol, quality foundations, and original-design controls; excludes campaign rules, UI flows, PWA lifecycle, and release execution.\"},\nprojects/mock-fantasy-quest-4/planning/implementation-catalogue-index.json-7-  \"contracts\": [\nprojects/mock-fantasy-quest-4/planning/implementation-catalogue-index.json:8:    {\"id\":\"IMP-0001\",\"title\":\"Bootstrap reproducible shared project baseline\",\"domain\":\"foundation\",\"targets\":[\"shared\",\"web\",\"pwa\"],\"requirement_ids\":[\"NFR-0010\",\"NFR-0012\"],\"bounded_outcome\":\"A framework-neutral project skeleton documents one bootstrap, lint, format, and deterministic test command with isolated shared, web-adapter, PWA-adapter, content, and test directories.\",\"prerequisites\":[],\"ownership\":{\"files\":[\"root build/tooling configuration\",\"src/{core,content,app,platform/web,platform/pwa}/\",\"tests/\",\"docs/development.md\"],\"data\":[\"pinned toolchain declaration\"],\"api\":[\"build/test command interface\"]},\"forbidden_scope\":[\"selecting framework/package manager/CI without DEC-0001\",\"gameplay\",\"service worker\",\"hosting\"],\"verification\":\"Clean approved-runtime checkout runs the documented deterministic sample test, lint, and format checks.\",\"human_external_gate\":\"GATE-0001 / DEC-0001 framework, package-manager, and CI selection before implementation.\",\"complexity\":\"medium\",\"status\":\"gated\"},\nprojects/mock-fantasy-quest-4/planning/implementation-catalogue-index.json:9:    {\"id\":\"IMP-0002\",\"title\":\"Enforce shared-core and adapter dependency seams\",\"domain\":\"foundation\",\"targets\":[\"shared\",\"web\",\"pwa\"],\"requirement_ids\":[\"NFR-0010\",\"REQ-0013\",\"NFR-0012\"],\"bounded_outcome\":\"A dependency policy and public interfaces prevent core code from importing browser, renderer, clock, network, or platform modules; adapters submit commands and render returned state/events.\",\"prerequisites\":[\"IMP-0001\"],\"ownership\":{\"files\":[\"src/core/public interfaces\",\"src/platform/{web,pwa}/adapter interfaces\",\"architecture dependency rules\",\"docs/architecture.md\"],\"data\":[\"dependency-policy manifest\"],\"api\":[\"Command, state, event, and adapter interfaces\"]},\"forbidden_scope\":[\"concrete combat/exploration/UI\",\"account or network client\",\"target-specific campaign rules\"],\"verification\":\"A dependency-rule test rejects forbidden core imports and a fixture adapter proves command-only interaction.\",\"human_external_gate\":\"None; retain GATE-0001 for tool-specific enforcement.\",\"complexity\":\"medium\",\"status\":\"current\"},\nprojects/mock-fantasy-quest-4/planning/implementation-catalogue-index.json:10:    {\"id\":\"IMP-0003\",\"title\":\"Create deterministic test and fixture harness\",\"domain\":\"tests\",\"targets\":[\"shared\",\"web\",\"pwa\"],\"requirement_ids\":[\"NFR-0010\",\"NFR-0012\"],\"bounded_outcome\":\"Layered unit, content, integration, and reserved browser-test conventions provide isolated RNG/clock and persistence fixtures with no real service or player data access.\",\"prerequisites\":[\"IMP-0001\",\"IMP-0002\"],\"ownership\":{\"files\":[\"test-runner configuration\",\"tests/{core,content,platform,app}/fixtures\",\"docs/testing.md\"],\"data\":[\"deterministic fixture factories\"],\"api\":[\"test fixture and fake clock/RNG interfaces\"]},\"forbidden_scope\":[\"final feature assertions\",\"real browser/device matrix claims\",\"production telemetry\"],\"verification\":\"Repeated core fixture execution has identical results; a deliberately failing fixture is detected; fixture storage is isolated.\",\"human_external_gate\":\"GATE-0002 before compatibility or performance claims.\",\"complexity\":\"medium\",\"status\":\"current\"},\nprojects/mock-fantasy-quest-4/planning/implementation-catalogue-index.json-11-    {\"id\":\"IMP-0004\",\"title\":\"Define deterministic campaign state and command contract\",\"domain\":\"data\",\"targets\":[\"shared\"],\"requirement_ids\":[\"REQ-0001\",\"REQ-0003\",\"REQ-0004\",\"REQ-0006\",\"NFR-0002\",\"NFR-0010\"],\"bounded_outcome\":\"Immutable versioned state, command/result/event envelopes, revision and interaction identifiers, deterministic RNG state, and invariant helpers define legal transition mechanics without feature state machines.\",\"prerequisites\":[\"IMP-0002\",\"IMP-0003\"],\"ownership\":{\"files\":[\"src/core/{state,commands,events,invariants,rng}/\",\"tests/core/contract.*\"],\"data\":[\"campaign snapshot envelope\",\"deterministic RNG state\"],\"api\":[\"Core command/state/event API\"]},\"forbidden_scope\":[\"authored values\",\"combat/inventory/quest algorithms\",\"save driver\",\"UI selection state\",\"account/network state\"],\"verification\":\"Invalid and stale commands do not mutate state; duplicate interaction IDs cause no extra durable transition.\",\"human_external_gate\":\"GATE-0004 before concrete party/content shapes.\",\"complexity\":\"high\",\"status\":\"current\"},\nprojects/mock-fantasy-quest-4/planning/implementation-catalogue-index.json:12:    {\"id\":\"IMP-0005\",\"title\":\"Define versioned content schema and validation boundary\",\"domain\":\"content\",\"targets\":[\"shared\"],\"requirement_ids\":[\"REQ-0002\",\"REQ-0008\",\"NFR-0007\",\"NFR-0008\"],\"bounded_outcome\":\"Typed content-package schema and validator cover IDs, references, locale keys, assets, predicates, rewards, and reachability but contain no authored campaign expression.\",\"prerequisites\":[\"IMP-0001\",\"IMP-0004\",\"IMP-0003\"],\"ownership\":{\"files\":[\"src/content/{schema,validator,registry}/\",\"tests/content/validation.*\",\"docs/content-authoring.md\"],\"data\":[\"versioned content package format\",\"asset/provenance manifest schema\"],\"api\":[\"content registry and validator API\"]},\"forbidden_scope\":[\"town/dungeon dialogue/maps/assets\",\"copied reference expression\",\"release packaging\"],\"verification\":\"Valid minimum package passes; each invalid reference class fails; a graph fixture checks opening-to-ending reachability.\",\"human_external_gate\":\"GATE-0004 for quantities, locale, and content detail; human provenance review remains required.\",\"complexity\":\"high\",\"status\":\"current\"},\nprojects/mock-fantasy-quest-4/planning/implementation-catalogue-index.json-13-    {\"id\":\"IMP-0006\",\"title\":\"Specify local save and recovery protocol\",\"domain\":\"persistence\",\"targets\":[\"shared\",\"web\",\"pwa\"],\"requirement_ids\":[\"REQ-0006\",\"REQ-0012\",\"NFR-0002\",\"NFR-0003\",\"NFR-0005\"],\"bounded_outcome\":\"A schema protocol specifies immutable revisions, checksums, current-pointer validation, known-good retention, quarantine, separate preferences, deletion confirmation, and safe-boundary persistence rules.\",\"prerequisites\":[\"IMP-0002\",\"IMP-0004\",\"IMP-0003\"],\"ownership\":{\"files\":[\"src/core/save/{schema,compatibility,migrations}/\",\"src/platform/web/persistence/\",\"tests/{core,platform}/save*\",\"docs/save-and-recovery.md\"],\"data\":[\"save snapshot and preference schemas\",\"quarantine record\"],\"api\":[\"snapshot repository and recovery protocol\"]},\"forbidden_scope\":[\"cloud sync\",\"identity\",\"PWA cache records\",\"eviction guarantee\"],\"verification\":\"Fault fixtures cover interrupted write, checksum failure, malformed data, quota/permission failure, quarantine, retry, and selected-slot deletion.\",\"human_external_gate\":\"GATE-0003 / DEC-0003 storage API, quota, support window, and recovery policy.\",\"complexity\":\"high\",\"status\":\"gated\"},\nprojects/mock-fantasy-quest-4/planning/implementation-catalogue-index.json-14-    {\"id\":\"IMP-0007\",\"title\":\"Define pure save migration runner\",\"domain\":\"persistence\",\"targets\":[\"shared\",\"web\",\"pwa\"],\"requirement_ids\":[\"REQ-0006\",\"NFR-0002\",\"NFR-0003\"],\"bounded_outcome\":\"Ordered, pure migrations declare supported versions and promote only validated candidates while preserving original invalid bytes for quarantine.\",\"prerequisites\":[\"IMP-0005\",\"IMP-0006\"],\"ownership\":{\"files\":[\"src/core/save/{migrations,compatibility}/\",\"tests/core/save/fixtures\"],\"data\":[\"migration registry and predecessor fixtures\"],\"api\":[\"migration runner API\"]},\"forbidden_scope\":[\"storage driver changes\",\"future data export\",\"automatic destructive repair\"],\"verification\":\"Every declared predecessor migrates once; unsupported or failed migration leaves the original candidate intact and quarantined.\",\"human_external_gate\":\"GATE-0003 / DEC-0003 support-window approval.\",\"complexity\":\"medium\",\"status\":\"gated\"},\nprojects/mock-fantasy-quest-4/planning/implementation-catalogue-index.json-15-    {\"id\":\"IMP-0008\",\"title\":\"Bound P0 identity, authorization, and connected-service exclusions\",\"domain\":\"security\",\"targets\":[\"shared\",\"web\",\"pwa\"],\"requirement_ids\":[\"REQ-0013\",\"REQ-0014\",\"REQ-0015\",\"NFR-0012\"],\"bounded_outcome\":\"Architecture and negative contract tests demonstrate that local campaign start/save/resume require no account identifier, token, remote profile, role, entitlement, multiplayer, or safety service.\",\"prerequisites\":[\"IMP-0002\",\"IMP-0004\"],\"ownership\":{\"files\":[\"docs/security-boundary.md\",\"tests/core/connected-scope-exclusion.*\"],\"data\":[\"future connected-service approval checklist\"],\"api\":[\"local-slot identity contract\"]},\"forbidden_scope\":[\"sign-in\",\"OAuth\",\"sync\",\"roles\",\"moderation\",\"purchases\",\"server APIs\"],\"verification\":\"Static scan and negative fixtures find no identity/token/privilege fields or network client in P0 foundation modules.\",\"human_external_gate\":\"GATE-0006 / DEC-0006 before any connected implementation.\",\"complexity\":\"low\",\"status\":\"current\"},\nprojects/mock-fantasy-quest-4/planning/implementation-catalogue-index.json-16-    {\"id\":\"IMP-0009\",\"title\":\"Define privacy-safe local diagnostics boundary\",\"domain\":\"privacy\",\"targets\":[\"web\",\"pwa\"],\"requirement_ids\":[\"REQ-0012\",\"NFR-0006\"],\"bounded_outcome\":\"A bounded local diagnostic schema, consent and clear controls, redaction rules, and no-network guardrails support future player recovery without collecting save or dialogue payloads.\",\"prerequisites\":[\"IMP-0002\",\"IMP-0003\",\"IMP-0006\"],\"ownership\":{\"files\":[\"src/platform/web/diagnostics/\",\"src/app/recovery/diagnostic-contract.*\",\"tests/platform/diagnostics.*\",\"docs/privacy-and-recovery.md\"],\"data\":[\"redacted local diagnostic record\",\"consent state\"],\"api\":[\"diagnostic recorder interface\"]},\"forbidden_scope\":[\"diagnostic provider/transport\",\"remote analytics\",\"retention promise\",\"secrets\"],\"verification\":\"Tests prove diagnostics are absent without consent, redact payloads, and can be deleted locally.\",\"human_external_gate\":\"GATE-0005 / DEC-0005 before transport, retention, hosting, or support claims.\",\"complexity\":\"medium\",\"status\":\"gated\"},\nprojects/mock-fantasy-quest-4/planning/implementation-catalogue-index.json:17:    {\"id\":\"IMP-0010\",\"title\":\"Establish semantic accessibility design tokens\",\"domain\":\"accessibility\",\"targets\":[\"shared\",\"web\",\"pwa\"],\"requirement_ids\":[\"REQ-0007\",\"REQ-0010\",\"NFR-0004\",\"NFR-0008\"],\"bounded_outcome\":\"Original semantic tokens cover typography, spacing, focus, motion, touch targets, status, contrast, and non-colour cues, enabling later responsive web UI and inherited PWA UI.\",\"prerequisites\":[\"IMP-0001\",\"IMP-0002\"],\"ownership\":{\"files\":[\"src/app/design/tokens/\",\"docs/design-tokens.md\",\"tests/app/design-tokens.*\"],\"data\":[\"semantic token inventory\"],\"api\":[\"token consumption contract\"]},\"forbidden_scope\":[\"screens\",\"maps\",\"final artwork/fonts\",\"final breakpoints\",\"copied reference styling\"],\"verification\":\"Token validation proves semantic labels/non-colour cues and reduced-motion values in representative fixtures.\",\"human_external_gate\":\"GATE-0002 and GATE-0004 before numeric contrast/font/breakpoint claims.\",\"complexity\":\"medium\",\"status\":\"gated\"},\nprojects/mock-fantasy-quest-4/planning/implementation-catalogue-index.json-18-    {\"id\":\"IMP-0011\",\"title\":\"Create original-content provenance control\",\"domain\":\"content\",\"targets\":[\"shared\"],\"requirement_ids\":[\"REQ-0001\",\"REQ-0008\",\"NFR-0008\"],\"bounded_outcome\":\"A provenance record format, review checklist, and source-asset manifest make authorship and permitted functional reference scope auditable before authored content enters a build.\",\"prerequisites\":[\"IMP-0005\"],\"ownership\":{\"files\":[\"assets/source-manifest.*\",\"docs/original-content-review.md\",\"tests/content/provenance.*\"],\"data\":[\"provenance manifest and review disposition\"],\"api\":[\"provenance validator input contract\"]},\"forbidden_scope\":[\"creating art/audio/story\",\"licensing approval\",\"automatic legal clearance\"],\"verification\":\"Validator rejects missing provenance fields; human creative review is recorded for each authored package.\",\"human_external_gate\":\"Human creative/provenance review; legal or licensing review if applicable under GATE-0007.\",\"complexity\":\"low\",\"status\":\"current\"},\nprojects/mock-fantasy-quest-4/planning/implementation-catalogue-index.json-19-    {\"id\":\"IMP-0012\",\"title\":\"Document foundation architecture and recovery boundaries\",\"domain\":\"documentation\",\"targets\":[\"shared\",\"web\",\"pwa\"],\"requirement_ids\":[\"NFR-0012\",\"NFR-0010\",\"NFR-0002\",\"NFR-0003\"],\"bounded_outcome\":\"Developer documentation records ownership, command flow, save-versus-cache separation, deferred connected scope, and the decisions/gates that later domain authors must preserve.\",\"prerequisites\":[\"IMP-0002\",\"IMP-0004\",\"IMP-0006\",\"IMP-0008\"],\"ownership\":{\"files\":[\"docs/{architecture,development,save-and-recovery,security-boundary}.md\"],\"data\":[\"foundation decision and ownership index\"],\"api\":[\"documented public-boundary inventory\"]},\"forbidden_scope\":[\"player release guide\",\"operational rollout\",\"claiming approved vendor or policy choices\"],\"verification\":\"Documentation review cross-checks every foundation contract's ownership, dependency, and gate against this catalogue.\",\"human_external_gate\":\"None; approval gates are documented, not resolved.\",\"complexity\":\"low\",\"status\":\"current\"}\nprojects/mock-fantasy-quest-4/planning/implementation-catalogue-index.json-20-  ],\nprojects/mock-fantasy-quest-4/planning/implementation-catalogue-index.json-21-  \"expansion_queue\": [\nprojects/mock-fantasy-quest-4/planning/implementation-catalogue-index.json-22-    {\"id\":\"SHARD-02\",\"title\":\"Campaign content and domain logic\",\"max_contracts\":250,\"