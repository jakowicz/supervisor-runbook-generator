[stderr] def process_is_running(pid: int | None) -> bool:
[stderr]     if not pid:
[stderr]         return False
[stderr]     try:
[stderr]         os.kill(pid, 0)
[stderr]     except ProcessLookupError:
[stderr]         return False
[stderr]     except PermissionError:
[stderr]         # A status command may be sandboxed more tightly than the parent
[stderr]         # Supervisor process. Permission denied still proves that the PID
[stderr]         # exists, so report it as active.
[stderr]         return True
[stderr]     return True
[stderr] 
[stderr] 
[stderr] def load_states(database: Path) -> list[sqlite3.Row]:
[stderr]     if not database.is_file():
[stderr]         return []
[stderr]     connection = sqlite3.connect(f"file:{database}?mode=ro", uri=True)
[stderr]     connection.row_factory = sqlite3.Row
[stderr]     try:
[stderr]         try:
[stderr]             return connection.execute(
[stderr]                 "SELECT task_id, status, active_pid, next_action, continuation_summary, updated_at FROM task_state ORDER BY task_id"
[stderr]             ).fetchall()
[stderr]         except sqlite3.OperationalError as error:
[stderr]             # Child state databases are created before their first task is
[stderr]             # claimed. An empty SQLite file is therefore valid progress state,
[stderr]             # not a status-command failure.
[stderr]             if "no such table: task_state" in str(error):
[stderr]                 return []
[stderr]             raise
[stderr]     finally:
[stderr]         connection.close()
[stderr] 
[stderr] 
[stderr] def collection_progress(
[stderr]     task_ids: list[str],
[stderr]     states: list[sqlite3.Row],
[stderr]     *,
[stderr]     creation_label: str = "files created",
[stderr] ) -> str:
[stderr]     """Summarise one named runbook collection.
[stderr] 
[stderr]     A shared state database can hold several collections (for example, B-series
[stderr]     authoring batches and C/D-series coordination runbooks).  Callers must pass
[stderr]     only the states belonging to the collection being displayed.
[stderr]     """
[stderr]     recorded = {row["task_id"] for row in states}
[stderr]     accepted = sum(row["status"] == "accepted" for row in states)
[stderr]     active = [row for row in states if row["status"] != "accepted" and process_is_running(row["active_pid"])]
[stderr]     needs_attention = [
[stderr]         row
[stderr]         for row in states
[stderr]         if row["status"] != "accepted" and row not in active
[stderr]     ]
[stderr]     not_yet_run = sum(task_id not in recorded for task_id in task_ids)
[stderr]     parts = [f"{len(task_ids)} {creation_label}", f"{accepted} accepted"]
[stderr]     if active:
[stderr]         parts.append(f"{len(active)} running")
[stderr]     if needs_attention:
[stderr]         parts.append(f"{len(needs_attention)} needs attention")
[stderr]     if not_yet_run:
[stderr]         parts.append(f"{not_yet_run} not yet run")
[stderr]     return " · ".join(parts)
[stderr] 
[stderr] 
[stderr] def states_for(task_ids: list[str], states: list[sqlite3.Row]) -> list[sqlite3.Row]:
[stderr]     """Return durable task states that belong to ``task_ids`` only."""
[stderr]     identifiers = set(task_ids)
[stderr]     return [row for row in states if row["task_id"] in identifiers]
