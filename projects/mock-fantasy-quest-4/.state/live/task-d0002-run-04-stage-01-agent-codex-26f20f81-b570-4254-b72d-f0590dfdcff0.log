rchitecture-and-requirement-traceability\"],\"source_catalogue_ids\":[\"IMP-0001\"],\"authoring_batch\":\"B0001\",\"factory_stages\":[\"F011\",\"F012\",\"F013\"],\"asset_impact\":\"not_applicable\",\"asset_ids\":[],\"asset_brief\":\"No product asset work; establish only project/tooling boundaries and prohibit incidental assets.\",\"acceptance_checks\":[\"documented deterministic baseline command\",\"isolated ownership directories\",\"GATE-0001 retained\"],\"checkpoint_cadence\":\"after metadata, after draft, before manifest acceptance\",\"recovery\":\"retain ID and path; repair only this contract\"},\n@@ -43,6 +46,14 @@\n     {\"id\":\"R0009\",\"catalogue_id\":\"IMP-0009\",\"title\":\"Define privacy-safe local diagnostics boundary\",\"dependencies\":[\"R0002\",\"R0003\",\"R0006\"],\"output_path\":\"projects/mock-fantasy-quest-4/runbooks/R0009.md\",\"source_specifications\":[\"specification/03-technical-contract.md#trust-privacy-and-security\",\"specification/04-experience-contract.md#empty-error-recovery-destructive-and-privacy-sensitive-states\"],\"source_catalogue_ids\":[\"IMP-0009\"],\"authoring_batch\":\"B0005\",\"factory_stages\":[\"F011\",\"F012\",\"F013\"],\"asset_impact\":\"not_applicable\",\"asset_ids\":[],\"asset_brief\":\"No assets; local redacted records only.\",\"acceptance_checks\":[\"consent and deletion controls\",\"payload redaction\",\"no network transport\",\"GATE-0005 retained\"],\"checkpoint_cadence\":\"after metadata, after draft, before manifest acceptance\",\"recovery\":\"retain ID and wait for privacy gate where required\"},\n     {\"id\":\"R0010\",\"catalogue_id\":\"IMP-0010\",\"title\":\"Establish semantic accessibility design tokens\",\"dependencies\":[\"R0001\",\"R0002\"],\"output_path\":\"projects/mock-fantasy-quest-4/runbooks/R0010.md\",\"source_specifications\":[\"specification/04-experience-contract.md#layout-visual-tokens-and-responsive-behaviour\",\"specification/04-experience-contract.md#accessibility-policy\"],\"source_catalogue_