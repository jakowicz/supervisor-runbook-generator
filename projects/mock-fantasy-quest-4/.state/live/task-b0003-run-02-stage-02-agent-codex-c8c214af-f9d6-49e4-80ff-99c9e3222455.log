y this contract\"},\n    {\"id\":\"R0004\",\"catalogue_id\":\"IMP-0004\",\"title\":\"Define deterministic campaign state and command contract\",\"dependencies\":[\"R0002\",\"R0003\"],\"output_path\":\"projects/mock-fantasy-quest-4/runbooks/R0004.md\",\"source_specifications\":[\"specification/03-technical-contract.md#data-contract\",\"specification/03-technical-contract.md#commands-validation-idempotency-and-concurrency\"],\"source_catalogue_ids\":[\"IMP-0004\"],\"authoring_batch\":\"B0003\",\"factory_stages\":[\"F011\",\"F012\",\"F013\"],\"asset_impact\":\"not_applicable\",\"asset_ids\":[],\"asset_brief\":\"No assets; state envelopes deliberately exclude authored content.\",\"acceptance_checks\":[\"stale and invalid commands do not mutate state\",\"duplicate interaction is idempotent\"],\"checkpoint_cadence\":\"after metadata, after draft, before manifest acceptance\",\"recovery\":\"retain ID and repair only this contract\"},\n    {\"id\":\"R0005\",\"catalogue_id\":\"IMP-0005\",\"title\":\"Define versioned content schema and validation boundary\",\"dependencies\":[\"R0001\",\"R0003\",\"R0004\"],\"output_path\":\"projects/mock-fantasy-quest-4/runbooks/R0005.md\",\"source_specifications\":[\"specification/03-technical-contract.md#versioned-content-and-save-schemas\",\"specification/02-feature-model.md#domain-vocabulary-and-state-ownership\"],\"source_catalogue_ids\":[\"IMP-0005\"],\"authoring_batch\":\"B0004\",\"factory_stages\":[\"F011\",\"F012\",\"F013\"],\"asset_impact\":\"not_applicable\",\"asset_ids\":[],\"asset_brief\":\"No art/audio assets; reserve only schema/provenance fields for later original assets.\",\"acceptance_checks\":[\"valid minimal package passes\",\"invalid references fail\",\"reachability fixture\"],\"checkpoint_cadence\":\"after metadata, after draft, before manifest acceptance\",\"recovery\":\"retain ID and repair only this contract\"},\n    {\"id\":\"R0006\",\"catalogue_id\":\"IMP-0006\",\"title\":\"Specify local save and recovery protocol\",\"dependencies\":[\"R0002\",\"R0003\",\"R0004\"],\"output_path\":\"projects/mock-fantasy-quest-4/runbooks/R0006.md\",\"source_specifications\":[\"specification/03-technical-contract.md#persistence-migration-and-failure-semantics\",\"specification/04-experience-contract.md#empty-error-recovery-destructive-and-privacy-sensitive-states\"],\"source_catalogue_ids\":[\"IMP-0006\"],\"authoring_batch\":\"B0004\",\"factory_stages\":[\"F011\",\"F012\",\"F013\"],\"asset_impact\":\"not_applicable\",\"asset_ids\":[],\"asset_brief\":\"No assets; protocol is data/recovery only.\",\"acceptance_checks\":[\"fault fixtures cover write and validation failures\",\"save/cache separation\",\"GATE-0003 retained\"],\"checkpoint_cadence\":\"after metadata, after draft, before manifest acceptance\",\"recovery\":\"retain ID; wait for storage decision before accepting gated work\"},\n    {\"id\":\"R0007\",\"catalogue_id\":\"IMP-0007\",\"title\":\"Define pure save migration runner\",\"dependencies\":[\"R0005\",\"R0006\"],\"output_path\":\"projects/mock-fantasy-quest-4/runbooks/R0007.md\",\"source_specifications\":[\"specification/03-technical-contract.md#persistence-migration-and-failure-semantics\"],\"source_catalogue_ids\":[\"IMP-0007\"],\"authoring_batch\":\"B0005\",\"factory_stages\":[\"F011\",\"F012\",\"F013\"],\"asset_impact\":\"not_applicable\",\"asset_ids\":[],\"asset_brief\":\"No assets; migration fixtures retain original bytes only.\",\"acceptance_checks\":[\"predecessors migrate once\",\"failed candidate remains intact\",\"GATE-0003 retained\"],\"checkpoint_cadence\":\"after metadata, after draft, before manifest acceptance\",\"recovery\":\"retain ID and resume after R0006/gate closure\"},\n    {\"id\":\"R0008\",\"catalogue_id\":\"IMP-0008\",\"title\":\"Bound P0 identity, authorization, and connected-service exclusions\",\"dependencies\":[\"R0002\",\"R0004\"],\"output_path\":\"projects/mock-fantasy-quest-4/runbooks/R0008.md\",\"source_specifications\":[\"specification/03-technical-contract.md#trust-privacy-and-security\"],\"source_catalogue_ids\":[\"IMP-0008\"],\"authoring_batch\":\"B0003\",\"factory_stages\":[\"F011\",\"F012\",\"F013\"],\"asset_impact\":\"not_applicable\",\"asset_ids\":[],\"asset_brief\":\"No assets; a negative scope boundary.\",\"acceptance_checks\":[\"no identity/token/network fields\",\"future connected work remains gated\"],\"checkpoint_cadence\":\"after metadata, after draft, before manifest acceptance\",\"recovery\":\"retain ID and repair only this contract\"},\n    {\"id\":\"R0009\",\"catalogue_id\":\"IMP-0009\",\"title\":\"Define privacy-safe local diagnostics boundary\",\"dependencies\":[\"R0002\",\"R0003\",\"R0006\"],\"output_path\":\"projects/mock-fantasy-quest-4/runbooks/R0009.md\",\"source_specifications\":[\"specification/03-technical-contract.md#trust-privacy-and-security\",\"specification/04-experience-contract.md#empty-error-recovery-destructive-and-privacy-sensitive-states\"],\"source_catalogue_ids\":[\"IMP-0009\"],\"authoring_batch\":\"B0005\",\"factory_stages\":[\"F011\",\"F012\",\"F013\"],\"asset_impact\":\"not_applicable\",\"asset_ids\":[],\"asset_brief\":\"No assets; local redacted records only.\",\"acceptance_checks\":[\"consent and deletion controls\",\"payload redaction\",\"no network transport\",\"GATE-0005 retained\"],\"checkpoint_cadence\":\"after metadata, after draft, before manifest acceptance\",\"recovery\":\"retain ID and wait for privacy gate where required\"},\n    {\"id\":\"R0010\",\"catalogue_id\":\"IMP-0010\",\"title\":\"Establish semantic accessibility design tokens\",\"dependencies\":[\"R0001\",\"R0002\"],\"output_path\":\"projects/mock-fantasy-quest-4/runbooks/R0010.md\",\"source_specifications\":[\"specification/04-experience-contract.md#layout-visual-tokens-and-responsive-behaviour\",\"specification/04-experience-contract.md#accessibility-policy\"],\"source_catalogue_ids\":[\"IMP-0010\"],\"authoring_batch\":\"B0002\",\"factory_stages\":[\"F011\",\"F012\",\"F013\"],\"asset_impact\":\"not_applicable\",\"asset_ids\":[],\"asset_brief\":\"No final artwork, fonts, or icons; semantic tokens only and prohibit incidental assets.\",\"acceptance_checks\":[\"non-colour cues\",\"reduced motion values\",\"GATE-0002,GATE-0004 retained\"],\"checkpoint_cadence\":\"after metadata, after draft, before manifest acceptance\",\"recovery\":\"retain ID and await numeric design decisions\"},\n    {\"id\":\"R0011\",\"catalogue_id\":\"IMP-0011\",\"title\":\"Create original-content provenance control\",\"dependencies\":[\"R0005\"],\"output_path\":\"projects/mock-fantasy-quest-4/runbooks/R0011.md\",\"source_specifications\":[\"specification/01-product-brief.md#originality-boundary\",\"specification/04-experience-contract.md#experience-premise-and-originality-boundary\"],\"source_catalogue_ids\":[\"IMP-0011\"],\"authoring_batch\":\"B0005\",\"factory_stages\":[\"F011\",\"F012\",\"F013\"],\"asset_impact\":\"not_applicable\",\"asset_ids\":[],\"asset_brief\":\"No assets are created; this contract defines provenance controls for later asset-required work.\",\"acceptance_checks\":[\"missing provenance rejected\",\"human creative review recorded\"],\"checkpoint_cadence\":\"after metadata, after draft, before manifest acceptance\",\"recovery\":\"retain ID and repair only this contract\"},\n    {\"id\":\"R0012\",\"catalogue_id\":\"IMP-0012\",\"title\":\"Document foundation architecture and recovery boundaries\",\"dependencies\":[\"R0002\",\"R0004\",\"R0006\",\"R0008\"],\"output_path\":\"projects/mock-fantasy-quest-4/runbooks/R0012.md\",\"source_specifications\":[\"specification/03-technical-contract.md#architecture-and-requirement-traceability\",\"specification/03-technical-contract.md#persistence-migration-and-failure-semantics\",\"specification/03-technical-contract.md#trust-privacy-and-security\"],\"source_catalogue_ids\":[\"IMP-0012\"],\"authoring_batch\":\"B0006\",\"factory_stages\":[\"F011\",\"F012\",\"F013\"],\"asset_impact\":\"not_applicable\",\"asset_ids\":[],\"asset_brief\":\"No assets; developer-documentation closure only.\",\"acceptance_checks\":[\"all foundation ownership/dependencies/gates cross-checked\",\"does not claim release readiness\"],\"checkpoint_cadence\":\"after metadata, after draft, before manifest acceptance\",\"recovery\":\"retain ID and repair only this documentation contract\"}\n  ]\n}\n---\ntask_id: R0004\nsequence: 4\ntitle: Define deterministic campaign state and command contract\ndependencies:\n  - R0002\n  - R0003\nrequirement_ids:\n  - REQ-0001\n  - REQ-0003\n  - REQ-0004\n  - REQ-0006\n  - NFR-0002\n  - NFR-0010\nsource_specifications:\n  - specification/03-technical-contract.md#data-contract\n  - specification/03-technical-contract.md#commands-validation-idempotency-and-concurrency\nsource_catalogue_ids:\n  - IMP-0004\nauthoring_batch: B0003\nfactory_stages:\n  - F011\n  - F012\n  - F013\nasset_impact: not_applicable\nasset_ids:\nasset_brief: No assets; state envelopes deliberately exclude authored content.\naudio_impact: not_applicable\naudio_ids:\naudio_brief:\naudio_duration_seconds: 0\naudio_loop: not_applicable\naudio_style_version:\nbrowser_impact: not_applicable\nplaywright_spec:\n---\n\n## Objective\n\nDefine the immutable, versioned shared campaign-state, command, result, event,\nrevision, interaction-ID, and deterministic-RNG contracts needed to validate\nlegal transitions. This foundation defines envelopes and invariants only; it\ndoes not introduce a feature state machine or authored campaign values.\n\n## Dependencies\n\nR0002 provides the shared-core/adapter seam and R0003 provides deterministic\nfixtures. They are implementation dependencies, not authoring blockers.\nRetain GATE-0004: concrete party and content shapes remain unapproved.\n\n## Ownership\n\n- `src/core/{state,commands,events,invariants,rng}/`.\n- The versioned campaign-snapshot envelope and deterministic RNG state.\n- The public core command, state, event, result, revision, and interaction-ID\n  interfaces, plus `tests/core/contract.*`.\n\n## Required behaviour\n\nMake state transitions pure and explicit: a command carries an expected\ncampaign revision and stable interaction/action ID; processing returns either\na typed rejection with no mutation or ordered state/events with a new revision.\nValidate command shape, session state, identifiers, availability, eligibility,\npredicates, and expected revision before any transition. Invariant helpers\nmust reject invalid state and preserve the prior immutable state.\n\nRecord deterministic RNG seed/state at safe boundaries. Require idempotency for\nretries: a duplicate interaction ID or acknowledged durable transition returns\nits prior result without a second reward, checkpoint, or revision-changing\ntransition. Process one command at a time per active campaign and reject stale\nwriters so visibility changes, repeated input, and concurrent tabs cannot\ninterleave a transition.\n\n## Web and PWA differences\n\nWeb and PWA adapters submit the same shared command envelopes and consume the\nsame state/event results. Platform adapters may debounce controls and manage a\nlocal slot lease/read-only warning, but neither gains authority to mutate state\ndirectly. Installation, cache lifecycle, and storage-driver work are outside\nthis contract.\n\n## Non-goals\n\nDo not author content values; implement combat, inventory, quest, exploration,\nor UI state machines; select party shapes; implement a save driver or cache;\nadd account, identity, token, role, network, or remote state; or create assets,\naudio, maps, dialogue, or reference-derived content.\n\n## Asset assessment\n\n`asset_impact` is `not_applicable`: these serializable state and interface\ncontracts deliberately exclude authored content. Do not create or reserve\nincidental visual, source, audio, font, icon, illustration, texture, sprite,\nmap, or other product assets; `asset_ids` remains blank.\n\n## Verification\n\n- Use R0003 deterministic fixtures to prove invalid commands leave the exact\n  prior state unchanged and stale revisions reject without mutation.\n- Prove a duplicate interaction ID returns the recorded prior outcome and\n  produces no additional durable transition.\n- Exercise controlled RNG state twice and compare state/event results.\n- Exercise sequential command handling and a stale-writer fixture without\n  selecting a browser-storage implementation.\n- Record GATE-0004 as retained before adding concrete party/content shapes.\n\n## Evidence\n\nRetain contract-test output for invalid, stale, duplicate, deterministic-RNG,\nand serialized transition cases, plus the public envelope/invariant inventory\nand the retained GATE-0004 record.\n\n## Acceptance criteria\n\n- Invalid or stale commands cannot mutate campaign state.\n- Duplicate interaction IDs are idempotent and cause no extra durable\n  transition.\n- State, command, result, event, revision, and RNG contracts are shared-core\n  only, versioned where serialized, and independent of concrete content,\n  persistence drivers, or connected scope.\n---\ntask_id: R0008\nsequence: 8\ntitle: Bound P0 identity, authorization, and connected-service exclusions\ndependencies:\n  - R0002\n  - R0004\nrequirement_ids:\n  - REQ-0013\n  - REQ-0014\n  - REQ-0015\n  - NFR-0012\nsource_specifications:\n  - specification/03-technical-contract.md#trust-privacy-and-security\nsource_catalogue_ids:\n  - IMP-0008\nauthoring_batch: B0003\nfactory_stages:\n  - F011\n  - F012\n  - F013\nasset_impact: not_applicable\nasset_ids:\nasset_brief: No assets; a negative scope boundary.\naudio_impact: not_applicable\naudio_ids:\naudio_brief:\naudio_duration_seconds: 0\naudio_loop: not_applicable\naudio_style_version:\nbrowser_impact: not_applicable\nplaywright_spec:\n---\n\n## Objective\n\nDocument and test the P0 negative boundary: local campaign start, save, and\nresume require no account identifier, token, remote profile, authorization\nrole, entitlement, multiplayer, moderation, safety, or connected service.\n\n## Dependencies\n\nR0002 supplies the core/adapter dependency seam and R0004 supplies the local\ncampaign state envelope. They are implementation dependencies. Retain\nGATE-0006 / DEC-0006: no connected feature may be implemented until its scope,\nprivacy, security, operational, cost, and failure-mode decisions are approved.\n\n## Ownership\n\n- `docs/security-boundary.md`.\n- `tests/core/connected-scope-exclusion.*`.\n- The future connected-service approval checklist and local-slot identity\n  contract.\n\n## Required behaviour\n\nState that the local browser profile is the P0 player boundary, not an account\nor authorization guarantee. The local campaign is the source of truth and has\nno remote profile, analytics stream, purchase ledger, match state, cloud\nbackup, role, privilege, or entitlement. Local slot selection is an opaque\nlocal reference only and must not contain identity, token, privilege, or remote\nprofile fields.\n\nAdd negative contract tests and a static boundary scan for P0 foundation\nmodules. They must fail on identity/token/role/entitlement fields, network or\nserver clients, sign-in/OAuth/sync paths, multiplayer/safety/moderation APIs,\npurchase flows, or remote campaign authority. Treat future replication, if\never approved, as a separate optional mirror rather than campaign truth.\n\n## Web and PWA differences\n\nResponsive web and installed PWA use the same local-slot contract and same\nconnected-scope exclusion. PWA installation, cache, and browser-origin storage\ndo not imply identity, authorization, sync, or a remote service. No target\nobtains a distinct connected implementation path.\n\n## Non-goals\n\nDo not implement sign-in, OAuth, accounts, profiles, tokens, roles,\nauthorization, synchronization, server APIs, analytics transport, multiplayer,\nmoderation, reporting, purchases, entitlements, cloud saves, remote\ndiagnostics, or security claims about a device owner. Do not create product\nassets, audio, or connected-service configuration.\n\n## Asset assessment\n\n`asset_impact` is `not_applicable`: this is documentation and negative test\ncoverage for an architectural exclusion. Do not create or reserve incidental\nvisual, source, audio, icon, illustration, font, texture, sprite, map, or\nother product assets; `asset_ids` remains blank.\n\n## Verification\n\n- Run a static scan across P0 foundation modules for prohibited identity,\n  token, privilege, entitlement, and network/server-client fields or imports.\n- Run negative fixtures that attempt prohibited connected-scope configuration\n  and prove the contract rejects or does not expose it.\n- Verify start, local save, and local resume fixtures require only a local slot\n  reference and no remote request or account data.\n- Review `docs/security-boundary.md` against the exclusion list and record\n  GATE-0006 / DEC-0006 as retained for any future connected proposal.\n\n## Evidence\n\nRetain static-scan and negative-fixture results, local start/save/resume test\noutput showing no remote request, the security-boundary review, and the future\nconnected-service approval checklist with its retained gate.\n\n## Acceptance criteria\n\n- P0 start, save, and resume expose no identity, token, role, entitlement,\n  remote-profile, or network-client field or dependency.\n- Negative tests prevent connected-service scope from entering P0 foundation\n  modules for both web and PWA delivery paths.\n- Any future connected work remains outside campaign truth and blocked by\n  GATE-0006 / DEC-0006 rather than implicitly approved.\n\nexec\n/bin/zsh -lc \"sed -n '1,240p' projects/mock-fantasy-quest-4/runbooks/TEMPLATE.md; sed -n '1,260p' projects/mock-fantasy-quest-4/runbooks/F014.md; rg -n -C 6 'IMP-0004|IMP-0008' projects/mock-fantasy-quest-4/planning/implementation-catalogue-index.json; rg -n 'B0002|R0002|R0003|R0010' projects/mock-fantasy-quest-4/planning/runbook-authoring-manifest.json projects/mock-fantasy-quest-4/runbooks -g '*.md'; find projects/mock-fantasy-quest-4/runbooks -maxdepth 1 -type f -name 'R*.md' -print | sort\" in /Users/simon/Dev/github/jakowicz/runbook-generator\n succeeded in 0ms:\nsed: projects/mock-fantasy-quest-4/runbooks/TEMPLATE.md: No such file or directory\nsed: projects/mock-fantasy-quest-4/runbooks/F014.md: No such file or directory\n5-  \"scope\": \"P0 is an original, offline-capable 2D single-player fantasy RPG delivered through a shared web core and a PWA delivery adaptation. Connected services are not P0 implementation scope.\",\n6-  \"first_bounded_domain\": {\"id\": \"SHARD-01\", \"title\": \"Foundation and core contracts\", \"contract_limit\": 250, \"contract_count\": 12, \"state\": \"ready_for_authoring\", \"boundary\": \"Framework-neutral seams, deterministic state/data contracts, local persistence protocol, quality foundations, and original-design controls; excludes campaign rules, UI flows, PWA lifecycle, and release execution.\"},\n7-  \"contracts\": [\n8-    {\"id\":\"IMP-0001\",\"title\":\"Bootstrap reproducible shared project baseline\",\"domain\":\"foundation\",\"targets\":[\"shared\",\"web\",\"pwa\"],\"requirement_ids\":[\"NFR-0010\",\"NFR-0012\"],\"bounded_outcome\":\"A framework-neutral project skeleton documents one bootstrap, lint, format, and deterministic test command with isolated shared, web-adapter, PWA-adapter, content, and test directories.\",\"prerequisites\":[],\"ownership\":{\"files\":[\"root build/tooling configuration\",\"src/{core,content,app,platform/web,platform/pwa}/\",\"tests/\",\"docs/development.md\"],\"data\":[\"pinned toolchain declaration\"],\"api\":[\"build/test command interface\"]},\"forbidden_scope\":[\"selecting framework/package manager/CI without DEC-0001\",\"gameplay\",\"service worker\",\"hosting\"],\"verification\":\"Clean approved-runtime checkout runs the documented deterministic sample test, lint, and format checks.\",\"human_external_gate\":\"GATE-0001 / DEC-0001 framework, package-manager, and CI selection before implementation.\",\"complexity\":\"medium\",\"status\":\"gated\"},\n9-    {\"id\":\"IMP-0002\",\"title\":\"Enforce shared-core and adapter dependency seams\",\"domain\":\"foundation\",\"targets\":[\"shared\",\"web\",\"pwa\"],\"requirement_ids\":[\"NFR-0010\",\"REQ-0013\",\"NFR-0012\"],\"bounded_outcome\":\"A dependency policy and public interfaces prevent core code from importing browser, renderer, clock, network, or platform modules; adapters submit commands and render returned state/events.\",\"prerequisites\":[\"IMP-0001\"],\"ownership\":{\"files\":[\"src/core/public interfaces\",\"src/platform/{web,pwa}/adapter interfaces\",\"architecture dependency rules\",\"docs/architecture.md\"],\"data\":[\"dependency-policy manifest\"],\"api\":[\"Command, state, event, and adapter interfaces\"]},\"forbidden_scope\":[\"concrete combat/exploration/UI\",\"account or network client\",\"target-specific campaign rules\"],\"verification\":\"A dependency-rule test rejects forbidden core imports and a fixture adapter proves command-only interaction.\",\"human_external_gate\":\"None; retain GATE-0001 for tool-specific enforcement.\",\"complexity\":\"medium\",\"status\":\"current\"},\n10-    {\"id\":\"IMP-0003\",\"title\":\"Create deterministic test and fixture harness\",\"domain\":\"tests\",\"targets\":[\"shared\",\"web\",\"pwa\"],\"requirement_ids\":[\"NFR-0010\",\"NFR-0012\"],\"bounded_outcome\":\"Layered unit, content, integration, and reserved browser-test conventions provide isolated RNG/clock and persistence fixtures with no real service or player data access.\",\"prerequisites\":[\"IMP-0001\",\"IMP-0002\"],\"ownership\":{\"files\":[\"test-runner configuration\",\"tests/{core,content,platform,app}/fixtures\",\"docs/testing.md\"],\"data\":[\"deterministic fixture factories\"],\"api\":[\"test fixture and fake clock/RNG interfaces\"]},\"forbidden_scope\":[\"final feature assertions\",\"real browser/device matrix claims\",\"production telemetry\"],\"verification\":\"Repeated core fixture execution has identical results; a deliberately failing fixture is detected; fixture storage is isolated.\",\"human_external_gate\":\"GATE-0002 before compatibility or performance claims.\",\"complexity\":\"medium\",\"status\":\"current\"},\n11:    {\"id\":\"IMP-0004\",\"title\":\"Define deterministic campaign state and command contract\",\"domain\":\"data\",\"targets\":[\"shared\"],\"requirement_ids\":[\"REQ-0001\",\"REQ-0003\",\"REQ-0004\",\"REQ-0006\",\"NFR-0002\",\"NFR-0010\"],\"bounded_outcome\":\"Immutable versioned state, command/result/event envelopes, revision and interaction identifiers, deterministic RNG state, and invariant helpers define legal transition mechanics without feature state machines.\",\"prerequisites\":[\"IMP-0002\",\"IMP-0003\"],\"ownership\":{\"files\":[\"src/core/{state,commands,events,invariants,rng}/\",\"tests/core/contract.*\"],\"data\":[\"campaign snapshot envelope\",\"deterministic RNG state\"],\"api\":[\"Core command/state/event API\"]},\"forbidden_scope\":[\"authored values\",\"combat/inventory/quest algorithms\",\"save driver\",\"UI selection state\",\"account/network state\"],\"verification\":\"Invalid and stale commands do not mutate state; duplicate interaction IDs cause no extra durable transition.\",\"human_external_gate\":\"GATE-0004 before concrete party/content shapes.\",\"complexity\":\"high\",\"status\":\"current\"},\n12:    {\"id\":\"IMP-0005\",\"title\":\"Define versioned content schema and validation boundary\",\"domain\":\"content\",\"targets\":[\"shared\"],\"requirement_ids\":[\"REQ-0002\",\"REQ-0008\",\"NFR-0007\",\"NFR-0008\"],\"bounded_outcome\":\"Typed content-package schema and validator cover IDs, references, locale keys, assets, predicates, rewards, and reachability but contain no authored campaign expression.\",\"prerequisites\":[\"IMP-0001\",\"IMP-0004\",\"IMP-0003\"],\"ownership\":{\"files\":[\"src/content/{schema,validator,registry}/\",\"tests/content/validation.*\",\"docs/content-authoring.md\"],\"data\":[\"versioned content package format\",\"asset/provenance manifest schema\"],\"api\":[\"content registry and validator API\"]},\"forbidden_scope\":[\"town/dungeon dialogue/maps/assets\",\"copied reference expression\",\"release packaging\"],\"verification\":\"Valid minimum package passes; each invalid reference class fails; a graph fixture checks opening-to-ending reachability.\",\"human_external_gate\":\"GATE-0004 for quantities, locale, and content detail; human provenance review remains required.\",\"complexity\":\"high\",\"status\":\"current\"},\n13:    {\"id\":\"IMP-0006\",\"title\":\"Specify local save and recovery protocol\",\"domain\":\"persistence\",\"targets\":[\"shared\",\"web\",\"pwa\"],\"requirement_ids\":[\"REQ-0006\",\"REQ-0012\",\"NFR-0002\",\"NFR-0003\",\"NFR-0005\"],\"bounded_outcome\":\"A schema protocol specifies immutable revisions, checksums, current-pointer validation, known-good retention, quarantine, separate preferences, deletion confirmation, and safe-boundary persistence rules.\",\"prerequisites\":[\"IMP-0002\",\"IMP-0004\",\"IMP-0003\"],\"ownership\":{\"files\":[\"src/core/save/{schema,compatibility,migrations}/\",\"src/platform/web/persistence/\",\"tests/{core,platform}/save*\",\"docs/save-and-recovery.md\"],\"data\":[\"save snapshot and preference schemas\",\"quarantine record\"],\"api\":[\"snapshot repository and recovery protocol\"]},\"forbidden_scope\":[\"cloud sync\",\"identity\",\"PWA cache records\",\"eviction guarantee\"],\"verification\":\"Fault fixtures cover interrupted write, checksum failure, malformed data, quota/permission failure, quarantine, retry, and selected-slot deletion.\",\"human_external_gate\":\"GATE-0003 / DEC-0003 storage API, quota, support window, and recovery policy.\",\"complexity\":\"high\",\"status\":\"gated\"},\n14-    {\"id\":\"IMP-0007\",\"title\":\"Define pure save migration runner\",\"domain\":\"persistence\",\"targets\":[\"shared\",\"web\",\"pwa\"],\"requirement_ids\":[\"REQ-0006\",\"NFR-0002\",\"NFR-0003\"],\"bounded_outcome\":\"Ordered, pure migrations declare supported versions and promote only validated candidates while preserving original invalid bytes for quarantine.\",\"prerequisites\":[\"IMP-0005\",\"IMP-0006\"],\"ownership\":{\"files\":[\"src/core/save/{migrations,compatibility}/\",\"tests/core/save/fixtures\"],\"data\":[\"migration registry and predecessor fixtures\"],\"api\":[\"migration runner API\"]},\"forbidden_scope\":[\"storage driver changes\",\"future data export\",\"automatic destructive repair\"],\"verification\":\"Every declared predecessor migrates once; unsupported or failed migration leaves the original candidate intact and quarantined.\",\"human_external_gate\":\"GATE-0003 / DEC-0003 support-window approval.\",\"complexity\":\"medium\",\"status\":\"gated\"},\n15:    {\"id\":\"IMP-0008\",\"title\":\"Bound P0 identity, authorization, and connected-service exclusions\",\"domain\":\"security\",\"targets\":[\"shared\",\"web\",\"pwa\"],\"requirement_ids\":[\"REQ-0013\",\"REQ-0014\",\"REQ-0015\",\"NFR-0012\"],\"bounded_outcome\":\"Architecture and negative contract tests demonstrate that local campaign start/save/resume require no account identifier, token, remote profile, role, entitlement, multiplayer, or safety service.\",\"prerequisites\":[\"IMP-0002\",\"IMP-0004\"],\"ownership\":{\"files\":[\"docs/security-boundary.md\",\"tests/core/connected-scope-exclusion.*\"],\"data\":[\"future connected-service approval checklist\"],\"api\":[\"local-slot identity contract\"]},\"forbidden_scope\":[\"sign-in\",\"OAuth\",\"sync\",\"roles\",\"moderation\",\"purchases\",\"server APIs\"],\"verification\":\"Static scan and negative fixtures find no identity/token/privilege fields or network client in P0 foundation modules.\",\"human_external_gate\":\"GATE-0006 / DEC-0006 before any connected implementation.\",\"complexity\":\"low\",\"status\":\"current\"},\n16-    {\"id\":\"IMP-0009\",\"title\":\"Define privacy-safe local diagnostics boundary\",\"domain\":\"privacy\",\