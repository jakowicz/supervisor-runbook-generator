[stderr] #!/usr/bin/env python3
[stderr] """Structural quality gate for generated B-series and R-series runbooks.
[stderr] 
[stderr] This validates planning artefacts only; it is never product or release evidence.
[stderr] """
[stderr] from __future__ import annotations
[stderr] import argparse
[stderr] import json
[stderr] import re
[stderr] import sys
[stderr] from collections import Counter, defaultdict
[stderr] from pathlib import Path
[stderr] 
[stderr] ROOT = Path(__file__).resolve().parents[1]
[stderr] REPOSITORY = ROOT.parents[1]
[stderr] MANIFEST_PATH = ROOT / "planning/runbook-authoring-manifest.json"
[stderr] CATALOGUE_PATH = ROOT / "planning/implementation-catalogue-index.json"
[stderr] R_ID, F_ID = re.compile(r"^R\d{4}$"), re.compile(r"^F\d{3}$")
[stderr] 
[stderr] def values(value):
[stderr]     return value if isinstance(value, list) else ([value] if value else [])
[stderr] 
[stderr] def parse_value(value):
[stderr]     value = value.strip().strip("\"'")
[stderr]     if value == "[]": return []
[stderr]     if value.startswith("[") and value.endswith("]"):
[stderr]         return [item.strip().strip("\"'") for item in value[1:-1].split(",") if item.strip()]
[stderr]     return value
[stderr] 
[stderr] def front_matter(path):
[stderr]     text = path.read_text(encoding="utf-8")
[stderr]     if not text.startswith("---\n"): return {}
[stderr]     end = text.find("\n---", 4)
[stderr]     if end < 0: return {}
[stderr]     result, key = {}, None
[stderr]     for line in text[4:end].splitlines():
[stderr]         if line.lstrip().startswith("-") and key:
[stderr]             result.setdefault(key, []).append(parse_value(line.split("-", 1)[1]))
[stderr]         elif ":" in line:
[stderr]             key, value = line.split(":", 1); key = key.strip(); result[key] = parse_value(value)
[stderr]     return result
[stderr] 
[stderr] def headings(path):
[stderr]     return {re.sub(r"[^a-z0-9]+", "-", match.group(1).lower()).strip("-")
[stderr]             for match in re.finditer(r"^#{1,6}\s+(.+?)\s*$", path.read_text(encoding="utf-8"), re.M)}
[stderr] 
[stderr] def main():
[stderr]     parser = argparse.ArgumentParser(description=__doc__)
[stderr]     parser.add_argument("--wave", help="validate allocations through this B batch")
[stderr]     args = parser.parse_args()
[stderr]     manifest = json.loads(MANIFEST_PATH.read_text())
[stderr]     catalogue = json.loads(CATALOGUE_PATH.read_text())
[stderr]     batches = {b["id"]: b for b in manifest["batches"]}
[stderr]     contracts = manifest["r_contracts"]
[stderr]     if args.wave:
[stderr]         if args.wave not in batches: parser.error("unknown B batch: " + args.wave)
[stderr]         contracts = [c for c in contracts if batches.get(c.get("authoring_batch"), {}).get("order", 999) <= batches[args.wave]["order"]]
[stderr]     records = {r["id"]: r for r in catalogue["contracts"]}
[stderr]     errors, missing, blocked, unverified = [], [], [], []
[stderr]     def fail(text): errors.append(text)
[stderr]     ids = [c.get("id", "") for c in contracts]
[stderr]     if ids != sorted(ids): fail("manifest R IDs are not sequence ordered")
[stderr]     for item, count in Counter(ids).items():
[stderr]         if count > 1: fail("duplicate manifest R ID " + item)
[stderr]     paths = [c.get("output_path", "") for c in contracts]
[stderr]     for item, count in Counter(paths).items():
[stderr]         if count > 1: fail("duplicate output path " + item)
[stderr]     assets, browser_paths = {}, defaultdict(list)
[stderr]     # The authoring collection is part of the gate: each allocated batch must
[stderr]     # exist, identify itself, and be the sole owner of its manifest R IDs.
[stderr]     for batch_id, batch_record in batches.items():
[stderr]         batch_path = ROOT / "authoring-runbooks" / f"{batch_id}.md"
[stderr]         meta = front_matter(batch_path) if batch_path.is_file() else {}
[stderr]         if not meta: fail(f"{batch_id}: missing or invalid B-series front matter")
[stderr]         elif meta.get("task_id") != batch_id: fail(f"{batch_id}: task ID mismatch in authoring runbook")
[stderr]         if len(batch_record.get("r_contract_ids", [])) > 7: fail(f"{batch_id}: exceeds seven-contract batch limit")
[stderr]     for contract in contracts:
[stderr]         rid, batch = contract.get("id", ""), contract.get("authoring_batch", "")
[stderr]         if not R_ID.fullmatch(rid): fail(f"invalid R ID {rid!r}")
[stderr]         if batch not in batches or rid not in batches.get(batch, {}).get("r_contract_ids", []): fail(f"{rid}: authoring batch ownership mismatch")
[stderr]         catalogue_ids = values(contract.get("source_catalogue_ids"))
[stderr]         if not catalogue_ids or contract.get("catalogue_id") not in catalogue_ids: fail(f"{rid}: missing or inconsistent catalogue provenance")
[stderr]         for cid in catalogue_ids:
[stderr]             if cid not in records: fail(f"{rid}: unknown catalogue ID {cid}")
[stderr]         if contract.get("catalogue_id") in records and not records[contract["catalogue_id"]].get("requirement_ids"): fail(f"{rid}: catalogue record lacks requirement links")
[stderr]         specs = values(contract.get("source_specifications"))
[stderr]         if not specs: fail(f"{rid}: missing source_specifications")
[stderr]         for link in specs:
[stderr]             file_name, _, anchor = link.partition("#"); source = ROOT / file_name
[stderr]             if not link.startswith("specification/") or not source.is_file() or (anchor and anchor not in headings(source)):
[stderr]                 fail(f"{rid}: unresolved canonical specification link {link}")
[stderr]         stages = values(contract.get("factory_stages"))
[stderr]         if not stages or any(not F_ID.fullmatch(s) for s in stages): fail(f"{rid}: invalid factory_stages")
[stderr]         for dependency in values(contract.get("dependencies")):
[stderr]             if dependency not in ids: fail(f"{rid}: dependency {dependency} is outside allocation")
[stderr]             elif dependency >= rid: fail(f"{rid}: dependency {dependency} does not precede contract")
[stderr]         impact, asset_ids = contract.get("asset_impact"), values(contract.get("asset_ids"))
[stderr]         if impact not in {"required", "not_applicable"}: fail(f"{rid}: invalid asset_impact")
[stderr]         if "asset_ids" not in contract: fail(f"{rid}: asset_ids absent")
[stderr]         if impact == "required":
[stderr]             if not asset_ids or not contract.get("asset_brief") or not contract.get("visual_style_version"): fail(f"{rid}: required assets lack IDs, brief, or style version")
[stderr]             for asset in asset_ids:
[stderr]                 if not re.fullmatch(r"ASSET-[A-Z0-9-]+", asset): fail(f"{rid}: unstable asset ID {asset}")
[stderr]                 if asset in assets: fail(f"asset {asset} ambiguously owned by {assets[asset]} and {rid}")
[stderr]                 assets[asset] = rid
[stderr]         elif asset_ids: fail(f"{rid}: non-asset contract reserves asset IDs")
[stderr]         if batches.get(batch, {}).get("state") in {"blocked_on_gate", "blocked", "repairable"}: blocked.append(rid)
[stderr]         r_path = REPOSITORY / contract.get("output_path", "")
[stderr]         if not r_path.is_file(): missing.append(rid); continue
[stderr]         meta = front_matter(r_path)
[stderr]         for field in ("task_id", "sequence", "source_specifications", "source_catalogue_ids", "authoring_batch", "factory_stages", "asset_impact", "asset_ids"):
[stderr]             if field not in meta: fail(f"{rid}: {r_path.name} lacks {field}")
[stderr]         if "requirement_ids" not in meta: fail(f"{rid}: {r_path.name} lacks requirement_ids")
[stderr]         if meta.get("task_id") != rid: fail(f"{rid}: task ID mismatch")
[stderr]         if values(meta.get("requirement_ids")) != records.get(contract.get("catalogue_id"), {}).get("requirement_ids", []): fail(f"{rid}: requirement_ids differ from catalogue")
[stderr]         for field in ("source_specifications", "source_catalogue_ids", "authoring_batch", "factory_stages", "asset_impact", "asset_ids"):
[stderr]             if values(meta.get(field)) != values(contract.get(field)): fail(f"{rid}: {field} differs from manifest")
[stderr]         browser, specs = meta.get("browser_impact", "not_applicable"), values(meta.get("playwright_spec", meta.get("playwright_specs")))
[stderr]         if browser == "not_applicable" and specs: fail(f"{rid}: browser path on non-browser contract")
[stderr]         if browser != "not_applicable" and (not specs or not set(records.get(contract.get("catalogue_id"), {}).get("targets", [])) & {"web", "pwa"}): fail(f"{rid}: browser metadata outside browser behaviour scope")
[stderr]         for spec in specs: browser_paths[spec].append(rid)
[stderr]         body = r_path.read_text(encoding="utf-8")
[stderr]         if "## Verification" not in body: unverified.append(rid)
[stderr]         if not re.search(r"^## Asset assessment\s*$", body, re.M | re.I): fail(f"{rid}: missing explicit Asset assessment section")
[stderr]     for path, owners in browser_paths.items():
[stderr]         if len(owners) > 1: fail(f"duplicate browser test path {path}: {', '.join(owners)}")
[stderr]     graph = {c["id"]: values(c.get("dependencies")) for c in contracts}; active, done = set(), set()
[stderr]     def visit(node):
[stderr]         if node in active: fail("unsupported circular dependency through " + node); return
[stderr]         if node not in done:
[stderr]             active.add(node)
[stderr]             for dep in graph[node]:
[stderr]                 if dep in graph: visit(dep)
[stderr]             active.remove(node); done.add(node)
[stderr]     for node in graph: visit(node)
[stderr]     # Discovered families need a canonical source and a category-appropriate
[stderr]     # catalogue/verification route. Explicitly held connected scope is a valid
[stderr]     # reviewed outcome, not a missing P0 implementation contract.
[stderr]     review = ROOT / "specification/domain-completeness-review.md"
[stderr]     for line in review.read_text(encoding="utf-8").splitlines():
[stderr]         if not line.startswith("|") or line.startswith("| System") or line.startswith("| ---"): continue
[stderr]         cells = [cell.strip() for cell in line.split("|")[1:-1]]
[stderr]         if len(cells) != 5: continue
[stderr]         family, source, _deps, authoring, decision = cells
[stderr]         if "SPEC-" not in source: fail(f"domain family {family}: no specification chapter")
[stderr]         if "hold" in decision.lower(): continue
[stderr]         keywords = [word.lower() for word in re.findall(r"[A-Za-z]{5,}", family)]
[stderr]         searchable = json.dumps(catalogue).lower()
[stderr]         if not any(word in searchable for word in keywords): fail(f"domain family {family}: no catalogue traceability")
[stderr]         if authoring.lower() not in {"none", "n/a"} and not authoring: fail(f"domain family {family}: no content/authoring approach")
[stderr]     allocated = {c.get("catalogue_id") for c in contracts}
[stderr]     unallocated = [cid for cid in records if cid not in allocated]
[stderr]     print("Runbook-generation structural quality gate (not product/release evidence)")
[stderr]     chapter_count = len(list((ROOT / "specification").glob("*.md")))
[stderr]     source_link_count = sum(len(values(c.get("source_specifications"))) for c in contracts)
[stderr]     print(f"canonical specification chapters: {chapter_count}")
[stderr]     print(f"specification provenance links: {source_link_count}")
[stderr]     for label, result in (("catalogue contracts", list(records)), ("manifest contracts", ids), ("R files missing", missing), ("blocked contracts", blocked), ("unverified contracts", unverified), ("unallocated catalogue contracts", unallocated), ("reserved asset IDs", list(assets)), ("browser test paths", list(browser_paths))):
[stderr]         print(f"{label}: {len(result)}" + (" (" + ", ".join(sorted(result)) + ")" if result else ""))
[stderr]     for error in errors: print("ERROR:", error)
[stderr]     return 1 if errors or missing or unverified else 0
[stderr] if __name__ == "__main__": sys.exit(main())
[stderr] # Runbook-generation quality gate
[stderr] 
[stderr] Run this after each B-series authoring wave:
[stderr] 
[stderr] ```zsh
[stderr] python3 projects/mock-fantasy-quest-4/planning/validate_runbook_generation.py
[stderr] ```
[stderr] 
[stderr] Use `--wave B0004` for a checkpoint through one batch. The validator reads the
[stderr] canonical specification, catalogue, manifest, B writers, and generated R
[stderr] contracts. It is structural evidence only: it does not build, test, review,
[stderr] deploy, or release the product.
[stderr] 
[stderr] ## Checks
[stderr] 
[stderr] - Unique, ordered B/R IDs; dependency closure/cycles; manifest output ownership;
[stderr]   requirement links; and exact, canonical provenance links.
[stderr] - Required R front matter (including `requirement_ids`) and matching manifest
[stderr]   metadata, an explicit Asset assessment section, and verification ownership.
[stderr]   Missing, duplicate, blocked, unverified, and unallocated IDs are printed with
[stderr]   catalogue, manifest, and specification coverage counts.
[stderr] - Explicit asset assessments. Asset-required work needs unique stable `ASSET-*`
[stderr]   IDs, an asset brief, and a visual-style version; non-asset work may not reserve
[stderr]   IDs or silently introduce asset work.
[stderr] - Unique browser test paths and browser-impact metadata only for web/PWA
[stderr]   behaviour. A web/PWA target alone does not require browser metadata.
[stderr] 
[stderr] The initial foundation wave correctly fails until B writers create their
[stderr] reserved R files; that is a missing authoring artefact, not product failure.
[stderr] 
[stderr] ## Recovery and human review
[stderr] 
[stderr] 1. Rerun only the failed B writer using its manifest context packet; retain its
[stderr]    B/R IDs and change only assigned R paths.
[stderr] 2. Repair a bounded R range through its owning B writer(s), then rerun this
[stderr]    command through the final affected `--wave` value. Never regenerate accepted
[stderr]    work or renumber IDs.
[stderr] 3. Checkpoint accepted work and resume the dispatcher at the manifest's first
[stderr]    unaccepted B batch.
[stderr] 
[stderr] Stop for human review on gates, credentials, paid services, legal/compliance or
[stderr] licensing decisions, device access, store/certification actions, deployment,
[stderr] publishing, or release approval. Mark work blocked and retain IDs.
