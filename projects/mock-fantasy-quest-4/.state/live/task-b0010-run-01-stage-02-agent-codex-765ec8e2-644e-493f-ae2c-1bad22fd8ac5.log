[stderr] +dependencies: R0006,R0009,R0021,R0022
[stderr] +requirement_ids: REQ-0006,REQ-0012,NFR-0002,NFR-0003
[stderr] +source_specifications: specification/04-experience-contract.md#empty-error-recovery-destructive-and-privacy-sensitive-states
