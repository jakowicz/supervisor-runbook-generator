[stderr] +task_id: R0024
[stderr] +sequence: 24
[stderr] +title: Specify accessible settings, captions, and feedback preferences
[stderr] +dependencies: R0010,R0006,R0022
[stderr] +requirement_ids: REQ-0007,REQ-0010,NFR-0004,NFR-0005
[stderr] +source_specifications: specification/04-experience-contract.md#accessibility-policy
[stderr] +source_catalogue_ids: IMP-0024
[stderr] +authoring_batch: B0010
[stderr] +factory_stages: F011,F012,F013
[stderr] +asset_impact: not_applicable
[stderr] +asset_ids:
