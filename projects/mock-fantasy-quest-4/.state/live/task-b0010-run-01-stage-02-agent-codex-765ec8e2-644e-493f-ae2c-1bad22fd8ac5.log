[stderr] +task_id: R0025
[stderr] +sequence: 25
[stderr] +title: Define recoverable empty, error, and destructive UI states
[stderr] +dependencies: R0006,R0009,R0021,R0022
[stderr] +requirement_ids: REQ-0006,REQ-0012,NFR-0002,NFR-0003
[stderr] +source_specifications: specification/04-experience-contract.md#empty-error-recovery-destructive-and-privacy-sensitive-states
[stderr] +source_catalogue_ids: IMP-0025
[stderr] +authoring_batch: B0010
[stderr] +factory_stages: F011,F012,F013
[stderr] +asset_impact: not_applicable
[stderr] +asset_ids:
[stderr] +asset_brief: No assets; recovery copy and state contract only.
[stderr] +audio_impact: not_applicable
[stderr] +audio_ids:
[stderr] +audio_brief:
