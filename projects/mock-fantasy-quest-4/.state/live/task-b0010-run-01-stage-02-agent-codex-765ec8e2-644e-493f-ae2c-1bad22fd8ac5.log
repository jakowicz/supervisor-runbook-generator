pted\",\"depends_on_batches\":[],\"parallel_with\":[],\"preceding_decision\":\"R0001 is an implementation dependency only; R0010 retains GATE-0002,GATE-0004\",\"r_contract_ids\":[\"R0002\",\"R0003\",\"R0010\"],\"context_packet\":{\"specification\":[\"specification/03-technical-contract.md#architecture-and-requirement-traceability\",\"specification/03-technical-contract.md#commands-validation-idempotency-and-concurrency\",\"specification/04-experience-contract.md#layout-visual-tokens-and-responsive-behaviour\",\"specification/04-experience-contract.md#accessibility-policy\"],\"catalogue_records\":[\"IMP-0002\",\"IMP-0003\",\"IMP-0010\"]},\"checkpoint\":\"validated R0002/R0003/R0010 metadata, provenance, dependencies, ownership, required sections, and retained gates against the manifest\",\"recovery\":\"repair only R0002,R0003,R0010; never split or renumber accepted contracts\",\"acceptance_checks\":[\"core/adapter seam precedes feature work\",\"fixture and token outputs have distinct ownership\",\"all gates retained\"]},\n    {\"id\":\"B0003\",\"order\":3,\"title\":\"Deterministic state slice and connected-scope exclusion\",\"state\":\"accepted\",\"depends_on_batches\":[\"B0002\"],\"parallel_with\":[],\"preceding_decision\":\"B0002 accepted\",\"r_contract_ids\":[\"R0004\",\"R0008\"],\"context_packet\":{\"specification\":[\"specification/02-feature-model.md#domain-vocabulary-and-state-ownership\",\"specification/03-technical-contract.md#data-contract\",\"specification/03-technical-contract.md#commands-validation-idempotency-and-concurrency\",\"specification/03-technical-contract.md#trust-privacy-and-security\"],\"catalogue_records\":[\"IMP-0004\",\"IMP-0008\"]},\"checkpoint\":\"validated R0004/R0008 metadata, provenance, dependencies, ownership, and required sections against the manifest\",\"recovery\":\"retain IDs and repair the failed R contract only\",\"acceptance_checks\":[\"vertical foundation slice remains independently reviewable\",\"P0 connected-service exclusion is explicit\"]},\n    {\"id\":\"B0004\",\"order\":4,\"title\":\"Content validation and local recovery protocols\",\"state\":\"planned\",\"depends_on_batches\":[\"B0003\"],\"parallel_with\":[],\"preceding_decision\":\"B0003 accepted; R0006 requires GATE-0003\",\"r_contract_ids\":[\"R0005\",\"R0006\"],\"context_packet\":{\"specification\":[\"specification/03-technical-contract.md#versioned-content-and-save-schemas\",\"specification/03-technical-contract.md#persistence-migration-and-failure-semantics\",\"specification/02-feature-model.md#save-recovery-and-offline-persistence\",\"specification/04-experience-contract.md#empty-error-recovery-destructive-and-privacy-sensitive-states\"],\"catalogue_records\":[\"IMP-0005\",\"IMP-0006\"]},\"checkpoint\":\"validate content/save boundaries and retained storage gate\",\"recovery\":\"retain R0005,R0006 and rerun the blocked item after its decision\",\"acceptance_checks\":[\"content and save/cache ownership is separated\",\"save recovery remains a bounded foundation slice\"]},\n    {\"id\":\"B0005\",\"order\":5,\"title\":\"Migration, diagnostics, and provenance controls\",\"state\":\"planned\",\"depends_on_batches\":[\"B0004\"],\"parallel_with\":[\"B0006 after B0004 acceptance, except R0007 still waits for R0006\"],\"preceding_decision\":\"R0007 needs GATE-0003; R0009 needs GATE-0005\",\"r_contract_ids\":[\"R0007\",\"R0009\",\"R0011\"],\"context_packet\":{\"specification\":[\"specification/03-technical-contract.md#persistence-migration-and-failure-semantics\",\"specification/03-technical-contract.md#trust-privacy-and-security\",\"specification/01-product-brief.md#originality-boundary\",\"specification/04-experience-contract.md#experience-premise-and-originality-boundary\"],\"catalogue_records\":[\"IMP-0007\",\"IMP-0009\",\"IMP-0011\"]},\"checkpoint\":\"validate migration, diagnostics, and provenance fields; record unresolved gates\",\"recovery\":\"rerun only incomplete assigned IDs; preserve any accepted R contract\",\"accepta