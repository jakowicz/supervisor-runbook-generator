emains visible\"]}\n+  ],\n+  \"r_contracts\": [\n+    {\"id\":\"R0001\",\"catalogue_id\":\"IMP-0001\",\"title\":\"Bootstrap reproducible shared project baseline\",\"dependencies\":[],\"output_path\":\"projects/mock-fantasy-quest-4/runbooks/R0001.md\",\"source_specifications\":[\"specification/01-product-brief.md#release-definition\",\"specification/03-technical-contract.md#architecture-and-requirement-traceability\"],\"source_catalogue_ids\":[\"IMP-0001\"],\"authoring_batch\":\"B0001\",\"factory_stages\":[\"F011\",\"F012\",\"F013\"],\"asset_impact\":\"not_applicable\",\"asset_ids\":[],\"asset_brief\":\"No product asset work; establish only project/tooling boundaries and prohibit incidental assets.\",\"acceptance_checks\":[\"documented deterministic baseline command\",\"isolated ownership directories\",\"GATE-0001 retained\"],\"checkpoint_cadence\":\"after metadata, after draft, before manifest acceptance\",\"recovery\":\"retain ID and path; repair only this contract\"},\n+    {\"id\":\"R0002\",\"catalogue_id\":\"IMP-0002\",\"title\":\"Enforce shared-core and adapter dependency seams\",\"dependencies\":[\"R0001\"],\"output_path\":\"projects/mock-fantasy-quest-4/runbooks/R0002.md\",\"source_specifications\":[\"specification/03-technical-contract.md#architecture-and-requirement-traceability\",\"specification/03-technical-contract.md#dependency-direction-and-state-rules\"],\"source_catalogue_ids\":[\"IMP-0002\"],\"authoring_batch\":\"B0002\",\"factory_stages\":[\"F011\",\"F012\",\"F013\"],\"asset_impact\":\"not_applicable\",\"asset_ids\":[],\"asset_brief\":\"No assets; this is an interface and dependency-policy contract.\",\"acceptance_checks\":[\"forbidden core imports rejected\",\"adapter command-only fixture\"],\"checkpoint_cadence\":\"after metadata, after draft, before manifest acceptance\",\"recovery\":\"retain ID and repair only this contract\"},\n+    {\"id\":\"R0003\",\"catalogue_id\":\"IMP-0003\",\"title\":\"Create deterministic test and fixture harness\",\"d