');\nif (m.batches.some(x => x.r_contract_ids.length > 7)) fail('batch exceeds R contract limit');\nif (\"'!unique(m.r_contracts.map(x => x.output_path))) fail('\"'duplicate output path');\nconst allocated = m.batches.flatMap(x => x.r_contract_ids);\nif (\"'!unique(allocated) || allocated.length !== m.r_contracts.length || allocated.some(id => !m.r_contracts.some(x => x.id === id))) fail('\"'batch/R allocation mismatch');\nconst imp = c.contracts.map(x => x.id);\nconst source = m.r_contracts.map(x => x.catalogue_id);\nif (\"'!unique(source) || imp.some(id => !source.includes(id)) || source.some(id => !imp.includes(id))) fail('\"'IMP allocation mismatch');\nconst rids = new Set(m.r_contracts.map(x => x.id));\nconst b = new Map(m.batches.map(x => [x.id, x]));\nfor (const r of m.r_contracts) {\n  if (\"'!r.source_specifications.length || !r.source_catalogue_ids.length || !r.authoring_batch || !r.factory_stages.length) fail('\"'missing provenance ' + r.id);\n  if (\"'!['\"'required','not_applicable'].includes(r.asset_impact) || \"'!Array.isArray(r.asset_ids) || !r.asset_brief) fail('\"'bad asset assessment ' + r.id);\n  if (r.asset_impact === 'required' && \"'!r.asset_ids.length) fail('\"'missing required assets ' + r.id);\n  if (\"'!b.has(r.authoring_batch) || !b.get(r.authoring_batch).r_contract_ids.includes(r.id)) fail('\"'writer mismatch ' + r.id);\n  if (r.dependencies.some(d => \"'!rids.has(d))) fail('\"'unknown R dependency ' + r.id);\n  for (const p of r.source_specifications) if (\"'!fs.existsSync(base + '\"'/' + p.split('#')[0])) fail('missing specification ' + p);\n}\nconst byImp = new Map(c.contracts.map(x => [x.id, x]));\nconst byR = new Map(m.r_contracts.map(x => [x.catalogue_id, x]));\nfor (const r of m.r_contracts) for (const p of byImp.get(r.catalogue_id).prerequisites) if (\"'!r.dependencies.includes(byR.get(p).id)) fail('\"'dependency not preserved ' + r.id + ' <- ' + p);\nconsole.log('runbook authoring manifest comprehensive structural check passed');\nNODE\ngit diff --check\ngit status --short\" in /Users/simon/Dev/github/jakowicz/runbook-generator\n succeeded in 0ms:\nrunbook authoring manifest comprehensive structural check passed\n?? projects/mock-fantasy-quest-2/\n?? projects/mock-fantasy-quest-3/\n?? projects/mock-fantasy-quest-4/\n?? projects/mock-fantasy-quest/\n\ndiff --git a/projects/mock-fantasy-quest-4/planning/runbook-authoring-manifest.json b/projects/mock-fantasy-quest-4/planning/runbook-authoring-manifest.json\nnew file mode 100644\nindex 0000000000000000000000000000000000000000..54c73f01829d105454656a3b544dfccaeae8654f\n--- /dev/null\n+++ b/projects/mock-fantasy-quest-4/planning/runbook-authoring-manifest.json\n@@ -0,0 +1,45 @@\n+{\n+  \"manifest_id\": \"mock-fantasy-quest-4-runbook-authoring-ledger\",\n+  \"version\": 1,\n+  \"purpose\": \"Persistent, append-only allocation ledger for bounded B-series authoring batches and immutable R-series implementation contracts. It allocates the current catalogue only; queued shards remain expansion work.\",\n+  \"project_slug\": \"mock-fantasy-quest-4\",\n+  \"source_catalogue\": \"planning/implementation-catalogue-index.json\",\n+  \"expected_runbook_count\": 12,\n+  \"id_counters\": {\"next_authoring_batch_id\": \"B0007\", \"next_implementation_runbook_id\": \"R0013\", \"rule\": \"Never reuse, renumber, or replace an accepted B or R ID. Append new allocations using these counters only.\"},\n+  \"wave\": {\"number\": 1, \"state\": \"planned\", \"checkpoint_after_each_batch\": true, \"resume_from\": \"first batch whose state is not accepted; validate accepted IDs, paths, and provenance before dispatch\", \"recovery\": \"If a batch fails, retain its IDs, mark it blocked or repairable, repair only its listed output paths, validate its contracts, then resume that same batch. Do not reallocate its R IDs.\"},\n+  \"catalogue_disposition\": {\"allocated\": [\"IMP-0001\",\"IMP-0002\",\"IMP-0003\",\"IMP-0004\",\"IMP-0005\",\"IMP-0006\",\"IMP-0007\",\"IMP-0008\",