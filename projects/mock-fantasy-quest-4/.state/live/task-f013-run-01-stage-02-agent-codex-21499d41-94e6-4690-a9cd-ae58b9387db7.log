pecification/03-technical-contract.md#trust-privacy-and-security\"],\"catalogue_records\":[\"IMP-0004\",\"IMP-0008\"]},\"checkpoint\":\"validate state/event ownership and negative connected-scope coverage\",\"recovery\":\"retain IDs and repair the failed R contract only\",\"acceptance_checks\":[\"vertical foundation slice remains independently reviewable\",\"P0 connected-service exclusion is explicit\"]},\n+    {\"id\":\"B0004\",\"order\":4,\"title\":\"Content validation and local recovery protocols\",\"state\":\"planned\",\"depends_on_batches\":[\"B0003\"],\"parallel_with\":[],\"preceding_decision\":\"B0003 accepted; R0006 requires GATE-0003\",\"r_contract_ids\":[\"R0005\",\"R0006\"],\"context_packet\":{\"specification\":[\"specification/03-technical-contract.md#versioned-content-and-save-schemas\",\"specification/03-technical-contract.md#persistence-migration-and-failure-semantics\",\"specification/02-feature-model.md#save-recovery-and-offline-persistence\",\"specification/04-experience-contract.md#empty-error-recovery-destructive-and-privacy-sensitive-states\"],\"catalogue_records\":[\"IMP-0005\",\"IMP-0006\"]},\"checkpoint\":\"validate content/save boundaries and retained storage gate\",\"recovery\":\"retain R0005,R0006 and rerun the blocked item after its decision\",\"acceptance_checks\":[\"content and save/cache ownership is separated\",\"save recovery remains a bounded foundation slice\"]},\n+    {\"id\":\"B0005\",\"order\":5,\"title\":\"Migration, diagnostics, and provenance controls\",\"state\":\"planned\",\"depends_on_batches\":[\"B0004\"],\"parallel_with\":[\"B0006 after B0004 acceptance, except R0007 still waits for R0006\"],\"preceding_decision\":\"R0007 needs GATE-0003; R0009 needs GATE-0005\",\"r_contract_ids\":[\"R0007\",\"R0009\",\"R0011\"],\"context_packet\":{\"specification\":[\"specification/03-technical-contract.md#persistence-migration-and-failure-semantics\",\"specification/03-technical-contract.md#trust-privacy-and-security\",\"specification/