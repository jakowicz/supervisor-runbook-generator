[stderr]     {"id":"IMP-0004","title":"Define deterministic campaign state and command contract","domain":"data","targets":["shared"],"requirement_ids":["REQ-0001","REQ-0003","REQ-0004","REQ-0006","NFR-0002","NFR-0010"],"bounded_outcome":"Immutable versioned state, command/result/event envelopes, revision and interaction identifiers, deterministic RNG state, and invariant helpers define legal transition mechanics without feature state machines.","prerequisites":["IMP-0002","IMP-0003"],"ownership":{"files":["src/core/{state,commands,events,invariants,rng}/","tests/core/contract.*"],"data":["campaign snapshot envelope","deterministic RNG state"],"api":["Core command/state/event API"]},"forbidden_scope":["authored values","combat/inventory/quest algorithms","save driver","UI selection state","account/network state"],"verification":"Invalid and stale commands do not mutate state; duplicate interaction IDs cause no extra durable transition.","human_external_gate":"GATE-0004 before concrete party/content shapes.","complexity":"high","status":"current"},
