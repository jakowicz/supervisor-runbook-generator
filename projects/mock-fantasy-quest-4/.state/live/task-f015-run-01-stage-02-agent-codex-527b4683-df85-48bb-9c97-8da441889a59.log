+    end = text.find("\n---", 4)
+    if end < 0: return {}
+    result, key = {}, None
+    for line in text[4:end].splitlines():
+        if line.lstrip().startswith("-") and key:
+            result.setdefault(key, []).append(parse_value(line.split("-", 1)[1]))
+        elif ":" in line:
