k\",\"fixture and token outputs have distinct ownership\",\"all gates retained\"]},\n    {\"id\":\"B0003\",\"order\":3,\"title\":\"Deterministic state slice and connected-scope exclusion\",\"state\":\"planned\",\"depends_on_batches\":[\"B0002\"],\"parallel_with\":[],\"preceding_decision\":\"B0002 accepted\",\"r_contract_ids\":[\"R0004\",\"R0008\"],\"context_packet\":{\"specification\":[\"specification/02-feature-model.md#domain-vocabulary-and-state-ownership\",\"specification/03-technical-contract.md#data-contract\",\"specification/03-technical-contract.md#commands-validation-idempotency-and-concurrency\",\"specification/03-technical-contract.md#trust-privacy-and-security\"],\"catalogue_records\":[\"IMP-0004\",\"IMP-0008\"]},\"checkpoint\":\"validate state/event ownership and negative connected-scope coverage\",\"recovery\":\"retain IDs and repair the failed R contract only\",\"acceptance_checks\":[\"vertical foundation slice remains independently reviewable\",\"P0 connected-service exclusion is explicit\"]},\n    {\"id\":\"B0004\",\"order\":4,\"title\":\"Content validation and local recovery protocols\",\"state\":\"planned\",\"depends_on_batches\":[\"B0003\"],\"parallel_with\":[],\"preceding_decision\":\"B0003 accepted; R0006 requires GATE-0003\",\"r_contract_ids\":[\"R0005\",\"R0006\"],\"context_packet\":{\"specification\":[\"specification/03-technical-contract.md#versioned-content-and-save-schemas\",\"specification/03-technical-contract.md#persistence-migration-and-failure-semantics\",\"specification/02-feature-model.md#save-recovery-and-offline-persistence\",\"specification/04-experience-contract.md#empty-error-recovery-destructive-and-privacy-sensitive-states\"],\"catalogue_records\":[\"IMP-0005\",\"IMP-0006\"]},\"checkpoint\":\"validate content/save boundaries and retained storage gate\",\"recovery\":\"retain R0005,R0006 and rerun the blocked item after its decision\",\"acceptance_checks\":[\"content and save/cache ownership is separated\",\"save recovery remains a bounded foundation slice\"]},\n    {\"id\":\"B0005\",\"order\":5,\"title\":\"Migration, diagnostics, and provenance controls\",\"state\":\"planned\",\"depends_on_batches\":[\"B0004\"],\"parallel_with\":[\"B0006 after B0004 acceptance, except R0007 still waits for R0006\"],\"preceding_decision\":\"R0007 needs GATE-0003; R0009 needs GATE-0005\",\"r_contract_ids\":[\"R0007\",\"R0009\",\"R0011\"],\"context_packet\":{\"specification\":[\"specification/03-technical-contract.md#persistence-migration-and-failure-semantics\",\"specification/03-technical-contract.md#trust-privacy-and-security\",\"specification/01-product-brief.md#originality-boundary\",\"specification/04-experience-contract.md#experience-premise-and-originality-boundary\"],\"catalogue_records\":[\"IMP-0007\",\"IMP-0009\",\"IMP-0011\"]},\"checkpoint\":\"validate migration, diagnostics, and provenance fields; record unresolved gates\",\"recovery\":\"rerun only incomplete assigned IDs; preserve any accepted R contract\",\"acceptance_checks\":[\"no transport or remote diagnostics is introduced\",\"provenance review is explicit\",\"contracts remain at most three\"]},\n    {\"id\":\"B0006\",\"order\":6,\"title\":\"Foundation documentation closure\",\"state\":\"planned\",\"depends_on_batches\":[\"B0004\",\"B0003\"],\"parallel_with\":[\"B0005 after B0004 acceptance\"],\"preceding_decision\":\"R0006 must be accepted or documented as blocked; no gate is implicitly resolved\",\"r_contract_ids\":[\"R0012\"],\"context_packet\":{\"specification\":[\"specification/03-technical-contract.md#architecture-and-requirement-traceability\",\"specification/03-technical-contract.md#persistence-migration-and-failure-semantics\",\"specification/03-technical-contract.md#trust-privacy-and-security\"],\"catalogue_records\":[\"IMP-0012\"]},\"checkpoint\":\"cross-check all foundation ownership, dependencies, and gates before accepting the wave\",\"recovery\":\"retain R0012 and correct only its documentation contract\",\"acceptance_checks\":[\"documentation concludes the foundation slice without claiming implementation or approval\",\"gated save work remains visible\"]}\n  ],\n  \"r_contracts\": [\n    {\"id\":\"R0001\",\"catalogue_id\":\"IMP-0001\",\"title\":\"Bootstrap reproducible shared project baseline\",\"dependencies\":[],\"output_path\":\"projects/mock-fantasy-quest-4/runbooks/R0001.md\",\"source_specifications\":[\"specification/01-product-brief.md#release-definition\",\"specification/03-technical-contract.md#architecture-and-requirement-traceability\"],\"source_catalogue_ids\":[\"IMP-0001\"],\"authoring_batch\":\"B0001\",\"factory_stages\":[\"F011\",\"F012\",\"F013\"],\"asset_impact\":\"not_applicable\",\"asset_ids\":[],\"asset_brief\":\"No product asset work; establish only project/tooling boundaries and prohibit incidental assets.\",\"acceptance_checks\":[\"documented deterministic baseline command\",\"isolated ownership directories\",\"GATE-0001 retained\"],\"checkpoint_cadence\":\"after metadata, after draft, before manifest acceptance\",\"recovery\":\"retain ID and path; repair only this contract\"},\n    {\"id\":\"R0002\",\"catalogue_id\":\"IMP-0002\",\"title\":\"Enforce shared-core and adapter dependency seams\",\"dependencies\":[\"R0001\"],\"output_path\":\"projects/mock-fantasy-quest-4/runbooks/R0002.md\",\"source_specifications\":[\"specification/03-technical-contract.md#architecture-and-requirement-traceability\",\"specification/03-technical-contract.md#dependency-direction-and-state-rules\"],\"source_catalogue_ids\":[\"IMP-0002\"],\"authoring_batch\":\"B0002\",\"factory_stages\":[\"F011\",\"F012\",\"F013\"],\"asset_impact\":\"not_applicable\",\"asset_ids\":[],\"asset_brief\":\"No assets; this is an interface and dependency-policy contract.\",\"acceptance_checks\":[\"forbidden core imports rejected\",\"adapter command-only fixture\"],\"checkpoint_cadence\":\"after metadata, after draft, before manifest acceptance\",\"recovery\":\"retain ID and repair only this contract\"},\n    {\"id\":\"R0003\",\"catalogue_id\":\"IMP-0003\",\"title\":\"Create deterministic test and fixture harness\",\"dependencies\":[\"R0001\",\"R0002\"],\"output_path\":\"projects/mock-fantasy-quest-4/runbooks/R0003.md\",\"source_specifications\":[\"specification/03-technical-contract.md#observability-quality-evidence-and-release-verification\"],\"source_catalogue_ids\":[\"IMP-0003\"],\"authoring_batch\":\"B0002\",\"factory_stages\":[\"F011\",\"F012\",\"F013\"],\"asset_impact\":\"not_applicable\",\"asset_ids\":[],\"asset_brief\":\"No assets; fixtures use non-product deterministic data.\",\"acceptance_checks\":[\"repeatable fixture result\",\"isolated fixture storage\"],\"checkpoint_cadence\":\"after metadata, after draft, before manifest acceptance\",\"recovery\":\"retain ID and repair only this contract\"},\n    {\"id\":\"R0004\",\"catalogue_id\":\"IMP-0004\",\"title\":\"Define deterministic campaign state and command contract\",\"dependencies\":[\"R0002\",\"R0003\"],\"output_path\":\"projects/mock-fantasy-quest-4/runbooks/R0004.md\",\"source_specifications\":[\"specification/03-technical-contract.md#data-contract\",\"specification/03-technical-contract.md#commands-validation-idempotency-and-concurrency\"],\"source_catalogue_ids\":[\"IMP-0004\"],\"authoring_batch\":\"B0003\",\"factory_stages\":[\"F011\",\"F012\",\"F013\"],\"asset_impact\":\"not_applicable\",\"asset_ids\":[],\"asset_brief\":\"No assets; state envelopes deliberately exclude authored content.\",\"acceptance_checks\":[\"stale and invalid commands do not mutate state\",\"duplicate interaction is idempotent\"],\"checkpoint_cadence\":\"after metadata, after draft, before manifest acceptance\",\"recovery\":\"retain ID and repair only this contract\"},\n    {\"id\":\"R0005\",\"catalogue_id\":\"IMP-0005\",\"title\":\"Define versioned content schema and validation boundary\",\"dependencies\":[\"R0001\",\"R0003\",\"R0004\"],\"output_path\":\"projects/mock-fantasy-quest-4/runbooks/R0005.md\",\"source_specifications\":[\"specification/03-technical-contract.md#versioned-content-and-save-schemas\",\"specification/02-feature-model.md#domain-vocabulary-and-state-ownership\"],\"source_catalogue_ids\":[\"IMP-0005\"],\"authoring_batch\":\"B0004\",\"factory_stages\":[\"F011\",\"F012\",\"F013\"],\"asset_impact\":\"not_applicable\",\"asset_ids\":[],\"asset_brief\":\"No art/audio assets; reserve only schema/provenance fields for later original assets.\",\"acceptance_checks\":[\"valid minimal package passes\",\"invalid references fail\",\"reachability fixture\"],\"checkpoint_cadence\":\"after metadata, after draft, before manifest acceptance\",\"recovery\":\"retain ID and repair only this contract\"},\n    {\"id\":\"R0006\",\"catalogue_id\":\"IMP-0006\",\"title\":\"Specify local save and recovery protocol\",\"dependencies\":[\"R0002\",\"R0003\",\"R0004\"],\"output_path\":\"projects/mock-fantasy-quest-4/runbooks/R0006.md\",\"source_specifications\":[\"specification/03-technical-contract.md#persistence-migration-and-failure-semantics\",\"specification/04-experience-contract.md#empty-error-recovery-destructive-and-privacy-sensitive-states\"],\"source_catalogue_ids\":[\"IMP-0006\"],\"authoring_batch\":\"B0004\",\"factory_stages\":[\"F011\",\"F012\",\"F013\"],\"asset_impact\":\"not_applicable\",\"asset_ids\":[],\"asset_brief\":\"No assets; protocol is data/recovery only.\",\"acceptance_checks\":[\"fault fixtures cover write and validation failures\",\"save/cache separation\",\"GATE-0003 retained\"],\"checkpoint_cadence\":\"after metadata, after draft, before manifest acceptance\",\"recovery\":\"retain ID; wait for storage decision before accepting gated work\"},\n    {\"id\":\"R0007\",\"catalogue_id\":\"IMP-0007\",\"title\":\"Define pure save migration runner\",\"dependencies\":[\"R0005\",\"R0006\"],\"output_path\":\"projects/mock-fantasy-quest-4/runbooks/R0007.md\",\"source_specifications\":[\"specification/03-technical-contract.md#persistence-migration-and-failure-semantics\"],\"source_catalogue_ids\":[\"IMP-0007\"],\"authoring_batch\":\"B0005\",\"factory_stages\":[\"F011\",\"F012\",\"F013\"],\"asset_impact\":\"not_applicable\",\"asset_ids\":[],\"asset_brief\":\"No assets; migration fixtures retain original bytes only.\",\"acceptance_checks\":[\"predecessors migrate once\",\"failed candidate remains intact\",\"GATE-0003 retained\"],\"checkpoint_cadence\":\"after metadata, after draft, before manifest acceptance\",\"recovery\":\"retain ID and resume after R0006/gate closure\"},\n    {\"id\":\"R0008\",\"catalogue_id\":\"IMP-0008\",\"title\":\"Bound P0 identity, authorization, and connected-service exclusions\",\"dependencies\":[\"R0002\",\"R0004\"],\"output_path\":\"projects/mock-fantasy-quest-4/runbooks/R0008.md\",\"source_specifications\":[\"specification/03-technical-contract.md#trust-privacy-and-security\"],\"source_catalogue_ids\":[\"IMP-0008\"],\"authoring_batch\":\"B0003\",\"factory_stages\":[\"F011\",\"F012\",\"F013\"],\"asset_impact\":\"not_applicable\",\"asset_ids\":[],\"asset_brief\":\"No assets; a negative scope boundary.\",\"acceptance_checks\":[\"no identity/token/network fields\",\"future connected work remains gated\"],\"checkpoint_cadence\":\"after metadata, after draft, before manifest acceptance\",\"recovery\":\"retain ID and repair only this contract\"},\n    {\"id\":\"R0009\",\"catalogue_id\":\"IMP-0009\",\"title\":\"Define privacy-safe local diagnostics boundary\",\"dependencies\":[\"R0002\",\"R0003\",\"R0006\"],\"output_path\":\"projects/mock-fantasy-quest-4/runbooks/R0009.md\",\"source_specifications\":[\"specification/03-technical-contract.md#trust-privacy-and-security\",\"specification/04-experience-contract.md#empty-error-recovery-destructive-and-privacy-sensitive-states\"],\"source_catalogue_ids\":[\"IMP-0009\"],\"authoring_batch\":\"B0005\",\"factory_stages\":[\"F011\",\"F012\",\"F013\"],\"asset_impact\":\"not_applicable\",\"asset_ids\":[],\"asset_brief\":\"No assets; local redacted records only.\",\"acceptance_checks\":[\"consent and deletion controls\",\"payload redaction\",\"no network transport\",\"GATE-0005 retained\"],\"checkpoint_cadence\":\"after metadata, after draft, before manifest acceptance\",\"recovery\":\"retain ID and wait for privacy gate where required\"},\n    {\"id\":\"R0010\",\"catalogue_id\":\"IMP-0010\",\"title\":\"Establish semantic accessibility design tokens\",\"dependencies\":[\"R0001\",\"R0002\"],\"output_path\":\"projects/mock-fantasy-quest-4/runbooks/R0010.md\",\"source_specifications\":[\"specification/04-experience-contract.md#layout-visual-tokens-and-responsive-behaviour\",\"specification/04-experience-contract.md#accessibility-policy\"],\"source_catalogue_ids\":[\"IMP-0010\"],\"authoring_batch\":\"B0002\",\"factory_stages\":[\"F011\",\"F012\",\"F013\"],\"asset_impact\":\"not_applicable\",\"asset_ids\":[],\"asset_brief\":\"No final artwork, fonts, or icons; semantic tokens only and prohibit incidental assets.\",\"acceptance_checks\":[\"non-colour cues\",\"reduced motion values\",\"GATE-0002,GATE-0004 retained\"],\"checkpoint_cadence\":\"after metadata, after draft, before manifest acceptance\",\"recovery\":\"retain ID and await numeric design decisions\"},\n    {\"id\":\"R0011\",\"catalogue_id\":\"IMP-0011\",\"title\":\"Create original-content provenance control\",\"dependencies\":[\"R0005\"],\"output_path\":\"projects/mock-fantasy-quest-4/runbooks/R0011.md\",\"source_specifications\":[\"specification/01-product-brief.md#originality-boundary\",\"specification/04-experience-contract.md#experience-premise-and-originality-boundary\"],\"source_catalogue_ids\":[\"IMP-0011\"],\"authoring_batch\":\"B0005\",\"factory_stages\":[\"F011\",\"F012\",\"F013\"],\"asset_impact\":\"not_applicable\",\"asset_ids\":[],\"asset_brief\":\"No assets are created; this contract defines provenance controls for later asset-required work.\",\"acceptance_checks\":[\"missing provenance rejected\",\"human creative review recorded\"],\"checkpoint_cadence\":\"after metadata, after draft, before manifest acceptance\",\"recovery\":\"retain ID and repair only this contract\"},\n    {\"id\":\"R0012\",\"catalogue_id\":\"IMP-0012\",\"title\":\"Document foundation architecture and recovery boundaries\",\"dependencies\":[\"R0002\",\"R0004\",\"R0006\",\"R0008\"],\"output_path\":\"projects/mock-fantasy-quest-4/runbooks/R0012.md\",\"source_specifications\":[\"specification/03-technical-contract.md#architecture-and-requirement-traceability\",\"specification/03-technical-contract.md#persistence-migration-and-failure-semantics\",\"specification/03-technical-contract.md#trust-privacy-and-security\"],\"source_catalogue_ids\":[\"IMP-0012\"],\"authoring_batch\":\"B0006\",\"factory_stages\":[\"F011\",\"F012\",\"F013\"],\"asset_impact\":\"not_applicable\",\"asset_ids\":[],\"asset_brief\":\"No assets; developer-documentation closure only.\",\"acceptance_checks\":[\"all foundation ownership/dependencies/gates cross-checked\",\"does not claim release readiness\"],\"checkpoint_cadence\":\"after metadata, after draft, before manifest acceptance\",\"recovery\":\"retain ID and repair only this documentation contract\"}\n  ]\n}\n{\n  \"catalogue_id\": \"mock-fantasy-quest-4-implementation-catalogue\",\n  \"version\": 1,\n  \"source\": [\"../specification/README.md\", \"../specification/requirements.json\", \"05-delivery-map.md\", \"06-foundation-domain-contracts.md\", \"07-feature-experience-contracts.md\", \"08-quality-operations-contracts.md\"],\n  \"scope\": \"P0 is an original, offline-capable 2D single-player fantasy RPG delivered through a shared web core and a PWA delivery adaptation. Connected services are not P0 implementation scope.\",\n  \"first_bounded_domain\": {\"id\": \"SHARD-01\", \"title\": \"Foundation and core contracts\", \"contract_limit\": 250, \"contract_count\": 12, \"state\": \"ready_for_authoring\", \"boundary\": \"Framework-neutral seams, deterministic state/data contracts, local persistence protocol, quality foundations, and original-design controls; excludes campaign rules, UI flows, PWA lifecycle, and release execution.\"},\n  \"contracts\": [\n    {\"id\":\"IMP-0001\",\"title\":\"Bootstrap reproducible shared project baseline\",\"domain\":\"foundation\",\"targets\":[\"shared\",\"web\",\"pwa\"],\"requirement_ids\":[\"NFR-0010\",\"NFR-0012\"],\"bounded_outcome\":\"A framework-neutral project skeleton documents one bootstrap, lint, format, and deterministic test command with isolated shared, web-adapter, PWA-adapter, content, and test directories.\",\"prerequisites\":[],\"ownership\":{\"files\":[\"root build/tooling configuration\",\"src/{core,content,app,platform/web,platform/pwa}/\",\"tests/\",\"docs/development.md\"],\"data\":[\"pinned toolchain declaration\"],\"api\":[\"build/test command interface\"]},\"forbidden_scope\":[\"selecting framework/package manager/CI without DEC-0001\",\"gameplay\",\"service worker\",\"hosting\"],\"verification\":\"Clean approved-runtime checkout runs the documented deterministic sample test, lint, and format checks.\",\"human_external_gate\":\"GATE-0001 / DEC-0001 framework, package-manager, and CI selection before implementation.\",\"complexity\":\"medium\",\"status\":\"gated\"},\n    {\"id\":\"IMP-0002\",\"title\":\"Enforce shared-core and adapter dependency seams\",\"domain\":\"foundation\",\"targets\":[\"shared\",\"web\",\"pwa\"],\"requirement_ids\":[\"NFR-0010\",\"REQ-0013\",\"NFR-0012\"],\"bounded_outcome\":\"A dependency policy and public interfaces prevent core code from importing browser, renderer, clock, network, or platform modules; adapters submit commands and render returned state/events.\",\"prerequisites\":[\"IMP-0001\"],\"ownership\":{\"files\":[\"src/core/public interfaces\",\"src/platform/{web,pwa}/adapter interfaces\",\"architecture dependency rules\",\"docs/architecture.md\"],\"data\":[\"dependency-policy manifest\"],\"api\":[\"Command, state, event, and adapter interfaces\"]},\"forbidden_scope\":[\"concrete combat/exploration/UI\",\"account or network client\",\"target-specific campaign rules\"],\"verification\":\"A dependency-rule test rejects forbidden core imports and a fixture adapter proves command-only interaction.\",\"human_external_gate\":\"None; retain GATE-0001 for tool-specific enforcement.\",\"complexity\":\"medium\",\"status\":\"current\"},\n    {\"id\":\"IMP-0003\",\"title\":\"Create deterministic test and fixture harness\",\"domain\":\"tests\",\"targets\":[\"shared\",\"web\",\"pwa\"],\"requirement_ids\":[\"NFR-0010\",\"NFR-0012\"],\"bounded_outcome\":\"Layered unit, content, integration, and reserved browser-test conventions provide isolated RNG/clock and persistence fixtures with no real service or player data access.\",\"prerequisites\":[\"IMP-0001\",\"IMP-0002\"],\"ownership\":{\"files\":[\"test-runner configuration\",\"tests/{core,content,platform,app}/fixtures\",\"docs/testing.md\"],\"data\":[\"deterministic fixture factories\"],\"api\":[\"test fixture and fake clock/RNG interfaces\"]},\"forbidden_scope\":[\"final feature assertions\",\"real browser/device matrix claims\",\"production telemetry\"],\"verification\":\"Repeated core fixture execution has identical results; a deliberately failing fixture is detected; fixture storage is isolated.\",\"human_external_gate\":\"GATE-0002 before compatibility or performance claims.\",\"complexity\":\"medium\",\"status\":\"current\"},\n    {\"id\":\"IMP-0004\",\"title\":\"Define deterministic campaign state and command contract\",\"domain\":\"data\",\"targets\":[\"shared\"],\"requirement_ids\":[\"REQ-0001\",\"REQ-0003\",\"REQ-0004\",\"REQ-0006\",\"NFR-0002\",\"NFR-0010\"],\"bounded_outcome\":\"Immutable versioned state, command/result/event envelopes, revision and interaction identifiers, deterministic RNG state, and invariant helpers define legal transition mechanics without feature state machines.\",\"prerequisites\":[\"IMP-0002\",\"IMP-0003\"],\"ownership\":{\"files\":[\"src/core/{state,commands,events,invariants,rng}/\",\"tests/core/contract.*\"],\"data\":[\"campaign snapshot envelope\",\"deterministic RNG state\"],\"api\":[\"Core command/state/event API\"]},\"forbidden_scope\":[\"authored values\",\"combat/inventory/quest algorithms\",\"save driver\",\"UI selection state\",\"account/network state\"],\"verification\":\"Invalid and stale commands do not mutate state; duplicate interaction IDs cause no extra durable transition.\",\"human_external_gate\":\"GATE-0004 before concrete party/content shapes.\",\"complexity\":\"high\",\"status\":\"current\"},\n    {\"id\":\"IMP-0005\",\"title\":\"Define versioned content schema and validation boundary\",\"domain\":\"content\",\"targets\":[\"shared\"],\"requirement_ids\":[\"REQ-0002\",\"REQ-0008\",\"NFR-0007\",\"NFR-0008\"],\"bounded_outcome\":\"Typed content-package schema and validator cover IDs, references, locale keys, assets, predicates, rewards, and reachability but contain no authored campaign expression.\",\"prerequisites\":[\"IMP-0001\",\"IMP-0004\",\"IMP-0003\"],\"ownership\":{\"files\":[\"src/content/{schema,validator,registry}/\",\"tests/content/validation.*\",\"docs/content-authoring.md\"],\"data\":[\"versioned content package format\",\"asset/provenance manifest schema\"],\"api\":[\"content registry and validator API\"]},\"forbidden_scope\":[\"town/dungeon dialogue/maps/assets\",\"copied reference expression\",\"release packaging\"],\"verification\":\"Valid minimum package passes; each invalid reference class fails; a graph fixture checks opening-to-ending reachability.\",\"human_external_gate\":\"GATE-0004 for quantities, locale, and content detail; human provenance review remains required.\",\"complexity\":\"high\",\"status\":\"current\"},\n    {\"id\":\"IMP-0006\",\"title\":\"Specify local save and recovery protocol\",\"domain\":\"persistence\",\"targets\":[\"shared\",\"web\",\"pwa\"],\"requirement_ids\":[\"REQ-0006\",\"REQ-0012\",\"NFR-0002\",\"NFR-0003\",\"NFR-0005\"],\"bounded_outcome\":\"A schema protocol specifies immutable revisions, checksums, current-pointer validation, known-good retention, quarantine, separate preferences, deletion confirmation, and safe-boundary persistence rules.\",\"prerequisites\":[\"IMP-0002\",\"IMP-0004\",\"IMP-0003\"],\"ownership\":{\"files\":[\"src/core/save/{schema,compatibility,migrations}/\",\"src/platform/web/persistence/\",\"tests/{core,platform}/save*\",\"docs/save-and-recovery.md\"],\"data\":[\"save snapshot and preference schemas\",\"quarantine record\"],\"api\":[\"snapshot repository and recovery protocol\"]},\"forbidden_scope\":[\"cloud sync\",\"identity\",\"PWA cache records\",\"eviction guarantee\"],\"verification\":\"Fault fixtures cover interrupted write, checksum failure, malformed data, quota/permission failure, quarantine, retry, and selected-slot deletion.\",\"human_external_gate\":\"GATE-0003 / DEC-0003 storage API, quota, support window, and recovery policy.\",\"complexity\":\"high\",\"status\":\"gated\"},\n    {\"id\":\"IMP-0007\",\"title\":\"Define pure save migration runner\",\"domain\":\"persistence\",\"targets\":[\"shared\",\"web\",\"pwa\"],\"requirement_ids\":[\"REQ-0006\",\"NFR-0002\",\"NFR-0003\"],\"bounded_outcome\":\"Ordered, pure migrations declare supported versions and promote only validated candidates while preserving original invalid bytes for quarantine.\",\"prerequisites\":[\"IMP-0005\",\"IMP-0006\"],\"ownership\":{\"files\":[\"src/core/save/{migrations,compatibility}/\",\"tests/core/save/fixtures\"],\"data\":[\"migration registry and predecessor fixtures\"],\"api\":[\"migration runner API\"]},\"forbidden_scope\":[\"storage driver changes\",\"future data export\",\"automatic destructive repair\"],\"verification\":\"Every declared predecessor migrates once; unsupported or failed migration leaves the original candidate intact and quarantined.\",\"human_external_gate\":\"GATE-0003 / DEC-0003 support-window approval.\",\"complexity\":\"medium\",\"status\":\"gated\"},\n    {\"id\":\"IMP-0008\",\"title\":\"Bound P0 identity, authorization, and connected-service exclusions\",\"domain\":\"security\",\"targets\":[\"shared\",\"web\",\"pwa\"],\"requirement_ids\":[\"REQ-0013\",\"REQ-0014\",\"REQ-0015\",\"NFR-0012\"],\"bounded_outcome\":\"Architecture and negative contract tests demonstrate that local campaign start/save/resume require no account identifier, token, remote profile, role, entitlement, multiplayer, or safety service.\",\"prerequisites\":[\"IMP-0002\",\"IMP-0004\"],\"ownership\":{\"files\":[\"docs/security-boundary.md\",\"tests/core/connected-scope-exclusion.*\"],\"data\":[\"future connected-service approval checklist\"],\"api\":[\"local-slot identity contract\"]},\"forbidden_scope\":[\"sign-in\",\"OAuth\",\"sync\",\"roles\",\"moderation\",\"purchases\",\"server APIs\"],\"verification\":\"Static scan and negative fixtures find no identity/token/privilege fields or network client in P0 foundation modules.\",\"human_external_gate\":\"GATE-0006 / DEC-0006 before any connected implementation.\",\"complexity\":\"low\",\"status\":\"current\"},\n    {\"id\":\"IMP-0009\",\"title\":\"Define privacy-safe local diagnostics boundary\",\"domain\":\"privacy\",\"targets\":[\"web\",\"pwa\"],\"requirement_ids\":[\"REQ-0012\",\"NFR-0006\"],\"bounded_outcome\":\"A bounded local diagnostic schema, consent and clear controls, redaction rules, and no-network guardrails support future player recovery without collecting save or dialogue payloads.\",\"prerequisites\":[\"IMP-0002\",\"IMP-0003\",\"IMP-0006\"],\"ownership\":{\"files\":[\"src/platform/web/diagnostics/\",\"src/app/recovery/diagnostic-contract.*\",\"tests/platform/diagnostics.*\",\"docs/privacy-and-recovery.md\"],\"data\":[\"redacted local diagnostic record\",\"consent state\"],\"api\":[\"diagnostic recorder interface\"]},\"forbidden_scope\":[\"diagnostic provider/transport\",\"remote analytics\",\"retention promise\",\"secrets\"],\"verification\":\"Tests prove diagnostics are absent without consent, redact payloads, and can be deleted locally.\",\"human_external_gate\":\"GATE-0005 / DEC-0005 before transport, retention, hosting, or support claims.\",\"complexity\":\"medium\",\"status\":\"gated\"},\n    {\"id\":\"IMP-0010\",\"title\":\"Establish semantic accessibility design tokens\",\"domain\":\"accessibility\",\"targets\":[\"shared\",\"web\",\"pwa\"],\"requirement_ids\":[\"REQ-0007\",\"REQ-0010\",\"NFR-0004\",\"NFR-0008\"],\"bounded_outcome\":\"Original semantic tokens cover typography, spacing, focus, motion, touch targets, status, contrast, and non-colour cues, enabling later responsive web UI and inherited PWA UI.\",\"prerequisites\":[\"IMP-0001\",\"IMP-0002\"],\"ownership\":{\"files\":[\"src/app/design/tokens/\",\"docs/design-tokens.md\",\"tests/app/design-tokens.*\"],\"data\":[\"semantic token inventory\"],\"api\":[\"token consumption contract\"]},\"forbidden_scope\":[\"screens\",\"maps\",\"final artwork/fonts\",\"final breakpoints\",\"copied reference styling\"],\"verification\":\"Token validation proves semantic labels/non-colour cues and reduced-motion values in representative fixtures.\",\"human_external_gate\":\"GATE-0002 and GATE-0004 before numeric contrast/font/breakpoint claims.\",\"complexity\":\"medium\",\"status\":\"gated\"},\n    {\"id\":\"IMP-0011\",\"title\":\"Create original-content provenance control\",\"domain\":\"content\",\"targets\":[\"shared\"],\"requirement_ids\":[\"REQ-0001\",\"REQ-0008\",\"NFR-0008\"],\"bounded_outcome\":\"A provenance record format, review checklist, and source-asset manifest make authorship and permitted functional reference scope auditable before authored content enters a build.\",\"prerequisites\":[\"IMP-0005\"],\"ownership\":{\"files\":[\"assets/source-manifest.*\",\"docs/original-content-review.md\",\"tests/content/provenance.*\"],\"data\":[\"provenance manifest and review disposition\"],\"api\":[\"provenance validator input contract\"]},\"forbidden_scope\":[\"creating art/audio/story\",\"licensing approval\",\"automatic legal clearance\"],\"verification\":\"Validator rejects missing provenance fields; human creative review is recorded for each authored package.\",\"human_external_gate\":\"Human creative/provenance review; legal or licensing review if applicable under GATE-0007.\",\"complexity\":\"low\",\"status\":\"current\"},\n    {\"id\":\"IMP-0012\",\"title\":\"Document foundation architecture and recovery boundaries\",\"domain\":\"documentation\",\"targets\":[\"shared\",\"web\",\"pwa\"],\"requirement_ids\":[\"NFR-0012\",\"NFR-0010\",\"NFR-0002\",\"NFR-0003\"],\"bounded_outcome\":\"Developer documentation records ownership, command flow, save-versus-cache separation, deferred connected scope, and the decisions/gates that later domain authors must preserve.\",\"prerequisites\":[\"IMP-0002\",\"IMP-0004\",\"IMP-0006\",\"IMP-0008\"],\"ownership\":{\"files\":[\"docs/{architecture,development,save-and-recovery,security-boundary}.md\"],\"data\":[\"foundation decision and ownership index\"],\"api\":[\"documented public-boundary inventory\"]},\"forbidden_scope\":[\"player release guide\",\"operational rollout\",\"claiming approved vendor or policy choices\"],\"verification\":\"Documentation review cross-checks every foundation contract's ownership, dependency, and gate against this catalogue.\",\"human_external_gate\":\"None; approval gates are documented, not resolved.\",\"complexity\":\"low\",\"status\":\"current\"}\n  ],\n  \"expansion_queue\": [\n    {\"id\":\"SHARD-02\",\"title\":\"Campaign content and domain logic\",\"max_contracts\":250,\"depends_on\":[\"SHARD-01\"],\"covers\":[\"exploration\",\"dialogue\",\"quests\",\"tutorial\",\"combat\",\"inventory\",\"party progression\",\"town/dungeon/ending content\",\"content validation\"],\"requirement_ids\":[\"REQ-0001\",\"REQ-0002\",\"REQ-0003\",\"REQ-0004\",\"REQ-0005\",\"REQ-0008\",\"NFR-0007\",\"NFR-0008\"],\"gate\":\"GATE-0004\",\"target_allocation\":\"shared core and content only; no UI ownership\",\"state\":\"queued\"},\n    {\"id\":\"SHARD-03\",\"title\":\"Session, UI, input, and accessibility\",\"max_contracts\":250,\"depends_on\":[\"SHARD-01\",\"SHARD-02\"],\"covers\":[\"session/checkpoints\",\"semantic responsive shell\",\"game panels\",\"keyboard/mouse/touch/gamepad adapters\",\"settings\",\"localisation\",\"captions\",\"feedback\",\"error recovery UI\",\"accessibility tests\"],\"requirement_ids\":[\"REQ-0005\",\"REQ-0006\",\"REQ-0007\",\"REQ-0009\",\"REQ-0010\",\"REQ-0012\",\"NFR-0002\",\"NFR-0003\",\"NFR-0004\",\"NFR-0005\"],\"gate\":\"GATE-0002,GATE-0003,GATE-0004\",\"target_allocation\":\"shared UI model; web input/layout adapter; PWA inherits UI with no separate UI fork\",\"state\":\"queued\"},\n    {\"id\":\"SHARD-04\",\"title\":\"PWA delivery, performance, operations, and release evidence\",\"max_contracts\":250,\"depends_on\":[\"SHARD-01\",\"SHARD-02\",\"SHARD-03\"],\"covers\":[\"PWA manifest/install\",\"service-worker cache lifecycle\",\"offline/update recovery\",\"performance measurement\",\"security headers\",\"release checks\",\"observability\",\"quality automation\",\"player/operator documentation\",\"platform certification assessment\"],\"requirement_ids\":[\"REQ-0011\",\"REQ-0012\",\"NFR-0001\",\"NFR-0003\",\"NFR-0006\",\"NFR-0009\",\"NFR-0011\",\"NFR-0012\"],\"gate\":\"GATE-0002,GATE-0005,GATE-0007\",\"target_allocation\":\"web release build and PWA service-worker/install adapter are distinct; shared core owns neither cache nor hosting\",\"state\":\"queued\"},\n    {\"id\":\"SHARD-05\",\"title\":\"Connected-scope decision package\",\"max_contracts\":250,\"depends_on\":[\"SHARD-01\"],\"covers\":[\"identity/sync conflict policy\",\"multiplayer/player safety\",\"live operations\",\"commerce/entitlements\"],\"requirement_ids\":[\"REQ-0014\",\"REQ-0015\"],\"gate\":\"GATE-0006\",\"target_allocation\":\"no P0 target implementation; research/decision outputs only if explicitly authorised\",\"state\":\"hold\"}\n  ],\n  \"requirement_coverage\": {\n    \"REQ-0001\":\"queued: SHARD-02; provenance foundation IMP-0011\",\"REQ-0002\":\"queued: SHARD-02\",\"REQ-0003\":\"queued: SHARD-02\",\"REQ-0004\":\"queued: SHARD-02\",\"REQ-0005\":\"queued: SHARD-02 and SHARD-03\",\"REQ-0006\":\"current/gated: IMP-0006, IMP-0007; queued: SHARD-03\",\"REQ-0007\":\"current/gated: IMP-0010; queued: SHARD-03\",\"REQ-0008\":\"current: IMP-0005, IMP-0011; queued: SHARD-02\",\"REQ-0009\":\"queued: SHARD-03\",\"REQ-0010\":\"current/gated: IMP-0010; queued: SHARD-03\",\"REQ-0011\":\"queued: SHARD-04\",\"REQ-0012\":\"current/gated: IMP-0006, IMP-0009; queued: SHARD-03 and SHARD-04\",\"REQ-0013\":\"current: IMP-0002, IMP-0008\",\"REQ-0014\":\"gated: SHARD-05 / GATE-0006; no P0 implementation\",\"REQ-0015\":\"hold: SHARD-05 / GATE-0006; no P0 implementation\",\"NFR-0001\":\"queued: SHARD-04\",\"NFR-0002\":\"current/gated: IMP-0004, IMP-0006, IMP-0007\",\"NFR-0003\":\"current/gated: IMP-0006, IMP-0007; queued: SHARD-04\",\"NFR-0004\":\"current/gated: IMP-0010; queued: SHARD-03\",\"NFR-0005\":\"current/gated: IMP-0006; queued: SHARD-03\",\"NFR-0006\":\"current/gated: IMP-0009; queued: SHARD-04\",\"NFR-0007\":\"current: IMP-0005; queued: SHARD-02\",\"NFR-0008\":\"current: IMP-0005, IMP-0010, IMP-0011; queued: SHARD-02\",\"NFR-0009\":\"gated: SHARD-04 / GATE-0002\",\"NFR-0010\":\"current: IMP-0001, IMP-0002, IMP-0003, IMP-0004; queued target adapters in SHARD-03 and SHARD-04\",\"NFR-0011\":\"gated: SHARD-04 / GATE-0005\",\"NFR-0012\":\"current/gated: IMP-0001, IMP-0002, IMP-0003, IMP-0008, IMP-0012; queued: SHARD-04\"\n  },\n  \"dependency_graph\": {\"nodes\":[\"IMP-0001\",\"IMP-0002\",\"IMP-0003\",\"IMP-0004\",\"IMP-0005\",\"IMP-0006\",\"IMP-0007\",\"IMP-0008\",\"IMP-0009\",\"IMP-0010\",\"IMP-0011\",\"IMP-0012\"],\"acyclic\":true,\"validation\":\"Each prerequisite points only to an earlier numbered contract; SHARD dependencies only point from later shards to earlier shards.\"}\n}\n\nexec\n/bin/zsh -lc \"rg --files | rg '(\"'^scripts/|pyproject|package.json|Makefile|supervisor/tests/test_quality_gates.py|README.md$)'\"'\nsed -n '1,240p' supervisor/tests/test_quality_gates.py\nsed -n '1,180p' README.md\nsed -n '1,160p' projects/mock-fantasy-quest-4/planning/10-authoring-handoff.md\" in /Users/simon/Dev/github/jakowicz/runbook-generator\n succeeded in 0ms:\nsupervisor/browser/package.json\nsupervisor/README.md\nsupervisor/tests/test_quality_gates.py\nsupervisor/pyproject.toml\nscripts/runbookgen_status.py\nscripts/runbookgen\nscripts/run_factory_e2e.sh\nREADME.md\nrunbooks/README.md\nprojects/README.md\nprojects/mock-fantasy-quest-4/specification/README.md\nfrom supervisor.models import Status, Task\nfrom supervisor.workers import browser, visual_review\n\n\ndef test_document_only_runbooks_bypass_browser_and_visual_workers(monkeypatch):\n    task = Task(task_id=\"F001\", title=\"Document factory\", browser_impact=\"not_applicable\")\n    monkeypatch.delenv(\"BROWSER_QA_COMMAND\", raising=False)\n    monkeypatch.delenv(\"VISUAL_REVIEW_COMMAND\", raising=False)\n\n    browser_result = browser.run(task)\n    visual_result = visual_review.run(task)\n\n    assert browser_result.status is Status.PASS\n    assert \"not applicable\" in browser_result.summary\n    assert visual_result.status is Status.PASS\n    assert \"not applicable\" in visual_result.summary\n# Runbook Generator\n\nThis repository is a generic, Supervisor-driven factory for turning a concise\nproduct brief into a complete, dependency-ordered implementation plan. It is\nnot tied to a particular app type, framework, agent, or delivery platform.\n\nGiven a brief for a game, desktop application, web product, operating system,\ndeveloper tool, service, document system, or any other product, the factory\nfirst discovers the product domains and creates a canonical specification. It\nthen builds a scalable collection of detailed implementation runbooks.\n\n## Install Supervisor\n\nInstall the global Supervisor CLI once. It requires Python 3.10 or newer but\ndoes not require administrator access:\n\n```zsh\ncurl -fsSL https://raw.githubusercontent.com/jakowicz/supervisor/main/scripts/install.sh -o /tmp/supervisor-install.sh\nbash /tmp/supervisor-install.sh\n```\n\nIf the installer says `~/.local/bin` is not on your `PATH`, add the line it\nprints to your shell profile, then open a new terminal. Confirm the commands\nare available:\n\n```zsh\nsupervisor --help\nsupervisor-run --help\n```\n\n## Start a factory run\n\nFrom the repository root, there are only two actions required to start a\nfactory run.\n\n1. Create a named project workspace and its\n   `projects/<project-name>/INITIAL.md` brief with the interactive wizard. It\n   asks for the project name, product type, target systems, users,\n   requirements, constraints, references, and open decisions. Responsive web\n   and PWA support are included by default.\n\n```zsh\nsupervisor initial --force\n```\n\n   `--force` deliberately replaces an existing brief with the same project\n   name; omit it if you want the command to refuse to overwrite it.\n\n2. Review the generated `projects/<project-name>/INITIAL.md`, make any edits\n   you want, then run that named project:\n\n```zsh\nsupervisor-run --project <project-name>\n```\n\n## Factory end-to-end test\n\nRun the opt-in real-agent factory acceptance test through the generator CLI:\n\n```zsh\nscripts/runbookgen e2e\n```\n\nIt creates a scoped game project, runs the factory, validates that it generated\n15\u201320 R-series runbooks, and verifies a second run resumes accepted work.\n\n`--project` reads that project's `INITIAL.md`, runs the reusable F-series, then\nautomatically follows the generated B-series and R-series files. It keeps the\nfactory's durable task history in `projects/<project-name>/.state/`, its\nversioned project configuration in `projects/<project-name>/.env`, and private\ncredentials in ignored `projects/<project-name>/.secrets.env`, so a\nlater `supervisor-run --project <project-name>` resumes at the first unfinished\ntask and does not rerun accepted tasks. That workspace contains its normalized\nbrief, specification, complete work checklist, generated B-series\nrunbook-writing files, R-series product-work runbooks, and handoff\ndocumentation.\n\n## See or resume project progress\n\nFrom the repository root, list every named workspace and its current phase,\naccepted/pending counts, next task, and exact resume command:\n\n```zsh\nsupervisor projects\n```\n\nRun `supervisor-run --project <project-name>` at any time to resume that\nproject. Its SQLite task state makes accepted tasks skip safely and returns to\nthe first unfinished task.\n\n## What the F, B, and R series mean\n\nThe letters describe *which layer of work a runbook belongs to*, rather than a\nproduct feature or a required technology.\n\n| Series | Created by | Where it lives | What it does |\n| --- | --- | --- | --- |\n| `INITIAL.md` | You or `supervisor initial` | `projects/<project-name>/` | The concise source brief: what is being made, for whom, where it will run, constraints, references, and desired outcome. It gives every later stage its context. |\n| `F001`\u2013`F016` | This repository | `runbooks/` | **Factory runbooks.** They analyse the brief, write the detailed product plan, and create the files that will write the final implementation instructions. They do not build the requested product. |\n| `B0001`, `B0002`, \u2026 | The F-series and later B dispatcher files | `projects/<slug>/authoring-runbooks/` | **Runbook-writing tasks.** A B task writes the next small set of R files. \u201cBounded\u201d simply means it has a hard limit: one B task may write no more than seven R files. |\n| `R0001`, `R0002`, \u2026 | B-series runbook-writing tasks | `projects/<slug>/runbooks/` | **Product-work runbooks.** Each R file gives detailed instructions and success checks for one small piece of building, testing, reviewing, documenting, or original-asset work. Every R file explicitly declares asset metadata and provenance links to its canonical specification, catalogue records, B batch, and originating F stages. |\n\nIn short:\n\n```text\nyour brief \u2192 F-series factory \u2192 B-series runbook writers \u2192 R-series product work\n```\n\nThe hierarchy stops there: F creates the plan and the B files, B writes R files,\nand R files describe the real implementation or verification work. For example,\na B file for an RPG's combat area might write up to seven R files: basic combat,\ndamage calculation, enemies, abilities, battle UI, balancing, and tests. For a\nlarge product, more B files are created for the next areas instead of making one\nagent write thousands of R files at once. The Supervisor finds those later B\nfiles and the R files automatically, so one `--run-all` invocation continues\nuntil the generated collection reaches its final audit or a real review gate.\n\n### How runbooks reference one another\n\nRunbooks do not pass the whole project history into every later prompt. They\nuse a small, explicit chain of references, while the full workspace remains\navailable for targeted lookup.\n\n| When | What is used | Why |\n| --- | --- | --- |\n| `F001` | `projects/<name>/INITIAL.md` | The user\u2019s original brief is the source of truth. F001 normalizes it but never replaces it. |\n| `F002`\u2013`F004` | `INITIAL.md`, `PROJECT_BRIEF.md`, and the relevant earlier specification chapters | These stages refine product/domain, technical, and experience decisions. They use the documents produced by earlier F stages\u2014not every earlier F Markdown procedure. |\n| `F005`\u2013`F010` | The canonical `specification/` chapters and earlier planning outputs | These stages translate established decisions into dependencies, delivery areas, authoring contracts, and a safe handoff. |\n| `F011`\u2013`F013` | The canonical specification plus the delivery/contract planning outputs | These stages create the traceability system, implementation catalogue, dependency graph, and small B-series batches. |\n| `F014`\u2013`F016` | The catalogue, authoring manifest, quality gate, and canonical specification | These stages create B writers, validate their intended R contracts, and register the child collections that Supervisor follows. |\n| A B-series writer | Its own F013 context packet: only the assigned catalogue records, relevant specification sections, target constraints, templates, and reserved IDs | It writes no more than seven R files without needing a huge prompt or unrelated product context. |\n| An R-series task | Its own objective, dependencies, acceptance criteria, and provenance metadata | It performs one small piece of product work. It can open the linked canonical files when it needs more detail. |\n\nEach generated R file must declare this provenance in its front matter:\n\n```yaml\nsource_specifications: specification/03-technical-contract.md#save-state\nsource_catalogue_ids: IMP-SAVE-001\nauthoring_batch: B0007\nfactory_stages: F003,F005,F012,F013\n```\n\nThese fields answer different questions:\n\n- `source_specifications` \u2014 which canonical requirement sections explain the work.\n- `source_catalogue_ids` \u2014 which planned implementation records the task covers.\n- `authoring_batch` \u2014 which bounded B writer created this R task.\n- `factory_stages` \u2014 which F stages established the underlying requirement.\n\nThe F and B references provide **provenance**, not a reason to use procedural\nfactory Markdown as implementation requirements. The canonical specification\nand planning files remain the authoritative context. R-to-R dependencies define\nexecution order; Supervisor also follows explicit `.supervisor-children/`\nregistrations from the F collection to the B collection and then to the R\ncollection.\n\n### Terms used in this repository\n\n| Term | Meaning here |\n| --- | --- |\n| **Runbook** | A Markdown work instruction with scope, steps, dependencies, and evidence required to mark it complete. |\n| **Runbook-writing task / authoring task** | A runbook whose output is more runbook Markdown files. It does not write application code. B-series files are these tasks. |\n| **Bounded** | Deliberately limited in size. A B-series task writes a maximum of seven R-series files. |\n| **Catalogue** | The complete checklist of product work that must eventually be covered: features, technical foundations, content, quality, release work, and dependencies. |\n| **Collection** | A folder of runbooks that Supervisor can run. The root F collection creates child B and R collections for one generated project. |\n| **Dispatcher** | A B-series file whose only job is to create the next B-series files when more parts of the catalogue still need R runbooks. |\n| **Contract** | The required shape of a runbook: its goal, inputs, steps, acceptance criteria, and evidence. It is not a legal agreement or an API contract. |\n\n### F-series factory stages, in detail\n\nThe F-series is deliberately product-agnostic. It uses the brief to decide what\n\u201ccomplete\u201d means for this particular product: an RPG may need story, systems,\ncontent, balancing, save state, and platform work; an IDE may need language\nservices, debugging, extensions, and source control; an operating system may\nneed kernel, hardware, security, installation, and system-management work.\n\n| Stage | What it establishes | Main output for later stages |\n| --- | --- | --- |\n| `F001` | Reads `INITIAL.md`, normalizes the requested outcome, distinguishes explicit requirements from safe assumptions and unanswered decisions, and discovers the product-specific system families. | `PROJECT_BRIEF.md` and the first domain-discovery specification. |\n| `F002` | Defines the domain model, key users or actors, journeys, feature areas, release slices, and the boundaries between first release and later work. | A product map that can be divided into independently buildable areas. |\n# 10 \u2014 Specification-to-runbook authoring handoff\n\n**Purpose:** hand the audited planning catalogue to F011\u2013F016 without starting\nproduct implementation, testing, deployment, or release activity. This file is\nan authoring control record, not an implementation plan that overrides the\n[source brief](../INITIAL.md).\n\n## Authoritative inputs and evidence locations\n\nRead these in order. If sources conflict, preserve the source brief, record the\nconflict in the F011 decision log, and stop the affected allocation rather than\ninventing a resolution.\n\n1. [INITIAL.md](../INITIAL.md) is the original source of truth; the normalized\n   [product brief](../specification/01-product-brief.md) preserves its scope.\n2. [Domain discovery](../specification/00-domain-discovery.md), the feature,\n   technical, and experience contracts (`02`\u2013`04`) define the discovered\n   product and target constraints.\n3. [Delivery map](05-delivery-map.md) provides the dependency order DM-01 to\n   DM-20. [Foundation](06-foundation-domain-contracts.md),\n   [feature](07-feature-experience-contracts.md), and\n   [quality](08-quality-operations-contracts.md) define FDN-01\u201309,\n   FEX-01\u201314, and QOR-01\u201308 ownership and acceptance evidence.\n4. [Contract audit](09-contract-audit.md) is the current closure evidence,\n   including browser-spec ownership and retained decisions.\n\nF011 writes canonical specification and traceability evidence under\n`specification/` (including `requirements.md`, `requirements.json`, a\ntraceability matrix, decision log, platform appendix, and specification index).\nF012 writes the implementation catalogue and graph under `planning/`; F013\nwrites the batch manifest there; F014 writes B-series authoring runbooks under\n`authoring-runbooks/` and their registration records; F015 writes structural\nquality-gate evidence; and F016 writes the project README and durable resume\nhandoff. Generated R-series instructions and their evidence belong in\n`runbooks/` and the locations named by their final contracts. Planned test and\nbrowser paths are ownership reservations only until a later implementation task\ncreates executable code and independent evidence.\n\n## Scope boundary and original-design rule\n\nThe P0 to author is an original, offline-capable 2D, single-player fantasy RPG:\none town, one dungeon, a guided short campaign ending, exploration, dialogue,\nquests, party-based turn-based combat, inventory/rewards, onboarding, local\nsave/load/checkpoints/recovery, settings/accessibility, responsive web, and an\ninstallable PWA with safe offline/update behaviour. It uses a shared core with\nonly necessary web/PWA adaptations.\n\nDo not author implementation work for additional regions, chapters, native\napps, PWA-exclusive rules, live events, player-created/shared content, advanced\nanalytics/monetisation, cloud sync, payment flows, accounts/identity,\nmultiplayer, moderation, player-safety services, live operations, or\nentitlements. The brief mentions several connected capabilities, but their\nconflict with the offline P0 remains an explicit hold; no author may recast\nthat hold as approved scope.\n\nThe Final Fantasy V reference permits only high-level party-based turn-based\nadventure scope. Never reproduce or request copied names, branding, assets,\nstory/lore, dialogue, maps, music, layouts, menus, combat screens, interaction\nchoreography, or distinctive presentation. All planned content and assets must\nbe independently original, warm hand-painted fantasy with readable silhouettes\nand a restrained palette, supported by provenance records and later human\nreview.\n\n## Execution order and dependencies\n\n| Stage | Required outcome | Inputs / dependency | Cannot proceed without |\n| --- | --- | --- | --- |\n| F011 | Canonical `REQ-*`, `NFR-*`, `DEC-*`, `RISK-*`, `GATE-*` system and traceability | This handoff and all specifications/planning 05\u201309 | Recording, not deciding, open choices |\n| F012 | Bounded `IMP-*` catalogue, ownership, and acyclic graph | Completed F011 | Requirement traceability and named domain shards |\n| F013 | Persistent B/R allocation ledger and context packets | Completed F012 | Unique immutable IDs and dependency-safe batches of at most seven R contracts |\n| F014 | Bootstrap B-series/dispatcher collection and child registrations | Completed F013 | Valid manifest, bounded wave, and existing-ID collision checks |\n| F015 | Structural/traceability quality gate and recovery procedure | F014 output plus manifest | Passing ownership, metadata, dependency, asset, and browser-path checks |\n| F016 | Project README, registrations, evidence map, and resume handoff | F015 quality evidence | Explicit holds and safe resume points retained |\n\nWithin later implementation contracts, preserve the DM order: select and\nbootstrap the framework before core/state/content; establish persistence and\nrecovery before session/UI; complete campaign rules before their UI; then input\nand accessibility, PWA lifecycle, release hardening, quality evidence, and\ndocumentation. Parallel authoring is allowed only for contracts whose declared\ndependencies are already satisfied and whose files/data/browser paths do not\noverlap.\n\n## Decision gates, approvals, and stop conditions\n\nThe following gates require a human or responsible external owner before a\ndependent contract is allocated as ready: engine/framework and package manager;\nCI runtime; browser storage API/quota; browser/device/assistive-tech and\nnetwork matrix; numeric performance budget; host/CDN and service-worker rollout;\ncontent quantities, party size, balance, locale, audio and remapping scope;\nfont/contrast targets; diagnostics provider/transport, retention and privacy;\nand ratings, age, regional, legal, support, store, or certification policy.\n\nStop the batch authoring system and mark the item blocked\u2014not failed or\nimplicitly approved\u2014when any of these occurs:\n\n- an open decision changes scope, privacy/security, cost, legal obligations,\n  connected services, or delivery commitments;\n- a requirement lacks a source, owner, verification approach, or safe bounded\n  contract; a dependency is cyclic or ownership conflicts;\n- an R/B/asset ID, output path, browser test path, or accepted contract would\n  be overwritten, renumbered, duplicated, or ambiguously owned;\n- a request entails credentials, paid services, account creation, store action,\n  deployment, publishing, release approval, or real-device/certification access;\n- evidence would require claiming that planned paths, generated runbooks, or\n  structural validation prove product implementation or release readiness.\n\n## Safe authoring-agent configuration\n\nUse a workspace-scoped authoring agent with no secrets, deployments, payments,\npublishing, external account actions, or authority to approve gates. Give each\nagent only its manifest context packet, the source documents it cites, its\nassigned immutable IDs, and its declared output paths. It may create Markdown,\nJSON manifests, validation instructions, and child-registration files only in\nthis project workspace; it must not create product source, generated game\nassets, tests that purport to validate a product, or release artefacts in this\nF011\u2013F016 phase.\n\nEvery authoring task records source links, requirement/contract IDs,\ndependencies, owned outputs, unresolved questions, gate status, and structural\nevidence. It checkpoints after each bounded batch, retains accepted IDs and\nmanifest counters, and resumes from the next unaccepted item. F015 is the\nstructural evidence gate: it validates metadata, traceability, dependency\nclosure, output ownership, asset assessment, and browser-path uniqueness. Any\nlater executable test, browser result, visual review, accessibility assessment,\nor release evidence must be stored at the paths named by its implementation\ncontract and remains outside this authoring handoff.\n\n## Assumptions and risks carried forward\n\nSafe assumptions are limited to an offline-first local campaign, original\ncontent/UI, shared core with necessary target adaptations, local durable saves\nwhere browser storage allows, visibly degraded connected features if ever\napproved, and privacy-minimised diagnostics. They are guardrails, not stack,\nvendor, backend, account, retention, performance, accessibility, or support\npromises.\n\nKey risks are unresolved connected-scope conflict; storage/quota and update\nloss hazards; unsupported browser/device or assistive-tech assumptions;\nunapproved performance targets; original-design/provenance failure; and\nmanifest/ID drift across resumed authoring waves. Mitigate each by retaining\nthe named gate, keeping save/cache responsibilities separated, requiring\nprovenance and human creative review, and using the F013 ledger plus F015\nquality gate before dispatching further work.\n\n## Readiness statement\n\nThe catalogue is ready for **batch authoring only**: audited inputs identify\nthe P0 boundary, contract namespaces, delivery dependencies, evidence owners,\nand unresolved decision gates. F011\u2013F016 may now formalise, shard, allocate,\nvalidate, and hand off implementation instructions. This statement does not\nselect a technology, authorize any gate, create implementation or release\nwork, or assert that the game has been built, tested, or approved for release.\n\nexec\n/bin/zsh -lc \"sed -n '1,180p' projects/mock-fantasy-quest-4/authoring-runbooks/B0002.md\nsed -n '1,180p' runbooks/F015.md\nsed -n '1,160p' projects/mock-fantasy-quest-4/specification/domain-completeness-review.md\" in /Users/simon/Dev/github/jakowicz/runbook-generator\n succeeded in 0ms:\n---\ntask_id: B0002\nsequence: 3\ntitle: Author shared seams and deterministic harness contracts\nbrowser_impact: not_applicable\nplaywright_spec:\n---\n\n## Objective\n\nCreate only `../runbooks/R0002.md`, `../runbooks/R0003.md`, and\n`../runbooks/R0010.md` for B0002. They map respectively to IMP-0002, IMP-0003,\nand IMP-0010; B0001 must be accepted first.\n\n## Context packet\n\nRead `../PROJECT_BRIEF.md`, the B0002 manifest record, its three catalogue\nrecords, and only these specification sections: `03-technical-contract.md#architecture-and-requirement-traceability`,\n`03-technical-contract.md#commands-validation-idempotency-and-concurrency`,\n`04-experience-contract.md#layout-visual-tokens-and-responsive-behaviour`, and\n`04-experience-contract.md#accessibility-policy`.\n\n## Output list\n\n- `../runbooks/R0002.md` \u2014 IMP-0002; dependencies R0001.\n- `../runbooks/R0003.md` \u2014 IMP-0003; dependencies R0001,R0002.\n- `../runbooks/R0010.md` \u2014 IMP-0010; dependencies R0001,R0002.\n\n## Required authoring content\n\nFor each output, use standard Supervisor front matter and the exact manifest\nprovenance (`source_specifications`, `source_catalogue_ids`, `authoring_batch:\nB0002`, `factory_stages: F011,F012,F013`) plus `asset_impact:\nnot_applicable` and blank `asset_ids`. Make each an individually implementable\ntask containing objective, dependencies, relevant requirements, ownership,\nbehaviour, non-goals, web/PWA differences, verification/evidence, observable\nacceptance criteria, and an `## Asset assessment` that prohibits incidental\nassets.\n\n## Validation procedure\n\nRefuse a conflicting existing R ID or path. Load every output, compare all\nmetadata and dependencies to the manifest, verify provenance fields are\nnon-empty, and verify that all three outputs have the required sections.\n\n## Checkpoint and update procedure\n\nUpdate only B0002's checkpoint/state after all three outputs validate. Preserve\naccepted outputs and repair only the failed assigned file on resume.\n\n## Stop condition\n\nStop after these three files; do not resolve the retained design gates or write another R-series contract.\n\n## Acceptance criteria\n\n- R0002, R0003, and R0010 are the only outputs and each maps to its assigned IMP record.\n- Each output is bounded, traceable, dependency-correct, and explicitly prohibits incidental asset work.\n- Metadata, required sections, and manifest ownership are structurally validated before checkpointing.\n- ID or ownership mismatches stop the batch without overwrite or renumbering.\n---\ntask_id: F015\nsequence: 15\ntitle: Validate generated authoring batches and implementation contracts\nbrowser_impact: not_applicable\nplaywright_spec:\n---\n\n## Objective\n\nCreate `projects/<project-slug>/planning/runbook-generation-quality-gate.md`\nand validation instructions/scripts that can be run after every B-series wave.\nValidate the authoring collection itself and the R-series contracts it produces.\nThe validation is structural and traceability-based; it must not claim the\nproduct has been implemented or released.\n\n## Acceptance criteria\n\n- Validation checks required front matter, unique IDs, sequence ordering,\n  requirement links, dependency closure, output ownership, and unsupported\n  circular dependencies. Every R contract must also have non-empty provenance:\n  canonical `source_specifications`, `source_catalogue_ids`, its originating\n  `authoring_batch`, and valid `factory_stages`; the links must resolve to the\n  manifest and canonical specification rather than merely naming an F or B\n  procedure file.\n- Validation checks every R-series contract has an explicit asset assessment:\n  `asset_impact` is `required` or `not_applicable`, `asset_ids` is present,\n  asset-required contracts reserve non-empty unique stable IDs and an asset\n  brief/style version, and non-asset contracts do not silently introduce asset\n  work. It reports missing, duplicate, ambiguous, or unowned asset IDs.\n- It detects duplicate browser test paths and confirms browser-impact metadata\n  only where browser behaviour is actually in scope.\n- It reports catalogue/manifest/specification coverage counts and identifies\n  every missing, duplicate, blocked, or unverified contract by ID.\n- It fails the quality gate when a discovered domain family has no specification\n  chapter, content/authoring approach where applicable, implementation\n  contracts, or traceable verification. It checks category-appropriate\n  completeness rather than applying a fixed checklist to every product.\n- It includes recovery: how to rerun one failed B-series authoring task, repair\n  a bounded R-series range, and resume the next dispatcher wave without\n  regenerating accepted work.\n- Human gates, paid services, credentials, legal/compliance decisions, device\n  access, and store/certification actions remain explicit review points.\n# Domain-completeness review\n\nReview basis: discovery map plus feature, technical, experience and delivery contracts. \u201cChapter\u201d may be an existing bounded F001\u2013F010 source until later authoring expands it. Every family has explicit entities/rules, dependencies, authoring model where needed, and a release decision.\n\n| System family | Requirement chapter / entities and rules | Cross-domain dependencies | Authoring model | Release decision |\n| --- | --- | --- | --- | --- |\n| Shell/session/input/rendering | SPEC-02/04; Session, InputAction, viewport; pause/focus semantic action rules | save, accessibility, scenes | routes, controls, layouts | P0 shared core; web adapters |\n| Town/dungeon exploration | SPEC-02; Scene, Exit, Interactable; collision/gates/safe boundaries | quests, combat, save, content | original scene/layout/NPC/exit data | P0: exactly one town/one dungeon |\n| Narrative/quests/tutorial/ending | SPEC-02; Quest, Dialogue, Campaign; predicates/reward-once/ending | scenes, inventory, combat, save | original text/localisation keys and quest graph | P0; quantities/locales gated |\n| Combat/party/rewards | SPEC-02; Party, Encounter; legal turns/defeat/checkpoints | quests, inventory, save | encounters/actions/reward definitions | P0; party size/balance gated |\n| Inventory/progression | SPEC-02; Item, inventory; legal use/protected quest items | quests, party, save | item/equipment definitions | P0 |\n| Persistence/recovery | SPEC-02/03; snapshot/checkpoint; atomic/version/quarantine rules | all durable game state, PWA cache | schema/migrations/fixtures | P0, storage policy gated |\n| Accessibility/localisation/feedback | SPEC-04; preferences/options; semantic/reflow/non-colour rules | shell, input, content | strings, captions, tokens, feedback assets | P0; exact targets/locales/assets gated |\n| Content/original assets | SPEC-02/03; ContentPackage; validation/reachability/provenance | all gameplay and UI | source manifest, assets, locale, validator | P0; original boundary explicit |\n| PWA/release/quality | SPEC-03; cache/version/release; safe activation/rollback | persistence, shell, content | manifest/precache/release metadata/evidence | P0 PWA, operations thresholds gated |\n| Privacy/diagnostics | SPEC-03/04; diagnostic record; consent/redaction/deletion | recovery, release | diagnostic schema and disclosure | P0 local-minimal; transport/retention gated |\n| Account/sync | SPEC-00; potential identity/replication/conflict rules | save/privacy/security | none until approved | hold, GATE-0006 |\n| Multiplayer/safety/live service/commerce | SPEC-00; service/safety/entitlement models not authored | privacy/security/operations/legal | none until approved | hold, GATE-0006 |\n\n**Conclusion:** the P0 game disciplines are complete enough to decompose without rediscovery. Deferred/contradictory connected disciplines are deliberately represented as held chapters rather than omitted or silently designed. No copied reference expression is authorised in any chapter.\n\ncodex\n{\"status\":\"pass\",\"summary\":\"The current workspace has the F013 manifest and B0001\u2013B0006 writers but no generated R files yet. I\u2019m adding a validator that intentionally reports this as missing-contract coverage rather than mistaking authoring plans for implementation evidence.\",\"changed_files\":[],\"test_result\":\"\",\"evidence\":{\"agent_log\":\"\",\"adapter_log\":\"\",\"test_log\":\"\",\"browser_log\":\"\",\"screenshots\":[]},\"acceptance_results\":[],\"documentation\":{\"reviewed_files\":[\"README.md\",\"projects/mock-fantasy-quest-4/planning/10-authoring-handoff.md\"],\"updated_files\":[],\"summary\":\"Inspected the authoring handoff and collection conventions.\"},\"known_limitations\":[],\"browser_coverage\":\"No browser behavior is implemented by this documentation/validator task.\",\"recommended_next_step\":\"complete\"}\n2026-08-02T14:58:41.907022Z ERROR codex_core::tools::router: error=apply_patch verification failed: Failed to find expected lines in /Users/simon/Dev/github/jakowicz/runbook-generator/README.md:\nR-to-R dependencies define\nexecution order; Supervisor also follows explicit `.supervisor-children/`\nregistrations from the F collection to the B collection and then to the R\ncollection.\napply patch\npatch: completed\n/Users/simon/Dev/github/jakowicz/runbook-generator/projects/mock-fantasy-quest-4/planning/runbook-generation-quality-gate.md\n/Users/simon/Dev/github/jakowicz/runbook-generator/projects/mock-fantasy-quest-4/planning/validate_runbook_generation.py\ndiff --git a/projects/mock-fantasy-quest-4/planning/runbook-generation-quality-gate.md b/projects/mock-fantasy-quest-4/planning/runbook-generation-quality-gate.md\nnew file mode 100644\nindex 0000000000000000000000000000000000000000..7d64f653f18bb12bd48c5de8c42cbadf06cddd1d\n--- /dev/null\n+++ b/projects/mock-fantasy-quest-4/planning/runbook-generation-quality-gate.md\n@@ -0,0 +1,41 @@\n+# Runbook-generation quality gate\n+\n+Run this after each B-series authoring wave:\n+\n+```zsh\n+python3 projects/mock-fantasy-quest-4/planning/validate_runbook_generation.py\n+```\n+\n+Use `--wave B0004` for a checkpoint through one batch. The validator reads the\n+canonical specification, catalogue, manifest, B writers, and generated R\n+contracts. It is structural evidence only: it does not build, test, review,\n+deploy, or release the product.\n+\n+## Checks\n+\n+- Unique, ordered B/R IDs; dependency closure/cycles; manifest output ownership;\n+  requirement links; and exact, canonical provenance links.\n+- Required R front matter and matching manifest metadata. Missing, duplicate,\n+  blocked, unverified, and unallocated IDs are printed with coverage counts.\n+- Explicit asset assessments. Asset-required work needs unique stable `ASSET-*`\n+  IDs, an asset brief, and a visual-style version; non-asset work may not reserve\n+  IDs or silently introduce asset work.\n+- Unique browser test paths and browser-impact metadata only for web/PWA\n+  behaviour. A web/PWA target alone does not require browser metadata.\n+\n+The initial foundation wave correctly fails until B writers create their\n+reserved R files; that is a missing authoring artefact, not product failure.\n+\n+## Recovery and human review\n+\n+1. Rerun only the failed B writer using its manifest context packet; retain its\n+   B/R IDs and change only assigned R paths.\n+2. Repair a bounded R range through its owning B writer(s), then rerun this\n+   command through the final affected `--wave` value. Never regenerate accepted\n+   work or renumber IDs.\n+3. Checkpoint accepted work and resume the dispatcher at the manifest's first\n+   unaccepted B batch.\n+\n+Stop for human review on gates, credentials, paid services, legal/compliance or\n+licensing decisions, device access, store/certification actions, deployment,\n+publishing, or release approval. Mark work blocked and retain IDs.\ndiff --git a/projects/mock-fantasy-quest-4/planning/validate_runbook_generation.py b/projects/mock-fantasy-quest-4/planning/validate_runbook_generation.py\nnew file mode 100644\nindex 0000000000000000000000000000000000000000..5f9e376ed1fb091d1034e0d0cd9ab2095efe1b28\n--- /dev/null\n+++ b/projects/mock-fantasy-quest-4/planning/validate_runbook_generation.py\n@@ -0,0 +1,130 @@\n+#!/usr/bin/env python3\n+\"\"\"Structural quality gate for generated B-series and R-series runbooks.\n+\n+This validates planning artefacts only; it is never product or release evidence.\n+\"\"\"\n+from __future__ import annotations\n+import argparse\n+import json\n+import re\n+import sys\n+from collections import Counter, defaultdict\n+from pathlib import Path\n+\n+ROOT = Path(__file__).resolve().parents[1]\n+MANIFEST_PATH = ROOT / \"planning/runbook-authoring-manifest.json\"\n+CATALOGUE_PATH = ROOT / \"planning/implementation-catalogue-index.json\"\n+R_ID, F_ID = re.compile(r\"^R\\d{4}$\"), re.compile(r\"^F\\d{3}$\")\n+\n+def values(value):\n+    return value if isinstance(value, list) else ([value] if value else [])\n+\n+def parse_value(value):\n+    value = value.strip().strip(\"\\\"'\")\n+    if value == \"[]\": return []\n+    if value.startswith(\"[\") and value.endswith(\"]\"):\n+        return [item.strip().strip(\"\\\"'\") for item in value[1:-1].split(\",\") if item.strip()]\n+    return value\n+\n+def front_matter(path):\n+    text = path.read_text(encoding=\"utf-8\")\n+    if not text.startswith(\"---\\n\"): return {}\n+    end = text.find(\"\\n---\", 4)\n+    if end < 0: return {}\n+    result, key = {}, None\n+    for line in text[4:end].splitlines():\n+        if line.lstrip().startswith(\"-\") and key:\n+            result.setdefault(key, []).append(parse_value(line.split(\"-\", 1)[1]))\n+        elif \":\" in line:\n+            key, value = line.split(\":\", 1); key = key.strip(); result[key] = parse_value(value)\n+    return result\n+\n+def headings(path):\n+    return {re.sub(r\"[^a-z0-9]+\", \"-\", match.group(1).lower()).strip(\"-\")\n+            for match in re.finditer(r\"^#{1,6}\\s+(.+?)\\s*$\", path.read_text(encoding=\"utf-8\"), re.M)}\n+\n+def main():\n+    parser = argparse.ArgumentParser(description=__doc__)\n+    parser.add_argument(\"--wave\", help=\"validate allocations through this B batch\")\n+    args = parser.parse_args()\n+    manifest = json.loads(MANIFEST_PATH.read_text())\n+    catalogue = json.loads(CATALOGUE_PATH.read_text())\n+    batches = {b[\"id\"]: b for b in manifest[\"batches\"]}\n+    contracts = manifest[\"r_contracts\"]\n+    if args.wave:\n+        if args.wave not in batches: parser.error(\"unknown B batch: \" + args.wave)\n+        contracts = [c for c in contracts if batches.get(c.get(\"authoring_batch\"), {}).get(\"order\", 999) <= batches[args.wave][\"order\"]]\n+    records = {r[\"id\"]: r for r in catalogue[\"contracts\"]}\n+    errors, missing, blocked, unverified = [], [], [], []\n+    def fail(text): errors.append(text)\n+    ids = [c.get(\"id\", \"\") for c in contracts]\n+    if ids != sorted(ids): fail(\"manifest R IDs are not sequence ordered\")\n+    for item, count in Counter(ids).items():\n+        if count > 1: fail(\"duplicate manifest R ID \" + item)\n+    paths = [c.get(\"output_path\", \"\") for c in contracts]\n+    for item, count in Counter(paths).items():\n+        if count > 1: fail(\"duplicate output path \" + item)\n+    assets, browser_paths = {}, defaultdict(list)\n+    for contract in contracts:\n+        rid, batch = contract.get(\"id\", \"\"), contract.get(\"authoring_batch\", \"\")\n+        if not R_ID.fullmatch(rid): fail(f\"invalid R ID {rid!r}\")\n+        if batch not in batches or rid not in batches.get(batch, {}).get(\"r_contract_ids\", []): fail(f\"{rid}: authoring batch ownership mismatch\")\n+        catalogue_ids = values(contract.get(\"source_catalogue_ids\"))\n+        if not catalogue_ids or contract.get(\"catalogue_id\") not in catalogue_ids: fail(f\"{rid}: missing or inconsistent catalogue provenance\")\n+        for cid in catalogue_ids:\n+            if cid not in records: fail(f\"{rid}: unknown catalogue ID {cid}\")\n+        if contract.get(\"catalogue_id\") in records and not records[contract[\"catalogue_id\"]].get(\"requirement_ids\"): fail(f\"{rid}: catalogue record lacks requirement links\")\n+        specs = values(contract.get(\"source_specifications\"))\n+        if not specs: fail(f\"{rid}: missing source_specifications\")\n+        for link in specs:\n+            file_name, _, anchor = link.partition(\"#\"); source = ROOT / file_name\n+            if not link.startswith(\"specification/\") or not source.is_file() or (anchor and anchor not in headings(source)):\n+                fail(f\"{rid}: unresolved canonical specification link {link}\")\n+        stages = values(contract.get(\"factory_stages\"))\n+        if not stages or any(not F_ID.fullmatch(s) for s in stages): fail(f\"{rid}: invalid factory_stages\")\n+        for dependency in values(contract.get(\"dependencies\")):\n+            if dependency not in ids: fail(f\"{rid}: dependency {dependency} is outside allocation\")\n+            elif dependency >= rid: fail(f\"{rid}: dependency {dependency} does not precede contract\")\n+        impact, asset_ids = contract.get(\"asset_impact\"), values(contract.get(\"asset_ids\"))\n+        if impact not in {\"required\", \"not_applicable\"}: fail(f\"{rid}: invalid asset_impact\")\n+        if \"asset_ids\" not in contract: fail(f\"{rid}: asset_ids absent\")\n+        if impact == \"required\":\n+            if not asset_ids or not contract.get(\"asset_brief\") or not contract.get(\"visual_style_version\"): fail(f\"{rid}: required assets lack IDs, brief, or style version\")\n+            for asset in asset_ids:\n+                if not re.fullmatch(r\"ASSET-[A-Z0-9-]+\", asset): fail(f\"{rid}: unstable asset ID {asset}\")\n+                if asset in assets: fail(f\"asset {asset} ambiguously owned by {assets[asset]} and {rid}\")\n+                assets[asset] = rid\n+        elif asset_ids: fail(f\"{rid}: non-asset contract reserves asset IDs\")\n+        r_path = ROOT.parent.parent / contract.get(\"output_path\", \"\")\n+        if not r_path.is_file(): missing.append(rid); continue\n+        meta = front_matter(r_path)\n+        for field in (\"task_id\", \"sequence\", \"source_specifications\", \"source_catalogue_ids\", \"authoring_batch\", \"factory_stages\", \"asset_impact\", \"asset_ids\"):\n+            if field not in meta: fail(f\"{rid}: {r_path.name} lacks {field}\")\n+        if meta.get(\"task_id\") != rid: fail(f\"{rid}: task ID mismatch\")\n+        for field in (\"source_specifications\", \"source_catalogue_ids\", \"authoring_batch\", \"factory_stages\", \"asset_impact\", \"asset_ids\"):\n+            if values(meta.get(field)) != values(contract.get(field)): fail(f\"{rid}: {field} differs from manifest\")\n+        browser, specs = meta.get(\"browser_impact\", \"not_applicable\"), values(meta.get(\"playwright_spec\", meta.get(\"playwright_specs\")))\n+        if browser == \"not_applicable\" and specs: fail(f\"{rid}: browser path on non-browser contract\")\n+        if browser != \"not_applicable\" and (not specs or not set(records.get(contract.get(\"catalogue_id\"), {}).get(\"targets\", [])) & {\"web\", \"pwa\"}): fail(f\"{rid}: browser metadata outside browser behaviour scope\")\n+        for spec in specs: browser_paths[spec].append(rid)\n+        if \"## Verification\" not in r_path.read_text(encoding=\"utf-8\"): unverified.append(rid)\n+        if batches.get(batch, {}).get(\"state\") in {\"blocked_on_gate\", \"blocked\", \"repairable\"}: blocked.append(rid)\n+    for path, owners in browser_paths.items():\n+        if len(owners) > 1: fail(f\"duplicate browser test path {path}: {', '.join(owners)}\")\n+    graph = {c[\"id\"]: values(c.get(\"dependencies\")) for c in contracts}; active, done = set(), set()\n+    def visit(node):\n+        if node in active: fail(\"unsupported circular dependency through \" + node); return\n+        if node not in done:\n+            active.add(node)\n+            for dep in graph[node]:\n+                if dep in graph: visit(dep)\n+            active.remove(node); done.add(node)\n+    for node in graph: visit(node)\n+    allocated = {c.get(\"catalogue_id\") for c in contracts}\n+    unallocated = [cid for cid in records if cid not in allocated]\n+    print(\"Runbook-generation structural quality gate (not product/release evidence)\")\n+    for label, result in ((\"catalogue contracts\", list(records)), (\"manifest contracts\", ids), (\"R files missing\", missing), (\"blocked contracts\", blocked), (\"unverified contracts\", unverified), (\"unallocated catalogue contracts\", unallocated), (\"reserved asset IDs\", list(assets)), (\"browser test paths\", list(browser_paths))):\n+        print(f\"{label}: {len(result)}\" + (\" (\" + \", \".join(sorted(result)) + \")\" if result else \"\"))\n+    for error in errors: print(\"ERROR:\", error)\n+    return 1 if errors or missing or unverified else 0\n+if __name__ == \"__main__\": sys.exit(main())\n\nhook: PostToolUse\nhook: PostToolUse Failed\ndiff --git a/projects/mock-fantasy-quest-4/planning/runbook-generation-quality-gate.md b/projects/mock-fantasy-quest-4/planning/runbook-generation-quality-gate.md\nnew file mode 100644\nindex 0000000000000000000000000000000000000000..7d64f653f18bb12bd48c5de8c42cbadf06cddd1d\n--- /dev/null\n+++ b/projects/mock-fantasy-quest-4/planning/runbook-generation-quality-gate.md\n@@ -0,0 +1,41 @@\n+# Runbook-generation quality gate\n+\n+Run this after each B-series authoring wave:\n+\n+```zsh\n+python3 projects/mock-fantasy-quest-4/planning/validate_runbook_generation.py\n+```\n+\n+Use `--wave B0004` for a checkpoint through one batch. The validator reads the\n+canonical specification, catalogue, manifest, B writers, and generated R\n+contracts. It is structural evidence only: it does not build, test, review,\n+deploy, or release the product.\n+\n+## Checks\n+\n+- Unique, ordered B/R IDs; dependency closure/cycles; manifest output ownership;\n+  requirement links; and exact, canonical provenance links.\n+- Required R front matter and matching manifest metadata. Missing, duplicate,\n+  blocked, unverified, and unallocated IDs are printed with coverage counts.\n+- Explicit asset assessments. Asset-required work needs unique stable `ASSET-*`\n+  IDs, an asset brief, and a visual-style version; non-asset work may not reserve\n+  IDs or silently introduce asset work.\n+- Unique browser test paths and browser-impact metadata only for web/PWA\n+  behaviour. A web/PWA target alone does not require browser metadata.\n+\n+The initial foundation wave correctly fails until B writers create their\n+reserved R files; that is a missing authoring artefact, not product failure.\n+\n+## Recovery and human review\n+\n+1. Rerun only the failed B writer using its manifest context packet; retain its\n+   B/R IDs and change only assigned R paths.\n+2. Repair a bounded R range through its owning B writer(s), then rerun this\n+   command through the final affected `--wave` value. Never regenerate accepted\n+   work or renumber IDs.\n+3. Checkpoint accepted work and resume the dispatcher at the manifest's first\n+   unaccepted B batch.\n+\n+Stop for human review on gates, credentials, paid services, legal/compliance or\n+licensing decisions, device access, store/certification actions, deployment,\n+publishing, or release approval. Mark work blocked and retain IDs.\ndiff --git a/projects/mock-fantasy-quest-4/planning/validate_runbook_generation.py b/projects/mock-fantasy-quest-4/planning/validate_runbook_generation.py\nnew file mode 100644\nindex 0000000000000000000000000000000000000000..5f9e376ed1fb091d1034e0d0cd9ab2095efe1b28\n--- /dev/null\n+++ b/projects/mock-fantasy-quest-4/planning/validate_runbook_generation.py\n@@ -0,0 +1,130 @@\n+#!/usr/bin/env python3\n+\"\"\"Structural quality gate for generated B-series and R-series runbooks.\n+\n+This validates planning artefacts only; it is never product or release evidence.\n+\"\"\"\n+from __future__ import annotations\n+import argparse\n+import json\n+import re\n+import sys\n+from collections import Counter, defaultdict\n+from pathlib import Path\n+\n+ROOT = Path(__file__).resolve().parents[1]\n+MANIFEST_PATH = ROOT / \"planning/runbook-authoring-manifest.json\"\n+CATALOGUE_PATH = ROOT / \"planning/implementation-catalogue-index.json\"\n+R_ID, F_ID = re.compile(r\"^R\\d{4}$\"), re.compile(r\"^F\\d{3}$\")\n+\n+def values(value):\n+    return value if isinstance(value, list) else ([value] if value else [])\n+\n+def parse_value(value):\n+    value = value.strip().strip(\"\\\"'\")\n+    if value == \"[]\": return []\n+    if value.startswith(\"[\") and value.endswith(\"]\"):\n+        return [item.strip().strip(\"\\\"'\") for item in value[1:-1].split(\",\") if item.strip()]\n+    return value\n+\n+def front_matter(path):\n+    text = path.read_text(encoding=\"utf-8\")\n+    if not text.startswith(\"---\\n\"): return {}\n+    end = text.find(\"\\n---\", 4)\n+    if end < 0: return {}\n+    result, key = {}, None\n+    for line in text[4:end].splitlines():\n+        if line.lstrip().startswith(\"-\") and key:\n+            result.setdefault(key, []).append(parse_value(line.split(\"-\", 1)[1]))\n+        elif \":\" in line:\n+            key, value = line.split(\":\", 1); key = key.strip(); result[key] = parse_value(value)\n+    return result\n+\n+def headings(path):\n+    return {re.sub(r\"[^a-z0-9]+\", \"-\", match.group(1).lower()).strip(\"-\")\n+            for match in re.finditer(r\"^#{1,6}\\s+(.+?)\\s*$\", path.read_text(encoding=\"utf-8\"), re.M)}\n+\n+def main():\n+    parser = argparse.ArgumentParser(description=__doc__)\n+    parser.add_argument(\"--wave\", help=\"validate allocations through this B batch\")\n+    args = parser.parse_args()\n+    manifest = json.loads(MANIFEST_PATH.read_text())\n+    catalogue = json.loads(CATALOGUE_PATH.read_text())\n+    batches = {b[\"id\"]: b for b in manifest[\"batches\"]}\n+    contracts = manifest[\"r_contracts\"]\n+    if args.wave:\n+        if args.wave not in batches: parser.error(\"unknown B batch: \" + args.wave)\n+        contracts = [c for c in contracts if batches.get(c.get(\"authoring_batch\"), {}).get(\"order\", 999) <= batches[args.wave][\"order\"]]\n+    records = {r[\"id\"]: r for r in catalogue[\"contracts\"]}\n+    errors, missing, blocked, unverified = []