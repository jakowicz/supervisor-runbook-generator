[stderr] +task_id: R0023
[stderr] +sequence: 23
[stderr] +title: Map semantic actions across supported inputs
[stderr] +dependencies: R0002,R0021,R0022
[stderr] +requirement_ids: REQ-0005,REQ-0009,NFR-0004
[stderr] +source_specifications: specification/04-experience-contract.md#input-and-interaction-adaptation
[stderr] +source_catalogue_ids: IMP-0023
[stderr] +authoring_batch: B0009
[stderr] +factory_stages: F011,F012,F013
[stderr] +asset_impact: not_applicable
[stderr] +asset_ids:
[stderr] +asset_brief: No assets; input semantics only.
[stderr] +audio_impact: not_applicable
