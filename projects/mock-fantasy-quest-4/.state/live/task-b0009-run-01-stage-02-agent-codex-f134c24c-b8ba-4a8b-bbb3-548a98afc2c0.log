[stderr] +title: Define semantic responsive game-shell and navigation contract
[stderr] +dependencies: R0010,R0021
[stderr] +requirement_ids: REQ-0007,REQ-0009,REQ-0010,NFR-0004
[stderr] +source_specifications: specification/04-experience-contract.md#information-architecture-and-navigation,specification/04-experience-contract.md#layout-visual-tokens-and-responsive-behaviour
