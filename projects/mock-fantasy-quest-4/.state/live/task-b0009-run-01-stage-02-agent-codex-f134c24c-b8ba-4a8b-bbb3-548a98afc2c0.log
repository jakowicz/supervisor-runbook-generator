[stderr] +title: Define shared session and safe checkpoint presentation model
[stderr] +dependencies: R0004,R0006,R0017
[stderr] +requirement_ids: REQ-0005,REQ-0006,NFR-0002,NFR-0003
[stderr] +source_specifications: specification/02-feature-model.md#1-game-shell-session-input-and-responsive-presentation,specification/04-experience-contract.md#empty-error-recovery-destructive-and-privacy-sensitive-states
