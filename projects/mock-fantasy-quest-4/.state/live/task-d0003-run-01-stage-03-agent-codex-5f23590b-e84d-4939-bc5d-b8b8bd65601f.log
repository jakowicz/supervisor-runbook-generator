[stderr] def _authoring_output_errors(runbook: Path) -> list[str]:
[stderr]     """Return structural errors for the R contracts owned by one B runbook."""
[stderr] 
[stderr]     if not re.fullmatch(r"B\d+", runbook.stem):
[stderr]         return []
[stderr]     document = runbook.read_text(encoding="utf-8")
[stderr]     output_section = re.search(r"^## Output list\s*$\n(.*?)(?=^## |\Z)", document, re.MULTILINE | re.DOTALL)
[stderr]     if not output_section:
[stderr]         return ["missing an ## Output list section"]
[stderr]     expected_ids = sorted(set(re.findall(r"\.\./runbooks/(R\d+)\.md", output_section.group(1))))
[stderr]     if not expected_ids:
[stderr]         return ["declares no R-series outputs"]
[stderr]     errors: list[str] = []
[stderr]     for task_id in expected_ids:
[stderr]         output = runbook.parent.parent / "runbooks" / f"{task_id}.md"
[stderr]         if not output.is_file():
[stderr]             errors.append(f"missing {task_id}.md")
[stderr]             continue
[stderr]         try:
[stderr]             task = load_task(output)
[stderr]         except ValueError as error:
[stderr]             errors.append(f"{task_id}.md is unreadable: {error}")
[stderr]             continue
[stderr]         if task.task_id != task_id:
[stderr]             errors.append(f"{task_id}.md declares task_id {task.task_id}")
[stderr]         if task.authoring_batch != runbook.stem:
[stderr]             errors.append(f"{task_id}.md has authoring_batch {task.authoring_batch or '<blank>'}")
[stderr]     return errors
