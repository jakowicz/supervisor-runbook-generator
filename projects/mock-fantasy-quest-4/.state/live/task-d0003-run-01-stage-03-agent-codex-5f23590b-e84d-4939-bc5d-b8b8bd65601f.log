[stderr] def _project_workspace(value: str) -> Path:
[stderr]     """Resolve a named project workspace without consulting the CLI install path."""
[stderr] 
[stderr]     requested = Path(value).expanduser()
[stderr]     if requested.is_absolute():
[stderr]         workspace = requested
[stderr]     elif requested.parts and requested.parts[0] == "projects":
[stderr]         workspace = Path.cwd() / requested
[stderr]     else:
[stderr]         workspace = Path.cwd() / "projects" / requested
[stderr]     workspace = workspace.resolve()
[stderr]     if not workspace.is_dir():
[stderr]         raise ValueError(f"--project requires an existing workspace: {workspace}. Run `supervisor initial` first.")
[stderr]     initial = workspace / "INITIAL.md"
[stderr]     if not initial.is_file():
[stderr]         raise ValueError(f"--project requires {initial}. Run `supervisor initial` first.")
[stderr]     return workspace
