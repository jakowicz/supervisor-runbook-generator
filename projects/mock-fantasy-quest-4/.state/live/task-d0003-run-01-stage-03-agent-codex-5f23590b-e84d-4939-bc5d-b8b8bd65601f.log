[stderr] def _reopen_invalid_authoring_tasks(runbooks: list[Path], states: dict[str, dict | None], database_path: Path) -> list[str]:
[stderr]     """Reopen accepted B tasks whose promised R contracts are not loadable."""
[stderr] 
[stderr]     reopened: list[str] = []
[stderr]     store = RunStore(database_path)
[stderr]     try:
[stderr]         for runbook in runbooks:
[stderr]             if (states.get(runbook.stem) or {}).get("status") != "accepted":
[stderr]                 continue
[stderr]             errors = _authoring_output_errors(runbook)
[stderr]             if errors:
[stderr]                 store.reopen_task(runbook.stem, "Authoring output validation failed: " + "; ".join(errors))
[stderr]                 reopened.append(runbook.stem)
[stderr]     finally:
[stderr]         store.close()
[stderr]     return reopened
