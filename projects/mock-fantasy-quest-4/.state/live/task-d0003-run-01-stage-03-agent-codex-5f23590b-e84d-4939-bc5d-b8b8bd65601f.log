[stderr] def _project_database_for_runbook(workspace: Path, runbook: Path, factory_database: Path) -> Path:
[stderr]     """Keep targeted B/R retries in their child collection's durable state."""
[stderr] 
[stderr]     try:
[stderr]         relative = runbook.resolve().relative_to(workspace.resolve())
[stderr]     except ValueError:
[stderr]         return factory_database
[stderr]     if relative.parent.name in {"authoring-runbooks", "runbooks"}:
[stderr]         return workspace / ".state" / f"{relative.parent.name}.sqlite3"
[stderr]     return factory_database
