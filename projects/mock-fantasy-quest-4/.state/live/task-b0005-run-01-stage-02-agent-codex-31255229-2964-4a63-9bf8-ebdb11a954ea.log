":\"Campaign content and domain logic\",\"max_contracts\":250,\"depends_on\":[\"SHARD-01\"],\"covers\":[\"exploration\",\"dialogue\",\"quests\",\"tutorial\",\"combat\",\"inventory\",\"party progression\",\"town/dungeon/ending content\",\"content validation\"],\"requirement_ids\":[\"REQ-0001\",\"REQ-0002\",\"REQ-0003\",\"REQ-0004\",\"REQ-0005\",\"REQ-0008\",\"NFR-0007\",\"NFR-0008\"],\"gate\":\"GATE-0004\",\"target_allocation\":\"shared core and content only; no UI ownership\",\"state\":\"queued\"},\n23-    {\"id\":\"SHARD-03\",\"title\":\"Session, UI, input, and accessibility\",\"max_contracts\":250,\"depends_on\":[\"SHARD-01\",\"SHARD-02\"],\"covers\":[\"session/checkpoints\",\"semantic responsive shell\",\"game panels\",\"keyboard/mouse/touch/gamepad adapters\",\"settings\",\"localisation\",\"captions\",\"feedback\",\"error recovery UI\",\"accessibility tests\"],\"requirement_ids\":[\"REQ-0005\",\"REQ-0006\",\"REQ-0007\",\"REQ-0009\",\"REQ-0010\",\"REQ-0012\",\"NFR-0002\",\"NFR-0003\",\"NFR-0004\",\"NFR-0005\"],\"gate\":\"GATE-0002,GATE-0003,GATE-0004\",\"target_allocation\":\"shared UI model; web input/layout adapter; PWA inherits UI with no separate UI fork\",\"state\":\"queued\"},\n24-    {\"id\":\"SHARD-04\",\"title\":\"PWA delivery, performance, operations, and release evidence\",\"max_contracts\":250,\"depends_on\":[\"SHARD-01\",\"SHARD-02\",\"SHARD-03\"],\"covers\":[\"PWA manifest/install\",\"service-worker cache lifecycle\",\"offline/update recovery\",\"performance measurement\",\"security headers\",\"release checks\",\"observability\",\"quality automation\",\"player/operator documentation\",\"platform certification assessment\"],\"requirement_ids\":[\"REQ-0011\",\"REQ-0012\",\"NFR-0001\",\"NFR-0003\",\"NFR-0006\",\"NFR-0009\",\"NFR-0011\",\"NFR-0012\"],\"gate\":\"GATE-0002,GATE-0005,GATE-0007\",\"target_allocation\":\"web release build and PWA service-worker/install adapter are distinct; shared core owns neither cache nor hosting\",\"state\":\"queued\"},\