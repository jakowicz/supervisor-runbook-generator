[stderr] +dependencies: R0002,R0003,R0006
[stderr] +requirement_ids: REQ-0012,NFR-0006
[stderr] +source_specifications: specification/03-technical-contract.md#trust-privacy-and-security,specification/04-experience-contract.md#empty-error-recovery-destructive-and-privacy-sensitive-states
