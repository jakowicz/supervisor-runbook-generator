[stderr] +title: Define pure save migration runner
[stderr] +dependencies: R0005,R0006
[stderr] +requirement_ids: REQ-0006,NFR-0002,NFR-0003
[stderr] +source_specifications: specification/03-technical-contract.md#persistence-migration-and-failure-semantics
[stderr] +source_catalogue_ids: IMP-0007
[stderr] +authoring_batch: B0005
[stderr] +factory_stages: F011,F012,F013
[stderr] +asset_impact: not_applicable
