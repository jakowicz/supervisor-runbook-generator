[stderr] def _collection_progress(runbooks_directory: Path, database_path: Path) -> tuple[int, int, str | None]:
[stderr]     """Return accepted count, pending count, and the next runbook without creating state."""
[stderr] 
[stderr]     runbooks = sorted(
[stderr]         (path for path in runbooks_directory.glob("*.md") if re.fullmatch(r"[A-Za-z]+\d+", path.stem)),
[stderr]         key=lambda path: (load_task(path).sequence, path.name),
[stderr]     ) if runbooks_directory.is_dir() else []
[stderr]     if not runbooks:
[stderr]         return 0, 0, None
[stderr]     states: dict[str, str] = {}
[stderr]     if database_path.is_file():
[stderr]         connection = sqlite3.connect(f"file:{database_path}?mode=ro", uri=True)
[stderr]         try:
[stderr]             states = dict(connection.execute("SELECT task_id, status FROM task_state"))
[stderr]         except sqlite3.OperationalError:
[stderr]             states = {}
[stderr]         finally:
[stderr]             connection.close()
[stderr]     accepted = sum(states.get(path.stem) == "accepted" for path in runbooks)
[stderr]     next_runbook = next((path.stem for path in runbooks if states.get(path.stem) != "accepted"), None)
[stderr]     return accepted, len(runbooks) - accepted, next_runbook
