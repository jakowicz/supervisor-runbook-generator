[stderr]         statuses.append({
[stderr]             "name": workspace.name,
[stderr]             "brief": str(workspace / "INITIAL.md"),
[stderr]             "phase": phase,
[stderr]             "accepted": accepted,
[stderr]             "pending": pending,
[stderr]             "next": active[1] if active else "None",
[stderr]         })
[stderr]     return statuses
