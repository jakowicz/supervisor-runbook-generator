[stderr]             ("B-series authoring", workspace / "authoring-runbooks", workspace / ".state" / "authoring-runbooks.sqlite3"),
[stderr]             ("F-series factory", factory_runbooks_directory, workspace / ".state" / "factory.sqlite3"),
[stderr]         )
[stderr]         progress = [_collection_progress(*collection[1:]) for collection in collections]
[stderr]         accepted = sum(item[0] for item in progress)
[stderr]         pending = sum(item[1] for item in progress)
[stderr]         active = next(((label, item[2]) for (label, *_paths), item in zip(collections, progress) if item[2]), None)
