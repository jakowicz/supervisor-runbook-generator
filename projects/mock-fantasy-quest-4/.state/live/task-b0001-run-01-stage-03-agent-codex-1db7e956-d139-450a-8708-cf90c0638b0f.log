n\":\"content\",\"targets\":[\"shared\"],\"requirement_ids\":[\"REQ-0002\",\"REQ-0008\",\"NFR-0007\",\"NFR-0008\"],\"bounded_outcome\":\"Typed content-package schema and validator cover IDs, references, locale keys, assets, predicates, rewards, and reachability but contain no authored campaign expression.\",\"prerequisites\":[\"IMP-0001\",\"IMP-0004\",\"IMP-0003\"],\"ownership\":{\"files\":[\"src/content/{schema,validator,registry}/\",\"tests/content/validation.*\",\"docs/content-authoring.md\"],\"data\":[\"versioned content package format\",\"asset/provenance manifest schema\"],\"api\":[\"content registry and validator API\"]},\"forbidden_scope\":[\"town/dungeon dialogue/maps/assets\",\"copied reference expression\",\"release packaging\"],\"verification\":\"Valid minimum package passes; each invalid reference class fails; a graph fixture checks opening-to-ending reachability.\",\"human_external_gate\":\"GATE-0004 for quantities, locale, and content detail; human provenance review remains required.\",\"complexity\":\"high\",\"status\":\"current\"},\nprojects/mock-fantasy-quest-4/planning/implementation-catalogue-index.json-13-    {\"id\":\"IMP-0006\",\"title\":\"Specify local save and recovery protocol\",\"domain\":\"persistence\",\"targets\":[\"shared\",\"web\",\"pwa\"],\"requirement_ids\":[\"REQ-0006\",\"REQ-0012\",\"NFR-0002\",\"NFR-0003\",\"NFR-0005\"],\"bounded_outcome\":\"A schema protocol specifies immutable revisions, checksums, current-pointer validation, known-good retention, quarantine, separate preferences, deletion confirmation, and safe-boundary persistence rules.\",\"prerequisites\":[\"IMP-0002\",\"IMP-0004\",\"IMP-0003\"],\"ownership\":{\"files\":[\"src/core/save/{schema,compatibility,migrations}/\",\"src/platform/web/persistence/\",\"tests/{core,platform}/save*\",\"docs/save-and-recovery.md\"],\"data\":[\"save snapshot and preference schemas\",\"quarantine record\"],\"api\":[\"snapshot repository and recovery protocol\"]},\"forbidden_scope\":[\"cloud sync\",\"identity\",\"PWA cache records\",\"eviction guarantee\"],\"verification\":\"Fault fixtures cover interrupted write, checksum failure, malformed data, quota/permission failure, quarantine, retry, and selected-slot deletion.\",\"human_external_gate\":\"GATE-0003 / DEC-0003 storage API, quota, support window, and recovery policy.\",\"complexity\":\"high\",\"status\":\"gated\"},\nprojects/mock-fantasy-quest-4/planning/implementation-catalogue-index.json-14-    {\"id\":\"IMP-0007\",\"title\":\"Define pure save migration runner\",\"domain\":\"persistence\",\"targets\":[\"shared\",\"web\",\"pwa\"],\"requirement_ids\":[\"REQ-0006\",\"NFR-0002\",\"NFR-0003\"],\"bounded_outcome\":\"Ordered, pure migrations declare supported versions and promote only validated candidates while preserving original invalid bytes for quarantine.\",\"prerequisites\":[\"IMP-0005\",\"IMP-0006\"],\"ownership\":{\"files\":[\"src/core/save/{migrations,compatibility}/\",\"tests/core/save/fixtures\"],\"data\":[\"migration registry and predecessor fixtures\"],\"api\":[\"migration runner API\"]},\"forbidden_scope\":[\"storage driver changes\",\"future data export\",\"automatic destructive repair\"],\"verification\":\"Every declared predecessor migrates once; unsupported or failed migration leaves the original candidate intact and quarantined.\",\"human_external_gate\":\"GATE-0003 / DEC-0003 support-window approval.\",\"complexity\":\"medium\",\"status\":\"gated\"},\nprojects/mock-fantasy-quest-4/planning/implementation-catalogue-index.json-15-    {\"id\":\"IMP-0008\",\"title\":\"Bound P0 identity, authorization, and connected-service exclusions\",\"domain\":\"security\",\"targets\":[\"shared\",\"web\",\"pwa\"],\"requirement_ids\":[\"REQ-0013\",\"REQ-0014\",\"REQ-0015\",\"NFR-0012\"],\"bounded_outcome\":\"Architecture and negative contract tests demonstrate that local campaign start/save/resume require no account identifier, token, remote profile, role, entitlement, multiplayer, or safety service.\",\"prerequisites\":[\"IMP-0002\",\"IMP-0004\"],\"ownership\":{\"files\":[\"docs/security-boundary.md\",\"tests/core/connected-scope-exclusion.*\"],\"data\":[\"future connected-service approval checklist\"],\"api\":[\"local-slot identity contract\"]},\"forbidden_scope\":[\"sign-in\",\"OAuth\",\"sync\",\"roles\",\"moderation\",\"purchases\",\"server APIs\"],\"verification\":\"Static scan and negative fixtures find no identity/token/privilege fields or network client in P0 foundation modules.\",\"human_external_gate\":\"GATE-0006 / DEC-0006 before any connected implementation.\",\"complexity\":\"low\",\"status\":\"current\"},\nprojects/mock-fantasy-quest-4/planning/implementation-catalogue-index.json-16-    {\"id\":\"IMP-0009\",\"title\":\"Define privacy-safe local diagnostics boundary\",\"domain\":\"privacy\",\"targets\":[\"web\",\"pwa\"],\"requirement_ids\":[\"REQ-0012\",\"NFR-0006\"],\"bounded_outcome\":\"A bounded local diagnostic schema, consent and clear controls, redaction rules, and no-network guardrails support future player recovery without collecting save or dialogue payloads.\",\"prerequisites\":[\"IMP-0002\",\"IMP-0003\",\"IMP-0006\"],\"ownership\":{\"files\":[\"src/platform/web/diagnostics/\",\"src/app/recovery/diagnostic-contract.*\",\"tests/platform/diagnostics.*\",\"docs/privacy-and-recovery.md\"],\"data\":[\"redacted local diagnostic record\",\"consent state\"],\"api\":[\"diagnostic recorder interface\"]},\"forbidden_scope\":[\"diagnostic provider/transport\",\"remote analytics\",\"retention promise\",\"secrets\"],\"verification\":\"Tests prove diagnostics are absent without consent, redact payloads, and can be deleted locally.\",\"human_external_gate\":\"GATE-0005 / DEC-0005 before transport, retention, hosting, or support claims.\",\"complexity\":\"medium\",\"status\":\"gated\"},\nprojects/mock-fantasy-quest-4/planning/implementation-catalogue-index.json:17:    {\"id\":\"IMP-0010\",\"title\":\"Establish semantic accessibility design tokens\",\"do