[stderr] +task_id: R0006
[stderr] +sequence: 6
[stderr] +title: Specify local save and recovery protocol
[stderr] +dependencies: R0002,R0003,R0004
[stderr] +requirement_ids: REQ-0006,REQ-0012,NFR-0002,NFR-0003,NFR-0005
[stderr] +source_specifications: specification/03-technical-contract.md#persistence-migration-and-failure-semantics,specification/04-experience-contract.md#empty-error-recovery-destructive-and-privacy-sensitive-states
