[stderr] +---
[stderr] +task_id: R0005
[stderr] +sequence: 5
[stderr] +title: Define versioned content schema and validation boundary
[stderr] +dependencies: R0001,R0003,R0004
[stderr] +requirement_ids: REQ-0002,REQ-0008,NFR-0007,NFR-0008
[stderr] +source_specifications: specification/03-technical-contract.md#versioned-content-and-save-schemas,specification/02-feature-model.md#save-recovery-and-offline-persistence
[stderr] +source_catalogue_ids: IMP-0005
[stderr] +authoring_batch: B0004
[stderr] +factory_stages: F011,F012,F013
[stderr] +asset_impact: not_applicable
[stderr] +asset_ids:
[stderr] +asset_brief: No art or audio assets; reserve schema and provenance fields only for later original assets.
[stderr] +audio_impact: not_applicable
[stderr] +audio_ids:
[stderr] +audio_brief:
