   raise ValueError(f\"{path} cannot depend on itself.\")\n        provenance_metadata = {\"source_specifications\", \"source_catalogue_ids\", \"authoring_batch\", \"factory_stages\"}\n        missing_provenance_metadata = provenance_metadata - metadata.keys()\n        if missing_provenance_metadata:\n            raise ValueError(\n                f\"{path} is an R-series runbook and must declare provenance metadata: \"\n                f\"{', '.join(sorted(missing_provenance_metadata))}\"\n            )\n        source_specifications = [value.strip() for value in metadata[\"source_specifications\"].split(\",\") if value.strip()]\n        source_catalogue_ids = [value.strip() for value in metadata[\"source_catalogue_ids\"].split(\",\") if value.strip()]\n        factory_stages = [value.strip() for value in metadata[\"factory_stages\"].split(\",\") if value.strip()]\n        if not source_specifications or not source_catalogue_ids or not factory_stages:\n            raise ValueError(f\"{path} has incomplete R-series provenance metadata.\")\n        if not re.fullmatch(r\"B\\d+\", metadata[\"authoring_batch\"]):\n            raise ValueError(f\"{path} has invalid authoring_batch; use an ID such as B0001.\")\n        if any(not re.fullmatch(r\"F\\d+\", stage) for stage in factory_stages):\n            raise ValueError(f\"{path} has invalid factory_stages; use comma-separated F-series IDs.\")\n        asset_metadata = {\"asset_impact\", \"asset_ids\"}\n        missing_asset_metadata = asset_metadata - metadata.keys()\n        if missing_asset_metadata:\n            raise ValueError(\n                f\"{path} is an R-series runbook and must declare asset metadata: \"\n                f\"{', '.join(sorted(missing_asset_metadata))}\"\n            )\n        if metadata[\"asset_impact\"] not in {\"required\", \"not_applicable\"}:\n            raise ValueError(f\"{path} has invalid asset_impact; use required or not_applicable.\")\n        declared_assets = [asset_id.strip() for asset_id in metadata[\"asset_ids\"].split(\",\") if asset_id.strip()]\n        if metadata[\"asset_impact\"] == \"required\" and not declared_assets:\n            raise ValueError(f\"{path} requires assets but has no asset_ids.\")\n        if metadata[\"asset_impact\"] == \"not_applicable\" and declared_assets:\n            raise ValueError(f\"{path} declares asset_ids but asset_impact is not_applicable.\")\n        audio_metadata = {\"audio_impact\", \"audio_ids\", \"audio_brief\", \"audio_duration_seconds\", \"audio_loop\", \"audio_style_version\"}\n        missing_audio_metadata = audio_metadata - metadata.keys()\n        if missing_audio_metadata:\n            raise ValueError(\n                f\"{path} is an R-series runbook and must declare audio metadata: \"\n                f\"{', '.join(sorted(missing_audio_metadata))}\"\n            )\n        if metadata[\"audio_impact\"] not in {\"required\", \"not_applicable\"}:\n            raise ValueError(f\"{path} has invalid audio_impact; use required or not_applicable.\")\n        declared_audio = [audio_id.strip() for audio_id in metadata[\"audio_ids\"].split(\",\") if audio_id.strip()]\n        if metadata[\"audio_impact\"] == \"required\":\n            if not declared_audio or not metadata[\"audio_brief\"].strip():\n                raise ValueError(f\"{path} requires audio but has no audio_ids or audio_brief.\")\n            try:\n                duration = int(metadata[\"audio_duration_seconds\"])\n            except ValueError as error:\n                raise ValueError(f\"{path} has invalid audio_duration_seconds.\") from error\n            if duration < 1:\n                raise ValueError(f\"{path} requires audio_duration_seconds greater than zero.\")\n            if metadata[\"audio_loop\"] not in {\"required\", \"not_required\"}:\n                raise ValueError(f\"{path} has invalid audio_loop; use required or not_required.\")\n        elif declared_audio or metadata[\"audio_brief\"].strip() or metadata[\"audio_duration_seconds\"].strip() not in {\"\", \"0\"} or metadata[\"audio_loop\"] not in {\"\", \"not_applicable\"}:\n            raise ValueError(f\"{path} declares audio fields but audio_impact is not_applicable.\")\n    criteria: list[str] = []\n    current: list[str] = []\n    for line in _section(document, \"Acceptance criteria\").splitlines():\n        if line.startswith(\"- \"):\n            if current:\n                criteria.append(\" \".join(current))\n            current = [line[2:].strip()]\n        elif current and line.strip():\n            # Markdown permits a hanging indent for a long bullet. Preserve\n            # the entire criterion so it remains a precise worker contract.\n            current.append(line.strip())\n    if current:\n        criteria.append(\" \".join(current))\n    if not criteria:\n        raise ValueError(f\"{path} has no acceptance criteria.\")\n    return Task(\n        task_id=metadata[\"task_id\"],\n        title=metadata[\"title\"],\n        sequence=int(metadata[\"sequence\"]),\n        dependencies=[value.strip() for value in metadata.get(\"dependencies\", \"\").split(\",\") if value.strip()],\n        browser_impact=metadata[\"browser_impact\"],\n        playwright_specs=[metadata[\"playwright_spec\"]] if metadata[\"playwright_spec\"] else [],\n        objective=_section(document, \"Objective\"),\n        acceptance_criteria=criteria,\n        asset_impact=metadata.get(\"asset_impact\", \"not_applicable\"),\n        asset_brief=metadata.get(\"asset_brief\", \"\"),\n        asset_ids=[asset_id.strip() for asset_id in metadata.get(\"asset_ids\", \"\").split(\",\") if asset_id.strip()],\n        visual_style_version=metadata.get(\"visual_style_version\", \"\"),\n        audio_impact=metadata.get(\"audio_impact\", \"not_applicable\"),\n        audio_brief=metadata.get(\"audio_brief\", \"\"),\n        audio_ids=[audio_id.strip() for audio_id in metadata.get(\"audio_ids\", \"\").split(\",\") if audio_id.strip()],\n        audio_duration_seconds=int(metadata.get(\"audio_duration_seconds\", \"0\") or 0),\n        audio_loop=metadata.get(\"audio_loop\", \"not_applicable\"),\n        audio_style_version=metadata.get(\"audio_style_version\", \"\"),\n        source_specifications=[value.strip() for value in metadata.get(\"source_specifications\", \"\").split(\",\") if value.strip()],\n        source_catalogue_ids=[value.strip() for value in metadata.get(\"source_catalogue_ids\", \"\").split(\",\") if value.strip()],\n        authoring_batch=metadata.get(\"authoring_batch\", \"\"),\n        factory_stages=[value.strip() for value in metadata.get(\"factory_stages\", \"\").split(\",\") if value.strip()],\n    )\n---\ntask_id: R0001\nsequence: 1\ntitle: Bootstrap reproducible shared project baseline\ndependencies: []\nrequirement_ids:\n  - NFR-0010\n  - NFR-0012\nsource_specifications:\n  - specification/01-product-brief.md#release-definition\n  - specification/03-technical-contract.md#architecture-and-requirement-traceability\nsource_catalogue_ids:\n  - IMP-0001\nauthoring_batch: B0001\nfactory_stages:\n  - F011\n  - F012\n  - F013\nasset_impact: not_applicable\nasset_ids:\nasset_brief: No product asset work; establish only project/tooling boundaries and prohibit incidental assets.\naudio_impact: not_applicable\naudio_ids:\naudio_brief:\naudio_duration_seconds: 0\naudio_loop: not_applicable\naudio_style_version:\nbrowser_impact: not_applicable\nplaywright_spec:\n---\n\n## Objective\n\nAfter DEC-0001 selects the framework, package manager, and CI baseline, create\nthe smallest reproducible project skeleton for the shared game core, web\nadapter, and PWA adapter. Document one bootstrap, format, lint, and\ndeterministic test command interface, and make a clean approved-runtime\ncheckout run a deterministic sample test. This task establishes boundaries and\ntooling only; it does not implement game behaviour or resolve the decision.\n\n## Dependencies\n\nThis is the first implementation contract and has no R-series dependencies.\nGATE-0001 / DEC-0001 is retained as a human implementation precondition:\nauthoring this runbook does not select a stack, and implementation must stop\nbefore selecting or installing framework, package-manager, or CI tooling.\n\n## Ownership\n\n- Root build and tooling configuration, including the pinned toolchain\n  declaration and command mapping.\n- `src/core/`, `src/content/`, `src/app/`, `src/platform/web/`, and\n  `src/platform/pwa/` ownership directories, created without feature code.\n- `tests/` and an isolated deterministic sample-test location.\n- `docs/development.md`, which records the approved-runtime bootstrap,\n  format, lint, and deterministic-test commands once DEC-0001 is decided.\n- The build/test command interface: `bootstrap`, `format`, `lint`, and\n  `test:deterministic` (or the selected tool's documented equivalent).\n\n## Behaviour\n\nUse the DEC-0001-approved runtime only. Pin its version and package-manager\nlock/metadata as appropriate to that approved selection. Create the isolated\ndirectory skeleton so later work has distinct shared-core, content, app,\nweb-adapter, PWA-adapter, and test ownership.\n\nConfigure the selected tooling so the documented command interface has a\nsingle reproducible mapping for bootstrap, formatting, linting, and a\ndeterministic sample test. The sample test must use no wall clock, network,\nplayer data, browser storage, renderer, or platform feature. Record the exact\ncommands and a clean-checkout result in `docs/development.md`.\n\nThe skeleton must preserve the canonical direction: target adapters are\nseparate from the shared deterministic core, and no directory implies that a\ntarget may change campaign rules. Later R0002 owns enforcement of detailed\ncore/adapter dependency rules.\n\n## Web and PWA differences\n\nThe responsive web and installable PWA targets receive separate adapter\ndirectories only. Neither adapter gains a renderer, service worker, cache\nlifecycle, browser API dependency, or target-specific campaign behaviour in\nthis task. PWA installation, caching, offline delivery, and update activation\nremain later scoped work; the PWA directory is an ownership boundary, not an\nimplementation of those features.\n\n## Non-goals\n\nDo not resolve DEC-0001 or choose a framework, package manager, CI provider,\nhost, storage API, browser/device matrix, or performance budget. Do not add\ngameplay, campaign state, content, UI screens, renderer code, input handling,\nservice worker, persistence, network client, accounts, diagnostics, hosting,\nor release automation. Do not claim browser/PWA compatibility or release\nreadiness.\n\n## Asset assessment\n\n`asset_impact` is `not_applicable`. The baseline contains only source,\nconfiguration, test, and developer-documentation boundaries. Do not create or\nadd incidental product visuals, UI assets, illustrations, icons, fonts,\ntextures, sprites, maps, audio-visual assets, or copied reference styling;\n`asset_ids` remains blank.\n\n## Audio assessment\n\n`audio_impact` is `not_applicable`. Do not create, add, reserve, or reference\nmusic, sound effects, voice, or other product audio; the blank audio metadata\nand zero duration intentionally record that exclusion.\n\n## Verification\n\n- Before implementation, confirm DEC-0001 is accepted and record the approved\n  runtime, package manager, CI baseline, and pinned versions. If it remains\n  unresolved, stop implementation and report GATE-0001 without substituting a\n  tool choice.\n- In a clean checkout of the approved runtime, run the exact documented\n  bootstrap command, format check, lint check, and deterministic sample-test\n  command.\n- Verify the documented ownership directories exist and that the sample test\n  is isolated from browser, network, storage, clock, and product data.\n- Preserve command output, pinned-toolchain evidence, directory listing, and\n  the deterministic test result in the implementation evidence.\n\n## Evidence\n\n`docs/development.md` must identify the selected command mapping and pinned\ntoolchain only after DEC-0001. The implementation record must retain the clean\ncheckout command outputs and show the isolated ownership directories. If the\ngate is still blocked, retain this runbook and record that no implementation\ntooling or product work was created.\n\n## Acceptance criteria\n\n- An approved-runtime clean checkout can run the documented bootstrap, format,\n  lint, and deterministic sample-test commands successfully.\n- Shared core, content, app, web-adapter, PWA-adapter, and test ownership\n  directories are isolated without feature, renderer, storage, or service\n  implementation.\n- GATE-0001 / DEC-0001 remains explicit; this task neither selects the stack\n  nor claims implementation, browser, PWA, or release readiness before that\n  decision.\n- No product visual or audio asset is created or introduced.\n\napply patch\npatch: completed\n/Users/simon/Dev/github/jakowicz/runbook-generator/projects/mock-fantasy-quest-4/runbooks/R0002.md\n/Users/simon/Dev/github/jakowicz/runbook-generator/projects/mock-fantasy-quest-4/runbooks/R0003.md\n/Users/simon/Dev/github/jakowicz/runbook-generator/projects/mock-fantasy-quest-4/runbooks/R0010.md\ndiff --git a/projects/mock-fantasy-quest-4/runbooks/R0002.md b/projects/mock-fantasy-quest-4/runbooks/R0002.md\nindex 633a41b6ad8a45f627ad63db38ac8bc620e63a41..85f80ebd6c03813683e4a4a10ed48a0e59d2f2e9\n--- a/projects/mock-fantasy-quest-4/runbooks/R0002.md\n+++ b/projects/mock-fantasy-quest-4/runbooks/R0002.md\n@@ -2,22 +2,12 @@\n task_id: R0002\n sequence: 2\n title: Enforce shared-core and adapter dependency seams\n-dependencies:\n-  - R0001\n-requirement_ids:\n-  - NFR-0010\n-  - REQ-0013\n-  - NFR-0012\n-source_specifications:\n-  - specification/03-technical-contract.md#architecture-and-requirement-traceability\n-  - specification/03-technical-contract.md#dependency-direction-and-state-rules\n-source_catalogue_ids